/// Process metadata and control helpers, backed by `beskid_host` builtins.

use Core.Process.ProcessError;
use Core.Results;

pub i32 Id() {
    return __process_getpid();
}

pub unit Exit(i32 code) {
    __process_exit(code);
    return;
}

pub Core.Results.Result<i32, ProcessError> ExitCode() {
    return Result::Ok(__process_last_exit_code());
}

/// Spawns a child process and waits for completion.
/// @tier(supported)
pub Core.Results.Result<i32, ProcessError> Run(string command) {
    if command == "" {
        return Result::Error(ProcessError::InvalidCommand(command));
    }
    i32 code = __process_run(command);
    if code < 0 {
        return Result::Error(ProcessError::SpawnFailed(command));
    }
    return Result::Ok(code);
}

pub i32 CurrentId() {
    return Id();
}

pub bool IsCurrentProcess(i32 pid) {
    return pid == Id();
}
