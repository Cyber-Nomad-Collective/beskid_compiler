/// Value-mapping combinators over TextParseResult<T>.
use Core.Text.Parser.Result;

pub TextParseResult<string> Map(
    TextParseResult<string> result,
    string value
) {
    return match result {
        TextParseResult::Ok(_, rest) => TextParseResult<string>::Ok(value, rest),
        TextParseResult::Err(err) => TextParseResult<string>::Err(err),
    };
}

pub TextParseResult<string> Tap(
    TextParseResult<string> result
) {
    return result;
}
