/// Construction options for Channel<T>.Create.
/// Uses discriminated unions throughout — no bool flags or raw i64 bitfields.
/// @tier(standard)
/// Selects bounded vs unbounded channel capacity.
pub enum ChannelCapacity {
    Unbounded,
    Bounded(i64 capacity),
}

/// Reader concurrency hint — selects internal queue optimization.
pub enum ReaderHint {
    /// Multiple readers may concurrently receive.
    Multiple,
    /// Only one reader will ever receive from this channel.
    Single,
}

/// Writer concurrency hint — selects internal queue optimization.
pub enum WriterHint {
    /// Multiple writers may concurrently send.
    Multiple,
    /// Only one writer will ever send to this channel.
    Single,
}

/// Channel factory options.
pub type ChannelOptions {
    ChannelCapacity capacity,
    ReaderHint reader,
    WriterHint writer,
}

/// Default: unbounded, multiple-reader, multiple-writer.
pub ChannelOptions Default() {
    return ChannelOptions {
        capacity: ChannelCapacity::Unbounded,
        reader: ReaderHint::Multiple,
        writer: WriterHint::Multiple,
    };
}

/// Explicit unbounded queue.
pub ChannelOptions Unbounded() {
    return Default();
}

/// Bounded queue; senders park when full.
pub ChannelOptions Bounded(i64 capacity) {
    return ChannelOptions {
        capacity: ChannelCapacity::Bounded(capacity),
        reader: ReaderHint::Multiple,
        writer: WriterHint::Multiple,
    };
}

/// Unbounded, single-reader optimized.
pub ChannelOptions SingleReader() {
    return ChannelOptions {
        capacity: ChannelCapacity::Unbounded,
        reader: ReaderHint::Single,
        writer: WriterHint::Multiple,
    };
}

/// Unbounded, single-writer optimized.
pub ChannelOptions SingleWriter() {
    return ChannelOptions {
        capacity: ChannelCapacity::Unbounded,
        reader: ReaderHint::Multiple,
        writer: WriterHint::Single,
    };
}

/// Encodes capacity for __channel_create (0 = unbounded).
pub i64 EncodeCapacity(ChannelOptions options) {
    return match options.capacity {
        ChannelCapacity::Unbounded => 0,
        ChannelCapacity::Bounded(capacity) => capacity,
    };
}

/// Encodes reader/writer hint flags for __channel_create.
pub i64 EncodeFlags(ChannelOptions options) {
    i64 flags = 0;
    if options.reader == ReaderHint::Single {
        flags = flags + 1;
    }
    if options.writer == WriterHint::Single {
        flags = flags + 2;
    }
    return flags;
}
