/// ABI status codes returned by channel, hub, mutex, and wait-group builtins.
/// Discriminated union — no raw i64 constants. Use pattern matching.
/// @tier(standard)
pub enum Status {
    /// Operation completed successfully.
    Ok,
    /// Endpoint/queue is closed.
    Closed,
    /// Owning fiber was cancelled.
    Cancelled,
    /// Non-blocking operation would block.
    WouldBlock,
    /// Hub has no registered channels.
    HubEmpty,
    /// Hub registration cap reached (256).
    HubLimit,
    /// Hub handle not found / not registered.
    HubNotFound,
}

/// Returns the ABI i64 for this status (used by runtime builtins).
pub i64 ToI64(Status status) {
    return match status {
        Status::Ok => 0,
        Status::Closed => 1,
        Status::Cancelled => 2,
        Status::WouldBlock => 3,
        Status::HubEmpty => 4,
        Status::HubLimit => 5,
        Status::HubNotFound => 6,
    };
}

/// Parses an ABI i64 back into a Status.
pub Status FromI64(i64 code) {
    if code == 0 {
        return Status::Ok;
    }
    if code == 1 {
        return Status::Closed;
    }
    if code == 2 {
        return Status::Cancelled;
    }
    if code == 3 {
        return Status::WouldBlock;
    }
    if code == 4 {
        return Status::HubEmpty;
    }
    if code == 5 {
        return Status::HubLimit;
    }
    if code == 6 {
        return Status::HubNotFound;
    }
    return Status::Ok;
}
