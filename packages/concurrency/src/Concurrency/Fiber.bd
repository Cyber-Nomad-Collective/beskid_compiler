/// Cooperative fiber handle returned by `spawn`.
use Concurrency.FiberError;
use Concurrency.FiberJoinStatus;
use Concurrency.Status;

/// Runtime fiber handle; declares cancellation event on the handle only.
pub type Fiber<T> {
    i64 handle,
    event OnCancelled(),
}

/// Waits for completion and returns the entry value or a `FiberError`.
pub Core.Results.Result<T, FiberError> Join<T>(Fiber<T> self) {
    i64 raw_status = __fiber_join(self.handle);
    FiberJoinStatus status = FiberJoinStatus.FromI64(raw_status);
    return match status {
        FiberJoinStatus::Ok => Result::Ok(__fiber_join_value(self.handle)),
        FiberJoinStatus::Cancelled => Result::Error(FiberError::Cancelled()),
        FiberJoinStatus::StackOverflow => Result::Error(FiberError::StackOverflow()),
        FiberJoinStatus::Panicked => Result::Error(FiberError::Panicked(raw_status)),
        FiberJoinStatus::NotDone => Result::Error(FiberError::Panicked(raw_status)),
    };
}

/// Waives parent shutdown join; child panic still aborts the process in v1.
pub unit Detach<T>(Fiber<T> self) {
    __fiber_detach(self.handle);
    return;
}

/// Sets cancellation flag and raises `OnCancelled` on the child fiber.
pub unit Cancel<T>(Fiber<T> self) {
    __fiber_cancel(self.handle);
    return;
}

pub FiberError MapJoinError(FiberJoinStatus status) {
    return match status {
        FiberJoinStatus::Cancelled => FiberError::Cancelled(),
        FiberJoinStatus::StackOverflow => FiberError::StackOverflow(),
        FiberJoinStatus::Panicked => FiberError::Panicked(FiberJoinStatus.ToI64(status)),
        _ => FiberError::Panicked(FiberJoinStatus.ToI64(status)),
    };
}
