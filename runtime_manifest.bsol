# Sole source of truth for the Beskid native runtime ABI.
# All Rust, C, GNU-as, MASM, abi.json, and audit artifacts are generated from this file.
manifest {
  abi_version = 5
  schema_version = 2
  runtime_publisher = "beskid-lang.org"
  runtime_package = "beskid-runtime-native"
  trap_exit_status = 101
  trap_diagnostic = "beskid runtime trap v5"
  build_profiles = [debug, release]
}

target "x86_64-unknown-linux-gnu" {
  endianness = little
  pointer_width = 64
  calling_convention = system_v
  object_format = elf
  symbol_prefix = ""
  stack_alignment = 16
  shadow_space = 0
}
target "aarch64-apple-darwin" {
  endianness = little
  pointer_width = 64
  calling_convention = apple_aarch64
  object_format = macho
  symbol_prefix = "_"
  stack_alignment = 16
  shadow_space = 0
}
target "x86_64-pc-windows-msvc" {
  endianness = little
  pointer_width = 64
  calling_convention = windows_x64
  object_format = coff
  symbol_prefix = ""
  stack_alignment = 16
  shadow_space = 32
}

export "beskid_rt_v5_abi_version" { params = [] returns = u32 }
export "beskid_library_attach_v5" { params = [{ name = runtime, type = pointer }] returns = i32 }
export "beskid_library_detach_v5" { params = [{ name = runtime, type = pointer }] returns = void }
export "beskid_rt_v5_process_init" { params = [{ name = config, type = pointer }] returns = pointer }
export "beskid_rt_v5_process_shutdown" { params = [{ name = runtime, type = pointer }] returns = void }
export "beskid_rt_v5_thread_attach" { params = [{ name = runtime, type = pointer }] returns = pointer }
export "beskid_rt_v5_thread_detach" { params = [{ name = thread, type = pointer }] returns = void }
export "beskid_rt_v5_managed_object_allocate" { params = [{ name = request, type = pointer }] returns = pointer }
export "beskid_rt_v5_array_allocate_rooted" { params = [{ name = request, type = pointer }, { name = root_handle_out, type = pointer }] returns = pointer }
export "beskid_rt_v5_array_grow_rooted" { params = [{ name = array, type = pointer }, { name = minimum_capacity, type = usize }, { name = root_handle_out, type = pointer }] returns = pointer }
export "beskid_rt_v5_array_construction_finish" { params = [{ name = root_handle, type = pointer }] returns = u8 }
export "beskid_rt_v5_array_write_barrier" { params = [{ name = array, type = pointer }, { name = value, type = pointer }] returns = u8 }
export "beskid_rt_v5_closure_environment_allocate" { params = [{ name = request, type = pointer }] returns = pointer }
export "beskid_rt_v5_closure_capture_store" { params = [{ name = environment, type = pointer }, { name = descriptor, type = pointer }, { name = map_index, type = usize }, { name = value, type = pointer }] returns = u8 }
export "beskid_rt_v5_closure_environment_root" { params = [{ name = tls_state, type = pointer }, { name = slot_index, type = usize }, { name = environment, type = pointer }] returns = u8 }
export "beskid_rt_v5_fiber_spawn_with_cancel_slot" { params = [{ name = entry, type = pointer }, { name = environment, type = pointer }, { name = cancelled_slot, type = pointer }] returns = i64 }
export "beskid_rt_v5_closure_environment_root_current" { params = [{ name = slot_index, type = usize }, { name = environment, type = pointer }] returns = u8 }
export "beskid_rt_v5_trap" {
  params = [{ name = code, type = u8 }, { name = message, type = pointer }, { name = message_len, type = usize }]
  returns = never
}
export "beskid_rt_v5_fiber_yield" { params = [] returns = void }
export "beskid_rt_v5_fiber_return_trampoline" { params = [] returns = never }

intrinsic "native_word_from_pointer" { symbol = "beskid_rt_v5_intrinsic_native_word_from_pointer" capability = "runtime.bootstrap.native_word_from_pointer" params = [{ name = value, type = pointer }] returns = usize }
intrinsic "pointer_from_native_word" { symbol = "beskid_rt_v5_intrinsic_pointer_from_native_word" capability = "runtime.bootstrap.pointer_from_native_word" params = [{ name = value, type = usize }] returns = pointer }
intrinsic "pointer_add" { symbol = "beskid_rt_v5_intrinsic_pointer_add" capability = "runtime.bootstrap.pointer_add" params = [{ name = base, type = pointer }, { name = offset, type = usize }] returns = pointer }
intrinsic "raw_word_load" { symbol = "beskid_rt_v5_intrinsic_raw_word_load" capability = "runtime.bootstrap.raw_word_load" params = [{ name = address, type = pointer }] returns = usize }
intrinsic "raw_word_store" { symbol = "beskid_rt_v5_intrinsic_raw_word_store" capability = "runtime.bootstrap.raw_word_store" params = [{ name = address, type = pointer }, { name = value, type = usize }] returns = void }
intrinsic "raw_byte_load" { symbol = "beskid_rt_v5_intrinsic_raw_byte_load" capability = "runtime.bootstrap.raw_byte_load" params = [{ name = address, type = pointer }] returns = u8 }
intrinsic "raw_byte_store" { symbol = "beskid_rt_v5_intrinsic_raw_byte_store" capability = "runtime.bootstrap.raw_byte_store" params = [{ name = address, type = pointer }, { name = value, type = u8 }] returns = void }
intrinsic "memory_set" { symbol = "beskid_rt_v5_intrinsic_memory_set" capability = "runtime.bootstrap.memory_set" params = [{ name = destination, type = pointer }, { name = byte, type = u8 }, { name = length, type = usize }] returns = void }
intrinsic "memory_copy" { symbol = "beskid_rt_v5_intrinsic_memory_copy" capability = "runtime.bootstrap.memory_copy" params = [{ name = destination, type = pointer }, { name = source, type = pointer }, { name = length, type = usize }] returns = void }
intrinsic "memory_compare" { symbol = "beskid_rt_v5_intrinsic_memory_compare" capability = "runtime.bootstrap.memory_compare" params = [{ name = left, type = pointer }, { name = right, type = pointer }, { name = length, type = usize }] returns = i32 }
intrinsic "system_allocate" { symbol = "beskid_rt_v5_intrinsic_system_allocate" capability = "runtime.bootstrap.system_allocate" params = [{ name = size, type = usize }, { name = alignment, type = usize }] returns = pointer }
intrinsic "system_free" { symbol = "beskid_rt_v5_intrinsic_system_free" capability = "runtime.bootstrap.system_free" params = [{ name = address, type = pointer }, { name = size, type = usize }] returns = void }
# Target-native guarded stack reservations are available only to the canonical
# scheduler. The adapter returns the writable usable base; its lower guard is
# retained by the native reservation and can be released only as one region.
intrinsic "guarded_stack_allocate" { symbol = "beskid_rt_v5_intrinsic_guarded_stack_allocate" capability = "runtime.bootstrap.guarded_stack_allocate" params = [{ name = usable_size, type = usize }] returns = pointer }
intrinsic "guarded_stack_free" { symbol = "beskid_rt_v5_intrinsic_guarded_stack_free" capability = "runtime.bootstrap.guarded_stack_free" params = [{ name = usable_base, type = pointer }, { name = usable_size, type = usize }] returns = void }
intrinsic "tls_get" { symbol = "beskid_rt_v5_intrinsic_tls_get" capability = "runtime.bootstrap.tls_get" params = [] returns = pointer }
intrinsic "tls_set" { symbol = "beskid_rt_v5_intrinsic_tls_set" capability = "runtime.bootstrap.tls_set" params = [{ name = value, type = pointer }] returns = void }
intrinsic "trap" { symbol = "beskid_rt_v5_trap" capability = "runtime.bootstrap.trap" params = [{ name = code, type = u8 }, { name = message, type = pointer }, { name = message_len, type = usize }] returns = never }
intrinsic "fiber_yield" { symbol = "beskid_rt_v5_fiber_yield" capability = "runtime.bootstrap.fiber_yield" params = [] returns = void }
intrinsic "fiber_return_trampoline" { symbol = "beskid_rt_v5_fiber_return_trampoline" capability = "runtime.bootstrap.fiber_return_trampoline" params = [] returns = never }
intrinsic "clock_monotonic_nanos" { symbol = "beskid_rt_v5_intrinsic_clock_monotonic_nanos" capability = "runtime.adapter.clock_monotonic_nanos" params = [] returns = i64 }
intrinsic "clock_realtime_nanos" { symbol = "beskid_rt_v5_intrinsic_clock_realtime_nanos" capability = "runtime.adapter.clock_realtime_nanos" params = [] returns = i64 }
intrinsic "process_exit" { symbol = "beskid_rt_v5_intrinsic_process_exit" capability = "runtime.adapter.process_exit" params = [{ name = code, type = i32 }] returns = never }
intrinsic "process_getpid" { symbol = "beskid_rt_v5_intrinsic_process_getpid" capability = "runtime.adapter.process_getpid" params = [] returns = i32 }
# Canonical process adapters. Their ABI declarations are authoritative even
# when a target's platform implementation is not linked into a runtime kit.
intrinsic "env_get" { symbol = "beskid_rt_v5_intrinsic_env_get" capability = "runtime.adapter.env_get" params = [{ name = key, type = pointer }] returns = pointer }
intrinsic "env_set" { symbol = "beskid_rt_v5_intrinsic_env_set" capability = "runtime.adapter.env_set" params = [{ name = key, type = pointer }, { name = value, type = pointer }] returns = i32 }
intrinsic "env_getcwd" { symbol = "beskid_rt_v5_intrinsic_env_getcwd" capability = "runtime.adapter.env_getcwd" params = [] returns = pointer }
intrinsic "fs_read_text" {
  symbol = "beskid_rt_v5_intrinsic_fs_read_text"
  capability = "runtime.adapter.fs_read_text"
  params = [{ name = path, type = pointer }, { name = text_out, type = pointer }]
  returns = i32
  result_status = "BeskidFsStatus"
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_read_text", os_imports = [open, fstat, read, close, mmap, munmap] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_read_text", os_imports = [open, fstat, read, close, mmap, munmap] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_read_text", os_imports = [MultiByteToWideChar, CreateFileW, GetFileSizeEx, ReadFile, CloseHandle, VirtualAlloc, VirtualFree] }
  ]
}
intrinsic "fs_write_text" {
  symbol = "beskid_rt_v5_intrinsic_fs_write_text"
  capability = "runtime.adapter.fs_write_text"
  params = [{ name = path, type = pointer }, { name = text, type = pointer }]
  returns = i32
  result_status = "BeskidFsStatus"
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_write_text", os_imports = [open, write, close] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_write_text", os_imports = [open, write, close] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_write_text", os_imports = [MultiByteToWideChar, CreateFileW, WriteFile, CloseHandle] }
  ]
}
intrinsic "fs_exists" {
  symbol = "beskid_rt_v5_intrinsic_fs_exists"
  capability = "runtime.adapter.fs_exists"
  params = [{ name = path, type = pointer }]
  returns = i32
  result_status = "BeskidFsStatus"
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_exists", os_imports = [stat] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_exists", os_imports = [stat] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_exists", os_imports = [MultiByteToWideChar, GetFileAttributesW] }
  ]
}
intrinsic "fs_mkdir" {
  symbol = "beskid_rt_v5_intrinsic_fs_mkdir"
  capability = "runtime.adapter.fs_mkdir"
  params = [{ name = path, type = pointer }]
  returns = i32
  result_status = "BeskidFsStatus"
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_mkdir", os_imports = [mkdir] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_mkdir", os_imports = [mkdir] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_mkdir", os_imports = [MultiByteToWideChar, CreateDirectoryW] }
  ]
}
intrinsic "fs_delete" {
  symbol = "beskid_rt_v5_intrinsic_fs_delete"
  capability = "runtime.adapter.fs_delete"
  params = [{ name = path, type = pointer }]
  returns = i32
  result_status = "BeskidFsStatus"
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_delete", os_imports = [unlink] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_delete", os_imports = [unlink] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_delete", os_imports = [MultiByteToWideChar, DeleteFileW] }
  ]
}
intrinsic "tty_winsize" { symbol = "beskid_rt_v5_intrinsic_tty_winsize" capability = "runtime.adapter.tty_winsize" params = [] returns = pointer }
# Target context metadata is materialized by the compiler from the selected
# `BeskidArchContext*` layout. These are not platform imports and cannot be
# forged by application source.
intrinsic "arch_context_size" { symbol = "beskid_rt_v5_intrinsic_arch_context_size" capability = "runtime.bootstrap.arch_context_size" params = [] returns = usize }
intrinsic "arch_context_alignment" { symbol = "beskid_rt_v5_intrinsic_arch_context_alignment" capability = "runtime.bootstrap.arch_context_alignment" params = [] returns = usize }
# These intrinsic names resolve to the exact assembly exports below. The
# canonical scheduler is their only source authority; no Rust/host fallback is
# admitted by the ABI contract.
intrinsic "context_init" { symbol = "beskid_arch_v5_context_init" capability = "runtime.bootstrap.context_init" params = [{ name = context, type = pointer }, { name = stack_top, type = pointer }, { name = entry, type = pointer }, { name = argument, type = pointer }, { name = return_trampoline, type = pointer }] returns = void }
intrinsic "context_switch" { symbol = "beskid_arch_v5_context_switch" capability = "runtime.bootstrap.context_switch" params = [{ name = from, type = pointer }, { name = to, type = pointer }] returns = void }

status "BeskidFsStatus" { repr = i32 values = [{ name = Ok, value = 0 }, { name = NotFound, value = 1 }, { name = PermissionDenied, value = 2 }, { name = IOError, value = 3 }, { name = InvalidInput, value = 4 }, { name = AlreadyExists, value = 5 }] }
status "BeskidRuntimeLifecycle" { repr = u32 values = [{ name = Uninitialized, value = 0 }, { name = Initializing, value = 1 }, { name = Active, value = 2 }, { name = ShuttingDown, value = 3 }, { name = ShutDown, value = 4 }] }
status "BeskidCompositionStatus" { repr = usize values = [{ name = Configuring, value = 1 }, { name = Activating, value = 2 }, { name = Active, value = 3 }, { name = ShuttingDown, value = 4 }, { name = ShutDown, value = 5 }] }

# Process-linked runtime services remain outside the exact runtime-kit export
# allowlist, but have one manifest-owned declaration for analysis and JIT linking.
soft_builtin "__args_count" { symbol = "args_count" params = [] returns = i64 }
soft_builtin "__args_get" { symbol = "args_get" params = [{ name = index, type = i64 }] returns = string }
soft_builtin "__fiber_yield" { symbol = "beskid_rt_v5_fiber_yield" params = [] returns = void }
soft_builtin "__math_floor" { symbol = "math_floor" params = [{ name = value, type = f64 }] returns = f64 }
soft_builtin "__math_ceil" { symbol = "math_ceil" params = [{ name = value, type = f64 }] returns = f64 }
soft_builtin "__math_sqrt" { symbol = "math_sqrt" params = [{ name = value, type = f64 }] returns = f64 }
soft_builtin "__math_log" { symbol = "math_log" params = [{ name = value, type = f64 }] returns = f64 }

# Foundation Core.Args services bind to one generated ABI-v5 adapter per
# supported target. This Task 3 declaration models generated binding authority
# only; it authorizes no direct target OS imports.
corelib_service "__args_count" {
  adapter = "beskid_rt_v5_args_count"
  params = []
  returns = i64
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_args_count", os_imports = [mmap] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_args_count", os_imports = [mmap] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_args_count", os_imports = [VirtualAlloc] }
  ]
}
corelib_service "__args_get" {
  adapter = "beskid_rt_v5_args_get"
  params = [{ name = index, type = i64 }]
  returns = string
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_args_get", os_imports = [mmap] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_args_get", os_imports = [mmap] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_args_get", os_imports = [VirtualAlloc] }
  ]
}

# The executable boundary is part of Core.Args authority. AOT selects this
# generated record; it must not infer target entry conventions from strings.
entry_adapter "Core.Args" {
  target = "x86_64-unknown-linux-gnu"
  executable_entry = main
  program_entry = beskid_program_main
  capture = utf8_argv
  handoff = beskid_rt_v5_args_handoff_utf8
  ownership = process_lifetime_copied_beskid_str_arena
  entry_source = "args_entry.S"
  os_imports = [memcpy, mmap, strlen]
}
entry_adapter "Core.Args" {
  target = "aarch64-apple-darwin"
  executable_entry = main
  program_entry = beskid_program_main
  capture = utf8_argv
  handoff = beskid_rt_v5_args_handoff_utf8
  ownership = process_lifetime_copied_beskid_str_arena
  entry_source = "args_entry.S"
  os_imports = [memcpy, mmap, strlen]
}
entry_adapter "Core.Args" {
  target = "x86_64-pc-windows-msvc"
  executable_entry = wmain
  program_entry = beskid_program_main
  capture = utf16_wargv
  handoff = beskid_rt_v5_args_handoff_utf16
  ownership = process_lifetime_copied_beskid_str_arena
  entry_source = "args_entry.asm"
  os_imports = [VirtualAlloc, strlen]
}

layout "BeskidAllocationRequest" { size = 24 alignment = 8 fields = [{ name = size, offset = 0, type = usize }, { name = alignment, offset = 8, type = usize }, { name = descriptor, offset = 16, type = pointer }] }
layout "BeskidHandle" { size = 16 alignment = 8 fields = [{ name = slot, offset = 0, type = u32 }, { name = generation, offset = 4, type = u32 }, { name = owner_cookie, offset = 8, type = u64 }] }
layout "BeskidObjectHeader" { size = 16 alignment = 8 fields = [{ name = descriptor, offset = 0, type = pointer }, { name = gc_word, offset = 8, type = usize }] }
layout "BeskidRootFrame" { size = 24 alignment = 8 fields = [{ name = previous, offset = 0, type = pointer }, { name = slots, offset = 8, type = pointer }, { name = slot_count, offset = 16, type = usize }] }
layout "BeskidRootSlot" { size = 8 alignment = 8 fields = [{ name = value, offset = 0, type = pointer }] }
layout "BeskidRuntimeState" { size = 64 alignment = 8 project_to_runtime = accessors fields = [{ name = abi_version, offset = 0, type = u32 }, { name = flags, offset = 4, type = u32 }, { name = current_thread, offset = 8, type = pointer }, { name = heap, offset = 16, type = pointer }, { name = callback_registry, offset = 24, type = pointer }, { name = scheduler, offset = 32, type = pointer }, { name = root_frame, offset = 40, type = pointer }, { name = tls_key, offset = 48, type = usize }, { name = lifecycle_state, offset = 56, type = u32 }, { name = lifecycle_generation, offset = 60, type = u32 }] }
# Scheduler state is the sole current-fiber authority. TLS offset 16 remains
# explicitly reserved so attachment/composition offsets cannot drift.
layout "BeskidTlsState" { size = 48 alignment = 8 project_to_runtime = accessors fields = [{ name = runtime, offset = 0, type = pointer }, { name = root_frame, offset = 8, type = pointer }, { name = reserved, offset = 16, type = usize }, { name = attach_depth, offset = 24, type = usize }, { name = composition_scope, offset = 32, type = pointer }, { name = composition_depth, offset = 40, type = usize }] }
layout "BeskidTypeDescriptor" { size = 40 alignment = 8 fields = [{ name = size, offset = 0, type = usize }, { name = alignment, offset = 8, type = usize }, { name = pointer_map, offset = 16, type = pointer }, { name = pointer_count, offset = 24, type = usize }, { name = flags, offset = 32, type = u32 }, { name = reserved, offset = 36, type = u32 }] }
# Immutable element metadata for an in-buffer typed array. This is intentionally
# distinct from BeskidTypeDescriptor: element pointer offsets are relative to an
# element base and may therefore be zero.
layout "BeskidArrayElementDescriptor" { size = 32 alignment = 8 fields = [{ name = stride, offset = 0, type = usize }, { name = alignment, offset = 8, type = usize }, { name = pointer_map, offset = 16, type = pointer }, { name = pointer_count, offset = 24, type = usize }] }
layout "BeskidArrayAllocationRequest" { size = 32 alignment = 8 fields = [{ name = element, offset = 0, type = pointer }, { name = length, offset = 8, type = usize }, { name = flags, offset = 16, type = u32 }, { name = reserved, offset = 20, type = u32 }] }
layout "BeskidHeapState" { size = 768 alignment = 8 project_to_runtime = accessors fields = [{ name = region_start, offset = 0, type = pointer }, { name = region_size, offset = 8, type = usize }, { name = bump, offset = 16, type = pointer }, { name = limit, offset = 24, type = pointer }, { name = live_bytes, offset = 32, type = usize }, { name = live_count, offset = 40, type = usize }, { name = collection_count, offset = 48, type = usize }, { name = collection_threshold, offset = 56, type = usize }, { name = gray_count, offset = 64, type = usize }, { name = gray_entries, offset = 72, type = "pointer[6]" }, { name = external_root_count, offset = 120, type = usize }, { name = external_roots, offset = 128, type = "pointer[63]" }, { name = handle_count, offset = 632, type = usize }, { name = handles, offset = 640, type = "BeskidGcHandleSlot[8]" }] }
layout "BeskidGcHandleSlot" { size = 16 alignment = 8 fields = [{ name = value, offset = 0, type = pointer }, { name = generation, offset = 8, type = usize }] }
layout "BeskidCallbackRegistry" { size = 1056 alignment = 8 project_to_runtime = accessors fields = [{ name = owner_runtime, offset = 0, type = pointer }, { name = callback_count, offset = 8, type = usize }, { name = handler_count, offset = 16, type = usize }, { name = reserved, offset = 24, type = usize }, { name = callbacks, offset = 32, type = "BeskidCallbackEntry[32]" }, { name = handlers, offset = 544, type = "BeskidCallbackEntry[32]" }] }
layout "BeskidCallbackEntry" { size = 16 alignment = 8 fields = [{ name = identity, offset = 0, type = pointer }, { name = target, offset = 8, type = pointer }] }
layout "BeskidPendingSpawn" { size = 40 alignment = 8 fields = [{ name = entry, offset = 0, type = pointer }, { name = argument, offset = 8, type = pointer }, { name = cancel_slot, offset = 16, type = pointer }, { name = parent, offset = 24, type = usize }, { name = reserved, offset = 32, type = usize }] }
layout "BeskidFiberRecord" { size = 128 alignment = 8 project_to_runtime = accessors fields = [{ name = state, offset = 0, type = usize }, { name = entry, offset = 8, type = pointer }, { name = argument, offset = 16, type = pointer }, { name = cancel_slot, offset = 24, type = pointer }, { name = parent, offset = 32, type = usize }, { name = detached, offset = 40, type = u8 }, { name = cancelled, offset = 41, type = u8 }, { name = outcome_kind, offset = 48, type = usize }, { name = outcome_value, offset = 56, type = i64 }, { name = join_snapshot_state, offset = 64, type = usize }, { name = join_snapshot_cancelled, offset = 72, type = u8 }, { name = join_snapshot_outcome_kind, offset = 80, type = usize }, { name = join_snapshot_outcome_value, offset = 88, type = i64 }, { name = stack_base, offset = 96, type = pointer }, { name = arch_context, offset = 104, type = pointer }, { name = arch_context_size, offset = 112, type = usize }, { name = stack_usable_size, offset = 120, type = usize }] }
# Bytes 0..3495 are occupied by the existing scheduler fields. The return
# trampoline requires a distinct saved scheduler context, so the next aligned
# pointer is at 3496 and the complete record size is 3504.
