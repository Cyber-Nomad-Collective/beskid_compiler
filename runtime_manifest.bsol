}
intrinsic "tty_winsize" { symbol = "beskid_rt_v5_intrinsic_tty_winsize" capability = "runtime.adapter.tty_winsize" params = [] returns = pointer }
# Target context metadata is materialized by the compiler from the selected
# `BeskidArchContext*` layout. These are not platform imports and cannot be
# forged by application source.
intrinsic "arch_context_size" { symbol = "beskid_rt_v5_intrinsic_arch_context_size" capability = "runtime.bootstrap.arch_context_size" params = [] returns = usize }
intrinsic "arch_context_alignment" { symbol = "beskid_rt_v5_intrinsic_arch_context_alignment" capability = "runtime.bootstrap.arch_context_alignment" params = [] returns = usize }
# These intrinsic names resolve to the exact assembly exports below. The
# canonical scheduler is their only source authority; no Rust/host fallback is
# admitted by the ABI contract.
intrinsic "context_init" { symbol = "beskid_arch_v5_context_init" capability = "runtime.bootstrap.context_init" params = [{ name = context, type = pointer }, { name = stack_top, type = pointer }, { name = entry, type = pointer }, { name = argument, type = pointer }, { name = return_trampoline, type = pointer }] returns = void }
intrinsic "context_switch" { symbol = "beskid_arch_v5_context_switch" capability = "runtime.bootstrap.context_switch" params = [{ name = from, type = pointer }, { name = to, type = pointer }] returns = void }
intrinsic "worker_pool_init" { symbol = "beskid_rt_v5_intrinsic_worker_pool_init" capability = "runtime.scheduler.worker_pool_init" params = [{ name = worker_count, type = usize }] returns = i32 }
intrinsic "worker_pool_shutdown" { symbol = "beskid_rt_v5_intrinsic_worker_pool_shutdown" capability = "runtime.scheduler.worker_pool_shutdown" params = [] returns = void }
intrinsic "worker_submit" { symbol = "beskid_rt_v5_intrinsic_worker_submit" capability = "runtime.scheduler.worker_submit" params = [{ name = request, type = pointer }] returns = i32 }
intrinsic "worker_poll" { symbol = "beskid_rt_v5_intrinsic_worker_poll" capability = "runtime.scheduler.worker_poll" params = [{ name = request, type = pointer }] returns = i32 }

status "BeskidFsStatus" { repr = i32 values = [{ name = Ok, value = 0 }, { name = NotFound, value = 1 }, { name = PermissionDenied, value = 2 }, { name = IOError, value = 3 }, { name = InvalidInput, value = 4 }, { name = AlreadyExists, value = 5 }] }
status "BeskidRuntimeLifecycle" { repr = u32 values = [{ name = Uninitialized, value = 0 }, { name = Initializing, value = 1 }, { name = Active, value = 2 }, { name = ShuttingDown, value = 3 }, { name = ShutDown, value = 4 }] }
status "BeskidCompositionStatus" { repr = usize values = [{ name = Configuring, value = 1 }, { name = Activating, value = 2 }, { name = Active, value = 3 }, { name = ShuttingDown, value = 4 }, { name = ShutDown, value = 5 }] }

# Process-linked runtime services remain outside the exact runtime-kit export
# allowlist, but have one manifest-owned declaration for analysis and JIT linking.
soft_builtin "__args_count" { symbol = "args_count" params = [] returns = i64 }
soft_builtin "__args_get" { symbol = "args_get" params = [{ name = index, type = i64 }] returns = string }
soft_builtin "__fiber_yield" { symbol = "beskid_rt_v5_fiber_yield" params = [] returns = void }
soft_builtin "__math_floor" { symbol = "math_floor" params = [{ name = value, type = f64 }] returns = f64 }
soft_builtin "__math_ceil" { symbol = "math_ceil" params = [{ name = value, type = f64 }] returns = f64 }
soft_builtin "__math_sqrt" { symbol = "math_sqrt" params = [{ name = value, type = f64 }] returns = f64 }
soft_builtin "__math_log" { symbol = "math_log" params = [{ name = value, type = f64 }] returns = f64 }

# Canonical process-linked runtime services. These exact symbols are compiler-owned
# corelib/runtime contracts and contribute to runtime-kit provenance on every target.
corelib_service "__array_new" {
  adapter = "array_new"
  params = [{ name = elementSize, type = usize }, { name = count, type = usize }]
  returns = pointer
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "array_new", os_imports = [] },
    { target = "aarch64-apple-darwin", implementation = "array_new", os_imports = [] },
    { target = "x86_64-pc-windows-msvc", implementation = "array_new", os_imports = [] }
  ]
}

