  returns = i32
  result_status = "BeskidFsStatus"
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_mkdir", os_imports = [mkdir, mmap, munmap] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_mkdir", os_imports = [mkdir, mmap, munmap] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_mkdir", os_imports = [MultiByteToWideChar, CreateDirectoryW, VirtualAlloc, VirtualFree, GetLastError] }
