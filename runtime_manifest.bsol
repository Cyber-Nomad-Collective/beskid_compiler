# The executable boundary is part of Core.Args authority. AOT selects this
# generated record; it must not infer target entry conventions from strings.
entry_adapter "Core.Args" {
  target = "x86_64-unknown-linux-gnu"
  executable_entry = main
  program_entry = beskid_program_main
  capture = utf8_argv
  handoff = beskid_rt_v5_args_handoff_utf8
  ownership = process_lifetime_copied_beskid_str_arena
  entry_source = "args_entry.S"
  os_imports = [memcpy, mmap, strlen]
}
entry_adapter "Core.Args" {
  target = "aarch64-apple-darwin"
  executable_entry = main
  program_entry = beskid_program_main
  capture = utf8_argv
  handoff = beskid_rt_v5_args_handoff_utf8
  ownership = process_lifetime_copied_beskid_str_arena
  entry_source = "args_entry.S"
  os_imports = [memcpy, mmap, strlen]
}
entry_adapter "Core.Args" {
  target = "x86_64-pc-windows-msvc"
  executable_entry = wmain
  program_entry = beskid_program_main
  capture = utf16_wargv
  handoff = beskid_rt_v5_args_handoff_utf16
  ownership = process_lifetime_copied_beskid_str_arena
  entry_source = "args_entry.asm"
  os_imports = [VirtualAlloc]
}

layout "BeskidAllocationRequest" { size = 24 alignment = 8 fields = [{ name = size, offset = 0, type = usize }, { name = alignment, offset = 8, type = usize }, { name = descriptor, offset = 16, type = pointer }] }
layout "BeskidHandle" { size = 16 alignment = 8 fields = [{ name = slot, offset = 0, type = u32 }, { name = generation, offset = 4, type = u32 }, { name = owner_cookie, offset = 8, type = u64 }] }
layout "BeskidObjectHeader" { size = 16 alignment = 8 fields = [{ name = descriptor, offset = 0, type = pointer }, { name = gc_word, offset = 8, type = usize }] }
layout "BeskidRootFrame" { size = 24 alignment = 8 fields = [{ name = previous, offset = 0, type = pointer }, { name = slots, offset = 8, type = pointer }, { name = slot_count, offset = 16, type = usize }] }
layout "BeskidRootSlot" { size = 8 alignment = 8 fields = [{ name = value, offset = 0, type = pointer }] }
layout "BeskidRuntimeState" { size = 64 alignment = 8 project_to_runtime = accessors fields = [{ name = abi_version, offset = 0, type = u32 }, { name = flags, offset = 4, type = u32 }, { name = current_thread, offset = 8, type = pointer }, { name = heap, offset = 16, type = pointer }, { name = callback_registry, offset = 24, type = pointer }, { name = scheduler, offset = 32, type = pointer }, { name = root_frame, offset = 40, type = pointer }, { name = tls_key, offset = 48, type = usize }, { name = lifecycle_state, offset = 56, type = u32 }, { name = lifecycle_generation, offset = 60, type = u32 }] }
# Native-only worker request. `buffer` is never a managed address: submission owns
# a copied system allocation until the canonical fiber resumes and releases it.
layout "BeskidWorkerRequest" { size = 64 alignment = 8 fields = [{ name = next, offset = 0, type = pointer }, { name = tag, offset = 8, type = u64 }, { name = operation, offset = 16, type = u32 }, { name = state, offset = 20, type = u32 }, { name = native_handle, offset = 24, type = usize }, { name = buffer, offset = 32, type = pointer }, { name = length, offset = 40, type = usize }, { name = result, offset = 48, type = isize }, { name = error, offset = 56, type = i32 }, { name = padding, offset = 60, type = u32 }] }
# Scheduler state is the sole current-fiber authority. TLS offset 16 remains
# explicitly reserved so attachment/composition offsets cannot drift.
layout "BeskidTlsState" { size = 48 alignment = 8 project_to_runtime = accessors fields = [{ name = runtime, offset = 0, type = pointer }, { name = root_frame, offset = 8, type = pointer }, { name = reserved, offset = 16, type = usize }, { name = attach_depth, offset = 24, type = usize }, { name = composition_scope, offset = 32, type = pointer }, { name = composition_depth, offset = 40, type = usize }] }
layout "BeskidTypeDescriptor" { size = 40 alignment = 8 fields = [{ name = size, offset = 0, type = usize }, { name = alignment, offset = 8, type = usize }, { name = pointer_map, offset = 16, type = pointer }, { name = pointer_count, offset = 24, type = usize }, { name = flags, offset = 32, type = u32 }, { name = reserved, offset = 36, type = u32 }] }
# Immutable element metadata for an in-buffer typed array. This is intentionally
# distinct from BeskidTypeDescriptor: element pointer offsets are relative to an
# element base and may therefore be zero.
layout "BeskidArrayElementDescriptor" { size = 32 alignment = 8 fields = [{ name = stride, offset = 0, type = usize }, { name = alignment, offset = 8, type = usize }, { name = pointer_map, offset = 16, type = pointer }, { name = pointer_count, offset = 24, type = usize }] }
layout "BeskidArrayAllocationRequest" { size = 32 alignment = 8 fields = [{ name = element, offset = 0, type = pointer }, { name = length, offset = 8, type = usize }, { name = descriptor, offset = 16, type = pointer }, { name = flags, offset = 24, type = u32 }, { name = reserved, offset = 28, type = u32 }] }
layout "BeskidHeapState" { size = 768 alignment = 8 project_to_runtime = accessors fields = [{ name = region_start, offset = 0, type = pointer }, { name = region_size, offset = 8, type = usize }, { name = bump, offset = 16, type = pointer }, { name = limit, offset = 24, type = pointer }, { name = live_bytes, offset = 32, type = usize }, { name = live_count, offset = 40, type = usize }, { name = collection_count, offset = 48, type = usize }, { name = collection_threshold, offset = 56, type = usize }, { name = gray_count, offset = 64, type = usize }, { name = gray_entries, offset = 72, type = "pointer[6]" }, { name = external_root_count, offset = 120, type = usize }, { name = external_roots, offset = 128, type = "pointer[63]" }, { name = handle_count, offset = 632, type = usize }, { name = handles, offset = 640, type = "BeskidGcHandleSlot[8]" }] }
layout "BeskidGcHandleSlot" { size = 16 alignment = 8 fields = [{ name = value, offset = 0, type = pointer }, { name = generation, offset = 8, type = usize }] }
layout "BeskidCallbackRegistry" { size = 1056 alignment = 8 project_to_runtime = accessors fields = [{ name = owner_runtime, offset = 0, type = pointer }, { name = callback_count, offset = 8, type = usize }, { name = handler_count, offset = 16, type = usize }, { name = composition_container, offset = 24, type = pointer }, { name = callbacks, offset = 32, type = "BeskidCallbackEntry[32]" }, { name = handlers, offset = 544, type = "BeskidCallbackEntry[32]" }] }
layout "BeskidCallbackEntry" { size = 16 alignment = 8 fields = [{ name = identity, offset = 0, type = pointer }, { name = target, offset = 8, type = pointer }] }
layout "BeskidPendingSpawn" { size = 40 alignment = 8 fields = [{ name = entry, offset = 0, type = pointer }, { name = argument, offset = 8, type = pointer }, { name = cancel_slot, offset = 16, type = pointer }, { name = parent, offset = 24, type = usize }, { name = reserved, offset = 32, type = usize }] }
layout "BeskidFiberRecord" { size = 128 alignment = 8 project_to_runtime = accessors fields = [{ name = state, offset = 0, type = usize }, { name = entry, offset = 8, type = pointer }, { name = argument, offset = 16, type = pointer }, { name = cancel_slot, offset = 24, type = pointer }, { name = parent, offset = 32, type = usize }, { name = detached, offset = 40, type = u8 }, { name = cancelled, offset = 41, type = u8 }, { name = generation, offset = 44, type = u32 }, { name = outcome_kind, offset = 48, type = usize }, { name = outcome_value, offset = 56, type = i64 }, { name = composition_scope, offset = 64, type = pointer }, { name = composition_depth, offset = 72, type = usize }, { name = root_frame, offset = 80, type = pointer }, { name = reserved, offset = 88, type = usize }, { name = stack_base, offset = 96, type = pointer }, { name = arch_context, offset = 104, type = pointer }, { name = arch_context_size, offset = 112, type = usize }, { name = stack_usable_size, offset = 120, type = usize }] }
# Bytes 0..3495 are occupied by scheduler fields. The saved scheduler context
# and poll-state pointer extend the manifest-owned record without hidden globals.
layout "BeskidSchedulerState" { size = 3512 alignment = 8 project_to_runtime = accessors fields = [{ name = fiber_count, offset = 0, type = usize }, { name = main_fiber, offset = 8, type = usize }, { name = run_queue_head, offset = 16, type = usize }, { name = run_queue_tail, offset = 24, type = usize }, { name = run_queue, offset = 32, type = "usize[32]" }, { name = pending_spawns, offset = 288, type = "BeskidPendingSpawn[8]" }, { name = pending_spawn_count, offset = 608, type = usize }, { name = pending_cancels, offset = 616, type = "usize[32]" }, { name = pending_cancel_count, offset = 872, type = usize }, { name = pending_detaches, offset = 880, type = "usize[32]" }, { name = pending_detach_count, offset = 1136, type = usize }, { name = pending_wakes, offset = 1144, type = "usize[32]" }, { name = pending_wake_count, offset = 1400, type = usize }, { name = fibers, offset = 1408, type = "BeskidFiberRecord[16]" }, { name = channel_table, offset = 3456, type = pointer }, { name = mutex_table, offset = 3464, type = pointer }, { name = waitgroup_table, offset = 3472, type = pointer }, { name = current_fiber, offset = 3480, type = usize }, { name = hub_table, offset = 3488, type = pointer }, { name = scheduler_context, offset = 3496, type = pointer }, { name = poll_state, offset = 3504, type = pointer }] }
layout "BeskidPollTask" { size = 80 alignment = 8 fields = [{ name = generation, offset = 0, type = usize }, { name = state, offset = 8, type = usize }, { name = queued, offset = 16, type = u8 }, { name = detached, offset = 17, type = u8 }, { name = poll_entry, offset = 24, type = pointer }, { name = task_state, offset = 32, type = pointer }, { name = result_slot, offset = 40, type = pointer }, { name = cancel_slot, offset = 48, type = pointer }, { name = outcome, offset = 56, type = usize }, { name = result, offset = 64, type = pointer }, { name = live_links, offset = 72, type = usize }] }
layout "BeskidPollMonitor" { size = 24 alignment = 8 fields = [{ name = generation, offset = 0, type = usize }, { name = task, offset = 8, type = usize }, { name = live, offset = 16, type = u8 }] }
layout "BeskidPollLink" { size = 32 alignment = 8 fields = [{ name = generation, offset = 0, type = usize }, { name = task, offset = 8, type = usize }, { name = live, offset = 16, type = u8 }, { name = reserved, offset = 24, type = usize }] }
layout "BeskidPollState" { size = 6144 alignment = 8 fields = [{ name = tasks, offset = 0, type = "BeskidPollTask[32]" }, { name = monitors, offset = 2560, type = "BeskidPollMonitor[64]" }, { name = links, offset = 4096, type = "BeskidPollLink[40]" }, { name = ready_queue, offset = 5376, type = "usize[32]" }, { name = ready_head, offset = 5632, type = usize }, { name = ready_tail, offset = 5640, type = usize }, { name = task_count, offset = 5648, type = usize }, { name = monitor_count, offset = 5656, type = usize }, { name = link_count, offset = 5664, type = usize }] }
layout "BeskidCompositionContainer" { size = 64 alignment = 8 project_to_runtime = accessors fields = [{ name = owner_runtime, offset = 0, type = pointer }, { name = status, offset = 8, type = usize }, { name = registration_count, offset = 16, type = usize }, { name = registrations, offset = 24, type = pointer }, { name = plural_count, offset = 32, type = usize }, { name = plural_bindings, offset = 40, type = pointer }, { name = activated_count, offset = 48, type = usize }, { name = open_scope_count, offset = 56, type = usize }] }
layout "BeskidCompositionScope" { size = 32 alignment = 8 project_to_runtime = accessors fields = [{ name = owner_container, offset = 0, type = pointer }, { name = parent_scope, offset = 8, type = pointer }, { name = owned_count, offset = 16, type = usize }, { name = owned_values, offset = 24, type = pointer }] }
