intrinsic "fs_delete" {
  symbol = "beskid_rt_v5_intrinsic_fs_delete"
  capability = "runtime.adapter.fs_delete"
  params = [{ name = path, type = pointer }]
  returns = i32
  result_status = "BeskidFsStatus"
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_delete", os_imports = [unlink, mmap, munmap] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_delete", os_imports = [unlink, mmap, munmap] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_delete", os_imports = [MultiByteToWideChar, DeleteFileW, VirtualAlloc, VirtualFree, GetLastError] }
