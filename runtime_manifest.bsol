# Sole source of truth for the Beskid native runtime ABI.
# All Rust, C, GNU-as, MASM, abi.json, and audit artifacts are generated from this file.
manifest {
  abi_version = 5
  schema_version = 1
  runtime_publisher = "beskid-lang.org"
  runtime_package = "beskid-runtime-native"
  trap_exit_status = 101
  trap_diagnostic = "beskid runtime trap v5"
}

target "x86_64-unknown-linux-gnu" {
  endianness = little
  pointer_width = 64
  calling_convention = system_v
  object_format = elf
  symbol_prefix = ""
  stack_alignment = 16
  shadow_space = 0
}
target "aarch64-apple-darwin" {
  endianness = little
  pointer_width = 64
  calling_convention = apple_aarch64
  object_format = macho
  symbol_prefix = "_"
  stack_alignment = 16
  shadow_space = 0
}
target "x86_64-pc-windows-msvc" {
  endianness = little
  pointer_width = 64
  calling_convention = windows_x64
  object_format = coff
  symbol_prefix = ""
  stack_alignment = 16
  shadow_space = 32
}

export "beskid_rt_v5_abi_version" { params = [] returns = u32 }
export "beskid_library_attach_v5" { params = [{ name = runtime, type = pointer }] returns = i32 }
export "beskid_library_detach_v5" { params = [{ name = runtime, type = pointer }] returns = void }
export "beskid_rt_v5_process_init" { params = [{ name = config, type = pointer }] returns = pointer }
export "beskid_rt_v5_process_shutdown" { params = [{ name = runtime, type = pointer }] returns = void }
export "beskid_rt_v5_thread_attach" { params = [{ name = runtime, type = pointer }] returns = pointer }
export "beskid_rt_v5_thread_detach" { params = [{ name = thread, type = pointer }] returns = void }
export "beskid_rt_v5_closure_environment_allocate" { params = [{ name = request, type = pointer }] returns = pointer }
export "beskid_rt_v5_closure_capture_store" { params = [{ name = environment, type = pointer }, { name = descriptor, type = pointer }, { name = map_index, type = usize }, { name = value, type = pointer }] returns = u8 }
export "beskid_rt_v5_closure_environment_root" { params = [{ name = tls_state, type = pointer }, { name = slot_index, type = usize }, { name = environment, type = pointer }] returns = u8 }
export "beskid_rt_v5_fiber_spawn_with_cancel_slot" { params = [{ name = entry, type = pointer }, { name = environment, type = pointer }, { name = cancelled_slot, type = pointer }] returns = i64 }
export "beskid_rt_v5_closure_environment_root_current" { params = [{ name = slot_index, type = usize }, { name = environment, type = pointer }] returns = u8 }
export "beskid_rt_v5_trap" {
  params = [{ name = code, type = u8 }, { name = message, type = pointer }, { name = message_len, type = usize }]
  returns = never
}

intrinsic "native_word_from_pointer" { symbol = "beskid_rt_v5_intrinsic_native_word_from_pointer" capability = "runtime.bootstrap.native_word_from_pointer" params = [{ name = value, type = pointer }] returns = usize }
intrinsic "pointer_from_native_word" { symbol = "beskid_rt_v5_intrinsic_pointer_from_native_word" capability = "runtime.bootstrap.pointer_from_native_word" params = [{ name = value, type = usize }] returns = pointer }
intrinsic "pointer_add" { symbol = "beskid_rt_v5_intrinsic_pointer_add" capability = "runtime.bootstrap.pointer_add" params = [{ name = base, type = pointer }, { name = offset, type = usize }] returns = pointer }
intrinsic "raw_word_load" { symbol = "beskid_rt_v5_intrinsic_raw_word_load" capability = "runtime.bootstrap.raw_word_load" params = [{ name = address, type = pointer }] returns = usize }
intrinsic "raw_word_store" { symbol = "beskid_rt_v5_intrinsic_raw_word_store" capability = "runtime.bootstrap.raw_word_store" params = [{ name = address, type = pointer }, { name = value, type = usize }] returns = void }
intrinsic "raw_byte_load" { symbol = "beskid_rt_v5_intrinsic_raw_byte_load" capability = "runtime.bootstrap.raw_byte_load" params = [{ name = address, type = pointer }] returns = u8 }
intrinsic "raw_byte_store" { symbol = "beskid_rt_v5_intrinsic_raw_byte_store" capability = "runtime.bootstrap.raw_byte_store" params = [{ name = address, type = pointer }, { name = value, type = u8 }] returns = void }
intrinsic "memory_set" { symbol = "beskid_rt_v5_intrinsic_memory_set" capability = "runtime.bootstrap.memory_set" params = [{ name = destination, type = pointer }, { name = byte, type = u8 }, { name = length, type = usize }] returns = void }
intrinsic "memory_copy" { symbol = "beskid_rt_v5_intrinsic_memory_copy" capability = "runtime.bootstrap.memory_copy" params = [{ name = destination, type = pointer }, { name = source, type = pointer }, { name = length, type = usize }] returns = void }
intrinsic "memory_compare" { symbol = "beskid_rt_v5_intrinsic_memory_compare" capability = "runtime.bootstrap.memory_compare" params = [{ name = left, type = pointer }, { name = right, type = pointer }, { name = length, type = usize }] returns = i32 }
intrinsic "system_allocate" { symbol = "beskid_rt_v5_intrinsic_system_allocate" capability = "runtime.bootstrap.system_allocate" params = [{ name = size, type = usize }, { name = alignment, type = usize }] returns = pointer }
intrinsic "system_free" { symbol = "beskid_rt_v5_intrinsic_system_free" capability = "runtime.bootstrap.system_free" params = [{ name = address, type = pointer }, { name = size, type = usize }] returns = void }
intrinsic "tls_get" { symbol = "beskid_rt_v5_intrinsic_tls_get" capability = "runtime.bootstrap.tls_get" params = [] returns = pointer }
intrinsic "tls_set" { symbol = "beskid_rt_v5_intrinsic_tls_set" capability = "runtime.bootstrap.tls_set" params = [{ name = value, type = pointer }] returns = void }
intrinsic "trap" { symbol = "beskid_rt_v5_trap" capability = "runtime.bootstrap.trap" params = [{ name = code, type = u8 }, { name = message, type = pointer }, { name = message_len, type = usize }] returns = never }

layout "BeskidAllocationRequest" { size = 24 alignment = 8 fields = [{ name = size, offset = 0, type = usize }, { name = alignment, offset = 8, type = usize }, { name = descriptor, offset = 16, type = pointer }] }
layout "BeskidHandle" { size = 16 alignment = 8 fields = [{ name = slot, offset = 0, type = u32 }, { name = generation, offset = 4, type = u32 }, { name = owner_cookie, offset = 8, type = u64 }] }
layout "BeskidObjectHeader" { size = 16 alignment = 8 fields = [{ name = descriptor, offset = 0, type = pointer }, { name = gc_word, offset = 8, type = usize }] }
layout "BeskidRootFrame" { size = 24 alignment = 8 fields = [{ name = previous, offset = 0, type = pointer }, { name = slots, offset = 8, type = pointer }, { name = slot_count, offset = 16, type = usize }] }
layout "BeskidRootSlot" { size = 8 alignment = 8 fields = [{ name = value, offset = 0, type = pointer }] }
layout "BeskidRuntimeState" { size = 64 alignment = 8 fields = [{ name = abi_version, offset = 0, type = u32 }, { name = flags, offset = 4, type = u32 }, { name = current_thread, offset = 8, type = pointer }, { name = heap, offset = 16, type = pointer }, { name = handles, offset = 24, type = pointer }, { name = scheduler, offset = 32, type = pointer }, { name = root_frame, offset = 40, type = pointer }, { name = tls_key, offset = 48, type = usize }, { name = corruption_cookie, offset = 56, type = u64 }] }
layout "BeskidTlsState" { size = 32 alignment = 8 fields = [{ name = runtime, offset = 0, type = pointer }, { name = root_frame, offset = 8, type = pointer }, { name = current_fiber, offset = 16, type = pointer }, { name = attach_depth, offset = 24, type = usize }] }
layout "BeskidTypeDescriptor" { size = 40 alignment = 8 fields = [{ name = size, offset = 0, type = usize }, { name = alignment, offset = 8, type = usize }, { name = pointer_map, offset = 16, type = pointer }, { name = pointer_count, offset = 24, type = usize }, { name = flags, offset = 32, type = u32 }, { name = reserved, offset = 36, type = u32 }] }
layout "BeskidArchContextX86_64SysV" { target = "x86_64-unknown-linux-gnu" size = 64 alignment = 16 fields = [{ name = rbx, offset = 0, type = u64 }, { name = rbp, offset = 8, type = u64 }, { name = r12, offset = 16, type = u64 }, { name = r13, offset = 24, type = u64 }, { name = r14, offset = 32, type = u64 }, { name = r15, offset = 40, type = u64 }, { name = rsp, offset = 48, type = u64 }, { name = rip, offset = 56, type = u64 }] }
layout "BeskidArchContextAarch64Darwin" { target = "aarch64-apple-darwin" size = 176 alignment = 16 fields = [{ name = x19, offset = 0, type = u64 }, { name = x20, offset = 8, type = u64 }, { name = x21, offset = 16, type = u64 }, { name = x22, offset = 24, type = u64 }, { name = x23, offset = 32, type = u64 }, { name = x24, offset = 40, type = u64 }, { name = x25, offset = 48, type = u64 }, { name = x26, offset = 56, type = u64 }, { name = x27, offset = 64, type = u64 }, { name = x28, offset = 72, type = u64 }, { name = x29, offset = 80, type = u64 }, { name = x30, offset = 88, type = u64 }, { name = sp, offset = 96, type = u64 }, { name = pc, offset = 104, type = u64 }, { name = d8, offset = 112, type = f64 }, { name = d9, offset = 120, type = f64 }, { name = d10, offset = 128, type = f64 }, { name = d11, offset = 136, type = f64 }, { name = d12, offset = 144, type = f64 }, { name = d13, offset = 152, type = f64 }, { name = d14, offset = 160, type = f64 }, { name = d15, offset = 168, type = f64 }] }
layout "BeskidArchContextX86_64Windows" { target = "x86_64-pc-windows-msvc" size = 240 alignment = 16 fields = [{ name = rbx, offset = 0, type = u64 }, { name = rbp, offset = 8, type = u64 }, { name = rdi, offset = 16, type = u64 }, { name = rsi, offset = 24, type = u64 }, { name = r12, offset = 32, type = u64 }, { name = r13, offset = 40, type = u64 }, { name = r14, offset = 48, type = u64 }, { name = r15, offset = 56, type = u64 }, { name = rsp, offset = 64, type = u64 }, { name = rip, offset = 72, type = u64 }, { name = xmm6, offset = 80, type = v128 }, { name = xmm7, offset = 96, type = v128 }, { name = xmm8, offset = 112, type = v128 }, { name = xmm9, offset = 128, type = v128 }, { name = xmm10, offset = 144, type = v128 }, { name = xmm11, offset = 160, type = v128 }, { name = xmm12, offset = 176, type = v128 }, { name = xmm13, offset = 192, type = v128 }, { name = xmm14, offset = 208, type = v128 }, { name = xmm15, offset = 224, type = v128 }] }

platform_import "_exit" { target = "x86_64-unknown-linux-gnu" library = libc params = [{ name = status, type = i32 }] returns = never }
platform_import "mmap" { target = "x86_64-unknown-linux-gnu" library = libc params = [{ name = address, type = pointer }, { name = length, type = usize }, { name = protection, type = i32 }, { name = flags, type = i32 }, { name = fd, type = i32 }, { name = offset, type = i64 }] returns = pointer }
platform_import "munmap" { target = "x86_64-unknown-linux-gnu" library = libc params = [{ name = address, type = pointer }, { name = length, type = usize }] returns = i32 }
platform_import "write" { target = "x86_64-unknown-linux-gnu" library = libc params = [{ name = fd, type = i32 }, { name = buffer, type = pointer }, { name = length, type = usize }] returns = isize }
platform_import "_exit" { target = "aarch64-apple-darwin" library = libSystem params = [{ name = status, type = i32 }] returns = never }
platform_import "mmap" { target = "aarch64-apple-darwin" library = libSystem params = [{ name = address, type = pointer }, { name = length, type = usize }, { name = protection, type = i32 }, { name = flags, type = i32 }, { name = fd, type = i32 }, { name = offset, type = i64 }] returns = pointer }
platform_import "munmap" { target = "aarch64-apple-darwin" library = libSystem params = [{ name = address, type = pointer }, { name = length, type = usize }] returns = i32 }
platform_import "write" { target = "aarch64-apple-darwin" library = libSystem params = [{ name = fd, type = i32 }, { name = buffer, type = pointer }, { name = length, type = usize }] returns = isize }
platform_import "ExitProcess" { target = "x86_64-pc-windows-msvc" library = kernel32 params = [{ name = status, type = u32 }] returns = never }
platform_import "GetStdHandle" { target = "x86_64-pc-windows-msvc" library = kernel32 params = [{ name = selector, type = i32 }] returns = pointer }
platform_import "VirtualAlloc" { target = "x86_64-pc-windows-msvc" library = kernel32 params = [{ name = address, type = pointer }, { name = size, type = usize }, { name = allocation_type, type = u32 }, { name = protection, type = u32 }] returns = pointer }
platform_import "VirtualFree" { target = "x86_64-pc-windows-msvc" library = kernel32 params = [{ name = address, type = pointer }, { name = size, type = usize }, { name = free_type, type = u32 }] returns = i32 }
platform_import "WriteFile" { target = "x86_64-pc-windows-msvc" library = kernel32 params = [{ name = handle, type = pointer }, { name = buffer, type = pointer }, { name = length, type = u32 }, { name = written, type = pointer }, { name = overlapped, type = pointer }] returns = i32 }

assembly "beskid_arch_v5_context_init" {
  params = [{ name = context, type = pointer }, { name = stack_top, type = pointer }, { name = entry, type = pointer }, { name = argument, type = pointer }, { name = return_trampoline, type = pointer }]
  returns = void
  x86_64_unknown_linux_gnu_preserved = [rbx, rbp, r12, r13, r14, r15]
  x86_64_unknown_linux_gnu_locations = [{ register = rdi }, { register = rsi }, { register = rdx }, { register = rcx }, { register = r8 }]
  aarch64_apple_darwin_preserved = [x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, v8, v9, v10, v11, v12, v13, v14, v15]
  aarch64_apple_darwin_locations = [{ register = x0 }, { register = x1 }, { register = x2 }, { register = x3 }, { register = x4 }]
  x86_64_pc_windows_msvc_preserved = [rbx, rbp, rdi, rsi, r12, r13, r14, r15, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15]
  x86_64_pc_windows_msvc_locations = [{ register = rcx }, { register = rdx }, { register = r8 }, { register = r9 }, { stack_base = rsp, stack_offset = 40 }]
}
assembly "beskid_arch_v5_context_switch" {
  params = [{ name = from, type = pointer }, { name = to, type = pointer }]
  returns = void
  x86_64_unknown_linux_gnu_preserved = [rbx, rbp, r12, r13, r14, r15]
  x86_64_unknown_linux_gnu_locations = [{ register = rdi }, { register = rsi }]
  aarch64_apple_darwin_preserved = [x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, v8, v9, v10, v11, v12, v13, v14, v15]
  aarch64_apple_darwin_locations = [{ register = x0 }, { register = x1 }]
  x86_64_pc_windows_msvc_preserved = [rbx, rbp, rdi, rsi, r12, r13, r14, r15, xmm6, xmm7, xmm8, xmm9, xmm10, xmm11, xmm12, xmm13, xmm14, xmm15]
  x86_64_pc_windows_msvc_locations = [{ register = rcx }, { register = rdx }]
}

trap "null_reference" { code = 1 }
trap "bounds" { code = 2 }
trap "arithmetic_overflow" { code = 3 }
trap "invalid_utf8" { code = 4 }
trap "out_of_memory" { code = 5 }
trap "invalid_or_stale_handle" { code = 6 }
trap "scheduler_deadlock" { code = 7 }
trap "abi_or_layout_mismatch" { code = 8 }
trap "unreachable_or_isle_invariant" { code = 9 }
trap "runtime_internal_corruption" { code = 10 }

audit {
  forbidden_symbol_families = [rust, _rust, __rust, "core::panicking", "std::panicking", "alloc::alloc", panic, _Unwind, __Unwind, eh_personality, gcc_personality, abfall, corosensei]
}
