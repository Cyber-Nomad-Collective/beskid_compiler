# Sole source of truth for the Beskid native runtime ABI.
# All Rust, C, GNU-as, MASM, abi.json, and audit artifacts are generated from this file.
manifest {
  abi_version = 5
  schema_version = 2
  runtime_publisher = "beskid-lang.org"
  runtime_package = "beskid-runtime-native"
  trap_exit_status = 101
  trap_diagnostic = "beskid runtime trap v5"
  build_profiles = [debug, release]
}

target "x86_64-unknown-linux-gnu" {
  endianness = little
  pointer_width = 64
  calling_convention = system_v
  object_format = elf
  symbol_prefix = ""
  stack_alignment = 16
  shadow_space = 0
}
target "aarch64-apple-darwin" {
  endianness = little
  pointer_width = 64
  calling_convention = apple_aarch64
  object_format = macho
  symbol_prefix = "_"
  stack_alignment = 16
  shadow_space = 0
}
target "x86_64-pc-windows-msvc" {
  endianness = little
  pointer_width = 64
  calling_convention = windows_x64
  object_format = coff
  symbol_prefix = ""
  stack_alignment = 16
  shadow_space = 32
}

export "beskid_rt_v5_abi_version" { params = [] returns = u32 }
export "beskid_library_attach_v5" { params = [{ name = runtime, type = pointer }] returns = i32 }
export "beskid_library_detach_v5" { params = [{ name = runtime, type = pointer }] returns = void }
export "beskid_rt_v5_process_init" { params = [{ name = config, type = pointer }] returns = pointer }
export "beskid_rt_v5_process_shutdown" { params = [{ name = runtime, type = pointer }] returns = void }
export "beskid_rt_v5_thread_attach" { params = [{ name = runtime, type = pointer }] returns = pointer }
export "beskid_rt_v5_thread_detach" { params = [{ name = thread, type = pointer }] returns = void }
export "beskid_rt_v5_managed_object_allocate" { params = [{ name = request, type = pointer }] returns = pointer }
export "beskid_rt_v5_array_allocate_rooted" { params = [{ name = request, type = pointer }, { name = root_handle_out, type = pointer }] returns = pointer }
export "beskid_rt_v5_array_grow_rooted" { params = [{ name = array, type = pointer }, { name = minimum_capacity, type = usize }, { name = root_handle_out, type = pointer }] returns = pointer }
export "beskid_rt_v5_array_construction_finish" { params = [{ name = root_handle, type = pointer }] returns = u8 }
export "beskid_rt_v5_array_write_barrier" { params = [{ name = array, type = pointer }, { name = value, type = pointer }] returns = u8 }
export "beskid_rt_v5_closure_environment_allocate" { params = [{ name = request, type = pointer }] returns = pointer }
export "beskid_rt_v5_closure_capture_store" { params = [{ name = environment, type = pointer }, { name = descriptor, type = pointer }, { name = map_index, type = usize }, { name = value, type = pointer }] returns = u8 }
export "beskid_rt_v5_closure_environment_root" { params = [{ name = tls_state, type = pointer }, { name = slot_index, type = usize }, { name = environment, type = pointer }] returns = u8 }
export "beskid_rt_v5_fiber_spawn_with_cancel_slot" { params = [{ name = entry, type = pointer }, { name = environment, type = pointer }, { name = cancelled_slot, type = pointer }] returns = i64 }
export "beskid_rt_v5_closure_environment_root_current" { params = [{ name = slot_index, type = usize }, { name = environment, type = pointer }] returns = u8 }
export "beskid_rt_v5_trap" {
  params = [{ name = code, type = u8 }, { name = message, type = pointer }, { name = message_len, type = usize }]
  returns = never
}
export "beskid_rt_v5_fiber_yield" { params = [] returns = void }
export "beskid_rt_v5_poll_executor_spawn" { params = [{ name = poll_entry, type = pointer }, { name = task_state, type = pointer }, { name = result_slot, type = pointer }, { name = cancel_slot, type = pointer }] returns = i64 }
export "beskid_rt_v5_poll_executor_run_once" { params = [] returns = i32 }
export "beskid_rt_v5_poll_executor_wake" { params = [{ name = task, type = i64 }] returns = i32 }
export "beskid_rt_v5_poll_monitor_new" { params = [{ name = task, type = i64 }] returns = i64 }
export "beskid_rt_v5_poll_monitor_poll" { params = [{ name = monitor, type = i64 }, { name = result_slot, type = pointer }] returns = i32 }
export "beskid_rt_v5_poll_monitor_drop" { params = [{ name = monitor, type = i64 }] returns = void }
export "beskid_rt_v5_poll_link_new" { params = [{ name = task, type = i64 }] returns = i64 }
export "beskid_rt_v5_poll_link_clone" { params = [{ name = link, type = i64 }] returns = i64 }
export "beskid_rt_v5_poll_link_poll" { params = [{ name = link, type = i64 }, { name = result_slot, type = pointer }] returns = i32 }
export "beskid_rt_v5_poll_link_drop" { params = [{ name = link, type = i64 }] returns = void }

intrinsic "native_word_from_pointer" { symbol = "beskid_rt_v5_intrinsic_native_word_from_pointer" capability = "runtime.bootstrap.native_word_from_pointer" params = [{ name = value, type = pointer }] returns = usize }
intrinsic "pointer_from_native_word" { symbol = "beskid_rt_v5_intrinsic_pointer_from_native_word" capability = "runtime.bootstrap.pointer_from_native_word" params = [{ name = value, type = usize }] returns = pointer }
intrinsic "pointer_add" { symbol = "beskid_rt_v5_intrinsic_pointer_add" capability = "runtime.bootstrap.pointer_add" params = [{ name = base, type = pointer }, { name = offset, type = usize }] returns = pointer }
intrinsic "raw_word_load" { symbol = "beskid_rt_v5_intrinsic_raw_word_load" capability = "runtime.bootstrap.raw_word_load" params = [{ name = address, type = pointer }] returns = usize }
intrinsic "raw_word_store" { symbol = "beskid_rt_v5_intrinsic_raw_word_store" capability = "runtime.bootstrap.raw_word_store" params = [{ name = address, type = pointer }, { name = value, type = usize }] returns = void }
intrinsic "raw_byte_load" { symbol = "beskid_rt_v5_intrinsic_raw_byte_load" capability = "runtime.bootstrap.raw_byte_load" params = [{ name = address, type = pointer }] returns = u8 }
intrinsic "raw_byte_store" { symbol = "beskid_rt_v5_intrinsic_raw_byte_store" capability = "runtime.bootstrap.raw_byte_store" params = [{ name = address, type = pointer }, { name = value, type = u8 }] returns = void }
intrinsic "memory_set" { symbol = "beskid_rt_v5_intrinsic_memory_set" capability = "runtime.bootstrap.memory_set" params = [{ name = destination, type = pointer }, { name = byte, type = u8 }, { name = length, type = usize }] returns = void }
intrinsic "memory_copy" { symbol = "beskid_rt_v5_intrinsic_memory_copy" capability = "runtime.bootstrap.memory_copy" params = [{ name = destination, type = pointer }, { name = source, type = pointer }, { name = length, type = usize }] returns = void }
intrinsic "memory_compare" { symbol = "beskid_rt_v5_intrinsic_memory_compare" capability = "runtime.bootstrap.memory_compare" params = [{ name = left, type = pointer }, { name = right, type = pointer }, { name = length, type = usize }] returns = i32 }
intrinsic "system_allocate" { symbol = "beskid_rt_v5_intrinsic_system_allocate" capability = "runtime.bootstrap.system_allocate" params = [{ name = size, type = usize }, { name = alignment, type = usize }] returns = pointer }
intrinsic "system_free" { symbol = "beskid_rt_v5_intrinsic_system_free" capability = "runtime.bootstrap.system_free" params = [{ name = address, type = pointer }, { name = size, type = usize }] returns = void }
# Target-native guarded stack reservations are available only to the canonical
# scheduler. Allocation reserves a fixed maximum range plus an inaccessible lower
# guard and commits only the high usable suffix. Growth makes additional pages in
# that reservation writable without moving it; free releases the whole reservation.
intrinsic "guarded_stack_allocate" { symbol = "beskid_rt_v5_intrinsic_guarded_stack_allocate" capability = "runtime.bootstrap.guarded_stack_allocate" params = [{ name = initial_size, type = usize }, { name = maximum_size, type = usize }] returns = pointer }
intrinsic "guarded_stack_grow" { symbol = "beskid_rt_v5_intrinsic_guarded_stack_grow" capability = "runtime.bootstrap.guarded_stack_grow" params = [{ name = usable_base, type = pointer }, { name = committed_size, type = usize }, { name = requested_size, type = usize }, { name = maximum_size, type = usize }] returns = u8 }
intrinsic "guarded_stack_free" { symbol = "beskid_rt_v5_intrinsic_guarded_stack_free" capability = "runtime.bootstrap.guarded_stack_free" params = [{ name = usable_base, type = pointer }, { name = maximum_size, type = usize }] returns = void }
intrinsic "tls_get" { symbol = "beskid_rt_v5_intrinsic_tls_get" capability = "runtime.bootstrap.tls_get" params = [] returns = pointer }
intrinsic "tls_set" { symbol = "beskid_rt_v5_intrinsic_tls_set" capability = "runtime.bootstrap.tls_set" params = [{ name = value, type = pointer }] returns = void }
intrinsic "trap" { symbol = "beskid_rt_v5_trap" capability = "runtime.bootstrap.trap" params = [{ name = code, type = u8 }, { name = message, type = pointer }, { name = message_len, type = usize }] returns = never }
intrinsic "fiber_yield" { symbol = "beskid_rt_v5_fiber_yield" capability = "runtime.bootstrap.fiber_yield" params = [] returns = void }
intrinsic "clock_monotonic_nanos" { symbol = "beskid_rt_v5_intrinsic_clock_monotonic_nanos" capability = "runtime.adapter.clock_monotonic_nanos" params = [] returns = i64 }
intrinsic "clock_realtime_nanos" { symbol = "beskid_rt_v5_intrinsic_clock_realtime_nanos" capability = "runtime.adapter.clock_realtime_nanos" params = [] returns = i64 }
intrinsic "process_exit" { symbol = "beskid_rt_v5_intrinsic_process_exit" capability = "runtime.adapter.process_exit" params = [{ name = code, type = i32 }] returns = never }
intrinsic "process_getpid" { symbol = "beskid_rt_v5_intrinsic_process_getpid" capability = "runtime.adapter.process_getpid" params = [] returns = i32 }
# Canonical process adapters. Their ABI declarations are authoritative even
# when a target's platform implementation is not linked into a runtime kit.
intrinsic "env_get" { symbol = "beskid_rt_v5_intrinsic_env_get" capability = "runtime.adapter.env_get" params = [{ name = key, type = pointer }] returns = pointer }
intrinsic "env_set" { symbol = "beskid_rt_v5_intrinsic_env_set" capability = "runtime.adapter.env_set" params = [{ name = key, type = pointer }, { name = value, type = pointer }] returns = i32 }
intrinsic "env_getcwd" { symbol = "beskid_rt_v5_intrinsic_env_getcwd" capability = "runtime.adapter.env_getcwd" params = [] returns = pointer }
intrinsic "fs_read_text" {
  symbol = "beskid_rt_v5_intrinsic_fs_read_text"
  capability = "runtime.adapter.fs_read_text"
  params = [{ name = path, type = pointer }, { name = bytes_out, type = pointer }, { name = length_out, type = pointer }]
  returns = i32
  result_status = "BeskidFsStatus"
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_read_text", os_imports = [open, fstat, read, close, mmap, munmap] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_read_text", os_imports = [open, fstat, read, close, mmap, munmap] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_read_text", os_imports = [MultiByteToWideChar, CreateFileW, GetFileSizeEx, ReadFile, CloseHandle, VirtualAlloc, VirtualFree, GetLastError] }
  ]
}
intrinsic "fs_read_text_release" {
  symbol = "beskid_rt_v5_intrinsic_fs_read_text_release"
  capability = "runtime.adapter.fs_read_text_release"
  params = [{ name = bytes, type = pointer }, { name = length, type = usize }]
  returns = void
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_read_text_release", os_imports = [munmap] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_read_text_release", os_imports = [munmap] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_read_text_release", os_imports = [VirtualFree] }
  ]
}
intrinsic "fs_write_text" {
  symbol = "beskid_rt_v5_intrinsic_fs_write_text"
  capability = "runtime.adapter.fs_write_text"
  params = [{ name = path, type = pointer }, { name = text, type = pointer }]
  returns = i32
  result_status = "BeskidFsStatus"
  target_bindings = [
    { target = "x86_64-unknown-linux-gnu", implementation = "beskid_rt_v5_linux_fs_write_text", os_imports = [open, write, close, mmap, munmap] },
    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_write_text", os_imports = [open, write, close, mmap, munmap] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_write_text", os_imports = [MultiByteToWideChar, CreateFileW, WriteFile, CloseHandle, VirtualAlloc, VirtualFree, GetLastError] }
  ]
}
intrinsic "fs_exists" {
  symbol = "beskid_rt_v5_intrinsic_fs_exists"
  capability = "runtime.adapter.fs_exists"
