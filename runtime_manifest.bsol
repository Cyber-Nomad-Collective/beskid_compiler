    { target = "aarch64-apple-darwin", implementation = "beskid_rt_v5_darwin_fs_exists", os_imports = [stat, mmap, munmap] },
    { target = "x86_64-pc-windows-msvc", implementation = "beskid_rt_v5_windows_fs_exists", os_imports = [MultiByteToWideChar, GetFileAttributesW, VirtualAlloc, VirtualFree, GetLastError] }
  ]
}
intrinsic "fs_mkdir" {
  symbol = "beskid_rt_v5_intrinsic_fs_mkdir"
