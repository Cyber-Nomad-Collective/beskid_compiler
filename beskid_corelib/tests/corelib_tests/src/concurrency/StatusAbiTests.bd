/// ABI contract for Concurrency.Status discriminated union mapping.
use Concurrency.Status;
use Testing.Assert;

test status_ok_is_zero {
    Assert.Equal(Status.ToI64(Status::Ok), 0, "Ok maps to 0");
}

test status_closed_is_one {
    Assert.Equal(Status.ToI64(Status::Closed), 1, "Closed maps to 1");
}

test status_cancelled_is_two {
    Assert.Equal(Status.ToI64(Status::Cancelled), 2, "Cancelled maps to 2");
}

test status_would_block_is_three {
    Assert.Equal(Status.ToI64(Status::WouldBlock), 3, "WouldBlock maps to 3");
}

test status_hub_empty_is_four {
    Assert.Equal(Status.ToI64(Status::HubEmpty), 4, "HubEmpty maps to 4");
}

test status_hub_limit_is_five {
    Assert.Equal(Status.ToI64(Status::HubLimit), 5, "HubLimit maps to 5");
}

test status_hub_not_found_is_six {
    Assert.Equal(Status.ToI64(Status::HubNotFound), 6, "HubNotFound maps to 6");
}

test status_roundtrip {
    Assert.Equal(Status.FromI64(0), Status::Ok, "roundtrip Ok");
    Assert.Equal(Status.FromI64(2), Status::Cancelled, "roundtrip Cancelled");
}
