/// WaitGroup wrapper surface.

use Concurrency.WaitGroup;
use Testing.Assert;



test wait_group_add_done_wait {
    WaitGroup group = WaitGroup.Create();
    WaitGroup.Add(group, 2);
    WaitGroup.Done(group);
    WaitGroup.Done(group);
    WaitGroup.Wait(group);
    Assert.True(true, "wait group should complete after matching Done calls");
}
