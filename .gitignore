# Rust build artifacts
target/
**/*.rs.bk
# Local Beskid toolchain + project cache (LSP Salsa, mod obj, pckg state)
.beskid/
# The bundled app template's manifest is source, embedded by beskid_template.
!/crates/beskid_template/bundled/app/.beskid/
/crates/beskid_template/bundled/app/.beskid/*
!/crates/beskid_template/bundled/app/.beskid/template.json

# Python
__pycache__/
*.py[cod]

# IDE/editor
.vscode/
.idea/
_refactor/
# OS files
.DS_Store

# Env files
.env
_refactor/*

# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# e2e generated artifacts
crates/beskid_engine/obj/
# Fixture build output (materialized dependencies, caches) and generated locks are never
# committed; tests generate them in place or in disposable copies.
crates/**/fixtures/**/obj/
crates/**/fixtures/**/Project.lock
