(decl partial item_body (AstNodeKey) AstNodeKey)
(rule (item_body key @ (node_kind (NodeKind.FunctionDefinition)))
      (child_at key 0))
(rule (item_body key @ (node_kind (NodeKind.TestDefinition)))
      key)
(rule (item_body key @ (node_kind (NodeKind.MethodDefinition)))
      (child_at key 0))
