(decl discard_value (Value) Unit)
(extern constructor discard_value discard_value)
(decl partial emit_return (AstNodeKey) Unit)
(extern constructor emit_return emit_return)
(decl partial emit_local_let (AstNodeKey) Unit)
(extern constructor emit_local_let emit_local_let)
(decl partial lower_statement (AstNodeKey) Unit)

(decl partial statement_cursor (AstNodeKey) StatementCursor)
(extern constructor statement_cursor statement_cursor)
(decl cursor_kind (CursorKind) StatementCursor)
(extern extractor cursor_kind cursor_kind)
(decl partial cursor_head (StatementCursor) AstNodeKey)
(extern constructor cursor_head cursor_head)
(decl cursor_tail (StatementCursor) StatementCursor)
(extern constructor cursor_tail cursor_tail)
(decl finish_statements () Unit)
(extern constructor finish_statements finish_statements)
(decl sequence_statements (Unit Unit) Unit)
(extern constructor sequence_statements sequence_statements)
(decl partial lower_statement_cursor (StatementCursor) Unit)

(rule (lower_statement key @ (node_kind (NodeKind.ExpressionStatement)))
      (discard_value (lower_expression (child_at key 0))))
(rule (lower_statement key @ (node_kind (NodeKind.ReturnStatement)))
      (emit_return key))
(rule (lower_statement key @ (node_kind (NodeKind.LetStatement)))
      (emit_local_let key))
(rule (lower_statement key @ (node_kind (NodeKind.BlockExpression)))
      (lower_statement_cursor (statement_cursor key)))

(rule (lower_statement_cursor cursor @ (cursor_kind (CursorKind.End)))
      (finish_statements))
(rule (lower_statement_cursor cursor @ (cursor_kind (CursorKind.More)))
      (sequence_statements
        (lower_statement (cursor_head cursor))
        (lower_statement_cursor (cursor_tail cursor))))
