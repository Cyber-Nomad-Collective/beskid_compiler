(decl partial emit_local_read (AstNodeKey) Value)
(extern constructor emit_local_read emit_local_read)
(decl partial emit_local_assign (AstNodeKey) Value)
(extern constructor emit_local_assign emit_local_assign)
(decl partial emit_array_literal (AstNodeKey) Value)
(extern constructor emit_array_literal emit_array_literal)
(decl partial emit_index_read (AstNodeKey) Value)
(extern constructor emit_index_read emit_index_read)
(decl partial emit_struct_literal (AstNodeKey) Value)
(extern constructor emit_struct_literal emit_struct_literal)
(decl partial emit_field_read (AstNodeKey) Value)
(extern constructor emit_field_read emit_field_read)
(decl partial emit_field_assign (AstNodeKey) Value)
(extern constructor emit_field_assign emit_field_assign)
(decl partial emit_index_assign (AstNodeKey) Value)
(extern constructor emit_index_assign emit_index_assign)
(decl partial emit_enum_literal (AstNodeKey) Value)
(extern constructor emit_enum_literal emit_enum_literal)
(decl partial emit_match (AstNodeKey) Value)
(extern constructor emit_match emit_match)
(decl partial emit_match_statement (AstNodeKey) Unit)
(extern constructor emit_match_statement emit_match_statement)

(rule (lower_expression key @ (node_kind (NodeKind.PathExpression)))
      (emit_local_read key))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.AssignExpression))
        (assignment_target_kind (NodeKind.PathExpression))))
      (emit_local_assign key))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.AssignExpression))
        (assignment_target_kind (NodeKind.FieldExpression))))
      (emit_field_assign key))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.AssignExpression))
        (assignment_target_kind (NodeKind.IndexExpression))))
      (emit_index_assign key))
(rule (lower_expression key @ (node_kind (NodeKind.ArrayLiteralExpression)))
      (emit_array_literal key))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.IndexExpression))
        (index_target (IndexTarget.Array))))
      (emit_index_read key))
(rule (lower_expression key @ (node_kind (NodeKind.StructLiteralExpression)))
      (emit_struct_literal key))
(rule (lower_expression key @ (node_kind (NodeKind.FieldExpression)))
      (emit_field_read key))
(rule (lower_expression key @ (node_kind (NodeKind.EnumLiteralExpression)))
      (emit_enum_literal key))
(rule (lower_expression key @ (node_kind (NodeKind.MatchExpression)))
      (emit_match key))
(rule (lower_statement key @ (node_kind (NodeKind.MatchExpression)))
      (emit_match_statement key))
