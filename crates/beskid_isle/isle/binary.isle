;; Enum discriminant comparison for value equality on enum types.
(decl partial clif_enum_eq (AstNodeKey) Value)
(extern constructor clif_enum_eq clif_enum_eq)
(decl partial clif_enum_ne (AstNodeKey) Value)
(extern constructor clif_enum_ne clif_enum_ne)

(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.EnumEq))))
      (clif_enum_eq key))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.EnumNotEq))))
      (clif_enum_ne key))

(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.IdentityEq))))
      (clif_eq (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.IdentityNotEq))))
      (clif_ne (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Eq))))
      (clif_eq_discriminant
        (lower_expression (child_at key 0))
        (lower_expression (child_at key 1))
        (child_at key 0)
        (child_at key 1)))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.NotEq))))
      (clif_ne_discriminant
        (lower_expression (child_at key 0))
        (lower_expression (child_at key 1))
        (child_at key 0)
        (child_at key 1)))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Lt))))
      (clif_slt (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Lte))))
      (clif_sle (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Gt))))
      (clif_sgt (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Gte))))
      (clif_sge (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))

(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Add))))
      (clif_iadd
        (lower_expression (child_at key 0))
        (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Sub))))
      (clif_isub (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Mul))))
      (clif_imul (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.BitAnd))))
      (clif_band (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.BitOr))))
      (clif_bor (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Shl))))
      (clif_ishl (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Shr))))
      (clif_ushr (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Div))))
      (clif_sdiv (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))
(rule (lower_expression key @ (and
        (node_kind (NodeKind.BinaryExpression))
        (operator_fact (OperatorFact.Mod))))
      (clif_srem (lower_expression (child_at key 0)) (lower_expression (child_at key 1))))

;; Zero-division trap guards: trap when the divisor is zero.
(decl clif_div_trapz (Value Value) Value)
(extern constructor clif_div_trapz clif_div_trapz)

