(decl partial rec lower_expression (AstNodeKey) Value)
(decl partial emit_block_expression (AstNodeKey) Value)
(extern constructor emit_block_expression emit_block_expression)
(decl partial emit_spawn (AstNodeKey) Value)
(extern constructor emit_spawn emit_spawn)
(decl partial emit_lambda (AstNodeKey) Value)
(extern constructor emit_lambda emit_lambda)
(decl partial emit_try_expression (AstNodeKey) Value)
(extern constructor emit_try_expression emit_try_expression)
(decl partial emit_try_statement (AstNodeKey) Unit)
(extern constructor emit_try_statement emit_try_statement)

(rule (lower_expression key @ (node_kind (NodeKind.GroupedExpression)))
      (lower_expression (child_at key 0)))
(rule (lower_expression key @ (node_kind (NodeKind.BlockExpression)))
      (emit_block_expression key))
(rule (lower_expression key @ (node_kind (NodeKind.SpawnExpression)))
      (emit_spawn key))
(rule (lower_expression key @ (node_kind (NodeKind.LambdaExpression)))
      (emit_lambda key))
(rule (lower_expression key @ (node_kind (NodeKind.TryExpression)))
      (emit_try_expression key))
(rule (lower_statement key @ (node_kind (NodeKind.TryExpression)))
      (emit_try_statement key))

(decl partial emit_clif_block (AstNodeKey) Value)
(extern constructor emit_clif_block emit_clif_block)

(rule (lower_expression key @ (node_kind (NodeKind.ClifBlock)))
      (emit_clif_block key))
