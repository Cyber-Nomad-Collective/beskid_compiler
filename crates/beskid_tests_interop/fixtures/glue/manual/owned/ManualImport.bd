use ManualTypes;

// Logical source signatures; private producer supplies checked status/out transport.
[Extern(Abi:"C", Library:"glue_manual")]
pub contract Foreign {
    i8 glue_i8(i8 value);
    i16 glue_i16(i16 value);
    i32 glue_i32(i32 value);
    i64 glue_i64(i64 value);
    u8 glue_u8(u8 value);
    u16 glue_u16(u16 value);
    u32 glue_u32(u32 value);
    u64 glue_u64(u64 value);
    f32 glue_f32(f32 value);
    f64 glue_f64(f64 value);
    bool glue_bool(bool value);
    char glue_char(char value);
    [RustOwner(Fallible:true)]
    string glue_utf8(string value);
    [RustOwner(Fallible:true)]
    u8[] glue_bytes(u8[] value);
    word glue_native_width(word value);
    unit glue_unit();
    [RustOwner(Fallible:true)]
    ManualOpaque<u8> make_manual_owned(word length);
    [RustOwner(Fallible:true)]
    word check_manual_owned(ManualOpaque<u8> value);
    [RustOwner(Fallible:true)]
    i32 glue_failure(u32 mode);
    u32 glue_f32_bits(f32 value);
    u64 glue_f64_bits(f64 value);
    f32 glue_f32_from_bits(u32 value);
    f64 glue_f64_from_bits(u64 value);
    [RustOwner(Fallible:true)]
    i32 glue_utf8_exact(string value);
    [RustOwner(Fallible:true)]
    i32 glue_bytes_exact(u8[] value);
}
[Export(Abi:"C", Symbol:"manual_ImportI8")]
pub i8 ImportI8(i8 value) { return Foreign.glue_i8(value); }
[Export(Abi:"C", Symbol:"manual_ImportI16")]
pub i16 ImportI16(i16 value) { return Foreign.glue_i16(value); }
[Export(Abi:"C", Symbol:"manual_ImportI32")]
pub i32 ImportI32(i32 value) { return Foreign.glue_i32(value); }
[Export(Abi:"C", Symbol:"manual_ImportI64")]
pub i64 ImportI64(i64 value) { return Foreign.glue_i64(value); }
[Export(Abi:"C", Symbol:"manual_ImportU8")]
pub u8 ImportU8(u8 value) { return Foreign.glue_u8(value); }
[Export(Abi:"C", Symbol:"manual_ImportU16")]
pub u16 ImportU16(u16 value) { return Foreign.glue_u16(value); }
[Export(Abi:"C", Symbol:"manual_ImportU32")]
pub u32 ImportU32(u32 value) { return Foreign.glue_u32(value); }
[Export(Abi:"C", Symbol:"manual_ImportU64")]
pub u64 ImportU64(u64 value) { return Foreign.glue_u64(value); }
[Export(Abi:"C", Symbol:"manual_ImportF32")]
pub f32 ImportF32(f32 value) { return Foreign.glue_f32(value); }
[Export(Abi:"C", Symbol:"manual_ImportF64")]
pub f64 ImportF64(f64 value) { return Foreign.glue_f64(value); }
[Export(Abi:"C", Symbol:"manual_ImportBool")]
pub bool ImportBool(bool value) { return Foreign.glue_bool(value); }
[Export(Abi:"C", Symbol:"manual_ImportChar")]
pub char ImportChar(char value) { return Foreign.glue_char(value); }
[Export(Abi:"C", Symbol:"manual_ImportUtf8")]
pub string ImportUtf8(string value) { return Foreign.glue_utf8(value); }
[Export(Abi:"C", Symbol:"manual_ImportBytes")]
pub u8[] ImportBytes(u8[] value) { return Foreign.glue_bytes(value); }
[Export(Abi:"C", Symbol:"manual_ImportNativeWidth")]
pub word ImportNativeWidth(word value) { return Foreign.glue_native_width(value); }
[Export(Abi:"C", Symbol:"manual_ImportUnit")]
pub unit ImportUnit() { Foreign.glue_unit(); return; }
[Export(Abi:"C", Symbol:"manual_ImportCreate")]
pub ManualOpaque<u8> ImportCreate(word length) { return Foreign.make_manual_owned(length); }
[Export(Abi:"C", Symbol:"manual_ImportInspect")]
pub word ImportInspect(ManualOpaque<u8> value) { return Foreign.check_manual_owned(value); }
