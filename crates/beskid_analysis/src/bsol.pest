////////////////////////////////////////////////////////////
// Bsol — Beskid Structured Object Language
// Normative surface grammar for `.bproj` and `.bws` manifests.
////////////////////////////////////////////////////////////

WHITESPACE = _{ " " | "\t" | NEWLINE | COMMENT }
COMMENT = _{ LineComment | HashComment }
LineComment = _{ "//" ~ (!NEWLINE ~ ANY)* }
HashComment = _{ "#" ~ (!NEWLINE ~ ANY)* }

document = { SOI ~ block* ~ EOI }

block = {
    project_root_block
  | labeled_reserved_block
  | unlabeled_reserved_block
}

project_root_block = { project_root_ident ~ "{" ~ project_body ~ "}" }
project_root_ident = @{ !top_level_keyword ~ manifest_ident }

manifest_ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }

top_level_keyword = {
    "target"
  | "dependency"
  | "link"
  | "workspace"
  | "member"
  | "override"
  | "registry"
}

labeled_reserved_block = { labeled_block_kind ~ quoted_string? ~ "{" ~ block_assignments ~ "}" }
labeled_block_kind = {
    "target"
  | "dependency"
  | "member"
  | "override"
  | "registry"
}

unlabeled_reserved_block = { unlabeled_block_kind ~ "{" ~ block_assignments ~ "}" }
unlabeled_block_kind = { "link" | "workspace" }

project_body = { project_body_item* }
project_body_item = {
    block_assignment
  | mod_block
  | template_block
}

mod_block = { mod_block_keyword ~ "{" ~ mod_assignments ~ "}" }
mod_block_keyword = { "mod" | "meta" }

template_block = { "template" ~ "{" ~ template_assignments ~ "}" }

block_assignments = { block_assignment* }
mod_assignments = { mod_assignment* }
template_assignments = { template_assignment* }

block_assignment = { ident ~ "=" ~ value }
mod_assignment = { ident ~ "=" ~ value }
template_assignment = { ident ~ "=" ~ value }

value = {
    bracket_list
  | quoted_string
  | bare_token
}

bracket_list = { "[" ~ list_content? ~ "]" }
list_content = { list_item ~ ("," ~ list_item)* }
list_item = { "default" | quoted_string | ident }

quoted_string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
bare_token = @{ ident | decimal_unsigned }
ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
decimal_unsigned = @{ ASCII_DIGIT+ }
