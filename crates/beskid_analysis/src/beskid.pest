////////////////////////////////////////////////////////////
// Beskid Grammar (v0.1)
////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////
// 1) LEXICAL
////////////////////////////////////////////////////////////
WHITESPACE = _{ " " | "\t" | "\n" | "\r" | FourSlashLineComment | OrdinaryLineComment | BlockComment }
// `////`+ lines are ordinary comments (not documentation); `///` is reserved for DocRun on ItemWithDocs.
FourSlashLineComment = _{ "////" ~ (!"\n" ~ ANY)* }
// `//` but not `///` (third slash would make documentation, parsed as DocLineContent on items).
OrdinaryLineComment = _{ "//" ~ !("/") ~ (!"\n" ~ ANY)* }
BlockComment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

ASCII_ALPHA_UNDERSCORE = _{ ASCII_ALPHA | "_" }
Identifier = @{ !Keyword ~ ASCII_ALPHA_UNDERSCORE ~ (ASCII_ALPHANUMERIC | "_")* }

TypeDeclarationKeyword = @{ "type" ~ !IdentTail }
EnumDeclarationKeyword = @{ "enum" ~ !IdentTail }
ContractDeclarationKeyword = @{ "contract" ~ !IdentTail }
AttributeDeclarationKeyword = @{ "attribute" ~ !IdentTail }
ImplKeyword = @{ "impl" ~ !IdentTail }
ExtendKeyword = @{ "extend" ~ !IdentTail }
ThisKeyword = @{ "This" ~ !IdentTail }
WhereKeyword = @{ "where" ~ !IdentTail }
MatchKeyword = @{ "match" ~ !IdentTail }
EventKeyword = @{ "event" ~ !IdentTail }
WhenKeyword = @{ "when" ~ !IdentTail }
IfKeyword = @{ "if" ~ !IdentTail }
ElseKeyword = @{ "else" ~ !IdentTail }
WhileKeyword = @{ "while" ~ !IdentTail }
ForKeyword = @{ "for" ~ !IdentTail }
InKeyword = @{ "in" ~ !IdentTail }
ReturnKeyword = @{ "return" ~ !IdentTail }
BreakKeyword = @{ "break" ~ !IdentTail }
ContinueKeyword = @{ "continue" ~ !IdentTail }
LetKeyword = @{ "let" ~ !IdentTail }
ConstKeyword = @{ "const" ~ !IdentTail }
MutKeyword = @{ "mut" ~ !IdentTail }
BulkKeyword = @{ "bulk" ~ !IdentTail }
ModKeyword = @{ "mod" ~ !IdentTail }
UseKeyword = @{ "use" ~ !IdentTail }
UsingKeyword = @{ "using" ~ !IdentTail }
PubKeyword = @{ "pub" ~ !IdentTail }
TestKeyword = @{ "test" ~ !IdentTail }
SkipKeyword = @{ "skip" ~ !IdentTail }
SpawnKeyword = @{ "spawn" ~ !IdentTail }
ClifKeyword = @{ "clif" ~ !IdentTail }
AsyncKeyword = @{ "async" ~ !IdentTail }
AwaitKeyword = @{ "await" ~ !IdentTail }
CodeKeyword = @{ "code" ~ !IdentTail }
HostKeyword = @{ "host" ~ !IdentTail }
RegistryKeyword = @{ "registry" ~ !IdentTail }
ScopeKeyword = @{ "scope" ~ !IdentTail }
StartupKeyword = @{ "startup" ~ !IdentTail }
InitKeyword = @{ "init" ~ !IdentTail }
DisposeKeyword = @{ "dispose" ~ !IdentTail }
WithKeyword = @{ "with" ~ !IdentTail }
LaunchKeyword = @{ "launch" ~ !IdentTail }
InjectKeyword = @{ "inject" ~ !IdentTail }
SingleKeyword = @{ "single" ~ !IdentTail }
TransientKeyword = @{ "transient" ~ !IdentTail }
GlobalKeyword = @{ "global" ~ !IdentTail }
ParentKeyword = @{ "parent" ~ !IdentTail }
TryKeyword = @{ "try" ~ !IdentTail }
CatchKeyword = @{ "catch" ~ !IdentTail }

Keyword = {
    (
        TypeDeclarationKeyword
      | EnumDeclarationKeyword
      | ContractDeclarationKeyword
      | AttributeDeclarationKeyword
      | ImplKeyword
      | ExtendKeyword
      | ThisKeyword
      | WhereKeyword
      | MatchKeyword
      | WhenKeyword
      | IfKeyword
      | ElseKeyword
      | WhileKeyword
      | ForKeyword
      | InKeyword
      | ReturnKeyword
      | BreakKeyword
      | ContinueKeyword
      | LetKeyword
      | ConstKeyword
      | MutKeyword
      | BulkKeyword
      | ModKeyword
      | UseKeyword
      | UsingKeyword
      | PubKeyword
      | TestKeyword
      | SkipKeyword
      | SpawnKeyword
      | ClifKeyword
      | AsyncKeyword
      | AwaitKeyword
      | HostKeyword
      | RegistryKeyword
      | ScopeKeyword
      | StartupKeyword
      | InitKeyword
      | DisposeKeyword
      | WithKeyword
      | LaunchKeyword
      | InjectKeyword
      | SingleKeyword
      | TransientKeyword
      | GlobalKeyword
      | TryKeyword
      | CatchKeyword
    ) ~ !IdentTail
}

// Keyword literals used inside non-atomic rules. Each `Kw*` is silent (no parse-tree pair) and
// matches the word only at a word boundary; the boundary is checked by an atomic `*Word` rule
// inside a double negative lookahead, so implicit whitespace cannot move the check past the word.
IdentTail = _{ ASCII_ALPHANUMERIC | "_" }
KwTrueWord = @{ "true" ~ !IdentTail }
KwTrue = _{ !(!KwTrueWord) ~ "true" }
KwFalseWord = @{ "false" ~ !IdentTail }
KwFalse = _{ !(!KwFalseWord) ~ "false" }
KwAttributeWord = @{ "attribute" ~ !IdentTail }
KwAttribute = _{ !(!KwAttributeWord) ~ "attribute" }
KwPubWord = @{ "pub" ~ !IdentTail }
KwPub = _{ !(!KwPubWord) ~ "pub" }
KwModWord = @{ "mod" ~ !IdentTail }
KwMod = _{ !(!KwModWord) ~ "mod" }
KwUseWord = @{ "use" ~ !IdentTail }
KwUse = _{ !(!KwUseWord) ~ "use" }
KwAsWord = @{ "as" ~ !IdentTail }
KwAs = _{ !(!KwAsWord) ~ "as" }
KwWhereWord = @{ "where" ~ !IdentTail }
KwWhere = _{ !(!KwWhereWord) ~ "where" }
KwConstWord = @{ "const" ~ !IdentTail }
KwConst = _{ !(!KwConstWord) ~ "const" }
KwImplWord = @{ "impl" ~ !IdentTail }
KwImpl = _{ !(!KwImplWord) ~ "impl" }
KwExtendWord = @{ "extend" ~ !IdentTail }
KwExtend = _{ !(!KwExtendWord) ~ "extend" }
KwTypeWord = @{ "type" ~ !IdentTail }
KwType = _{ !(!KwTypeWord) ~ "type" }
KwBlockWord = @{ "block" ~ !IdentTail }
KwBlock = _{ !(!KwBlockWord) ~ "block" }
KwExpressionWord = @{ "expression" ~ !IdentTail }
KwExpression = _{ !(!KwExpressionWord) ~ "expression" }
KwStatementWord = @{ "statement" ~ !IdentTail }
KwStatement = _{ !(!KwStatementWord) ~ "statement" }
KwIdentifierWord = @{ "identifier" ~ !IdentTail }
KwIdentifier = _{ !(!KwIdentifierWord) ~ "identifier" }
KwLiteralWord = @{ "literal" ~ !IdentTail }
KwLiteral = _{ !(!KwLiteralWord) ~ "literal" }
KwPatternWord = @{ "pattern" ~ !IdentTail }
KwPattern = _{ !(!KwPatternWord) ~ "pattern" }
KwPathWord = @{ "path" ~ !IdentTail }
KwPath = _{ !(!KwPathWord) ~ "path" }
KwItemWord = @{ "item" ~ !IdentTail }
KwItem = _{ !(!KwItemWord) ~ "item" }
KwNodeWord = @{ "node" ~ !IdentTail }
KwNode = _{ !(!KwNodeWord) ~ "node" }
KwMacroWord = @{ "macro" ~ !IdentTail }
KwMacro = _{ !(!KwMacroWord) ~ "macro" }
KwEventWord = @{ "event" ~ !IdentTail }
KwEvent = _{ !(!KwEventWord) ~ "event" }
KwGlobalWord = @{ "global" ~ !IdentTail }
KwGlobal = _{ !(!KwGlobalWord) ~ "global" }
KwParentWord = @{ "parent" ~ !IdentTail }
KwParent = _{ !(!KwParentWord) ~ "parent" }
KwInjectWord = @{ "inject" ~ !IdentTail }
KwInject = _{ !(!KwInjectWord) ~ "inject" }
KwEnumWord = @{ "enum" ~ !IdentTail }
KwEnum = _{ !(!KwEnumWord) ~ "enum" }
KwContractWord = @{ "contract" ~ !IdentTail }
KwContract = _{ !(!KwContractWord) ~ "contract" }
KwSingleWord = @{ "single" ~ !IdentTail }
KwSingle = _{ !(!KwSingleWord) ~ "single" }
KwTransientWord = @{ "transient" ~ !IdentTail }
KwTransient = _{ !(!KwTransientWord) ~ "transient" }
KwForWord = @{ "for" ~ !IdentTail }
KwFor = _{ !(!KwForWord) ~ "for" }
KwRegistryWord = @{ "registry" ~ !IdentTail }
KwRegistry = _{ !(!KwRegistryWord) ~ "registry" }
KwInitWord = @{ "init" ~ !IdentTail }
KwInit = _{ !(!KwInitWord) ~ "init" }
KwDisposeWord = @{ "dispose" ~ !IdentTail }
KwDispose = _{ !(!KwDisposeWord) ~ "dispose" }
KwStartupWord = @{ "startup" ~ !IdentTail }
KwStartup = _{ !(!KwStartupWord) ~ "startup" }
KwScopeWord = @{ "scope" ~ !IdentTail }
KwScope = _{ !(!KwScopeWord) ~ "scope" }
KwHostWord = @{ "host" ~ !IdentTail }
KwHost = _{ !(!KwHostWord) ~ "host" }
KwTestWord = @{ "test" ~ !IdentTail }
KwTest = _{ !(!KwTestWord) ~ "test" }
KwMetaWord = @{ "meta" ~ !IdentTail }
KwMeta = _{ !(!KwMetaWord) ~ "meta" }
KwSkipWord = @{ "skip" ~ !IdentTail }
KwSkip = _{ !(!KwSkipWord) ~ "skip" }
KwWithWord = @{ "with" ~ !IdentTail }
KwWith = _{ !(!KwWithWord) ~ "with" }
KwLaunchWord = @{ "launch" ~ !IdentTail }
KwLaunch = _{ !(!KwLaunchWord) ~ "launch" }
KwReturnWord = @{ "return" ~ !IdentTail }
KwReturn = _{ !(!KwReturnWord) ~ "return" }
KwBreakWord = @{ "break" ~ !IdentTail }
KwBreak = _{ !(!KwBreakWord) ~ "break" }
KwContinueWord = @{ "continue" ~ !IdentTail }
KwContinue = _{ !(!KwContinueWord) ~ "continue" }
KwIfWord = @{ "if" ~ !IdentTail }
KwIf = _{ !(!KwIfWord) ~ "if" }
KwWhileWord = @{ "while" ~ !IdentTail }
KwWhile = _{ !(!KwWhileWord) ~ "while" }
KwInWord = @{ "in" ~ !IdentTail }
KwIn = _{ !(!KwInWord) ~ "in" }
KwRangeWord = @{ "range" ~ !IdentTail }
KwRange = _{ !(!KwRangeWord) ~ "range" }
KwMatchWord = @{ "match" ~ !IdentTail }
KwMatch = _{ !(!KwMatchWord) ~ "match" }
KwWhenWord = @{ "when" ~ !IdentTail }
KwWhen = _{ !(!KwWhenWord) ~ "when" }

DecimalIntegerBody = { ASCII_DIGIT+ ~ ("_" ~ ASCII_DIGIT+)* }
HexIntegerBody = { ASCII_HEX_DIGIT+ ~ ("_" ~ ASCII_HEX_DIGIT+)* }
IntegerLiteral = @{ "-"? ~ (("0x" ~ HexIntegerBody) | DecimalIntegerBody) ~ ("_i8" | "_i16" | "_i32" | "_i64" | "_u8" | "_u16" | "_u32" | "_u64")? }
FloatLiteral = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ ("_f32" | "_f64")? }
StringLiteral = @{ "\"" ~ StringContent* ~ "\"" }
StringLiteralValueBody = ${ (StringContent)* }
StringLiteralValue = ${ SOI ~ StringLiteralValueBody ~ EOI }
StringContent = { StringInterpolation | StringEscape | StringText }
StringInterpolation = { "${" ~ InterpolationExpression ~ "}" }
InterpolationExpression = !{ Expression }
StringEscape = { "\\\"" | "\\\\" | "\\${" }
StringText = { (!("\"" | "\\" | "$") ~ ANY)+ | ("$" ~ !("{")) }
CharLiteral = @{ "'" ~ ("\\'" | !("'") ~ ANY) ~ "'" }

CodeLanguageTag = @{ ASCII_ALPHA+ }
CodeHole = { "@{" ~ InterpolationExpression ~ "}" }
CodeFenceChar = { !("`" | "@") ~ ANY | "@" ~ !("{") }
CodeFenceBodyContents = ${ (CodeHole | CodeFenceChar)* }
CodeFenceBody = { CodeFenceBodyContents }
CodeFenceOpen = @{ "```" ~ CodeLanguageTag? ~ NEWLINE }
CodeFenceClose = @{ "```" ~ NEWLINE? }
CodeFence = { CodeFenceOpen ~ CodeFenceBody ~ CodeFenceClose }
CodeExpression = { CodeKeyword ~ CodeFence }
CodePlainText = { (!("@") ~ ANY)+ | ("@" ~ !("{") ~ ANY)+ }
CodePlainBodyContents = ${ (CodeHole | CodePlainText)* }
CodePlainBody = { SOI ~ CodePlainBodyContents ~ EOI }

Literal = { FloatLiteral | IntegerLiteral | StringLiteral | CharLiteral | KwTrue | KwFalse | "()" }

////////////////////////////////////////////////////////////
// 2) PROGRAM
////////////////////////////////////////////////////////////
NEWLINE = _{ "\r\n" | "\n" | "\r" }
DocGap = _{ " " | "\t" | NEWLINE | FourSlashLineComment | OrdinaryLineComment | BlockComment }

ItemWithDocs = { ((DocRun ~ InnerItem) | InnerItem) ~ DocGap* }
ItemList = { ItemWithDocs* }
Program = { SOI ~ ItemList ~ EOI }

DocLineContent = { "///" ~ !("/") ~ (!(NEWLINE) ~ ANY)* ~ NEWLINE? }
DocRun = @{ DocLineContent ~ ((" " | "\t")* ~ DocLineContent)* }
InnerItem = _{ HostDefinition | MacroDefinition | FunctionDefinition | ConstantDefinition | ImplBlock | ExtendTypeDefinition | TypeDefinition | EnumDefinition | ContractDefinition | TestDefinition | AttributeDeclaration | InlineModule | ModuleDeclaration | UseDeclaration }

AttributeList = { Attribute+ }
Attribute = { "[" ~ Identifier ~ ("(" ~ AttributeArgumentList? ~ ")")? ~ "]" }
AttributeArgumentList = { AttributeArgument ~ ("," ~ AttributeArgument)* }
AttributeArgument = { Identifier ~ ":" ~ Expression }
AttributeDeclaration = { Visibility? ~ KwAttribute ~ Identifier ~ AttributeTargetList? ~ "{" ~ AttributeParameterList? ~ "}" }
AttributeTargetList = { "(" ~ AttributeTarget ~ ("," ~ AttributeTarget)* ~ ","? ~ ")" }
AttributeTarget = { Identifier }
AttributeParameterList = { AttributeParameter ~ ("," ~ AttributeParameter)* ~ ","? }
AttributeParameter = { Identifier ~ ":" ~ BeskidType ~ ("=" ~ Expression)? }

Visibility = { KwPub }

ModuleDeclaration = { AttributeList? ~ Visibility? ~ KwMod ~ Path ~ ";" }
InlineModuleBody = { ItemWithDocs* }
InlineModule = { AttributeList? ~ Visibility? ~ KwMod ~ Identifier ~ "{" ~ InlineModuleBody ~ "}" }
UseDeclaration = { Visibility? ~ KwUse ~ Path ~ (KwAs ~ Identifier)? ~ ";" }
PathSegment = { Identifier ~ GenericArguments? }
Path = { PathSegment ~ ("." ~ PathSegment)* }
PathList = { Path ~ ("," ~ Path)* }
EnumPath = { Path ~ "::" ~ Identifier }

////////////////////////////////////////////////////////////
// 3) TYPES
////////////////////////////////////////////////////////////
PrimitiveType = @{ ("i8" | "i16" | "u16" | "u64" | "f32" | "bool" | "i32" | "i64" | "u32" | "u8" | "pointer" | "word" | "f64" | "char" | "string" | "unit" | "never") ~ !IdentTail }

GenericParameters = { "<" ~ Identifier ~ ("," ~ Identifier)* ~ ">" }
GenericArguments = { "<" ~ BeskidType ~ ("," ~ BeskidType)* ~ ">" }

TypeName = { PrimitiveType | Path }
AssociatedTypeRef = { Path ~ "::" ~ Identifier }
// Atomic: a non-atomic rule here would let pest's implicit whitespace insertion skip past the
// word boundary before the lookahead runs, so `!ASCII_ALPHANUMERIC` would test the *next*
// token's first character (e.g. "This Make()"'s `M`) instead of the character immediately
// after "This" -- silently rejecting `This` whenever anything followed it. Same reasoning as
// `Identifier`'s own atomic `!Keyword ~ ...` boundary check.
ThisType = @{ "This" ~ !IdentTail }
TypeAtom = { AssociatedTypeRef | ThisType | TypeName }
ArrayType = { TypeAtom ~ "[" ~ "]" }
FunctionType = { TypeAtom ~ "(" ~ BeskidTypeList? ~ ")" }
ArrowFunctionType = { "(" ~ BeskidTypeList? ~ ")" ~ "=>" ~ BeskidType }
BeskidTypeList = { BeskidType ~ ("," ~ BeskidType)* }
BeskidType = { ArrowFunctionType | FunctionType | ArrayType | TypeAtom }

////////////////////////////////////////////////////////////
// 4) DEFINITIONS
////////////////////////////////////////////////////////////
TypeBound = { Identifier ~ ":" ~ Path }
WhereClause = { KwWhere ~ TypeBound ~ ("," ~ TypeBound)* }
FunctionDefinition = { AttributeList? ~ Visibility? ~ BeskidType ~ Identifier ~ GenericParameters? ~ "(" ~ ParameterList? ~ ")" ~ WhereClause? ~ Block }
ConstantDefinition = { KwConst ~ Identifier ~ "=" ~ IntegerLiteral ~ ";" }
ReceiverType = { PrimitiveType | Path }
ImplConformanceList = { ":" ~ PathList }
ImplBlock = { KwImpl ~ GenericParameters? ~ ReceiverType ~ ImplConformanceList? ~ WhereClause? ~ "{" ~ (AssociatedTypeBindingWithDocs | ImplMethodWithDocs)* ~ "}" }
ExtendTypeDefinition = { KwExtend ~ KwType ~ ReceiverType ~ "{" ~ ImplMethodWithDocs* ~ "}" }

MacroFragmentKind = { KwBlock | KwExpression | KwStatement | KwType | KwIdentifier | KwLiteral | KwPattern | KwPath | KwItem | KwNode }
MacroParameter = { MacroFragmentKind ~ Identifier }
MacroParameterList = { MacroParameter ~ ("," ~ MacroParameter)* }
MacroDefinition = { Visibility? ~ KwMacro ~ Identifier ~ "(" ~ MacroParameterList? ~ ")" ~ Block }
ImplMethodWithDocs = { ((DocRun ~ ImplMethodDefinition) | ImplMethodDefinition) ~ DocGap* }
MethodBody = { Block | ExpressionBody }
ExpressionBody = { "=>" ~ Expression }
ImplMethodDefinition = { AttributeList? ~ Visibility? ~ BeskidType ~ Identifier ~ "(" ~ ParameterList? ~ ")" ~ MethodBody ~ ";"? }
ParameterList = { ParameterWithDocs ~ ("," ~ DocGap* ~ ParameterWithDocs)* }
ParameterWithDocs = { (DocRun ~ Parameter) | Parameter }
Parameter = { BulkKeyword? ~ MutKeyword? ~ BeskidType ~ Identifier }

FieldList = { FieldWithDocs ~ ("," ~ DocGap* ~ FieldWithDocs)* ~ ","? }
FieldWithDocs = { (DocRun ~ Field) | Field }
ValueField = { BeskidType ~ Identifier ~ !"(" }
EventCapacity = { "{" ~ IntegerLiteral ~ "}" }
EventField = { KwEvent ~ EventCapacity? ~ Identifier ~ "(" ~ ParameterList? ~ ")" }
InjectQualifier = { (KwGlobal | KwParent) ~ "::" }
InjectField = { KwInject ~ InjectQualifier? ~ BeskidType ~ Identifier }
Field = { AttributeList? ~ Visibility? ~ (InjectField | EventField | ValueField) }

TypeConformanceList = { ":" ~ PathList }
// Fields are comma-separated; inline methods follow (commas inside method types must not split members).
TypeFieldList = { FieldWithDocs ~ ("," ~ DocGap* ~ FieldWithDocs)* ~ ","? }
TypeBody = { TypeFieldList? ~ (AssociatedTypeBindingWithDocs | ImplMethodWithDocs)* }
TypeDefinition = { AttributeList? ~ Visibility? ~ KwType ~ Identifier ~ GenericParameters? ~ TypeConformanceList? ~ "{" ~ TypeBody? ~ "}" }

EnumDefinition = { AttributeList? ~ Visibility? ~ KwEnum ~ Identifier ~ GenericParameters? ~ "{" ~ EnumVariantList? ~ "}" }
EnumVariantList = { EnumVariantWithDocs ~ ("," ~ DocGap* ~ EnumVariantWithDocs)* ~ ","? }
EnumVariantWithDocs = { (DocRun ~ EnumVariant) | EnumVariant }
EnumVariant = { Identifier ~ ("(" ~ FieldList? ~ ")")? }

ContractDefinition = { AttributeList? ~ Visibility? ~ KwContract ~ Identifier ~ GenericParameters? ~ "{" ~ ContractItemWithDocs* ~ "}" }
ContractItemWithDocs = { ((DocRun ~ ContractItem) | ContractItem) ~ DocGap* }
ContractItem = _{ ContractAssociatedType | ContractMethodSignature | ContractEmbedding }
ContractMethodSignature = { AttributeList? ~ BeskidType ~ Identifier ~ "(" ~ ParameterList? ~ ")" ~ ";" }
ContractEmbedding = { Identifier ~ GenericArguments? ~ ";"? }
ContractAssociatedType = { KwType ~ Identifier ~ ("=" ~ BeskidType)? ~ ";" }

// An associated-type binding at an implementor site (`type Item = T;` inside a `type X : C { }`
// or `impl X : C { }` body), parallel to `ImplMethodWithDocs`.
AssociatedTypeBinding = { KwType ~ Identifier ~ "=" ~ BeskidType ~ ";" }
AssociatedTypeBindingWithDocs = { ((DocRun ~ AssociatedTypeBinding) | AssociatedTypeBinding) ~ DocGap* }

RegistrationLifetime = { KwSingle | KwTransient }
RegistrationTarget = { KwFor ~ Path }
RegistryEntry = { RegistrationLifetime? ~ Path ~ RegistrationTarget? ~ ";" }
RegistryBlock = { KwRegistry ~ "{" ~ RegistryEntry* ~ "}" }

ScopeHookName = { KwInit | KwDispose | KwStartup }
ScopeHook = { ScopeHookName ~ "(" ~ ParameterList? ~ ")" ~ Block }
ScopeBodyItem = _{ RegistryBlock | ScopeHook | ScopeDefinition | RegistryEntry }
ScopeDefinition = { KwScope ~ Identifier ~ "(" ~ ParameterList? ~ ")" ~ "{" ~ ScopeBodyItem* ~ "}" }
HostBodyItem = _{ RegistryBlock | ScopeHook | ScopeDefinition }
HostDefinition = { KwHost ~ Identifier ~ "(" ~ ParameterList? ~ ")" ~ (":" ~ Path)? ~ "{" ~ HostBodyItem* ~ "}" }

TestDefinition = { AttributeList? ~ Visibility? ~ KwTest ~ Identifier ~ TestBody }
TestBody = { "{" ~ TestBodyItemWithDocs* ~ "}" }
TestBodyItemWithDocs = { ((DocRun ~ Statement) | TestMetaSection | TestSkipSection | Statement) ~ DocGap* }
TestBodyItem = _{ TestMetaSection | TestSkipSection | Statement }
TestMetaSection = { KwMeta ~ "{" ~ TestMetadataEntry* ~ "}" }
TestMetadataEntry = { Identifier ~ "=" ~ Expression ~ ";" }
TestSkipSection = { KwSkip ~ "{" ~ TestSkipEntry* ~ "}" }
TestSkipEntry = { Identifier ~ "=" ~ Expression ~ ";" }

////////////////////////////////////////////////////////////
// 5) STATEMENTS AND BLOCKS
////////////////////////////////////////////////////////////
Block = { "{" ~ Statement* ~ "}" }

WithStatement = { KwWith ~ Identifier ~ "(" ~ ArgumentList? ~ ")" ~ Block }
LaunchStatement = { KwLaunch ~ Path ~ "(" ~ ArgumentList? ~ ")" ~ ";" }
Statement = _{ ScopedUseStatement | LetStatement | ReturnStatement | BreakStatement | ContinueStatement | WhileStatement | ForStatement | IfStatement | WithStatement | LaunchStatement | ExpressionStatement }

ScopedUseStatement = { KwUse ~ ("(" ~ ScopedUseBinding ~ ")" ~ Block | ScopedUseBinding ~ ";") }
ScopedUseBinding = { BeskidType ~ Identifier ~ "=" ~ Expression }

LetStatement = { TypedLetStatement | InferredLetStatement }
TypedLetStatement = { MutKeyword? ~ BeskidType ~ Identifier ~ ("=" ~ Expression)? ~ ";" }
InferredLetStatement = { LetKeyword ~ MutKeyword? ~ Identifier ~ "=" ~ Expression ~ ";" }
TypeAnnotation = { ":" ~ BeskidType }

ReturnStatement = { KwReturn ~ Expression? ~ ";" }
BreakStatement = { KwBreak ~ ";" }
ContinueStatement = { KwContinue ~ ";" }

IfStatement = { KwIf ~ Expression ~ Block ~ ElsePart? }
ElsePart = { ElseKeyword ~ (IfStatement | Block) }
WhileStatement = { KwWhile ~ Expression ~ Block }
ForStatement = { KwFor ~ Identifier ~ KwIn ~ Expression ~ Block }
RangeExpression = { KwRange ~ "(" ~ Expression ~ "," ~ Expression ~ ")" }

ExpressionStatement = { Expression ~ ";" }

////////////////////////////////////////////////////////////
// 6) EXPRESSIONS
////////////////////////////////////////////////////////////
Expression = { LambdaExpression | MatchExpression | AssignmentExpression }

LambdaExpression = { LambdaParameters ~ "=>" ~ LambdaBody }
LambdaParameters = { Identifier | "(" ~ LambdaParameterList? ~ ")" }
LambdaParameterList = { LambdaParameter ~ ("," ~ LambdaParameter)* }
LambdaParameter = { BeskidType ~ Identifier | Identifier }
LambdaBody = { BlockExpression | Expression }

AssignmentOperator = { "=" | "+=" | "-=" }
AssignmentExpression = { LogicalOrExpression ~ (AssignmentOperator ~ AssignmentExpression)? }
LogicalOrExpression = { LogicalAndExpression ~ ("||" ~ LogicalAndExpression)* }
LogicalAndExpression = { BitwiseOrExpression ~ ("&&" ~ BitwiseOrExpression)* }
BitwiseOrExpression = { BitwiseAndExpression ~ ("|" ~ BitwiseAndExpression)* }
BitwiseAndExpression = { EqualityExpression ~ ("&" ~ EqualityExpression)* }

EqualityExpression = { ComparisonExpression ~ (("===" | "!==" | "==" | "!=") ~ ComparisonExpression)* }
ComparisonExpression = { ShiftExpression ~ (("<=" | ">=" | "<" | ">") ~ ShiftExpression)* }
ShiftExpression = { AdditionExpression ~ (("<<" | ">>") ~ AdditionExpression)* }
AdditionExpression = { MultiplicationExpression ~ (("+" | "-") ~ MultiplicationExpression)* }
MultiplicationExpression = { UnaryExpression ~ (("*" | "/" | "%") ~ UnaryExpression)* }

UnaryExpression = _{ SpawnUnary | PrefixUnary }
SpawnUnary = { SpawnKeyword ~ PostfixExpression }
PrefixUnary = { ("-" | "!")* ~ PostfixExpression }
PostfixExpression = { PrimaryExpression ~ PostfixOperator* }
PostfixOperator = { CallOperator | MemberAccess | SubscriptOperator | TryOperator }

CallOperator = { "(" ~ ArgumentList? ~ ")" }
MemberAccess = { "." ~ Identifier }
SubscriptOperator = { "[" ~ Expression ~ "]" }
TryOperator = { "?" }
TryBlockExpression = { TryKeyword ~ Block ~ CatchKeyword ~ "(" ~ Identifier ~ ")" ~ Block }

MacroInvocation = { Identifier ~ "!" ~ "(" ~ MacroArgumentList? ~ ")"? ~ MacroInvocationBlock? }
MacroArgumentList = { Expression ~ ("," ~ Expression)* }
MacroInvocationBlock = { Block }
MacroMetavariable = { "$" ~ Identifier }

PrimaryExpression = { TryBlockExpression | MacroInvocation | MacroMetavariable | CodeExpression | ClifBlockExpression | Literal | GroupedExpression | BlockExpression | EnumConstructorExpression | StructLiteralExpression | ArrayLiteralExpression | Path }

ClifBlockExpression = { ClifKeyword ~ "{" ~ (!"}" ~ ANY)* ~ "}" }

EnumConstructorExpression = { enum_constructor_nullary | enum_constructor_with_args }
enum_constructor_nullary = { EnumPath ~ !"(" }
enum_constructor_with_args = { EnumPath ~ "(" ~ ArgumentList? ~ ")" }

StructLiteralExpression = { Path ~ "{" ~ FieldValueList? ~ "}" }
FieldValueList = { FieldValue ~ ("," ~ FieldValue)* ~ ","? }
FieldValue = { Identifier ~ ":" ~ Expression }

ArrayLiteralExpression = { "[" ~ ExpressionList? ~ "]" }

CallExpression = { Identifier ~ "(" ~ ArgumentList? ~ ")" }
ArgumentList = { Expression ~ ("," ~ Expression)* }
ExpressionList = { Expression ~ ("," ~ Expression)* ~ ","? }

MatchExpression = { KwMatch ~ Expression ~ "{" ~ (MatchArm ~ ("," ~ MatchArm?)*)? ~ "}" }
MatchArm = { Pattern ~ MatchGuard? ~ "=>" ~ Expression }
MatchGuard = { KwWhen ~ Expression }

Pattern = { "_" | EnumPattern | Identifier | Literal }
EnumPattern = { EnumPath ~ ("(" ~ PatternList? ~ ")")? }
PatternList = { Pattern ~ ("," ~ Pattern)* }

GroupedExpression = { "(" ~ Expression ~ ")" }
BlockExpression = { Block }
