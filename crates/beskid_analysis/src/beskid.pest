////////////////////////////////////////////////////////////
// Beskid Grammar (v0.1)
////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////
// 1) LEXICAL
////////////////////////////////////////////////////////////
WHITESPACE = _{ " " | "\t" | "\n" | "\r" | FourSlashLineComment | OrdinaryLineComment | BlockComment }
// `////`+ lines are ordinary comments (not documentation); `///` is reserved for DocRun on ItemWithDocs.
FourSlashLineComment = _{ "////" ~ (!"\n" ~ ANY)* }
// `//` but not `///` (third slash would make documentation, parsed as DocLineContent on items).
OrdinaryLineComment = _{ "//" ~ !("/") ~ (!"\n" ~ ANY)* }
BlockComment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

ASCII_ALPHA_UNDERSCORE = _{ ASCII_ALPHA | "_" }
Identifier = @{ !Keyword ~ ASCII_ALPHA_UNDERSCORE ~ (ASCII_ALPHANUMERIC | "_")* }

TypeDeclarationKeyword = { "type" }
EnumDeclarationKeyword = { "enum" }
ContractDeclarationKeyword = { "contract" }
AttributeDeclarationKeyword = { "attribute" }
ImplKeyword = { "impl" }
ExtendKeyword = { "extend" }
MatchKeyword = { "match" }
EventKeyword = { "event" }
WhenKeyword = { "when" }
IfKeyword = { "if" }
ElseKeyword = { "else" }
WhileKeyword = { "while" }
ForKeyword = { "for" }
InKeyword = { "in" }
ReturnKeyword = { "return" }
BreakKeyword = { "break" }
ContinueKeyword = { "continue" }
LetKeyword = { "let" }
MutKeyword = { "mut" }
ModKeyword = { "mod" }
UseKeyword = { "use" }
PubKeyword = { "pub" }
RefKeyword = { "ref" }
OutKeyword = { "out" }
TestKeyword = { "test" }
SkipKeyword = { "skip" }
SpawnKeyword = { "spawn" }
AsyncKeyword = { "async" }
AwaitKeyword = { "await" }
HostKeyword = { "host" }
RegistryKeyword = { "registry" }
ScopeKeyword = { "scope" }
StartupKeyword = { "startup" }
InitKeyword = { "init" }
DisposeKeyword = { "dispose" }
WithKeyword = { "with" }
LaunchKeyword = { "launch" }
InjectKeyword = { "inject" }
SingleKeyword = { "single" }
TransientKeyword = { "transient" }
GlobalKeyword = { "global" }
ParentKeyword = { "parent" }

Keyword = {
    (
        TypeDeclarationKeyword
      | EnumDeclarationKeyword
      | ContractDeclarationKeyword
      | AttributeDeclarationKeyword
      | ImplKeyword
      | ExtendKeyword
      | MatchKeyword
      | EventKeyword
      | WhenKeyword
      | IfKeyword
      | ElseKeyword
      | WhileKeyword
      | ForKeyword
      | InKeyword
      | ReturnKeyword
      | BreakKeyword
      | ContinueKeyword
      | LetKeyword
      | MutKeyword
      | ModKeyword
      | UseKeyword
      | PubKeyword
      | RefKeyword
      | OutKeyword
      | TestKeyword
      | SkipKeyword
      | SpawnKeyword
      | AsyncKeyword
      | AwaitKeyword
      | HostKeyword
      | RegistryKeyword
      | ScopeKeyword
      | StartupKeyword
      | InitKeyword
      | DisposeKeyword
      | WithKeyword
      | LaunchKeyword
      | InjectKeyword
      | SingleKeyword
      | TransientKeyword
      | GlobalKeyword
      | ParentKeyword
    ) ~ !ASCII_ALPHANUMERIC
}

IntegerLiteral = @{ "-"? ~ ASCII_DIGIT+ }
FloatLiteral = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
StringLiteral = @{ "\"" ~ StringContent* ~ "\"" }
StringContent = { StringInterpolation | StringEscape | StringText }
StringInterpolation = { "${" ~ InterpolationExpression ~ "}" }
InterpolationExpression = !{ Expression }
StringEscape = { "\\\"" | "\\\\" | "\\${" }
StringText = { (!("\"" | "\\" | "$") ~ ANY)+ | ("$" ~ !("{")) }
CharLiteral = @{ "'" ~ ("\\'" | !("'") ~ ANY) ~ "'" }

Literal = { FloatLiteral | IntegerLiteral | StringLiteral | CharLiteral | "true" | "false" }

////////////////////////////////////////////////////////////
// 2) PROGRAM
////////////////////////////////////////////////////////////
NEWLINE = _{ "\r\n" | "\n" | "\r" }
DocGap = _{ " " | "\t" | NEWLINE | FourSlashLineComment | OrdinaryLineComment | BlockComment }

ItemWithDocs = { ((DocRun ~ InnerItem) | InnerItem) ~ DocGap* }
ItemList = { ItemWithDocs* }
Program = { SOI ~ ItemList ~ EOI }

DocLineContent = { "///" ~ !("/") ~ (!(NEWLINE) ~ ANY)* ~ NEWLINE? }
DocRun = @{ DocLineContent+ }
InnerItem = _{ HostDefinition | MacroDefinition | FunctionDefinition | ImplBlock | ExtendTypeDefinition | TypeDefinition | EnumDefinition | ContractDefinition | TestDefinition | AttributeDeclaration | InlineModule | ModuleDeclaration | UseDeclaration }

AttributeList = { Attribute+ }
Attribute = { "[" ~ Identifier ~ ("(" ~ AttributeArgumentList? ~ ")")? ~ "]" }
AttributeArgumentList = { AttributeArgument ~ ("," ~ AttributeArgument)* }
AttributeArgument = { Identifier ~ ":" ~ Expression }
AttributeDeclaration = { Visibility? ~ "attribute" ~ Identifier ~ AttributeTargetList? ~ "{" ~ AttributeParameterList? ~ "}" }
AttributeTargetList = { "(" ~ AttributeTarget ~ ("," ~ AttributeTarget)* ~ ","? ~ ")" }
AttributeTarget = { Identifier }
AttributeParameterList = { AttributeParameter ~ ("," ~ AttributeParameter)* ~ ","? }
AttributeParameter = { Identifier ~ ":" ~ BeskidType ~ ("=" ~ Expression)? }

Visibility = { "pub" }

ModuleDeclaration = { AttributeList? ~ Visibility? ~ "mod" ~ Path ~ ";" }
InlineModuleBody = { ItemWithDocs* }
InlineModule = { AttributeList? ~ Visibility? ~ "mod" ~ Identifier ~ "{" ~ InlineModuleBody ~ "}" }
UseDeclaration = { Visibility? ~ "use" ~ Path ~ ("as" ~ Identifier)? ~ ";" }
PathSegment = { Identifier ~ GenericArguments? }
Path = { PathSegment ~ ("." ~ PathSegment)* }
PathList = { Path ~ ("," ~ Path)* }
EnumPath = { Identifier ~ "::" ~ Identifier }

////////////////////////////////////////////////////////////
// 3) TYPES
////////////////////////////////////////////////////////////
PrimitiveType = { "bool" | "i32" | "i64" | "u8" | "f64" | "char" | "string" | "unit" }

GenericParameters = { "<" ~ Identifier ~ ("," ~ Identifier)* ~ ">" }
GenericArguments = { "<" ~ BeskidType ~ ("," ~ BeskidType)* ~ ">" }

TypeName = { PrimitiveType | Path }
ArrayType = { TypeName ~ "[" ~ "]" }
TypeReference = { "ref" ~ TypeName }
FunctionType = { TypeName ~ "(" ~ BeskidTypeList? ~ ")" }
ArrowFunctionType = { "(" ~ BeskidTypeList? ~ ")" ~ "=>" ~ BeskidType }
BeskidTypeList = { BeskidType ~ ("," ~ BeskidType)* }
BeskidType = { ArrowFunctionType | FunctionType | TypeReference | ArrayType | TypeName }

////////////////////////////////////////////////////////////
// 4) DEFINITIONS
////////////////////////////////////////////////////////////
FunctionDefinition = { Visibility? ~ BeskidType ~ Identifier ~ GenericParameters? ~ "(" ~ ParameterList? ~ ")" ~ Block }
ReceiverType = { PrimitiveType | Path }
ImplBlock = { "impl" ~ ReceiverType ~ "{" ~ ImplMethodWithDocs* ~ "}" }
ExtendTypeDefinition = { "extend" ~ "type" ~ ReceiverType ~ "{" ~ ImplMethodWithDocs* ~ "}" }

MacroFragmentKind = { "block" | "expression" | "statement" | "type" | "identifier" | "literal" | "pattern" | "path" | "item" | "node" }
MacroParameter = { MacroFragmentKind ~ Identifier }
MacroParameterList = { MacroParameter ~ ("," ~ MacroParameter)* }
MacroDefinition = { Visibility? ~ "macro" ~ Identifier ~ "(" ~ MacroParameterList? ~ ")" ~ Block }
ImplMethodWithDocs = { ((DocRun ~ ImplMethodDefinition) | ImplMethodDefinition) ~ DocGap* }
ImplMethodDefinition = { Visibility? ~ BeskidType ~ Identifier ~ "(" ~ ParameterList? ~ ")" ~ Block }
ParameterList = { ParameterWithDocs ~ ("," ~ DocGap* ~ ParameterWithDocs)* }
ParameterWithDocs = { (DocRun ~ Parameter) | Parameter }
Parameter = { ParameterModifier? ~ BeskidType ~ MutKeyword? ~ Identifier }
ParameterModifier = { "ref" | "out" }

FieldList = { FieldWithDocs ~ ("," ~ DocGap* ~ FieldWithDocs)* ~ ","? }
FieldWithDocs = { (DocRun ~ Field) | Field }
ValueField = { BeskidType ~ Identifier }
EventCapacity = { "{" ~ IntegerLiteral ~ "}" }
EventField = { "event" ~ EventCapacity? ~ Identifier ~ "(" ~ ParameterList? ~ ")" }
InjectQualifier = { ("global" | "parent") ~ "::" }
InjectField = { "inject" ~ InjectQualifier? ~ BeskidType ~ Identifier }
Field = { Visibility? ~ (InjectField | EventField | ValueField) }

TypeConformanceList = { ":" ~ PathList }
TypeDefinition = { Visibility? ~ "type" ~ Identifier ~ GenericParameters? ~ TypeConformanceList? ~ "{" ~ FieldList? ~ "}" }

EnumDefinition = { Visibility? ~ "enum" ~ Identifier ~ GenericParameters? ~ "{" ~ EnumVariantList? ~ "}" }
EnumVariantList = { EnumVariantWithDocs ~ ("," ~ DocGap* ~ EnumVariantWithDocs)* ~ ","? }
EnumVariantWithDocs = { (DocRun ~ EnumVariant) | EnumVariant }
EnumVariant = { Identifier ~ ("(" ~ FieldList? ~ ")")? }

ContractDefinition = { AttributeList? ~ Visibility? ~ "contract" ~ Identifier ~ "{" ~ ContractItemWithDocs* ~ "}" }
ContractItemWithDocs = { ((DocRun ~ ContractItem) | ContractItem) ~ DocGap* }
ContractItem = _{ ContractMethodSignature | ContractEmbedding }
ContractMethodSignature = { BeskidType ~ Identifier ~ "(" ~ ParameterList? ~ ")" ~ ";" }
ContractEmbedding = { Identifier ~ ";"? }

RegistrationLifetime = { "single" | "transient" }
RegistrationTarget = { "for" ~ Path }
RegistryEntry = { RegistrationLifetime? ~ Path ~ RegistrationTarget? ~ ";" }
RegistryBlock = { "registry" ~ "{" ~ RegistryEntry* ~ "}" }

ScopeHookName = { "init" | "dispose" | "startup" }
ScopeHook = { ScopeHookName ~ "(" ~ ParameterList? ~ ")" ~ Block }
ScopeBodyItem = _{ RegistryBlock | ScopeHook | ScopeDefinition | RegistryEntry }
ScopeDefinition = { "scope" ~ Identifier ~ "(" ~ ParameterList? ~ ")" ~ "{" ~ ScopeBodyItem* ~ "}" }
HostBodyItem = _{ RegistryBlock | ScopeHook | ScopeDefinition }
HostDefinition = { "host" ~ Identifier ~ "(" ~ ParameterList? ~ ")" ~ (":" ~ Path)? ~ "{" ~ HostBodyItem* ~ "}" }

TestDefinition = { AttributeList? ~ Visibility? ~ "test" ~ Identifier ~ TestBody }
TestBody = { "{" ~ TestBodyItemWithDocs* ~ "}" }
TestBodyItemWithDocs = { ((DocRun ~ Statement) | TestMetaSection | TestSkipSection | Statement) ~ DocGap* }
TestBodyItem = _{ TestMetaSection | TestSkipSection | Statement }
TestMetaSection = { "meta" ~ "{" ~ TestMetadataEntry* ~ "}" }
TestMetadataEntry = { Identifier ~ "=" ~ Expression ~ ";" }
TestSkipSection = { "skip" ~ "{" ~ TestSkipEntry* ~ "}" }
TestSkipEntry = { Identifier ~ "=" ~ Expression ~ ";" }

////////////////////////////////////////////////////////////
// 5) STATEMENTS AND BLOCKS
////////////////////////////////////////////////////////////
Block = { "{" ~ Statement* ~ "}" }

WithStatement = { "with" ~ Identifier ~ "(" ~ ArgumentList? ~ ")" ~ Block }
LaunchStatement = { "launch" ~ Path ~ "(" ~ ArgumentList? ~ ")" ~ ";" }
Statement = _{ LetStatement | ReturnStatement | BreakStatement | ContinueStatement | WhileStatement | ForStatement | IfStatement | WithStatement | LaunchStatement | ExpressionStatement }

LetStatement = { TypedLetStatement | InferredLetStatement }
TypedLetStatement = { BeskidType ~ MutKeyword? ~ Identifier ~ "=" ~ Expression ~ ";" }
InferredLetStatement = { LetKeyword ~ Identifier ~ "=" ~ Expression ~ ";" }
TypeAnnotation = { ":" ~ BeskidType }

ReturnStatement = { "return" ~ Expression? ~ ";" }
BreakStatement = { "break" ~ ";" }
ContinueStatement = { "continue" ~ ";" }

IfStatement = { "if" ~ Expression ~ Block ~ ("else" ~ Block)? }
WhileStatement = { "while" ~ Expression ~ Block }
ForStatement = { "for" ~ Identifier ~ "in" ~ Expression ~ Block }
RangeExpression = { "range" ~ "(" ~ Expression ~ "," ~ Expression ~ ")" }

ExpressionStatement = { Expression ~ ";" }

////////////////////////////////////////////////////////////
// 6) EXPRESSIONS
////////////////////////////////////////////////////////////
Expression = { LambdaExpression | MatchExpression | AssignmentExpression }

LambdaExpression = { LambdaParameters ~ "=>" ~ LambdaBody }
LambdaParameters = { Identifier | "(" ~ LambdaParameterList? ~ ")" }
LambdaParameterList = { LambdaParameter ~ ("," ~ LambdaParameter)* }
LambdaParameter = { BeskidType ~ Identifier | Identifier }
LambdaBody = { BlockExpression | Expression }

AssignmentOperator = { "=" | "+=" | "-=" }
AssignmentExpression = { LogicalOrExpression ~ (AssignmentOperator ~ AssignmentExpression)? }
LogicalOrExpression = { LogicalAndExpression ~ ("||" ~ LogicalAndExpression)* }
LogicalAndExpression = { EqualityExpression ~ ("&&" ~ EqualityExpression)* }

EqualityExpression = { ComparisonExpression ~ (("===" | "!==" | "==" | "!=") ~ ComparisonExpression)* }
ComparisonExpression = { AdditionExpression ~ (("<=" | ">=" | "<" | ">") ~ AdditionExpression)* }
AdditionExpression = { MultiplicationExpression ~ (("+" | "-") ~ MultiplicationExpression)* }
MultiplicationExpression = { UnaryExpression ~ (("*" | "/") ~ UnaryExpression)* }

UnaryExpression = _{ SpawnUnary | PrefixUnary }
SpawnUnary = { SpawnKeyword ~ PostfixExpression }
PrefixUnary = { ("-" | "!")* ~ PostfixExpression }
PostfixExpression = { PrimaryExpression ~ PostfixOperator* }
PostfixOperator = { CallOperator | MemberAccess | TryOperator }

CallOperator = { "(" ~ ArgumentList? ~ ")" }
MemberAccess = { "." ~ Identifier }
TryOperator = { "?" }

MacroInvocation = { Identifier ~ "!" ~ "(" ~ MacroArgumentList? ~ ")"? ~ MacroInvocationBlock? }
MacroArgumentList = { Expression ~ ("," ~ Expression)* }
MacroInvocationBlock = { Block }
MacroMetavariable = { "$" ~ Identifier }

PrimaryExpression = { MacroInvocation | MacroMetavariable | Literal | GroupedExpression | BlockExpression | EnumConstructorExpression | StructLiteralExpression | Path }

EnumConstructorExpression = { EnumPath ~ "(" ~ ArgumentList? ~ ")" }

StructLiteralExpression = { Path ~ "{" ~ FieldValueList? ~ "}" }
FieldValueList = { FieldValue ~ ("," ~ FieldValue)* ~ ","? }
FieldValue = { Identifier ~ ":" ~ Expression }

CallExpression = { Identifier ~ "(" ~ ArgumentList? ~ ")" }
ArgumentList = { Expression ~ ("," ~ Expression)* }

MatchExpression = { "match" ~ Expression ~ "{" ~ (MatchArm ~ ("," ~ MatchArm?)*)? ~ "}" }
MatchArm = { Pattern ~ MatchGuard? ~ "=>" ~ Expression }
MatchGuard = { "when" ~ Expression }

Pattern = { "_" | EnumPattern | Identifier | Literal }
EnumPattern = { EnumPath ~ ("(" ~ PatternList? ~ ")")? }
PatternList = { Pattern ~ ("," ~ Pattern)* }

GroupedExpression = { "(" ~ Expression ~ ")" }
BlockExpression = { Block }
