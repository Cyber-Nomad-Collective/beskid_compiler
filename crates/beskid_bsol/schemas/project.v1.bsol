profile "project.v1" {
  rule "root" {
    scope = top
    match = free_ident
    except = [target, dependency, link, workspace, member, override, registry, project]
    label = forbidden
    cardinality = one
    extras = true
    field "name" { type = quoted required = true }
    field "version" { type = quoted required = true }
    field "root" { type = quoted required = false }
    field "root_namespace" { type = quoted required = false }
    field "type" { type = enum_or_quoted values = [Mod, Meta, Template, Aggregate] required = false }
    field "readme" { type = quoted required = false }
    nested "mod" {
      match = keywords
      keywords = [mod, meta]
      label = forbidden
      cardinality = zero_or_one
      field "maxGeneratorRounds" { type = u32 required = false }
      field "maxMetaRounds" { type = u32 required = false }
      field "capabilities" { type = list required = false }
      field "artifactPolicy" { type = enum_or_quoted values = [reuse, rebuild, clean_rebuild] required = false }
    }
    nested "template" {
      match = keyword
      keyword = template
      label = forbidden
      cardinality = zero_or_one
      field "shortName" { type = quoted required = false }
      field "identity" { type = quoted required = false }
    }
  }
  rule "target" {
    scope = top
    match = keyword
    keyword = target
    label = required
    cardinality = many
    field "kind" { type = enum_or_quoted values = [App, Lib, Test] required = true }
    field "entry" { type = quoted required = false }
  }
  rule "dependency" {
    scope = top
    match = keyword
    keyword = dependency
    label = required
    cardinality = many
    field "source" { type = enum_or_quoted values = [path, git, registry] required = true }
    field "path" { type = quoted required = false }
    field "url" { type = quoted required = false }
    field "rev" { type = quoted required = false }
    field "version" { type = quoted required = false }
    field "registry" { type = quoted required = false }
  }
  rule "link" {
    scope = top
    match = keyword
    keyword = link
    label = forbidden
    cardinality = zero_or_one
    field "libraries" { type = list required = false }
    field "searchPaths" { type = list required = false }
    field "extraArgs" { type = list required = false }
  }
}
