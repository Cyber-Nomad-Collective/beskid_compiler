board "hi-default" {
  version = 2
  title = "Beskid Hi"
  scope = user
  root = "root"
}

node "log" {
  kind = panel
  widget = "shell.log"
  grow = 1
}

node "root" {
  kind = col
  children = ["home_body", "log"]
}

node "home_body" {
  kind = row
  grow = 1
  children = ["stage"]
}

node "stage" {
  kind = panel
  widget = "hi.welcome"
  grow = 1
}

node "graphs_root" {
  kind = col
  children = ["graphs_body", "log"]
}

node "graphs_body" {
  kind = row
  grow = 1
  children = ["graph_deps", "graph_compile"]
}

node "graph_deps" {
  kind = panel
  widget = "graph.deps"
  grow = 1
}

node "graph_compile" {
  kind = panel
  widget = "graph.compile"
  grow = 1
}

node "compile_debug_root" {
  kind = col
  children = ["compile_debug_main", "log"]
}

node "compile_debug_main" {
  kind = panel
  widget = "compile.debugger"
  grow = 1
}

node "analysis_root" {
  kind = col
  children = ["analysis_main", "log"]
}

node "analysis_main" {
  kind = panel
  widget = "analysis.diagnostics"
  grow = 1
}

node "settings_root" {
  kind = col
  children = ["settings_main", "log"]
}

node "settings_main" {
  kind = panel
  widget = "shell.settings"
  grow = 1
}

node "pckg_root" {
  kind = col
  children = ["pckg_main", "log"]
}

node "pckg_main" {
  kind = panel
  widget = "pckg.browser"
  grow = 1
}

node "new_project_root" {
  kind = col
  children = ["new_project_main", "log"]
}

node "new_project_main" {
  kind = panel
  widget = "hi.welcome"
  grow = 1
}

node "debugger_root" {
  kind = col
  children = ["debugger_main", "log"]
}

node "debugger_main" {
  kind = panel
  widget = "debug.future"
  grow = 1
}
