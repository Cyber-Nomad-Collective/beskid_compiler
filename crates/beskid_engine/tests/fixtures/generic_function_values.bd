// A generic function read as a value, end to end: the value is instantiated where it is read,
// from explicit type arguments or from the expected function type of its position, and its
// closure record points at that specialization's entry. A record held in a local survives a
// forced collection.

[Extern(Abi:"C")]
pub contract Probe { unit gc_collect(); }

pub type Cell { i64 value }

T Identity<T>(T x) { return x; }

i64 Apply(i64 v, (i64) => i64 f) { return f(v); }

T ApplyGeneric<T>(T v, (T) => T f) { return f(v); }

// Indirect call results typed by the instance are values: passed on and stored.
T Twice<T>(T x, (T) => T f) { return f(f(x)); }

T Stored<T>(T x, (T) => T f) {
    T once = f(x);
    Probe.gc_collect();
    return f(once);
}

i64 AddOne(i64 x) { return x + 1_i64; }

// The callee parameter `(i64) => i64` fixes `T`.
i64 FromCalleeParameter() { return Apply(5_i64, Identity); }

// Explicit type arguments on the value.
i64 FromExplicitArguments() { return Apply(6_i64, Identity<i64>); }

// The explicit type arguments of a generic callee type its parameter, which fixes `T`.
i64 FromGenericCallee() { return ApplyGeneric<i64>(7_i64, Identity); }

// An annotated local fixes `T`; the record survives a collection.
i64 FromAnnotatedLocal() {
    (i64) => i64 f = Identity;
    Probe.gc_collect();
    return f(8_i64);
}

// A nominal instantiation: `Identity<Cell>` passes the managed reference through.
i64 NominalInstance() {
    (Cell) => Cell f = Identity;
    Cell cell = Cell { value: 9_i64 };
    Probe.gc_collect();
    Cell back = f(cell);
    return back.value;
}

// A generic higher-order callee with a non-generic value (1 + 1 + 1) and with a generic one
// instantiated from the callee's explicit type arguments (4 passed through twice).
i64 GenericHigherOrder() { return Twice<i64>(1_i64, AddOne) + Stored<i64>(4_i64, Identity); }

[Export(Abi:"C", Symbol:"RunGenericFunctionValues")]
pub i64 RunGenericFunctionValues() {
    if FromCalleeParameter() != 5_i64 { return 1_i64; }
    if FromExplicitArguments() != 6_i64 { return 2_i64; }
    if FromGenericCallee() != 7_i64 { return 3_i64; }
    if FromAnnotatedLocal() != 8_i64 { return 4_i64; }
    if NominalInstance() != 9_i64 { return 5_i64; }
    if GenericHigherOrder() != 7_i64 { return 6_i64; }
    return 42_i64;
}
