use Core.Results;
use Core.Collections.Array;
use Core.Memory.Managed;
use Core.Parallel;
use Core.Parallel.Scopes;
use Core.Parallel.Port;
use Core.Parallel.ParallelSeq;
use Core.Collections.List;
use Core.Optional.Option;
use Concurrency.TryResult;

// Isolate, port and ORCA count evidence (v063-isolates-and-scope, v064-ports-and-pipelines 2.x
// and 3.x, v065-parallel-sequences 2.x and 3.x). Every entry returns a non-negative value on
// success and a distinct negative code on the first failed check; the `heap_growth.c` host then
// requires a clean `gc_heap_verify`. Entries collect after each scope so that DECs, adoption and
// retained heaps are exercised by a real cycle on every side.

[Extern(Abi:"C")]
pub contract Probe {
    unit gc_collect();
    u8 gc_heap_verify();
}

[Immutable]
pub type Config {
    pub string name,
    pub i64 width,
}

[Isolated]
pub type Node {
    pub i64 value,
    pub Node[] next,
}

i64 Collected() {
    Probe.gc_collect();
    if Probe.gc_heap_verify() == 0_u8 { return -100_i64; }
    return 0_i64;
}

i64 ScopeValue(Result<i64, ParallelError> result) {
    return match result {
        Result::Ok(value) => value,
        Result::Error(_) => -1_i64,
    };
}

i64 Received(Result<i64, PortError> result) {
    return match result {
        Result::Ok(value) => value,
        Result::Error(_) => -1_i64,
    };
}

// ---- Fork-join: two isolates, results adopted at join (v0.6.3) ----
[Export(Abi:"C", Symbol:"RunTwoIsolates")]
pub i64 RunTwoIsolates() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Task<i64[]> left = s.Spawn(() => Array.Of<i64>(1_i64, 2_i64, 3_i64));
        Task<i64[]> right = s.Spawn(() => Array.Of<i64>(4_i64, 5_i64));
        mut i64 sum = 0_i64;
        match left.Join() {
            Result::Ok(values) => { for v in values { sum = sum + v; } },
            Result::Error(_) => { return Result::Error(ParallelError::Cancelled); },
        };
        match right.Join() {
            Result::Ok(values) => { for v in values { sum = sum + v; } },
            Result::Error(_) => { return Result::Error(ParallelError::Cancelled); },
        };
        return Result::Ok(sum);
    });
    if ScopeValue(result) != 15_i64 { return -1_i64; }
    return Collected();
}

// ---- Port FIFO and close-then-drain (v0.6.4 2.1-2.3) ----
[Export(Abi:"C", Symbol:"RunPortFifo")]
pub i64 RunPortFifo() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<i64> numbers = s.PortWith<i64>(4_i64);
        Task<i64> producer = s.Spawn(() => {
            mut i64 i = 0_i64;
            while i < 200_i64 {
                numbers.Send(i);
                i = i + 1_i64;
            }
            numbers.Close();
            return i;
        });
        mut i64 expected = 0_i64;
        mut bool open = true;
        while open {
            match numbers.Receive() {
                Result::Ok(value) => {
                    if value != expected { return Result::Ok(-2_i64); }
                    expected = expected + 1_i64;
                },
                Result::Error(_) => { open = false; },
            };
        }
        producer.Join();
        return Result::Ok(expected);
    });
    if ScopeValue(result) != 200_i64 { return -1_i64; }
    return Collected();
}

// ---- Shared values cross by pointer (v0.6.4 4.5, ORCA step 2) ----
// The isolate echoes the Config it received: the address that comes back is the original one.
[Export(Abi:"C", Symbol:"RunSharedByPointer")]
pub i64 RunSharedByPointer() {
    Config original = Config { name: "shared", width: 42_i64 };
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<Config> outbound = s.Port<Config>();
        Port<Config> inbound = s.Port<Config>();
        Task<i64> echo = s.Spawn(() => {
            match outbound.Receive() {
                Result::Ok(config) => {
                    inbound.Send(config);
                    return config.width;
                },
                Result::Error(_) => { return -1_i64; },
            };
        });
        outbound.Send(original);
        mut i64 same = 0_i64;
        match inbound.Receive() {
            Result::Ok(config) => {
                if Managed.SameIdentity<Config>(config, original) { same = 1_i64; }
            },
            Result::Error(_) => { return Result::Ok(-3_i64); },
        };
        match echo.Join() {
            Result::Ok(width) => { if width != 42_i64 { return Result::Ok(-4_i64); } },
            Result::Error(_) => { return Result::Ok(-5_i64); },
        };
        return Result::Ok(same);
    });
    if ScopeValue(result) != 1_i64 { return -1_i64; }
    // The echo isolate's DEC and the own-object receive bring the local count back to zero; the
    // object is still reachable from `original`.
    if Collected() != 0_i64 { return -6_i64; }
    if original.width != 42_i64 { return -7_i64; }
    return 0_i64;
}

// ---- Shared value outlives its sender (count keeps it alive after the sender exits) ----
[Export(Abi:"C", Symbol:"RunSharedOutlivesSender")]
pub i64 RunSharedOutlivesSender() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<Config> configs = s.Port<Config>();
        Task<i64> sender = s.Spawn(() => {
            configs.Send(Config { name: "from-child", width: 7_i64 });
            return 0_i64;
        });
        sender.Join();
        // The sender has ended and its heap was adopted by this isolate; the value is read in
        // place after a collection.
        Probe.gc_collect();
        match configs.Receive() {
            Result::Ok(config) => { return Result::Ok(config.width); },
            Result::Error(_) => { return Result::Ok(-2_i64); },
        };
    });
    if ScopeValue(result) != 7_i64 { return -1_i64; }
    return Collected();
}

// ---- Moved graphs are handed over by pointer (v0.6.5 2.1-2.3) ----
// A linked list of 1,000 nodes travels from a child to the parent; the child keeps allocating
// and collecting while the parent walks the list, so shallow marking on the owner and tracing
// through foreign mutable objects on the receiver are both exercised.
Node Chain(i64 length) {
    mut Node head = Node { value: 0_i64, next: Array.Empty<Node>() };
    mut i64 i = 1_i64;
    while i < length {
        head = Node { value: i, next: Array.Of<Node>(head) };
        i = i + 1_i64;
    }
    return head;
}

i64 ChainSum(Node head) {
    mut i64 sum = head.value;
    mut Node[] rest = head.next;
    while Array.Len<Node>(rest) > 0_i64 {
        Node node = rest[0_i64];
        sum = sum + node.value;
        rest = node.next;
    }
    return sum;
}

[Export(Abi:"C", Symbol:"RunMovedHandOver")]
pub i64 RunMovedHandOver() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<Node> chains = s.Port<Node>();
        Port<i64> done = s.Port<i64>();
        Task<i64> producer = s.Spawn(() => {
            chains.Send(Chain(1000_i64));
            // Churn on the owner while the receiver holds the graph.
            mut i64 round = 0_i64;
            while round < 50_i64 {
                Chain(100_i64);
                Probe.gc_collect();
                round = round + 1_i64;
            }
            return Received(done.Receive());
        });
        mut i64 sum = -1_i64;
        match chains.Receive() {
            Result::Ok(received) => {
                mut Node head = received;
                Probe.gc_collect();
                // A store of a receiver object into the foreign mutable graph: the receiver's
                // collector traces through the foreign node to keep it alive.
                head.next = Array.Of<Node>(Node { value: 0_i64, next: move head.next });
                Probe.gc_collect();
                sum = ChainSum(head);
            },
            Result::Error(_) => { return Result::Ok(-2_i64); },
        };
        done.Send(1_i64);
        producer.Join();
        return Result::Ok(sum);
    });
    // 0 + 1 + ... + 999, plus the inserted zero node.
    if ScopeValue(result) != 499500_i64 { return -1_i64; }
    return Collected();
}

// ---- A failed isolate whose object another isolate holds is retained and adopted ----
[Export(Abi:"C", Symbol:"RunFailedOwnerRetained")]
pub i64 RunFailedOwnerRetained() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<Config> configs = s.Port<Config>();
        Task<i64> failing = s.SpawnTry<i64>(() => {
            configs.Send(Config { name: "orphan", width: 9_i64 });
            return Result::Error("fails after sending");
        });
        failing.Join();
        Probe.gc_collect();
        match configs.Receive() {
            Result::Ok(config) => { return Result::Ok(config.width); },
            Result::Error(_) => { return Result::Ok(-2_i64); },
        };
    });
    // The scope reports the failed task; the received value was readable inside it.
    match result {
        Result::Error(ParallelError::Failed(_)) => { },
        _ => { return -1_i64; },
    };
    return Collected();
}

// ---- Undelivered stakes are released when the scope releases its ports ----
[Export(Abi:"C", Symbol:"RunUndeliveredReleased")]
pub i64 RunUndeliveredReleased() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<Config> configs = s.PortWith<Config>(8_i64);
        Task<i64> sender = s.Spawn(() => {
            mut i64 i = 0_i64;
            while i < 8_i64 {
                configs.Send(Config { name: "never-read", width: i });
                i = i + 1_i64;
            }
            return i;
        });
        sender.Join();
        return Result::Ok(0_i64);
    });
    if ScopeValue(result) != 0_i64 { return -1_i64; }
    return Collected();
}

// ---- One spawned value at a real isolate (v0.6.3 regression) ----
string DiagDigit(i64 d) {
    if d == 0_i64 { return "0"; }
    if d == 1_i64 { return "1"; }
    if d == 2_i64 { return "2"; }
    if d == 3_i64 { return "3"; }
    if d == 4_i64 { return "4"; }
    if d == 5_i64 { return "5"; }
    if d == 6_i64 { return "6"; }
    if d == 7_i64 { return "7"; }
    if d == 8_i64 { return "8"; }
    return "9";
}

string DiagDecimal(i64 v) {
    if v < 0_i64 { return "-" + DiagDecimal(0_i64 - v); }
    if v < 10_i64 { return DiagDigit(v); }
    return DiagDecimal(v / 10_i64) + DiagDigit(v % 10_i64);
}

[Export(Abi:"C", Symbol:"RunSpawnValue")]
pub i64 RunSpawnValue() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Task<i64> t = s.Spawn(() => 20_i64);
        mut i64 value = -3_i64;
        match t.Join() {
            Result::Ok(v) => {
                Core.Output.WriteLine("spawn-value ok " + DiagDecimal(v));
                value = v;
            },
            Result::Error(TaskError::Failed(failure)) => {
                Core.Output.WriteLine("spawn-value failed index " + DiagDecimal(failure.index) + " message <" + failure.message + ">");
            },
            Result::Error(TaskError::Cancelled) => { Core.Output.WriteLine("spawn-value cancelled"); },
            Result::Error(TaskError::Joined) => { Core.Output.WriteLine("spawn-value joined"); },
        };
        return Result::Ok(value);
    });
    match result {
        Result::Ok(v) => { Core.Output.WriteLine("scope ok " + DiagDecimal(v)); },
        Result::Error(ParallelError::Cancelled) => { Core.Output.WriteLine("scope cancelled"); },
        Result::Error(ParallelError::Failed(_)) => { Core.Output.WriteLine("scope failed"); },
    };
    if ScopeValue(result) != 20_i64 { return -1_i64; }
    return Collected();
}

// ---- A tolerated Error value is a task value, not a failure (v0.6.3) ----
[Export(Abi:"C", Symbol:"RunToleratedValue")]
pub i64 RunToleratedValue() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Task<Result<i64, string>> t = s.Spawn<Result<i64, string>>(() => Result::Error("skip"));
        mut i64 code = -3_i64;
        match t.Join() {
            Result::Ok(Result::Error(reason)) => {
                Core.Output.WriteLine("tolerated value <" + reason + ">");
                if reason == "skip" { code = 0_i64; }
            },
            Result::Ok(Result::Ok(v)) => { Core.Output.WriteLine("tolerated ok " + DiagDecimal(v)); },
            Result::Error(TaskError::Failed(failure)) => {
                Core.Output.WriteLine("tolerated failed <" + failure.message + ">");
            },
            Result::Error(TaskError::Cancelled) => { Core.Output.WriteLine("tolerated cancelled"); },
            Result::Error(TaskError::Joined) => { Core.Output.WriteLine("tolerated joined"); },
        };
        return Result::Ok(code);
    });
    if ScopeValue(result) != 0_i64 { return -1_i64; }
    return Collected();
}

// ---- Strings cross a port by pointer and stay readable in the receiver (v0.6.4) ----
[Export(Abi:"C", Symbol:"RunStringPort")]
pub i64 RunStringPort() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<string> lines = s.PortWith<string>(4_i64);
        Task<i64> producer = s.Spawn(() => {
            mut i64 i = 0_i64;
            while i < 50_i64 {
                lines.Send("line " + DiagDecimal(i));
                i = i + 1_i64;
            }
            lines.Close();
            return i;
        });
        mut i64 expected = 0_i64;
        mut bool open = true;
        while open {
            match lines.Receive() {
                Result::Ok(line) => {
                    if line != "line " + DiagDecimal(expected) {
                        Core.Output.WriteLine("string-port mismatch <" + line + ">");
                        return Result::Ok(-2_i64);
                    }
                    expected = expected + 1_i64;
                },
                Result::Error(_) => { open = false; },
            };
        }
        producer.Join();
        return Result::Ok(expected);
    });
    if ScopeValue(result) != 50_i64 { return -1_i64; }
    return Collected();
}

// ---- Collect keeps every element across real isolates (v0.6.5) ----
[Export(Abi:"C", Symbol:"RunCollect")]
pub i64 RunCollect() {
    mut List<i64> values = List.New<i64>();
    mut i64 i = 0_i64;
    while i < 10000_i64 {
        values = values.Push(i);
        i = i + 1_i64;
    }
    List<i64> doubled = values.Parallel().Chunk(7_i64).Map((x) => x * 2_i64).Collect();
    if doubled.Count() != 10000_i64 {
        Core.Output.WriteLine("collect count " + DiagDecimal(doubled.Count()));
        return -1_i64;
    }
    mut i64 k = 0_i64;
    while k < 10000_i64 {
        match doubled.TryGet(k) {
            Option::Some(v) => {
                if v != 2_i64 * k {
                    Core.Output.WriteLine("collect at " + DiagDecimal(k) + " got " + DiagDecimal(v));
                    return -2_i64;
                }
            },
            Option::None => { return -3_i64; },
        };
        k = k + 1_i64;
    }
    return Collected();
}

// ---- A port handle crosses a port (v0.6.4) ----
[Export(Abi:"C", Symbol:"RunPortHandle")]
pub i64 RunPortHandle() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<Port<i64>> replyTo = s.Port<Port<i64>>();
        Task<unit> server = s.Spawn(() => {
            match replyTo.Receive() {
                Result::Ok(reply) => { reply.Send(42_i64); },
                Result::Error(_) => { },
            };
            return;
        });
        Port<i64> fresh = s.Port<i64>();
        replyTo.Send(fresh);
        return match fresh.Receive() {
            Result::Ok(v) => Result::Ok(v),
            Result::Error(_) => Result::Ok(-1_i64),
        };
    });
    if ScopeValue(result) != 42_i64 { return -1_i64; }
    return Collected();
}

// ---- A three-stage pipeline keeps input order (v0.6.4) ----
[Export(Abi:"C", Symbol:"RunPipeline")]
pub i64 RunPipeline() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<string> lines = s.PortWith<string>(2000_i64);
        Result<i64, ParallelError> consumed = s
            .Source((Port<i64> out) => {
                mut i64 i = 1_i64;
                while i <= 1000_i64 {
                    out.Send(i);
                    i = i + 1_i64;
                }
                return;
            })
            .Stage(4_i64, (n) => n * n)
            .Ordered()
            .Stage(2_i64, (sq) => "${sq}")
            .Ordered()
            .Sink((line) => {
                lines.Send(line);
                return;
            });
        mut i64 expected = 1_i64;
        mut bool more = true;
        while more {
            match lines.TryReceive() {
                TryResult::Ok(line) => {
                    i64 square = expected * expected;
                    if line != "${square}" {
                        Core.Output.WriteLine("pipeline mismatch at " + DiagDecimal(expected) + " <" + line + ">");
                        return Result::Ok(-2_i64);
                    }
                    expected = expected + 1_i64;
                },
                _ => { more = false; },
            };
        }
        return match consumed {
            Result::Ok(n) => Result::Ok(n),
            Result::Error(_) => Result::Ok(-3_i64),
        };
    });
    if ScopeValue(result) != 1000_i64 { return -1_i64; }
    return Collected();
}

// ---- A payload kept after its Shared wrapper is dropped (0.6.6, gate-2 F6) ----
// A `Shared` send stakes only the message's root object. The keeper extracts the text of each
// wrapper (a pipeline's `Sequenced::Item`), drops the wrappers and collects, so their DECs reach
// the producer; the producer then collects twice before the keeper forwards the texts. Only the
// stake the keeper's own marking takes on each text keeps it alive in the producer's heap.
enum Wrapped<T> {
    Item(i64 sequence, T value),
}

[Export(Abi:"C", Symbol:"RunWrappedPayloadKept")]
pub i64 RunWrappedPayloadKept() {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Scope s) => {
        Port<Wrapped<string>> wrapped = s.PortWith<Wrapped<string>>(64_i64);
        Port<string> kept = s.PortWith<string>(64_i64);
        Port<i64> dropped = s.Port<i64>();
        Port<i64> swept = s.Port<i64>();
        Task<i64> producer = s.Spawn(() => {
            mut i64 i = 0_i64;
            while i < 32_i64 {
                wrapped.Send(Wrapped::Item(i, "item " + DiagDecimal(i)));
                i = i + 1_i64;
            }
            wrapped.Close();
            match dropped.Receive() {
                _ => { },
            };
            Probe.gc_collect();
            Probe.gc_collect();
            swept.Send(1_i64);
            return i;
        });
        Task<i64> keeper = s.Spawn(() => {
            mut List<string> texts = List.New<string>();
            mut bool open = true;
            while open {
                match wrapped.Receive() {
                    Result::Ok(Wrapped::Item(_, text)) => { texts = texts.Push(text); },
                    Result::Error(_) => { open = false; },
                };
            }
            Probe.gc_collect();
            dropped.Send(1_i64);
            match swept.Receive() {
                _ => { },
            };
            mut i64 k = 0_i64;
            while k < texts.Count() {
                match texts.TryGet(k) {
                    Option::Some(text) => { kept.Send(text); },
                    Option::None => { },
                };
                k = k + 1_i64;
            }
            kept.Close();
            return k;
        });
        mut i64 expected = 0_i64;
        mut bool open = true;
        while open {
            match kept.Receive() {
                Result::Ok(text) => {
                    if text != "item " + DiagDecimal(expected) {
                        Core.Output.WriteLine("wrapped payload mismatch <" + text + ">");
                        return Result::Ok(-2_i64);
                    }
                    expected = expected + 1_i64;
                },
                Result::Error(_) => { open = false; },
            };
        }
        producer.Join();
        keeper.Join();
        return Result::Ok(expected);
    });
    if ScopeValue(result) != 32_i64 { return -1_i64; }
    return Collected();
}
