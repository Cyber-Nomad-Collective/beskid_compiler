enum DisposeError { Failed(i64 code) }
enum Result<T, E> { Ok(T value), Error(E error) }
contract Disposable { Result<unit, DisposeError> Dispose(); }
[Extern(Abi:"C")]
pub contract Probe { unit gc_collect(); }

type Resource: Disposable {
    i64[] trace,
    i64 digit,
    bool fail,
    pub Result<unit, DisposeError> Dispose() {
        i64[] log = trace;
        Probe.gc_collect();
        log[0] = log[0] * 10_i64 + digit;
        if fail { return Result::Error(DisposeError::Failed(digit)); }
        return Result::Ok(());
    }
}

Result<i64, DisposeError> ReturnNested(i64[] trace, bool failOuter, bool failInner) {
    use Resource outer = Resource { trace: trace, digit: 1_i64, fail: failOuter };
    if true {
        use Resource inner = Resource { trace: trace, digit: 2_i64, fail: failInner };
        return Result::Ok(7_i64);
    }
    return Result::Ok(0_i64);
}

Result<i64, DisposeError> Fallthrough(i64[] trace, bool failInner) {
    use Resource outer = Resource { trace: trace, digit: 1_i64, fail: false };
    if true {
        use Resource inner = Resource { trace: trace, digit: 2_i64, fail: failInner };
    }
    trace[0] = trace[0] * 10_i64 + 3_i64;
    return Result::Ok(7_i64);
}

Result<i64, DisposeError> Propagate(i64[] trace, Result<i64, DisposeError> operand, bool failInner) {
    use Resource outer = Resource { trace: trace, digit: 1_i64, fail: false };
    use Resource inner = Resource { trace: trace, digit: 2_i64, fail: failInner };
    i64 value = operand?;
    return Result::Ok(value);
}

Result<i64, DisposeError> Structured(i64[] trace) {
    use Resource outer = Resource { trace: trace, digit: 1_i64, fail: false };
    mut i64 iteration = 0_i64;
    while iteration < 2_i64 {
        use Resource inner = Resource { trace: trace, digit: 2_i64, fail: false };
        iteration = iteration + 1_i64;
        if iteration == 1_i64 { continue; }
        break;
    }
    return Result::Ok(7_i64);
}

Result<i64, DisposeError> ValueBlock(i64[] trace) {
    use Resource outer = Resource { trace: trace, digit: 1_i64, fail: false };
    i64 value = { use Resource inner = Resource { trace: trace, digit: 2_i64, fail: false }; 7_i64; };
    trace[0] = trace[0] * 10_i64 + 3_i64;
    return Result::Ok(value);
}

Result<i64, DisposeError> RangeStructured(i64[] trace) {
    use Resource outer = Resource { trace: trace, digit: 1_i64, fail: false };
    for iteration in range(0_i64, 3_i64) {
        use Resource inner = Resource { trace: trace, digit: 2_i64, fail: false };
        if iteration == 0_i64 { continue; }
        break;
    }
    return Result::Ok(7_i64);
}

Result<i64, DisposeError> ManagedValueBlock(i64[] trace, bool failInner) {
    use Resource outer = Resource { trace: trace, digit: 1_i64, fail: false };
    i64[] values = { use Resource inner = Resource { trace: trace, digit: 2_i64, fail: failInner }; [7_i64]; };
    return Result::Ok(values[0]);
}

Result<i64, DisposeError> ExplicitBlock(i64[] trace, i64 mode, Result<i64, DisposeError> operand) {
    use Resource outer = Resource { trace: trace, digit: 1_i64, fail: false };
    mut i64 iteration = 0_i64;
    while iteration < 2_i64 {
        use (Resource inner = Resource { trace: trace, digit: 2_i64, fail: mode == 5_i64 }) {
            iteration = iteration + 1_i64;
            if mode == 1_i64 { return Result::Ok(7_i64); }
            if mode == 2_i64 {
                i64 failed = operand?;
            }
            if mode == 3_i64 { continue; }
            if mode == 4_i64 { break; }
            if mode == 6_i64 {
                use Resource nested = Resource { trace: trace, digit: 3_i64, fail: false };
                return Result::Ok(7_i64);
            }
        }
        trace[0] = trace[0] * 10_i64 + 3_i64;
    }
    return Result::Ok(7_i64);
}

enum DomainError { Converted(i64 code) }
[CleanupConversion]
DomainError ConvertCleanup(DisposeError error) {
    Probe.gc_collect();
    return match error { DisposeError::Failed(code) => DomainError::Converted(code + 100_i64), };
}

Result<i64, DomainError> ConvertedCleanup(i64[] trace) {
    use Resource outer = Resource { trace: trace, digit: 1_i64, fail: true };
    use Resource inner = Resource { trace: trace, digit: 2_i64, fail: true };
    return Result::Ok(7_i64);
}

i64 ConvertedValue(Result<i64, DomainError> result) {
    return match result { Result::Ok(value) => value, Result::Error(DomainError::Converted(code)) => -code, };
}

i64 Value(Result<i64, DisposeError> result) {
    return match result { Result::Ok(value) => value, Result::Error(DisposeError::Failed(code)) => -code, };
}

[Export(Abi:"C", Symbol:"RunCleanupFixture")]
pub i64 RunCleanupFixture() {
    i64[] trace = [0_i64];
    if Value(ReturnNested(trace, false, false)) != 7_i64 { return 101_i64; }
    if trace[0] != 21_i64 { return 102_i64; }
    trace[0] = 0_i64;
    if Value(ReturnNested(trace, true, true)) != -2_i64 { return 103_i64; }
    if trace[0] != 21_i64 { return 104_i64; }
    trace[0] = 0_i64;
    if Value(Fallthrough(trace, false)) != 7_i64 { return 105_i64; }
    if trace[0] != 231_i64 { return 106_i64; }
    trace[0] = 0_i64;
    if Value(Fallthrough(trace, true)) != -2_i64 { return 107_i64; }
    if trace[0] != 21_i64 { return 108_i64; }
    trace[0] = 0_i64;
    Result<i64, DisposeError> error = Result::Error(DisposeError::Failed(9_i64));
    if Value(Propagate(trace, error, false)) != -9_i64 { return 109_i64; }
    if trace[0] != 21_i64 { return 110_i64; }
    trace[0] = 0_i64;
    if Value(Propagate(trace, error, true)) != -2_i64 { return 111_i64; }
    if trace[0] != 21_i64 { return 112_i64; }
    trace[0] = 0_i64;
    if Value(Structured(trace)) != 7_i64 { return 113_i64; }
    if trace[0] != 221_i64 { return 114_i64; }
    trace[0] = 0_i64;
    if Value(ValueBlock(trace)) != 7_i64 { return 115_i64; }
    if trace[0] != 231_i64 { return 116_i64; }
    trace[0] = 0_i64;
    if Value(ManagedValueBlock(trace, false)) != 7_i64 { return 117_i64; }
    if trace[0] != 21_i64 { return 118_i64; }
    trace[0] = 0_i64;
    if Value(ManagedValueBlock(trace, true)) != -2_i64 { return 119_i64; }
    if trace[0] != 21_i64 { return 120_i64; }
    trace[0] = 0_i64;
    if ConvertedValue(ConvertedCleanup(trace)) != -102_i64 { return 121_i64; }
    if trace[0] != 21_i64 { return 122_i64; }
    trace[0] = 0_i64;
    if Value(RangeStructured(trace)) != 7_i64 { return 123_i64; }
    if trace[0] != 221_i64 { return 124_i64; }
    trace[0] = 0_i64;
    if Value(ExplicitBlock(trace, 0_i64, error)) != 7_i64 { return 125_i64; }
    if trace[0] != 23231_i64 { return 126_i64; }
    trace[0] = 0_i64;
    if Value(ExplicitBlock(trace, 1_i64, error)) != 7_i64 { return 127_i64; }
    if trace[0] != 21_i64 { return 128_i64; }
    trace[0] = 0_i64;
    if Value(ExplicitBlock(trace, 2_i64, error)) != -9_i64 { return 129_i64; }
    if trace[0] != 21_i64 { return 130_i64; }
    trace[0] = 0_i64;
    if Value(ExplicitBlock(trace, 3_i64, error)) != 7_i64 { return 131_i64; }
    if trace[0] != 221_i64 { return 132_i64; }
    trace[0] = 0_i64;
    if Value(ExplicitBlock(trace, 4_i64, error)) != 7_i64 { return 133_i64; }
    if trace[0] != 21_i64 { return 134_i64; }
    trace[0] = 0_i64;
    if Value(ExplicitBlock(trace, 5_i64, error)) != -2_i64 { return 135_i64; }
    if trace[0] != 21_i64 { return 136_i64; }
    trace[0] = 0_i64;
    if Value(ExplicitBlock(trace, 6_i64, error)) != 7_i64 { return 137_i64; }
    if trace[0] != 321_i64 { return 138_i64; }
    return 42_i64;
}
