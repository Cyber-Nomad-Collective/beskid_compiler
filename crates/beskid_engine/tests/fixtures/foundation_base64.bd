use Core.Encoding.Base64;
use Core.Encoding.EncodingError;
use Core.Results;

bool Rejected(u8[] input) {
    Result<u8[], EncodingError> result = Base64.DecodeBytes(input);
    return match result { Result::Ok(_) => false, Result::Error(_) => true };
}
i64 CheckBytes(u8[] bytes) {
    if bytes[0] != 102_u8 || bytes[1] != 111_u8 || bytes[2] != 111_u8 || bytes[3] != 98_u8 { return 8_i64; }
    return 42_i64;
}
pub i64 RunFoundationFixture() {
    if !Rejected([90_u8, 104_u8, 61_u8, 61_u8]) { return 1_i64; }
    if !Rejected([90_u8, 109_u8, 57_u8, 61_u8]) { return 2_i64; }
    if !Rejected([90_u8, 103_u8, 61_u8, 61_u8, 90_u8, 109_u8, 57_u8, 118_u8]) { return 3_i64; }
    if !Rejected([90_u8, 61_u8, 61_u8, 61_u8]) { return 4_i64; }
    if !Rejected([90_u8, 103_u8, 61_u8, 65_u8]) { return 5_i64; }
    if !Rejected([90_u8, 103_u8]) { return 6_i64; }
    if !Rejected([90_u8, 103_u8, 32_u8, 61_u8]) { return 7_i64; }
    u8[] encoded = [90_u8, 109_u8, 57_u8, 118_u8, 89_u8, 103_u8, 61_u8, 61_u8];
    Result<u8[], EncodingError> decoded = Base64.DecodeBytes(encoded);
    return match decoded {
        Result::Ok(bytes) => CheckBytes(bytes),
        Result::Error(_) => 9_i64,
    };
}
