bool IsCloseOk(Result<unit, IoError> result) {
    return match result {
        Result::Ok(_) => true,
        Result::Error(_) => false,
    };
}
bool IsCloseFailure(Result<unit, IoError> result) {
    return match result {
        Result::Ok(_) => false,
        Result::Error(error) => match error {
            IoError::CloseFailed() => true, IoError::InvalidRange() => false,
            IoError::UnexpectedEof(_) => false, IoError::NoProgress() => false,
            IoError::ReadFailed() => false, IoError::WriteFailed() => false,
        },
    };
}
Result<unit, IoError> CloseTwice(Closer closer) {
    Result<unit, IoError> first = closer.Close();
    Result<unit, IoError> second = closer.Close();
    return match first {
        Result::Ok(_) => second,
        Result::Error(error) => Result::Error(error),
    };
}
bool FirstFailureThenSecondCloseIsOk(Closer closer) {
    Result<unit, IoError> first = closer.Close();
    Result<unit, IoError> second = closer.Close();
    return IsCloseFailure(first) && IsCloseOk(second);
}
i64 ThroughStream(Stream stream) {
