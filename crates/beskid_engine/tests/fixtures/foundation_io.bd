i64 IoResultCode(Result<i64, IoError> result) {
    return match result {
        Result::Ok(value) => value,
        Result::Error(error) => match error {
            IoError::ReadFailed() => -1_i64, IoError::CloseFailed() => -2_i64,
            IoError::InvalidRange() => -3_i64, IoError::UnexpectedEof(_) => -4_i64,
            IoError::NoProgress() => -5_i64, IoError::WriteFailed() => -6_i64,
        },
    };
}
bool IsRange(Result<unit, IoError> result) {
    return match result {
        Result::Ok(_) => false,
        Result::Error(error) => match error {
            IoError::InvalidRange() => true, IoError::UnexpectedEof(_) => false,
            IoError::NoProgress() => false, IoError::ReadFailed() => false,
            IoError::WriteFailed() => false, IoError::CloseFailed() => false,
