        lifecycle[0] = 1_i64;
        lifecycle[1] = lifecycle[1] + 1_i64;
        if digit != 0_i64 { releaseTrace[0] = releaseTrace[0] * 10_i64 + digit; }
        if lifecycle[2] != 0_i64 { return Result::Error(IoError::CloseFailed()); }
        return Result::Ok(());
