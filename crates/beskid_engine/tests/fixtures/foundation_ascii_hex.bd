use Core.Encoding;
use Core.Encoding.Hex;
use Core.Encoding.EncodingError;
use Core.Results;
use Core.String;

bool RejectedHex(u8[] input) {
    Result<u8[], EncodingError> result = Hex.DecodeBytes(input);
    return match result { Result::Ok(_) => false, Result::Error(_) => true };
}
i64 CheckHex(u8[] bytes) {
    if bytes[0] != 0_u8 || bytes[1] != 127_u8 || bytes[2] != 255_u8 { return 4_i64; }
    return 42_i64;
}
[Export(Abi:"C", Symbol:"RunFoundationFixture")]
pub i64 RunFoundationFixture() {
    Result<string, EncodingError> invalid = Encoding.DecodeHttpAscii([128_u8]);
    bool rejected = match invalid { Result::Ok(_) => false, Result::Error(_) => true };
    if !rejected { return 1_i64; }
    if !RejectedHex([48_u8]) || !RejectedHex([48_u8, 103_u8]) { return 2_i64; }
    Result<string, EncodingError> valid = Encoding.DecodeHttpAscii([72_u8, 84_u8, 84_u8, 80_u8, 47_u8, 49_u8, 46_u8, 49_u8, 13_u8, 10_u8]);
    i64 length = match valid { Result::Ok(text) => String.Len(text), Result::Error(_) => 0_i64 };
    if length != 10_i64 { return 3_i64; }
    Result<u8[], EncodingError> decoded = Hex.DecodeBytes([48_u8, 48_u8, 55_u8, 70_u8, 102_u8, 102_u8]);
    return match decoded { Result::Ok(bytes) => CheckHex(bytes), Result::Error(_) => 5_i64 };
}
