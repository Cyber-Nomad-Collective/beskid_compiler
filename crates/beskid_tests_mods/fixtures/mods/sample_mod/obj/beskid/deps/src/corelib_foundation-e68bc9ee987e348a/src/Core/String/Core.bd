/// Core string helpers backed by runtime builtins (`__str_len`, `__str_slice`).
use Core.Bytes.Slice;

/// Returns the number of UTF-8 code units in text.
pub i64 Len(string text) {
    return i64(__str_len(text));
}

/// Returns true when text is empty.
pub bool IsEmpty(string text) {
    return Len(text) == 0;
}

/// Returns the zero-based byte index of `needle` in `haystack` starting at `start`, or `-1`.
pub i64 IndexOfFrom(string haystack, mut i64 start, string needle) {
    i64 hlen = Len(haystack);
    i64 nlen = Len(needle);
    if nlen == 0 {
        return start;
    }
    if start < 0 {
        start = 0;
    }
    mut i64 i = start;
    while !(i + nlen > hlen) {
        mut i64 j = 0;
        mut bool matched = true;
        while j < nlen {
            if ByteAt(haystack, i + j) != ByteAt(needle, j) {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Returns true when `needle` occurs as a substring of `text`.
pub bool Contains(string text, string needle) {
    return !(IndexOfFrom(text, 0, needle) < 0);
}

/// Returns a substring of `text` starting at byte `start` with `count` code units.
pub string SubSlice(string text, i64 start, i64 count) {
    return __str_slice(text, start, count);
}

/// Trims ASCII space, tab, and carriage return from both ends.
pub string Trim(string text) {
    i64 len = Len(text);
    mut i64 start = 0;
    while start < len {
        u8 b = ByteAt(text, start);
        if b != 32 && b != 9 && b != 13 {
            break;
        }
        start = start + 1;
    }
    mut i64 end = len;
    while end > start {
        u8 b = ByteAt(text, end - 1);
        if b != 32 && b != 9 && b != 13 {
            break;
        }
        end = end - 1;
    }
    if start >= end {
        return "";
    }
    return SubSlice(text, start, end - start);
}

/// Returns the byte at the given zero-based index in the UTF-8 representation.
/// Out-of-bounds access triggers a runtime error.
pub u8 ByteAt(string text, i64 index) {
    return text[index];
}
