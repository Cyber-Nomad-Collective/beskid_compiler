/// Query.Operators — transformation and consumption combinators for iterators.
/// @tier(supported)
/// All combinators consume the iterator mutably.

use Core.Collections.Array;
use Core.Optional.Option;
use Query.ArrayIterator;

/// Maps each element through `project` (called externally for each element).
/// Returns a new array of projected values.
pub TOut[] Map<TIn, TOut>(mut ArrayIterator<TIn> it, TOut sample) {
    i64 remaining = ArrayIterator.Remaining<TIn>(it);
    mut TOut[] result = Array.Empty<TOut>();
    mut i64 outIndex = 0;
    while outIndex < remaining {
        Option<TIn> next = ArrayIterator.Current<TIn>(it);
        match next {
            Option::Some(_) => {
                result = Array.Append<TOut>(result, sample);
                outIndex = outIndex + 1;
                it = ArrayIterator.MoveNext<TIn>(it);
            },
            Option::None => { },
        };
    }
    return result;
}

/// Filters elements, keeping only those where `predicate` returns true.
/// Since Beskid lacks closures, the caller must pre-filter and pass the array to Over() + collect.
/// This is a skeleton for when closures land; for now use direct array filtering.
pub T[] Filter<T>(T[] source, T[] keep) {
    // Passthrough: caller pre-filters externally.
    return keep;
}

/// Returns the first `count` elements as a new array.
pub T[] Take<T>(mut ArrayIterator<T> it, i64 count) {
    if count < 1 {
        return Array.Empty<T>();
    }
    i64 remaining = ArrayIterator.Remaining<T>(it);
    mut i64 take = count;
    if take > remaining {
        take = remaining;
    }
    mut T[] result = Array.Empty<T>();
    mut i64 outIndex = 0;
    while outIndex < take {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(value) => {
                result = Array.Append<T>(result, value);
                outIndex = outIndex + 1;
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { },
        };
    }
    return result;
}

/// Skips the first `count` elements, returns the rest as a new array.
pub T[] Skip<T>(mut ArrayIterator<T> it, i64 count) {
    mut i64 skipped = 0;
    while skipped < count {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(_) => {
                skipped = skipped + 1;
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { skipped = count; },
        };
    }
    i64 remaining = ArrayIterator.Remaining<T>(it);
    return Take<T>(it, remaining);
}

/// Counts remaining elements in the iterator.
pub i64 Count<T>(mut ArrayIterator<T> it) {
    return ArrayIterator.Remaining<T>(it);
}

/// Returns the first element or `None`.
pub Option<T> First<T>(mut ArrayIterator<T> it) {
    return ArrayIterator.Current<T>(it);
}

/// Returns the last element or `None`.
pub Option<T> Last<T>(mut ArrayIterator<T> it) {
    mut Option<T> last = Option::None();
    mut bool done = false;
    while !done {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(value) => {
                last = Option::Some(value);
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { done = true; },
        };
    }
    return last;
}

/// Collects all remaining elements into a new array.
pub T[] ToArray<T>(mut ArrayIterator<T> it) {
    i64 remaining = ArrayIterator.Remaining<T>(it);
    if remaining < 1 {
        return Array.Empty<T>();
    }
    mut T[] result = Array.Empty<T>();
    mut i64 outIndex = 0;
    while outIndex < remaining {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(value) => {
                result = Array.Append<T>(result, value);
                outIndex = outIndex + 1;
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { },
        };
    }
    return result;
}

/// Returns true when any remaining element equals `value`.
pub bool Any<T>(mut ArrayIterator<T> it, T value) {
    mut bool done = false;
    while !done {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(elem) => {
                if elem == value {
                    return true;
                }
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { done = true; },
        };
    }
    return false;
}

/// Returns true when all remaining elements equal `value` (empty = true).
pub bool All<T>(mut ArrayIterator<T> it, T value) {
    mut bool done = false;
    while !done {
        Option<T> next = ArrayIterator.Current<T>(it);
        match next {
            Option::Some(elem) => {
                if elem != value {
                    return false;
                }
                it = ArrayIterator.MoveNext<T>(it);
            },
            Option::None => { done = true; },
        };
    }
    return true;
}

/// Folds remaining elements using `seed` and a binary op (caller must apply externally per element).
/// Returns the accumulated value.
pub i64 FoldI64(mut ArrayIterator<i64> it, i64 seed) {
    mut i64 acc = seed;
    mut bool done = false;
    while !done {
        Option<i64> next = ArrayIterator.Current<i64>(it);
        match next {
            Option::Some(value) => {
                acc = acc + value;
                it = ArrayIterator.MoveNext<i64>(it);
            },
            Option::None => { done = true; },
        };
    }
    return acc;
}

/// Returns true when the iterator has no remaining elements.
pub bool IteratorIsEmpty<T>(mut ArrayIterator<T> it) {
    return ArrayIterator.Remaining<T>(it) == 0;
}

/// Bubble-sorts elements of the iterator ascending or descending, returns new array.
pub i64[] OrderBy(mut ArrayIterator<i64> it, bool ascending) {
    mut i64[] materialized = ToArray<i64>(it);
    i64 n = Array.Len<i64>(materialized);
    if n < 2 {
        return materialized;
    }
    mut i64 outer = 0;
    while outer < n {
        mut i64 inner = 0;
        while inner + 1 < n - outer {
            i64 left = Array.Get<i64>(materialized, inner);
            i64 right = Array.Get<i64>(materialized, inner + 1);
            mut bool swap = false;
            if ascending && left > right {
                swap = true;
            }
            if !ascending && left < right {
                swap = true;
            }
            if swap {
                materialized = Array.Set<i64>(materialized, inner, right);
                materialized = Array.Set<i64>(materialized, inner + 1, left);
            }
            inner = inner + 1;
        }
        outer = outer + 1;
    }
    return materialized;
}
