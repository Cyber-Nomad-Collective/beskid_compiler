/// Core.IO owns partial transfer, exact/all loops, EOF, progress and close policy.
/// Partial F6 checkpoint: execution requires static contract-parameter specialization.
/// Compiler foundation_io_native regressions intentionally remain failing until it exists.
/// @tier(standard)
pub mod Core.IO.Reader;
pub mod Core.IO.Writer;
pub mod Core.IO.Closer;
pub mod Core.IO.Stream;
pub mod Core.IO.IoError;

use Core.IO.Reader;
use Core.IO.Writer;
use Core.IO.IoError;
use Core.Bytes.Slice;
use Core.Disposable;
use Core.Results;

/// The explicit scoped-cleanup conversion for callables returning Result<T, IoError>.
[CleanupConversion]
pub IoError FromDisposeError(DisposeError error) {
    return IoError::CloseFailed();
}

pub Result<i64, IoError> Read(Reader reader, u8[] destination, i64 offset, i64 count) {
    if !Slice.IsValidRange(Slice.Len(destination), offset, count) { return Result::Error(IoError::InvalidRange()); }
    if count == 0_i64 { return Result::Ok(0_i64); }
    Result<i64, IoError> result = reader.Read(destination, offset, count);
    return match result {
        Result::Error(error) => Result::Error(error),
        Result::Ok(completed) => {
            if completed < 0_i64 || completed > count { return Result::Error(IoError::ReadFailed()); }
            Result::Ok(completed);
        },
    };
}

pub Result<i64, IoError> Write(Writer writer, u8[] source, i64 offset, i64 count) {
    if !Slice.IsValidRange(Slice.Len(source), offset, count) { return Result::Error(IoError::InvalidRange()); }
    if count == 0_i64 { return Result::Ok(0_i64); }
    Result<i64, IoError> result = writer.Write(source, offset, count);
    return match result {
        Result::Error(error) => Result::Error(error),
        Result::Ok(completed) => {
            if completed < 0_i64 || completed > count { return Result::Error(IoError::WriteFailed()); }
            Result::Ok(completed);
        },
    };
}

pub Result<unit, IoError> ReadExact(Reader reader, u8[] destination, i64 offset, i64 count) {
    if !Slice.IsValidRange(Slice.Len(destination), offset, count) { return Result::Error(IoError::InvalidRange()); }
    mut i64 completed = 0_i64;
    while completed < count {
        i64 nextOffset = offset + completed;
        i64 remaining = count - completed;
        Result<i64, IoError> result = Read(reader, destination, nextOffset, remaining);
        match result {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(progress) => {
                if progress == 0_i64 { return Result::Error(IoError::UnexpectedEof(completed)); }
                completed = completed + progress;
            },
        };
    }
    return Result::Ok(());
}

pub Result<unit, IoError> WriteAll(Writer writer, u8[] source, i64 offset, i64 count) {
    if !Slice.IsValidRange(Slice.Len(source), offset, count) { return Result::Error(IoError::InvalidRange()); }
    mut i64 completed = 0_i64;
    while completed < count {
        i64 nextOffset = offset + completed;
        i64 remaining = count - completed;
        Result<i64, IoError> result = Write(writer, source, nextOffset, remaining);
        match result {
            Result::Error(error) => { return Result::Error(error); },
            Result::Ok(progress) => {
                if progress == 0_i64 { return Result::Error(IoError::NoProgress()); }
                completed = completed + progress;
            },
        };
    }
    return Result::Ok(());
}
