/// Query.ArrayIterator — concrete iterator over T[] slices.
/// @tier(supported)

use Core.Collections.Array;
use Core.Optional.Option;
use Query.Iterator;

/// Iterator state for T[] traversal — implements `Iterator<T>`.
pub type ArrayIterator<T> {
    T[] source,
    i64 index,
    i64 length,
}

/// Creates an iterator over `source`.
pub ArrayIterator<T> Over<T>(T[] source) {
    i64 length = Array.Len<T>(source);
    return ArrayIterator<T> { source: source, index: 0, length: length };
}

/// Returns the current element without advancing.
pub Option<T> Current<T>(ArrayIterator<T> it) {
    if it.index >= it.length {
        return Option::None();
    }
    return Option::Some(Array.Get<T>(it.source, it.index));
}

/// Advances the iterator by one element.
pub ArrayIterator<T> MoveNext<T>(ArrayIterator<T> it) {
    if it.index >= it.length {
        return it;
    }
    return ArrayIterator<T> { source: it.source, index: it.index + 1, length: it.length };
}

/// Returns the number of remaining elements.
pub i64 Remaining<T>(ArrayIterator<T> it) {
    if it.index >= it.length {
        return 0;
    }
    return it.length - it.index;
}

/// Resets the iterator to the beginning.
pub ArrayIterator<T> Reset<T>(ArrayIterator<T> it) {
    return ArrayIterator<T> { source: it.source, index: 0, length: it.length };
}
