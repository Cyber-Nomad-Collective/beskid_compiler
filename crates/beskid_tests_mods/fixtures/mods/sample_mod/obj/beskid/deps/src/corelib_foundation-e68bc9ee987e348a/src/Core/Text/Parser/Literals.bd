/// Literal and primitive character parsers.
use Core.Text.Cursor;
use Core.Text.Parser.Result;
use Core.String;

pub TextParseResult<string> Fail(Cursor.TextCursor c, ParseErrorKind kind, string rule) {
    ParseError err = ParseError { offset: Cursor.Position(c), kind: kind, rule: rule };
    return TextParseResult::Err(err);
}

pub TextParseResult<string> Text(Cursor.TextCursor c, string text, string rule) {
    if Cursor.StartsWith(c, text) {
        i64 n = String.Len(text);
        Cursor.TextCursor rest = Cursor.Advance(c, n);
        return Result.Success<string>(text, rest);
    }
    return Fail(c, ParseErrorKind::ExpectedLiteral(rule), rule);
}

pub TextParseResult<string> Char(Cursor.TextCursor c, string ch, string rule) {
    return Text(c, ch, rule);
}

pub TextParseResult<string> Any(Cursor.TextCursor c, string rule) {
    if Cursor.AtEnd(c) {
        return Fail(c, ParseErrorKind::ExpectedRule(rule), rule);
    }
    string ch = Cursor.Slice(c, c.pos, 1);
    Cursor.TextCursor rest = Cursor.Advance(c, 1);
    return Result.Success<string>(ch, rest);
}

pub TextParseResult<string> Eof(Cursor.TextCursor c, string rule) {
    if Cursor.AtEnd(c) {
        return Result.Success<string>("", c);
    }
    return Fail(c, ParseErrorKind::ExpectedRule(rule), rule);
}

pub TextParseResult<string> Satisfy(Cursor.TextCursor c, string rule) {
    return Any(c, rule);
}
