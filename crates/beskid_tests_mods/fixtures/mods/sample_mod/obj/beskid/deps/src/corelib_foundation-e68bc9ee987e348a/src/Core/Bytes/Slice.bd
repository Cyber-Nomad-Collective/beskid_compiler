use Core.Collections.Array;

/// Allocates a zero-filled byte buffer with `len` elements.
/// @tier(standard)
/// @returns A descriptor-backed `u8[]` managed by the canonical array protocol.
pub u8[] New(i64 len) {
    mut u8[] result = Array.Empty<u8>();
    if len <= 0 {
        return result;
    }
    mut i64 i = 0;
    while i < len {
        Array.Append<u8>(result, u8(0));
        i = i + 1;
    }
    return result;
}

/// Returns element count of a byte buffer.
pub i64 Len(u8[] handle) {
    return Array.Len<u8>(handle);
}

pub bool IsEmpty(u8[] handle) {
    return Len(handle) == 0;
}

/// Checks a range before arithmetic, allocation, copying, or I/O can occur.
pub bool IsValidRange(i64 length, i64 offset, i64 count) {
    if offset < 0 || count < 0 { return false; }
    if count > 9223372036854775807_i64 - offset { return false; }
    return offset + count <= length;
}

/// Returns the byte at `index`.
pub u8 Get(u8[] handle, i64 index) {
    return handle[index];
}

pub u8[] Set(u8[] handle, i64 index, u8 value) {
    handle[index] = value;
    return handle;
}

pub unit Copy(u8[] dst, i64 dstOff, u8[] src, i64 srcOff, i64 len) {
    if !IsValidRange(Len(dst), dstOff, len) || !IsValidRange(Len(src), srcOff, len) {
        __panic(2_i64);
    }
    if len == 0 {
        return;
    }
    if dstOff > srcOff {
        mut i64 i = len;
        while i > 0 {
            i = i - 1;
            dst[dstOff + i] = src[srcOff + i];
        }
        return;
    }
    mut i64 i = 0;
    while i < len {
        dst[dstOff + i] = src[srcOff + i];
        i = i + 1;
    }
    return;
}

pub i64 Compare(u8[] left, u8[] right) {
    i64 leftLen = Len(left);
    i64 rightLen = Len(right);
    mut i64 shared = leftLen;
    if rightLen < shared {
        shared = rightLen;
    }
    mut i64 i = 0;
    while i < shared {
        u8 leftByte = left[i];
        u8 rightByte = right[i];
        if leftByte < rightByte {
            return -1;
        }
        if leftByte > rightByte {
            return 1;
        }
        i = i + 1;
    }
    if leftLen < rightLen {
        return -1;
    }
    if leftLen > rightLen {
        return 1;
    }
    return 0;
}

pub u8[] Fill(u8[] handle, i64 offset, i64 len, u8 value) {
    mut i64 i = 0;
    while i < len {
        Set(handle, offset + i, value);
        i = i + 1;
    }
    return handle;
}

pub u8[] SubSlice(u8[] handle, mut i64 offset, mut i64 count) {
    i64 total = Len(handle);
    if offset < 0 {
        offset = 0;
    }
    if count < 0 {
        count = 0;
    }
    if offset > total {
        return New(0);
    }
    i64 available = total - offset;
    if count > available {
        count = available;
    }
    u8[] buf = New(count);
    if count > 0 {
        Copy(buf, 0, handle, offset, count);
    }
    return buf;
}
