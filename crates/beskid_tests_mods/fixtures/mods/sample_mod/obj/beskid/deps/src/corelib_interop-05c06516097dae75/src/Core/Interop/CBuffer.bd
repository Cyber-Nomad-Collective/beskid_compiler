/// C ABI byte buffer view: a length-associated byte range passed across the
/// FFI boundary.
///
/// `CBuffer` carries a pointer and length. Ownership is tracked separately
/// by the `Interop.Contracts` ownership class. Beskid `u8[]` values MUST
/// NOT cross the user FFI boundary as ordinary GC references; they cross as
/// `CBuffer`.
pub type CBuffer {
    pub pointer ptr;
    pub i64 len;
}

/// Constructs a buffer view from a pointer and length.
pub CBuffer New(pointer ptr, i64 len) {
    return CBuffer { ptr: ptr, len: len };
}

/// Returns the pointer field.
pub pointer Ptr(CBuffer view) {
    return view.ptr;
}

/// Returns the length field.
pub i64 Len(CBuffer view) {
    return view.len;
}

/// Returns true when the buffer is empty.
pub bool IsEmpty(CBuffer view) {
    return view.len == 0;
}
