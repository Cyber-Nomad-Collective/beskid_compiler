/// Non-blocking operation outcome: success, error, or would-block.
/// Replaces the nested `Option<Result<T, E>>` pattern for `Try*` operations.
pub enum TryResult<TValue, TError> {
    /// Operation succeeded; carries the value.
    Ok(TValue value),
    /// Operation failed (closed or cancelled); carries the error.
    Err(TError error),
    /// Operation would block; no value or error.
    WouldBlock,
}
