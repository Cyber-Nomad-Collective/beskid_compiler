/// Stdio bridge fiber: a cooperative `Fiber` generated by the glue system from
/// `[GlueImport]` attributes that proxies calls between the Beskid runtime
/// and a foreign library over a stdio message protocol.
///
/// The bridge owns a registry of `GlueTag` objects, one per imported library,
/// and routes messages by tag. 0.4: declaration only. The stdio message
/// protocol implementation lands in 0.5.
use Core.Glue.GlueTag;

/// A stdio bridge message: a tag identifying the target library and a payload
/// buffer carrying the encoded call.
pub type StdioBridgeMessage {
    pub GlueTag tag;
    pub u8[] payload;
}

/// Constructs a stdio bridge message.
pub StdioBridgeMessage New(GlueTag tag, u8[] payload) {
    return StdioBridgeMessage { tag: tag, payload: payload };
}

/// Returns the target library tag.
pub GlueTag Tag(StdioBridgeMessage message) {
    return message.tag;
}

/// Returns the payload buffer.
pub u8[] Payload(StdioBridgeMessage message) {
    return message.payload;
}

/// Marks a type or function as a glue entry point. The glue mod uses this
/// attribute to select the backend and configure per-type glue rules.
pub attribute Glue(TypeDefinition, FunctionDefinition) {
    backend: string,
}

/// Marks a contract or function as an imported foreign library binding. The
/// glue mod generates a stdio bridge fiber tag for each `[GlueImport]`.
pub attribute GlueImport(ContractDefinition, FunctionDefinition) {
    library: string,
}

/// Marks a function as exported to a foreign library through the glue layer.
pub attribute GlueExport(FunctionDefinition) {
    library: string,
}
