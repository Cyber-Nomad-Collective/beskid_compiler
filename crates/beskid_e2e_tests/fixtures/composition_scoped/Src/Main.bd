// Every registration declared in a named scope is created anew on each `with` activation:
// sequential activations and a nested activation of the same scope each get their own set. A
// `transient` of the scope that injects the scoped `Session` and the scope's `single` `Ledger`
// sees the activation's own instances, the ones the scope's hooks receive: a scope `single` is
// one per activation, shared within it.
use Core.Output;

contract Session
{
    i64 Id();
}

contract Ledger
{
    i64 Entries();
}

type Book : Ledger
{
    pub i64 Entries()
    {
        return 0;
    }
}

type DbSession : Session
{
    pub i64 Id()
    {
        return 7;
    }
}

type Report
{
    inject Session session;
    inject Ledger ledger;

    pub string Matches(Session other, Ledger book)
    {
        if (this.session == other && this.ledger == book)
        {
            return "same";
        }
        return "different";
    }
}

host AppHost()
{
    scope Visit(i64 visit)
    {
        DbSession for Session;
        single Book for Ledger;
        transient Report;

        init(Session session, Ledger ledger, Report report)
        {
            Output.WriteLine("init ${visit} ${report.Matches(session, ledger)}");
        }

        dispose(Session session, Ledger ledger, Report report)
        {
            Output.WriteLine("dispose ${visit} ${report.Matches(session, ledger)}");
        }
    }
}

i32 Main()
{
    launch AppHost();
    with Visit(1)
    {
        Output.WriteLine("body 1");
    }
    with Visit(2)
    {
        with Visit(3)
        {
            Output.WriteLine("body 3");
        }
    }
    return 0;
}
