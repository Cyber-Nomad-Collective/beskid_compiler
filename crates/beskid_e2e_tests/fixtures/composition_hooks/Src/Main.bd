// Host hooks run at run time: `startup` once after launch, scope `init` before each `with`
// body, scope `dispose` after it (also on an early return), and the global `dispose` last.
// Hook parameters come from the registry, contract-typed or concrete. `Say` has a
// caller-information parameter: the compiler fills it at every call, also inside hook bodies.
use Core.Output;

unit Say(string text, [CallerLineNumber] i64 line = 0)
{
    Output.WriteLine(text);
}

contract Greeter
{
    string Greet();
}

type PoliteGreeter : Greeter
{
    pub string Greet()
    {
        return "hello";
    }
}

type Reception
{
    inject Greeter greeter;

    pub string Welcome()
    {
        return this.greeter.Greet();
    }
}

host AppHost()
{
    registry
    {
        single PoliteGreeter for Greeter;
        single Reception;
    }

    startup(Reception reception, Greeter greeter)
    {
        Say("startup ${reception.Welcome()} ${greeter.Greet()}");
    }

    dispose()
    {
        Output.WriteLine("shutdown");
    }

    scope Visit()
    {
        init(Greeter greeter)
        {
            Say("init ${greeter.Greet()}");
        }

        dispose()
        {
            Output.WriteLine("dispose");
        }
    }
}

bool Early()
{
    return true;
}

i32 Main()
{
    Output.WriteLine("before launch");
    launch AppHost();
    with Visit()
    {
        Output.WriteLine("inside with");
    }
    with Visit()
    {
        Output.WriteLine("early exit");
        if Early()
        {
            return 3;
        }
        Output.WriteLine("not reached");
    }
    return 0;
}
