// `T[][]` is an array whose elements are `T[]`, in locals, fields, parameters, return types, and
// generic arguments.
use Core.Collections.Array;

type Grid {
    i64[][] cells,
}

i64[][] Square(i64 size) {
    mut i64[][] rows = Array.Empty<i64[]>();
    mut i64 row = 0;
    while row < size {
        mut i64[] cells = Array.Empty<i64>();
        mut i64 column = 0;
        while column < size {
            Array.Append<i64>(cells, row * size + column);
            column = column + 1;
        }
        Array.Append<i64[]>(rows, cells);
        row = row + 1;
    }
    return rows;
}

i64 Total(i64[][] rows) {
    mut i64 total = 0;
    for row in rows {
        for value in row {
            total = total + value;
        }
    }
    return total;
}

i32 Main() {
    i64[][] literal = [[1, 2], [3, 4, 5]];
    if Array.Len<i64[]>(literal) != 2 || Array.Len<i64>(literal[1]) != 3 || literal[1][2] != 5 {
        return 1;
    }
    i64[][] square = Square(3);
    if Total(square) != 36 || square[2][1] != 7 {
        return 2;
    }
    // The struct literal takes `square` by move, so the write is observed through the field.
    Grid grid = Grid { cells: square };
    grid.cells[0][0] = 100;
    if grid.cells[0][0] != 100 || Total(grid.cells) != 136 {
        return 3;
    }
    string[][] words = [["a", "b"], ["c"]];
    if words[0][1] != "b" {
        return 4;
    }
    return 42;
}
