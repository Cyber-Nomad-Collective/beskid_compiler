use Runtime.Bootstrap.Lifecycle;
use Runtime.Bootstrap.Native;
use Runtime.Host.Composition;
use Testing.Assert;
use HostRuntimeSupport;
use Concurrency.Fiber;
use Runtime.Fiber.Scheduler.Core;
use Runtime.Fiber.Scheduler.Loop;

pub unit CompositionFiberScopeEntry(pointer state) {
    pointer container = NativePointer(raw_word_load(state));
    bool entered = CompositionScopeTryEnter(container, 1, 0);
    if entered { raw_word_store(pointer_add(state, 32), 1); }
    if !entered { return; }
    raw_word_store(pointer_add(state, 8), word(CompositionScopeDepth()));
    FiberYield();
    raw_word_store(pointer_add(state, 16), word(CompositionScopeDepth()));
    CompositionScopeLeave();
    raw_word_store(pointer_add(state, 24), word(CompositionScopeDepth()));
    return;
}

pub i64 SpawnCompositionFiberScopeEntry(pointer state) {
    Fiber<unit> child = spawn CompositionFiberScopeEntry(state);
    return child.handle;
}

test composition_activates_scopes_and_disposes_compiler_materialized_slots {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    memory_set(runtime, 0, 64);
    Assert.True(ProcessInit(runtime) == runtime, "runtime initialized");
    Assert.True(CurrentThreadState() != NativePointer(0), "process initialization attached the mutator");

    pointer container = CompositionContainerCreate(2);
    pointer first = SystemAllocate(8, 8);
    pointer second = SystemAllocate(8, 8);
    Assert.True(container != NativePointer(0), "container owns compiler-sized slot storage");
    Assert.True(CompositionSlotStore(container, 0, first), "compiler-selected slot zero is rooted");
    Assert.True(CompositionSlotStore(container, 1, second), "compiler-selected slot one is rooted");
    Assert.True(CompositionLaunch(container), "fully materialized plan activates");

    CompositionScopeEnter(container, 1, 0);
    CompositionScopeEnter(container, 2, 1);
    Assert.Equal(CompositionScopeDepth(), 2, "nested scopes are tracked by the current execution owner");
    CompositionScopeLeave();
    CompositionScopeLeave();
    Assert.Equal(CompositionScopeDepth(), 0, "scope leave restores TLS ownership");

    CompositionShutdown(container);
    CompositionContainerDrop(container);
    SystemFree(first, 8);
    SystemFree(second, 8);
    ProcessShutdown(runtime);
    SystemFree(runtime, 64);
    ResumeHostRuntime(hostRuntime);
}

test composition_rejects_unmaterialized_duplicate_and_out_of_range_slots {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    memory_set(runtime, 0, 64);
    ProcessInit(runtime);
    pointer container = CompositionContainerCreate(2);
    pointer service = SystemAllocate(8, 8);

    Assert.True(CompositionSlotStore(container, 0, service), "planned slot accepts one value");
    Assert.True(!CompositionSlotStore(container, 0, service), "planned slot is immutable after publication");
    Assert.True(!CompositionSlotStore(container, 2, service), "runtime rejects slots absent from compiler plan");
    Assert.True(!CompositionLaunch(container), "an unmaterialized slot prevents activation");
    Assert.True(CompositionSlotStore(container, 1, service), "missing planned slot can still be materialized");
    Assert.True(CompositionLaunch(container), "complete plan launches atomically");
    Assert.True(!CompositionSlotStore(container, 1, service), "active plan rejects mutation");
    Assert.True(!CompositionLaunch(container), "active plan cannot launch twice");

    CompositionShutdown(container);
    CompositionContainerDrop(container);
    SystemFree(service, 8);
    ProcessShutdown(runtime);
    SystemFree(runtime, 64);
    ResumeHostRuntime(hostRuntime);
}

test composition_rejects_plan_sizes_outside_the_compiler_runtime_contract {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    memory_set(runtime, 0, 64);
    Assert.True(ProcessInit(runtime) == runtime, "runtime initialized");
    Assert.True(CompositionContainerCreate(257) == NativePointer(0), "oversized compiler plans fail closed");
    ProcessShutdown(runtime);
    SystemFree(runtime, 64);
    ResumeHostRuntime(hostRuntime);
}

test composition_containers_keep_slots_and_activation_independent {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    memory_set(runtime, 0, 64);
    Assert.True(ProcessInit(runtime) == runtime, "runtime initialized");

    pointer first = CompositionContainerCreate(1);
    pointer second = CompositionContainerCreate(1);
    pointer firstService = SystemAllocate(8, 8);
    pointer secondService = SystemAllocate(8, 8);
    Assert.True(first != NativePointer(0) && second != NativePointer(0), "separate containers allocated");
    Assert.True(first != second, "each container owns its own state");
    Assert.True(CompositionSlotStore(first, 0, firstService), "first service installed");
    Assert.True(CompositionLaunch(first), "first container activates");
    Assert.True(!CompositionLaunch(second), "second cannot borrow the first container's slot");
    Assert.True(CompositionSlotStore(second, 0, secondService), "second service installed");
    Assert.True(CompositionLaunch(second), "second container activates independently");

    CompositionShutdown(first);
    CompositionContainerDrop(first);
    CompositionScopeEnter(second, 1, 0);
    Assert.Equal(CompositionScopeDepth(), 1, "second container remains active after first drops");
    CompositionScopeLeave();
    CompositionShutdown(second);
    CompositionContainerDrop(second);
    SystemFree(firstService, 8);
    SystemFree(secondService, 8);
    ProcessShutdown(runtime);
    SystemFree(runtime, 64);
    ResumeHostRuntime(hostRuntime);
}

test composition_scope_rejects_wrong_frozen_parent_without_publishing_a_frame {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    memory_set(runtime, 0, 64);
    ProcessInit(runtime);
    pointer container = CompositionContainerCreate(0);
    Assert.True(CompositionLaunch(container), "empty compiler plan activates");

    Assert.True(!CompositionScopeTryEnter(container, 2, 1), "child cannot enter without its frozen parent");
    Assert.Equal(CompositionScopeDepth(), 0, "failed root entry leaves frame stack untouched");
    CompositionScopeEnter(container, 1, 0);
    Assert.True(!CompositionScopeTryEnter(container, 2, 0), "child cannot claim global parent while nested");
    Assert.Equal(CompositionScopeDepth(), 1, "failed nested entry does not publish a frame");
    CompositionScopeEnter(container, 2, 1);
    Assert.Equal(CompositionScopeDepth(), 2, "validated parent enters beneath its own frame");
    CompositionScopeEnter(container, 2, 1);
    Assert.Equal(CompositionScopeDepth(), 3, "same named scope reentry owns a separate frame");
    CompositionScopeLeave();
    CompositionScopeLeave();
    CompositionScopeLeave();
    CompositionShutdown(container);
    CompositionContainerDrop(container);
    ProcessShutdown(runtime);
    SystemFree(runtime, 64);
    ResumeHostRuntime(hostRuntime);
}

test composition_scope_identity_is_fiber_local {
    meta { tags = "composition-scope"; }
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    memory_set(runtime, 0, 64);
    ProcessInit(runtime);
    pointer container = CompositionContainerCreate(0);
    Assert.True(CompositionLaunch(container), "empty plan activates");
    pointer firstState = SystemAllocate(40, 8);
    pointer secondState = SystemAllocate(40, 8);
    memory_set(firstState, 0, 40);
    memory_set(secondState, 0, 40);
    raw_word_store(firstState, NativeWord(container));
    raw_word_store(secondState, NativeWord(container));
    i64 first = SpawnCompositionFiberScopeEntry(firstState);
    i64 second = SpawnCompositionFiberScopeEntry(secondState);
    Assert.True(first >= 0 && second >= 0, "two fibers scheduled");
    Assert.True(SchedStep(), "first fiber enters and yields");
    Assert.True(SchedStep(), "second fiber enters and yields");
    Assert.Equal(raw_word_load(pointer_add(firstState, 32)), 1, "first fiber accepted its frozen root identity");
    Assert.Equal(raw_word_load(pointer_add(secondState, 32)), 1, "second fiber accepted its frozen root identity");
    Assert.Equal(CompositionScopeDepth(), 0, "main execution has no borrowed fiber frame");
    Assert.True(SchedStep(), "first fiber resumes and leaves");
    Assert.True(SchedStep(), "second fiber resumes and leaves");
    Assert.Equal(raw_word_load(pointer_add(firstState, 8)), 1, "first fiber entered one frame");
    Assert.Equal(raw_word_load(pointer_add(secondState, 8)), 1, "second fiber entered one independent frame");
    Assert.Equal(raw_word_load(pointer_add(firstState, 16)), 1, "first fiber retained its own frame after yield");
    Assert.Equal(raw_word_load(pointer_add(secondState, 16)), 1, "second fiber retained its own frame after yield");
    Assert.Equal(raw_word_load(pointer_add(firstState, 24)), 0, "first fiber left its frame");
    Assert.Equal(raw_word_load(pointer_add(secondState, 24)), 0, "second fiber left its frame");
    CompositionShutdown(container);
    CompositionContainerDrop(container);
    SystemFree(firstState, 40);
    SystemFree(secondState, 40);
    Assert.True(SchedShutdown(), "scheduler is idle after both scoped fibers");
    ProcessShutdown(runtime);
    SystemFree(runtime, 64);
    ResumeHostRuntime(hostRuntime);
}
