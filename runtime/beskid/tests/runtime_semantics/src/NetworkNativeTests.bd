// The portable service fixture runs unchanged over epoll, kqueue and IOCP kits.
// Only ABI-managed array descriptors cross these runtime entrypoints.
pub pointer NetworkTestArray(word length, word stride) {
    pointer allocation = Native.SystemAllocate(16 + length * stride, 8);
    Assert.True(allocation != Native.NativePointer(0), "network fixture allocation");
    memory_set(allocation, 0, 16 + length * stride);
    raw_word_store(allocation, Native.NativeWord(pointer_add(allocation, 16)));
    raw_word_store(pointer_add(allocation, 8), length);
    return allocation;
}

test native_network_bind_address_close_and_generation_are_portable {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = Native.SystemAllocate(64, 8);
    memory_set(runtime, 0, 64);
    Assert.True(Lifecycle.ProcessInit(runtime) == runtime, "native runtime initialized");
    pointer address = NetworkTestArray(19, 1);
    pointer wire = pointer_add(address, 16);
    raw_byte_store(wire, 4);
    raw_byte_store(pointer_add(wire, 3), 127);
    raw_byte_store(pointer_add(wire, 6), 1);
    pointer output = NetworkTestArray(1, 8);
    pointer observed = NetworkTestArray(19, 1);

    Assert.Equal(Sockets.NetworkOpen(1, address, 0, 8, -1, output), 0, "TCP listener binds an ephemeral loopback endpoint");
    word previous = raw_word_load(pointer_add(output, 16));
    Assert.True(previous != 0, "listener owns an opaque generation handle");
    Assert.Equal(Sockets.NetworkAddress(previous, false, observed), 0, "listener exposes portable local address");
    pointer result = pointer_add(observed, 16);
    Assert.Equal(raw_byte_load(result), 4, "address family is portable IPv4");
    Assert.True(raw_byte_load(pointer_add(result, 1)) != 0 || raw_byte_load(pointer_add(result, 2)) != 0, "port zero selected a bound port");
    Assert.Equal(raw_byte_load(pointer_add(result, 3)), 127, "loopback address survives the native bridge");
    Assert.Equal(Table.NetworkClose(previous), 0, "listener closes once");
    Assert.Equal(Table.NetworkClose(previous), 0, "duplicate close is idempotent");

    Assert.Equal(Sockets.NetworkOpen(3, address, 0, 0, -1, output), 0, "UDP socket uses the same portable ownership table");
    word replacement = raw_word_load(pointer_add(output, 16));
    Assert.True(replacement != previous, "slot reuse changes handle generation");
    Assert.Equal(replacement & 0xFFFFFFFF, previous & 0xFFFFFFFF, "fixture exercises actual slot reuse");
    Assert.Equal(Sockets.NetworkAddress(previous, false, observed), 14, "stale handle cannot access a replacement socket");
    Assert.Equal(Table.NetworkClose(previous), 0, "stale close cannot close the replacement socket");
    Assert.Equal(Sockets.NetworkAddress(replacement, false, observed), 0, "replacement remains live after stale close");
    Assert.Equal(Table.NetworkClose(replacement), 0, "UDP socket closes exactly once");
    Assert.Equal(Dns.NetworkShutdown(External.ExternalOwnerId()), 0, "native socket lifecycle leaves no live handles");

    Native.SystemFree(observed, 35);
    Native.SystemFree(output, 24);
    Native.SystemFree(address, 35);
    Lifecycle.ProcessShutdown(runtime);
    Native.SystemFree(runtime, 64);
    ResumeHostRuntime(hostRuntime);
}

test native_network_shutdown_reports_and_closes_live_socket_idempotently {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = Native.SystemAllocate(64, 8);
    memory_set(runtime, 0, 64);
    Assert.True(Lifecycle.ProcessInit(runtime) == runtime, "native runtime initialized");
    pointer address = NetworkTestArray(19, 1);
    pointer wire = pointer_add(address, 16);
    raw_byte_store(wire, 4);
    raw_byte_store(pointer_add(wire, 3), 127);
    raw_byte_store(pointer_add(wire, 6), 1);
    pointer output = NetworkTestArray(1, 8);

    Assert.Equal(Sockets.NetworkOpen(3, address, 0, 0, -1, output), 0, "UDP socket opens for shutdown leak check");
    word handle = raw_word_load(pointer_add(output, 16));
    Assert.True(handle != 0, "shutdown fixture owns a live socket handle");
    Assert.Equal(Dns.NetworkShutdown(External.ExternalOwnerId()), 1, "shutdown reports one live socket leak");
    Assert.Equal(Sockets.NetworkAddress(handle, false, address), 14, "shutdown closes the leaked socket handle");
    Assert.Equal(Dns.NetworkShutdown(External.ExternalOwnerId()), 0, "repeated shutdown is idempotent after cleanup");

    Native.SystemFree(output, 24);
    Native.SystemFree(address, 35);
    Lifecycle.ProcessShutdown(runtime);
    Native.SystemFree(runtime, 64);
    ResumeHostRuntime(hostRuntime);
}

// Table exhaustion and host descriptor exhaustion (EMFILE before the table fills)
// both report ResourceExhausted (18), never NetworkDown (9).
test native_network_socket_exhaustion_reports_resource_exhausted {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = Native.SystemAllocate(64, 8);
    memory_set(runtime, 0, 64);
    Assert.True(Lifecycle.ProcessInit(runtime) == runtime, "native runtime initialized");
    pointer address = NetworkTestArray(19, 1);
    pointer wire = pointer_add(address, 16);
    raw_byte_store(wire, 4);
    raw_byte_store(pointer_add(wire, 3), 127);
    raw_byte_store(pointer_add(wire, 6), 1);
    pointer output = NetworkTestArray(1, 8);
    pointer handleArray = NetworkTestArray(257, 8);
    pointer handles = pointer_add(handleArray, 16);

    mut word count = 0;
    mut i32 status = 0;
    while count < 257 {
        status = Sockets.NetworkOpen(3, address, 0, 0, -1, output);
        if status != 0 { break; }
        raw_word_store(pointer_add(handles, count * 8), raw_word_load(pointer_add(output, 16)));
        count = count + 1;
    }
    Assert.Equal(status, 18, "exhaustion reports ResourceExhausted");
    Assert.True(count > 0 && count <= 256, "exhaustion occurs at or before the slot count");
    word last = raw_word_load(pointer_add(handles, (count - 1) * 8));
    Assert.Equal(Table.NetworkClose(last), 0, "one live socket closes");
    Assert.Equal(Sockets.NetworkOpen(3, address, 0, 0, -1, output), 0, "the freed slot admits the next bind");
    raw_word_store(pointer_add(handles, (count - 1) * 8), raw_word_load(pointer_add(output, 16)));
    mut word index = 0;
    while index < count {
        Assert.Equal(Table.NetworkClose(raw_word_load(pointer_add(handles, index * 8))), 0, "exhaustion fixture closes every socket");
        index = index + 1;
    }
    Assert.Equal(Dns.NetworkShutdown(External.ExternalOwnerId()), 0, "exhaustion fixture leaves no live handles");

    Native.SystemFree(handleArray, 2072);
    Native.SystemFree(output, 24);
    Native.SystemFree(address, 35);
    Lifecycle.ProcessShutdown(runtime);
    Native.SystemFree(runtime, 64);
    ResumeHostRuntime(hostRuntime);
}

unit ExpiredReadKeepsTcpStreamOpen() {
    pointer address = NetworkTestArray(19, 1);
    pointer wire = pointer_add(address, 16);
    raw_byte_store(wire, 4);
    raw_byte_store(pointer_add(wire, 3), 127);
    raw_byte_store(pointer_add(wire, 6), 1);
    pointer listenerOut = NetworkTestArray(1, 8);
    pointer clientOut = NetworkTestArray(1, 8);
    pointer acceptedOut = NetworkTestArray(1, 8);
    pointer boundAddress = NetworkTestArray(19, 1);
    pointer bytes = NetworkTestArray(1, 1);

    Assert.Equal(Sockets.NetworkOpen(1, address, 0, 8, -1, listenerOut), 0, "listener binds loopback");
    word listener = raw_word_load(pointer_add(listenerOut, 16));
    Assert.Equal(Sockets.NetworkAddress(listener, false, boundAddress), 0, "listener reports selected port");
    Assert.Equal(Sockets.NetworkOpen(2, boundAddress, 0, 0, -1, clientOut), 0, "client connects");
    word client = raw_word_load(pointer_add(clientOut, 16));
    Assert.Equal(Sockets.NetworkAccept(listener, -1, acceptedOut), 0, "server accepts");
    word accepted = raw_word_load(pointer_add(acceptedOut, 16));

    Assert.Equal(Operations.NetworkSetDeadlines(client, 0, -1), 0, "stream accepts an expired read policy without changing its write policy");
    Assert.Equal(Operations.NetworkRead(client, bytes, 0, 1, -1), -12, "expired read policy reports TimedOut exactly once");
    Assert.Equal(External.ExternalActiveCount(), 0, "timed-out read releases its one wait");
    Assert.Equal(Operations.NetworkSetDeadlines(client, -1, -1), 0, "clearing a read policy restores unbounded reads");
    raw_byte_store(pointer_add(bytes, 16), 7);
    Assert.Equal(Operations.NetworkWrite(accepted, bytes, 0, 1), 1, "server writes after client timeout");
    raw_byte_store(pointer_add(bytes, 16), 0);
    Assert.Equal(Operations.NetworkRead(client, bytes, 0, 1, -1), 1, "client remains readable after timeout");
    Assert.Equal(raw_byte_load(pointer_add(bytes, 16)), 7, "later read receives the byte");
    Assert.Equal(Table.NetworkClose(client), 0, "client closes normally");
    Assert.Equal(Table.NetworkClose(accepted), 0, "accepted socket closes normally");
    Assert.Equal(Table.NetworkClose(listener), 0, "listener closes normally");

    Native.SystemFree(bytes, 17);
    Native.SystemFree(boundAddress, 35);
    Native.SystemFree(acceptedOut, 24);
    Native.SystemFree(clientOut, 24);
    Native.SystemFree(listenerOut, 24);
    Native.SystemFree(address, 35);
    return;
}

test native_network_expired_tcp_read_has_one_timeout_and_keeps_stream_open {
    Fiber<unit> scenario = spawn ExpiredReadKeepsTcpStreamOpen();
    match scenario.Join() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("expired-read scenario completes"),
    };
}

unit ExpiredUdpReceiveKeepsSocketOpen() {
    pointer bindAddress = NetworkTestArray(19, 1);
    pointer wire = pointer_add(bindAddress, 16);
    raw_byte_store(wire, 4);
    raw_byte_store(pointer_add(wire, 3), 127);
    raw_byte_store(pointer_add(wire, 6), 1);
    pointer receiverOut = NetworkTestArray(1, 8);
    pointer senderOut = NetworkTestArray(1, 8);
    pointer peer = NetworkTestArray(19, 1);
    pointer payload = NetworkTestArray(1, 1);
    pointer metadata = NetworkTestArray(20, 1);

    Assert.Equal(Sockets.NetworkOpen(3, bindAddress, 0, 0, -1, receiverOut), 0, "receiver binds loopback");
    word receiver = raw_word_load(pointer_add(receiverOut, 16));
    Assert.Equal(Sockets.NetworkAddress(receiver, false, peer), 0, "receiver has an ephemeral endpoint");
    Assert.Equal(Sockets.NetworkOpen(3, bindAddress, 0, 0, -1, senderOut), 0, "sender binds loopback");
    word sender = raw_word_load(pointer_add(senderOut, 16));

    Assert.Equal(Sockets.NetworkReceive(receiver, payload, metadata, false, -2), -17, "invalid raw ABI deadline is rejected before registration");
    Assert.Equal(Sockets.NetworkReceive(receiver, payload, metadata, false, 0), -12, "empty UDP receive expires through Foundation's timer");
    Assert.Equal(External.ExternalActiveCount(), 0, "timed-out UDP receive releases its sole wait");
    raw_byte_store(pointer_add(payload, 16), 73);
    Assert.Equal(Sockets.NetworkSend(sender, payload, peer, false, -1), 1, "send remains usable after a receive timeout");
    raw_byte_store(pointer_add(payload, 16), 0);
    Assert.Equal(Sockets.NetworkReceive(receiver, payload, metadata, false, -1), 1, "receiver remains usable after its timeout");
    Assert.Equal(raw_byte_load(pointer_add(payload, 16)), 73, "later datagram payload arrives intact");
    Assert.Equal(External.ExternalActiveCount(), 0, "UDP operations leave no active waits");
    Assert.Equal(Table.NetworkClose(sender), 0, "sender closes normally");
    Assert.Equal(Table.NetworkClose(receiver), 0, "receiver closes normally");

    Native.SystemFree(metadata, 36);
    Native.SystemFree(payload, 17);
    Native.SystemFree(peer, 35);
    Native.SystemFree(senderOut, 24);
    Native.SystemFree(receiverOut, 24);
    Native.SystemFree(bindAddress, 35);
    return;
}

test native_network_expired_udp_receive_has_one_timeout_and_keeps_socket_open {
    Fiber<unit> scenario = spawn ExpiredUdpReceiveKeepsSocketOpen();
    match scenario.Join() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("expired-UDP-receive scenario completes"),
    };
}

unit ExpiredAcceptKeepsListenerOpen() {
    pointer address = NetworkTestArray(19, 1);
    pointer wire = pointer_add(address, 16);
    raw_byte_store(wire, 4);
    raw_byte_store(pointer_add(wire, 3), 127);
    raw_byte_store(pointer_add(wire, 6), 1);
    pointer listenerOut = NetworkTestArray(1, 8);
    pointer clientOut = NetworkTestArray(1, 8);
    pointer acceptedOut = NetworkTestArray(1, 8);
    pointer boundAddress = NetworkTestArray(19, 1);

    Assert.Equal(Sockets.NetworkOpen(1, address, 0, 8, -1, listenerOut), 0, "listener binds without a deadline");
    word listener = raw_word_load(pointer_add(listenerOut, 16));
    Assert.Equal(Sockets.NetworkAddress(listener, false, boundAddress), 0, "listener exposes its bound address");
    Assert.Equal(Sockets.NetworkAccept(listener, -2, acceptedOut), 17, "invalid accept deadline is rejected before registration");
    Assert.Equal(Sockets.NetworkOpen(2, boundAddress, 0, 0, -2, clientOut), 17, "invalid connect deadline is rejected before socket ownership");
    Assert.Equal(External.ExternalActiveCount(), 0, "invalid lifecycle deadlines leave no waits");
    Assert.Equal(Sockets.NetworkAccept(listener, 0, acceptedOut), 12, "expired accept reports TimedOut");
    Assert.Equal(raw_word_load(pointer_add(acceptedOut, 16)), 0, "expired accept does not create a socket");
    Assert.Equal(External.ExternalActiveCount(), 0, "expired accept releases its wait");
    Assert.Equal(Sockets.NetworkOpen(2, boundAddress, 0, 0, -1, clientOut), 0, "client can still connect");
    word client = raw_word_load(pointer_add(clientOut, 16));
    Assert.Equal(Sockets.NetworkAccept(listener, -1, acceptedOut), 0, "listener accepts after timeout");
    word accepted = raw_word_load(pointer_add(acceptedOut, 16));
    Assert.Equal(Table.NetworkClose(accepted), 0, "accepted socket closes");
    Assert.Equal(Table.NetworkClose(client), 0, "client closes");
    Assert.Equal(Table.NetworkClose(listener), 0, "listener closes");
    Assert.Equal(External.ExternalActiveCount(), 0, "accept lifecycle leaves no waits");

    Native.SystemFree(boundAddress, 35);
    Native.SystemFree(acceptedOut, 24);
    Native.SystemFree(clientOut, 24);
    Native.SystemFree(listenerOut, 24);
    Native.SystemFree(address, 35);
    return;
}

test native_network_expired_accept_has_one_timeout_and_keeps_listener_open {
    Fiber<unit> scenario = spawn ExpiredAcceptKeepsListenerOpen();
    match scenario.Join() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("expired-accept scenario completes"),
    };
}

i32 PendingAcceptOne(word listener, i64 deadline) {
    pointer acceptedOut = NetworkTestArray(1, 8);
    i32 status = Sockets.NetworkAccept(listener, deadline, acceptedOut);
    word accepted = raw_word_load(pointer_add(acceptedOut, 16));
    if status == 0 {
        Assert.True(accepted != 0, "ready accept owns exactly one socket");
        Assert.Equal(Table.NetworkClose(accepted), 0, "ready accept closes its owned socket");
    } else {
        Assert.Equal(accepted, 0, "non-ready accept does not expose a socket");
    }
    Native.SystemFree(acceptedOut, 24);
    return status;
}

// A peer contends with close and deadline after the accept wait is registered.
i32 ConnectRacePeer(word addressValue) {
    pointer boundAddress = Native.NativePointer(addressValue);
    pointer clientOut = NetworkTestArray(1, 8);
    i32 status = Sockets.NetworkOpen(2, boundAddress, 0, 0, clock_monotonic_nanos() + 1000000000, clientOut);
    word client = raw_word_load(pointer_add(clientOut, 16));
    if status == 0 {
        Assert.True(client != 0, "ready connect owns exactly one socket");
        Assert.Equal(Table.NetworkClose(client), 0, "ready connect closes its owned socket");
    } else {
        Assert.Equal(client, 0, "failed connect does not expose a socket");
    }
    Native.SystemFree(clientOut, 24);
    return status;
}

unit CloseRacesPendingAccept() {
    pointer address = NetworkTestArray(19, 1);
    pointer wire = pointer_add(address, 16);
    raw_byte_store(wire, 4);
    raw_byte_store(pointer_add(wire, 3), 127);
    raw_byte_store(pointer_add(wire, 6), 1);
    pointer listenerOut = NetworkTestArray(1, 8);
    pointer boundAddress = NetworkTestArray(19, 1);
    Assert.Equal(Sockets.NetworkOpen(1, address, 0, 8, -1, listenerOut), 0, "race listener binds");
    word listener = raw_word_load(pointer_add(listenerOut, 16));
    Assert.Equal(Sockets.NetworkAddress(listener, false, boundAddress), 0, "race listener exposes selected port");
    Fiber<i32> pendingAccept = spawn (() => PendingAcceptOne(listener, clock_monotonic_nanos() + 1000000000));
    mut word pending = 0;
    mut word attempts = 0;
    while pending == 0 && attempts < 1000 {
        network_table_lock();
        pointer table = Native.NativePointer(raw_word_load(network_table_root()));
        pointer slot = Table.NetworkFindLocked(table, listener);
        if slot != Native.NativePointer(0) { pending = raw_word_load(Table.NetworkSlotToken(slot, 0)); }
        network_table_unlock();
        if pending == 0 { Concurrency.Yield(); }
        attempts = attempts + 1;
    }
    Assert.True(pending != 0, "accept is pending before close");
    word addressValue = Native.NativeWord(boundAddress);
    Fiber<i32> connector = spawn (() => ConnectRacePeer(addressValue));
    Concurrency.Yield();
    Assert.Equal(Table.NetworkClose(listener), 0, "close claims pending listener");
    match pendingAccept.Join() {
        Result::Ok(status) => Assert.True(status == 0 || status == 14 || status == 12, "readiness, close, or deadline wins exactly once"),
        Result::Error(_) => Assert.Fail("pending accept fiber joins"),
    };
    match connector.Join() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("contending connector fiber joins"),
    };
    Assert.Equal(External.ExternalActiveCount(), 0, "readiness/close/deadline race leaves no wait");
    Assert.Equal(Table.NetworkClose(listener), 0, "duplicate close is harmless");
    Assert.Equal(Dns.NetworkShutdown(External.ExternalOwnerId()), 0, "race leaves no live socket");
    Native.SystemFree(boundAddress, 35);
    Native.SystemFree(listenerOut, 24);
    Native.SystemFree(address, 35);
    return;
}

test native_network_close_vs_accept_deadline_has_one_winner {
    Fiber<unit> scenario = spawn CloseRacesPendingAccept();
    match scenario.Join() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("close/accept race scenario completes"),
    };
}

unit CheckDnsDeadlineWhileHostJobIsBlocked() {
    word activeBefore = External.ExternalActiveCount();
    match Deadline.After(Time.FromMilliseconds(0_i64)) {
        Result::Error(_) => Assert.Fail("zero duration creates a typed deadline"),
        Result::Ok(deadline) => {
            Result<SocketAddress[], NetworkError> timed = NetworkDns.Resolve(
                "beskid-deadline-block.invalid",
                Network.Types.PortBytes(0_u8, 53_u8),
                Option::Some(AddressFamily::V4),
                Option.FromValue<Deadline>(deadline)
            );
            Assert.True(match timed { Result::Error(NetworkError::TimedOut) => true, _ => false, }, "deadline wins exactly once");
        },
    };

    Result<SocketAddress[], NetworkError> observed = NetworkDns.Resolve(
        "beskid-deadline-observe.invalid",
        Network.Types.PortBytes(0_u8, 53_u8),
        Option::Some(AddressFamily::V4),
        Option.Empty<Deadline>()
    );
    Assert.True(match observed { Result::Ok(addresses) => Array.Len<SocketAddress>(addresses) > 0_i64, _ => false, }, "observer confirms blocked resolver entered getaddrinfo");
    Assert.Equal(External.ExternalActiveCount(), activeBefore + 1, "timed-out DNS operation retains its host-work lease while getaddrinfo is blocked");

    Result<SocketAddress[], NetworkError> released = NetworkDns.Resolve(
        "beskid-deadline-release.invalid",
        Network.Types.PortBytes(0_u8, 53_u8),
        Option::Some(AddressFamily::V4),
        Option.Empty<Deadline>()
    );
    Assert.True(match released { Result::Ok(addresses) => Array.Len<SocketAddress>(addresses) > 0_i64, _ => false, }, "release waits for positive completion of the abandoned resolver");
    Assert.Equal(External.ExternalActiveCount(), activeBefore, "late DNS result is discarded and host-work accounting drains");
    return;
}

unit CheckDnsDeadlineWithoutShim() {
    Result<SocketAddress[], NetworkError> ordinary = NetworkDns.Resolve(
        "127.0.0.1",
        Network.Types.PortBytes(0_u8, 53_u8),
        Option::Some(AddressFamily::V4),
        Option.Empty<Deadline>()
    );
    Assert.True(match ordinary { Result::Ok(addresses) => Array.Len<SocketAddress>(addresses) > 0_i64, _ => false, }, "ordinary numeric DNS resolution succeeds from a scheduler fiber");
    return;
}

test native_network_dns_deadline_race_retains_and_drains_host_job {
    meta { tags = "dns-deadline"; }
    if Environment.Has("BESKID_DNS_DEADLINE_SHIM") {
        Fiber<unit> scenario = spawn CheckDnsDeadlineWhileHostJobIsBlocked();
        Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "deterministic DNS deadline scenario completes");
    } else {
        Fiber<unit> scenario = spawn CheckDnsDeadlineWithoutShim();
        Assert.True(match scenario.Join() { Result::Ok(_) => true, _ => false, }, "ordinary DNS check runs on a scheduler fiber without the Linux shim");
    }
}

i64 PendingReadOne(word client) {
    pointer received = NetworkTestArray(1, 1);
    mut i64 completed = Operations.NetworkRead(client, received, 0, 1, -1);
    if completed == 1 { completed = 1000 + i64(raw_byte_load(pointer_add(received, 16))); }
    Native.SystemFree(received, 17);
    return completed;
}

unit PendingReadPolicyRekeysItsOwner() {
    pointer address = NetworkTestArray(19, 1);
    pointer wire = pointer_add(address, 16);
    raw_byte_store(wire, 4);
    raw_byte_store(pointer_add(wire, 3), 127);
    raw_byte_store(pointer_add(wire, 6), 1);
    pointer listenerOut = NetworkTestArray(1, 8);
    pointer clientOut = NetworkTestArray(1, 8);
    pointer acceptedOut = NetworkTestArray(1, 8);
    pointer boundAddress = NetworkTestArray(19, 1);
    pointer sent = NetworkTestArray(1, 1);

    Assert.Equal(Sockets.NetworkOpen(1, address, 0, 8, -1, listenerOut), 0, "pending-policy listener binds loopback");
    word listener = raw_word_load(pointer_add(listenerOut, 16));
    Assert.Equal(Sockets.NetworkAddress(listener, false, boundAddress), 0, "pending-policy listener reports its address");
    Assert.Equal(Sockets.NetworkOpen(2, boundAddress, 0, 0, -1, clientOut), 0, "pending-policy client connects");
    word client = raw_word_load(pointer_add(clientOut, 16));
    Assert.Equal(Sockets.NetworkAccept(listener, -1, acceptedOut), 0, "pending-policy server accepts");
    word accepted = raw_word_load(pointer_add(acceptedOut, 16));

    Fiber<i64> timedRead = spawn (() => PendingReadOne(client));
    mut word pending = 0;
    mut word attempts = 0;
    while pending == 0 && attempts < 1000 {
        network_table_lock();
        pointer table = Native.NativePointer(raw_word_load(network_table_root()));
        pointer slot = Table.NetworkFindLocked(table, client);
        if slot != Native.NativePointer(0) { pending = raw_word_load(Table.NetworkSlotToken(slot, 0)); }
        network_table_unlock();
        if pending == 0 { Concurrency.Yield(); }
        attempts = attempts + 1;
    }
    Assert.True(pending != 0, "first read is pending before deadline replacement");
    Assert.Equal(Operations.NetworkSetDeadlines(client, 0, -1), 0, "expired replacement reaches an already pending read");
    match timedRead.Join() {
        Result::Ok(status) => Assert.Equal(status, -12_i64, "pending read times out once"),
        Result::Error(_) => Assert.Fail("timed-out read fiber joins"),
    };
    Assert.Equal(External.ExternalActiveCount(), 0, "timed-out pending read releases its wait");

    Assert.Equal(Operations.NetworkSetDeadlines(client, clock_monotonic_nanos() + 1000000000, -1), 0, "next read inherits a future deadline");
    Fiber<i64> clearedRead = spawn (() => PendingReadOne(client));
    pending = 0;
    attempts = 0;
    while pending == 0 && attempts < 1000 {
        network_table_lock();
        pointer table = Native.NativePointer(raw_word_load(network_table_root()));
        pointer slot = Table.NetworkFindLocked(table, client);
        if slot != Native.NativePointer(0) { pending = raw_word_load(Table.NetworkSlotToken(slot, 0)); }
        network_table_unlock();
        if pending == 0 { Concurrency.Yield(); }
        attempts = attempts + 1;
    }
    Assert.True(pending != 0, "second read is pending before its timer is cleared");
    Assert.Equal(Operations.NetworkSetDeadlines(client, -1, -1), 0, "clear removes the pending read timer");
    raw_byte_store(pointer_add(sent, 16), 29);
    Assert.Equal(Operations.NetworkWrite(accepted, sent, 0, 1), 1, "peer readiness completes the cleared read");
    match clearedRead.Join() {
        Result::Ok(completed) => Assert.Equal(completed, 1029_i64, "cleared pending read receives one peer byte"),
        Result::Error(_) => Assert.Fail("cleared read fiber joins"),
    };
    Assert.Equal(External.ExternalActiveCount(), 0, "cleared read releases its wait");

    Assert.Equal(Table.NetworkClose(client), 0, "client closes after pending-policy checks");
    Assert.Equal(Table.NetworkClose(accepted), 0, "accepted stream closes after pending-policy checks");
    Assert.Equal(Table.NetworkClose(listener), 0, "listener closes after pending-policy checks");
    Native.SystemFree(sent, 17);
    Native.SystemFree(boundAddress, 35);
    Native.SystemFree(acceptedOut, 24);
    Native.SystemFree(clientOut, 24);
    Native.SystemFree(listenerOut, 24);
    Native.SystemFree(address, 35);
    return;
}

test native_network_pending_read_policy_rekeys_and_clears_without_resurrection {
    Fiber<unit> scenario = spawn PendingReadPolicyRekeysItsOwner();
    match scenario.Join() {
        Result::Ok(_) => (),
        Result::Error(_) => Assert.Fail("pending-policy scenario completes"),
    };
}
