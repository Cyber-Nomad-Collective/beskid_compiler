use Runtime.Bootstrap.Lifecycle;
use Runtime.Bootstrap.Native;
use Runtime.Bootstrap.Objects;
use Runtime.Mem.Gc.Allocation;
use Runtime.Mem.Gc.Identity;
use Runtime.Mem.Gc.CheckedScope;
use Runtime.Mem.Gc.Collection;
use Runtime.Mem.Gc.RootsHandles;
use Runtime.Data.Collections;
use Testing.Assert;
use HostRuntimeSupport;

pub pointer TestDescriptor(word size, word alignment) {
    pointer descriptor = SystemAllocate(40, 8);
    memory_set(descriptor, 0, 40);
    raw_word_store(descriptor, size);
    raw_word_store(pointer_add(descriptor, 8), alignment);
    return descriptor;
}

pub pointer InstallTestHeap(pointer runtime, pointer heap, pointer region, word regionSize) {
    memory_set(runtime, 0, 64);
    Assert.True(ProcessInit(runtime) == runtime, "runtime initialized before installing heap");
    pointer thread = CurrentThreadState();
    Assert.True(thread != NativePointer(0), "process initialization attached the mutator and installed its heap");
    return thread;
}

pub unit DropTestHeap(pointer runtime, pointer thread, pointer heap, pointer region, word regionSize) {
    ProcessShutdown(runtime);
    SystemFree(region, regionSize);
    SystemFree(heap, 720);
    SystemFree(runtime, 64);
    return;
}

test gc_fails_closed_before_runtime_initialization {
    // No runtime is attached while the host runtime is suspended, and assertion messages need
    // one: record the observations and assert them after the host runtime is restored.
    pointer hostRuntime = SuspendHostRuntime();
    bool allocationRejected = Alloc(24, NativePointer(0)) == NativePointer(0);
    word bytesAllocated = GcBytesAllocated();
    word collected = GcCollect();
    ResumeHostRuntime(hostRuntime);
    Assert.True(allocationRejected, "allocation rejects a missing descriptor before initialization");
    Assert.Equal(bytesAllocated, 0, "statistics are zero before initialization");
    Assert.Equal(collected, 0, "collection fails closed before initialization");
}

test gc_reclaims_reuses_and_invalidates_stale_handles {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    pointer heap = SystemAllocate(720, 8);
    pointer region = SystemAllocate(128, 8);
    pointer thread = InstallTestHeap(runtime, heap, region, 128);
    pointer descriptor = TestDescriptor(24, 8);

    pointer rooted = Alloc(24, descriptor);
    pointer reclaimable = Alloc(24, descriptor);
    Assert.True(rooted != NativePointer(0) && reclaimable != NativePointer(0), "valid descriptors allocate managed objects");
    word handle = GcRootHandle(rooted);
    Assert.True(handle != 0, "handle roots an allocated object");
    // Live bytes are the size-class slot occupied on the heap, not the raw request: a 24-byte
    // request rounds up into the 32-byte size class (Span.bd's `SizeClassForSize`/`SizeClassBytes`),
    // and `GcAlloc` (Allocation.bd) and `Sweep` (Sweep.bd) both account by that slot size so the
    // two stay consistent across a collection. Two 24-byte objects occupy 2 * 32 = 64 slot bytes.
    Assert.Equal(GcBytesAllocated(), 64, "live-byte accounting includes both objects' size-class slots");
    Assert.Equal(GcObjectCount(), 2, "object accounting includes both objects");

    GcCollect();
    Assert.Equal(GcCollectionCount(), 1, "successful collection increments collection count");
    // Only the rooted 24-byte object survives; its slot is still the 32-byte size class.
    Assert.Equal(GcBytesAllocated(), 32, "collection reclaims unreachable bytes down to the surviving slot");
    Assert.Equal(GcObjectCount(), 1, "collection retains only the rooted object");
    Assert.Equal(GcPhase(), 0, "successful collection returns to idle");

    pointer reused = Alloc(24, descriptor);
    Assert.True(reused == reclaimable, "allocation reuses the reclaimed non-moving block");
    GcUnrootHandle(handle);
    Assert.True(GcResolveHandle(handle) == NativePointer(0), "released handle is stale immediately");
    word replacement = GcRootHandle(rooted);
    Assert.True(replacement != 0 && replacement != handle, "reused handle slot advances its generation");
    Assert.True(GcResolveHandle(handle) == NativePointer(0), "old generation remains stale after slot reuse");

    // Process shutdown requires every handle to be released.
    GcUnrootHandle(replacement);
    SystemFree(descriptor, 40);
    DropTestHeap(runtime, thread, heap, region, 128);
    ResumeHostRuntime(hostRuntime);
}

test gc_array_uses_distinct_descriptors_and_traces_variable_pointer_elements {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    pointer heap = SystemAllocate(720, 8);
    pointer region = SystemAllocate(512, 8);
    pointer thread = InstallTestHeap(runtime, heap, region, 512);
    pointer childDescriptor = TestDescriptor(24, 8);
    pointer child = Alloc(24, childDescriptor);
    pointer pointerMap = SystemAllocate(8, 8);
    raw_word_store(pointerMap, 0);
    pointer element = SystemAllocate(32, 8);
    memory_set(element, 0, 32);
    raw_word_store(element, 8);
    raw_word_store(pointer_add(element, 8), 8);
    raw_word_store(pointer_add(element, 16), NativeWord(pointerMap));
    raw_word_store(pointer_add(element, 24), 1);
    pointer arrayDescriptor = TestDescriptor(48, 8);
    raw_word_store(pointer_add(arrayDescriptor, 32), TypeDescriptorArrayFlag());
    pointer request = SystemAllocate(32, 8);
    memory_set(request, 0, 32);
    raw_word_store(request, NativeWord(element));
    raw_word_store(pointer_add(request, 8), 2);
    raw_word_store(pointer_add(request, 16), NativeWord(arrayDescriptor));
    pointer handleOut = SystemAllocate(8, 8);

    pointer array = AllocateArrayRooted(request, handleOut);
    Assert.True(array != NativePointer(0), "array allocation accepts a valid array-aware object descriptor");
    Assert.True(NativePointer(raw_word_load(NativePointer(NativeWord(array) - 8))) == element, "array retains its separate element descriptor");
    raw_word_store(NativePointer(raw_word_load(array)), NativeWord(child));
    Assert.True(GcCollect() > 0, "variable-size array and pointer elements scan safely");
    Assert.True(GcBytesAllocated() >= 24, "pointer element keeps its child alive");
    Assert.Equal(ArrayConstructionFinish(NativePointer(raw_word_load(handleOut))), 1, "construction root releases deterministically");

    SystemFree(handleOut, 8);
    SystemFree(request, 32);
    SystemFree(arrayDescriptor, 40);
    SystemFree(element, 32);
    SystemFree(pointerMap, 8);
    SystemFree(childDescriptor, 40);
    DropTestHeap(runtime, thread, heap, region, 512);
    ResumeHostRuntime(hostRuntime);
}

test gc_external_root_accepts_public_array_reference {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    pointer heap = SystemAllocate(720, 8);
    pointer region = SystemAllocate(256, 8);
    pointer thread = InstallTestHeap(runtime, heap, region, 256);
    pointer element = SystemAllocate(32, 8);
    memory_set(element, 0, 32);
    raw_word_store(element, 8);
    raw_word_store(pointer_add(element, 8), 8);
    pointer arrayDescriptor = TestDescriptor(48, 8);
    raw_word_store(pointer_add(arrayDescriptor, 32), TypeDescriptorArrayFlag());
    pointer request = SystemAllocate(32, 8);
    memory_set(request, 0, 32);
    raw_word_store(request, NativeWord(element));
    raw_word_store(pointer_add(request, 8), 2);
    raw_word_store(pointer_add(request, 16), NativeWord(arrayDescriptor));
    pointer handleOut = SystemAllocate(8, 8);
    pointer rootSlot = SystemAllocate(8, 8);

    pointer array = AllocateArrayRooted(request, handleOut);
    Assert.True(array != NativePointer(0), "public array allocates");
    Assert.Equal(ArrayConstructionFinish(NativePointer(raw_word_load(handleOut))), 1, "construction handle releases");
    raw_word_store(rootSlot, NativeWord(array));
    Assert.True(GcRegisterRoot(rootSlot), "public array reference registers as an external root");
    Assert.True(GcCollect() > 0, "public array root keeps its backing object alive");
    Assert.Equal(GcObjectCount(), 1, "public array root retains exactly its object");
    Assert.Equal(ArrayLen(array), 2, "public array remains readable after collection");

    GcUnregisterRoot(rootSlot);
    SystemFree(rootSlot, 8);
    SystemFree(handleOut, 8);
    SystemFree(request, 32);
    SystemFree(arrayDescriptor, 40);
    SystemFree(element, 32);
    DropTestHeap(runtime, thread, heap, region, 256);
    ResumeHostRuntime(hostRuntime);
}

test gc_nested_array_reference_keeps_child_alive {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    pointer heap = SystemAllocate(720, 8);
    pointer region = SystemAllocate(512, 8);
    pointer thread = InstallTestHeap(runtime, heap, region, 512);
    pointer pointerMap = SystemAllocate(8, 8);
    raw_word_store(pointerMap, 0);
    pointer pointerElement = SystemAllocate(32, 8);
    memory_set(pointerElement, 0, 32);
    raw_word_store(pointerElement, 8);
    raw_word_store(pointer_add(pointerElement, 8), 8);
    raw_word_store(pointer_add(pointerElement, 16), NativeWord(pointerMap));
    raw_word_store(pointer_add(pointerElement, 24), 1);
    pointer scalarElement = SystemAllocate(32, 8);
    memory_set(scalarElement, 0, 32);
    raw_word_store(scalarElement, 8);
    raw_word_store(pointer_add(scalarElement, 8), 8);
    pointer arrayDescriptor = TestDescriptor(48, 8);
    raw_word_store(pointer_add(arrayDescriptor, 32), TypeDescriptorArrayFlag());
    pointer childRequest = SystemAllocate(32, 8);
    pointer parentRequest = SystemAllocate(32, 8);
    memory_set(childRequest, 0, 32);
    memory_set(parentRequest, 0, 32);
    raw_word_store(childRequest, NativeWord(scalarElement));
    raw_word_store(pointer_add(childRequest, 8), 1);
    raw_word_store(pointer_add(childRequest, 16), NativeWord(arrayDescriptor));
    raw_word_store(parentRequest, NativeWord(pointerElement));
    raw_word_store(pointer_add(parentRequest, 8), 1);
    raw_word_store(pointer_add(parentRequest, 16), NativeWord(arrayDescriptor));
    pointer childHandleOut = SystemAllocate(8, 8);
    pointer parentHandleOut = SystemAllocate(8, 8);

    pointer child = AllocateArrayRooted(childRequest, childHandleOut);
    pointer parent = AllocateArrayRooted(parentRequest, parentHandleOut);
    Assert.True(child != NativePointer(0) && parent != NativePointer(0), "nested arrays allocate");
    raw_word_store(NativePointer(raw_word_load(parent)), NativeWord(child));
    Assert.Equal(ArrayConstructionFinish(NativePointer(raw_word_load(childHandleOut))), 1, "child construction releases");
    Assert.True(GcCollect() > 0, "parent traces a public child array reference");
    Assert.Equal(GcObjectCount(), 2, "parent and nested child both survive");
    Assert.Equal(ArrayConstructionFinish(NativePointer(raw_word_load(parentHandleOut))), 1, "parent construction releases");

    SystemFree(parentHandleOut, 8);
    SystemFree(childHandleOut, 8);
    SystemFree(parentRequest, 32);
    SystemFree(childRequest, 32);
    SystemFree(arrayDescriptor, 40);
    SystemFree(scalarElement, 32);
    SystemFree(pointerElement, 32);
    SystemFree(pointerMap, 8);
    DropTestHeap(runtime, thread, heap, region, 512);
    ResumeHostRuntime(hostRuntime);
}

test gc_heap_wide_marking_handles_broad_roots_fanout_and_cycles {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    pointer heap = SystemAllocate(720, 8);
    pointer region = SystemAllocate(2048, 8);
    pointer thread = InstallTestHeap(runtime, heap, region, 2048);

    pointer leafDescriptor = TestDescriptor(24, 8);
    pointer fanoutMap = SystemAllocate(64, 8);
    mut word index = 0;
    while index < 8 {
        raw_word_store(pointer_add(fanoutMap, index * 8), 16 + index * 8);
        index = index + 1;
    }
    pointer fanoutDescriptor = TestDescriptor(80, 8);
    raw_word_store(pointer_add(fanoutDescriptor, 16), NativeWord(fanoutMap));
    raw_word_store(pointer_add(fanoutDescriptor, 24), 8);
    pointer fanout = Alloc(80, fanoutDescriptor);
    index = 0;
    while index < 8 {
        pointer leaf = Alloc(24, leafDescriptor);
        Assert.True(leaf != NativePointer(0), "broad graph leaf allocates");
        raw_word_store(pointer_add(fanout, 16 + index * 8), NativeWord(leaf));
        index = index + 1;
    }
    word fanoutHandle = GcRootHandle(fanout);
    Assert.True(fanoutHandle != 0, "broad fanout parent is rooted");

    pointer nodeMap = SystemAllocate(8, 8);
    raw_word_store(nodeMap, 16);
    pointer nodeDescriptor = TestDescriptor(24, 8);
    raw_word_store(pointer_add(nodeDescriptor, 16), NativeWord(nodeMap));
    raw_word_store(pointer_add(nodeDescriptor, 24), 1);
    pointer firstNode = Alloc(24, nodeDescriptor);
    mut pointer previousNode = firstNode;
    index = 1;
    while index < 10 {
        pointer node = Alloc(24, nodeDescriptor);
        raw_word_store(pointer_add(previousNode, 16), NativeWord(node));
        previousNode = node;
        index = index + 1;
    }
    raw_word_store(pointer_add(previousNode, 16), NativeWord(firstNode));
    word cycleHandle = GcRootHandle(firstNode);
    Assert.True(cycleHandle != 0, "cycle is rooted");

    pointer rootSlots = SystemAllocate(96, 8);
    index = 0;
    while index < 12 {
        pointer root = Alloc(24, leafDescriptor);
        pointer slot = pointer_add(rootSlots, index * 8);
        raw_word_store(slot, NativeWord(root));
        Assert.True(GcRegisterRoot(slot), "root breadth beyond six registers");
        index = index + 1;
    }

    GcCollect();
    Assert.Equal(GcPhase(), 0, "heap-wide marking completes without breadth failure");
    Assert.Equal(GcObjectCount(), 31, "all broad roots, fanout children, and cycle nodes survive");

    index = 0;
    while index < 12 {
        GcUnregisterRoot(pointer_add(rootSlots, index * 8));
        index = index + 1;
    }
    GcUnrootHandle(cycleHandle);
    GcUnrootHandle(fanoutHandle);
    SystemFree(rootSlots, 96);
    SystemFree(nodeDescriptor, 40);
    SystemFree(nodeMap, 8);
    SystemFree(fanoutDescriptor, 40);
    SystemFree(fanoutMap, 64);
    SystemFree(leafDescriptor, 40);
    DropTestHeap(runtime, thread, heap, region, 2048);
    ResumeHostRuntime(hostRuntime);
}

test gc_validates_descriptor_alignment {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    pointer heap = SystemAllocate(720, 8);
    pointer region = SystemAllocate(256, 8);
    pointer thread = InstallTestHeap(runtime, heap, region, 256);
    pointer invalid = TestDescriptor(24, 3);
    pointer valid = TestDescriptor(24, 8);

    Assert.True(Alloc(24, invalid) == NativePointer(0), "non-power-of-two descriptor alignment fails closed");
    Assert.True(Alloc(16, valid) == NativePointer(0), "allocation size must match descriptor size");
    pointer object = Alloc(24, valid);
    Assert.True(object != NativePointer(0), "aligned descriptor allocates");

    // Process shutdown requires every handle to be released, so keep it.
    word handle = GcRootHandle(object);
    Assert.True(handle != 0, "aligned object roots a handle");
    GcUnrootHandle(handle);

    SystemFree(invalid, 40);
    SystemFree(valid, 40);
    DropTestHeap(runtime, thread, heap, region, 256);
    ResumeHostRuntime(hostRuntime);
}

// Handles used to fail outright once a fixed 8-slot manifest table filled up (the ninth handle
// returned 0). The handle stack (RootsHandles.bd) now grows in 64-slot `BeskidHandleStackBlock`s
// instead, chained like the root stack, so there is no fixed capacity to fail at. This exercises
// that growth: allocate well past two 64-slot block boundaries, confirm every handle still
// resolves to its object regardless of which block it landed in, release them out of order (not
// LIFO), and confirm the handle stack is back to empty — its baseline before this test rooted
// anything.
test gc_handle_stack_grows_across_block_boundaries {
    pointer hostRuntime = SuspendHostRuntime();
    pointer runtime = SystemAllocate(64, 8);
    pointer heap = SystemAllocate(720, 8);
    pointer region = SystemAllocate(256, 8);
    pointer thread = InstallTestHeap(runtime, heap, region, 256);
    pointer descriptor = TestDescriptor(24, 8);
    pointer object = Alloc(24, descriptor);
    Assert.True(object != NativePointer(0), "object allocates for handle growth test");
    Assert.True(GcHandlesClear(), "handle stack starts at its baseline (empty) before this test roots anything");

    // Past 64 (first block boundary) and past 128 (second block boundary).
    word handleCount = 150;
    pointer handles = SystemAllocate(handleCount * 8, 8);
    mut word index = 0;
    while index < handleCount {
        word handle = GcRootHandle(object);
        Assert.True(handle != 0, "handle stack grows a new block past capacity instead of failing");
        raw_word_store(pointer_add(handles, index * 8), handle);
        index = index + 1;
    }

    index = 0;
    while index < handleCount {
        word handle = raw_word_load(pointer_add(handles, index * 8));
        Assert.True(GcResolveHandle(handle) == object, "every handle across block boundaries resolves to its object");
        index = index + 1;
    }

    // Out-of-order release: every odd-indexed handle first, then every even-indexed handle,
    // instead of the LIFO order scope exit normally produces.
    index = 1;
    while index < handleCount {
        GcUnrootHandle(raw_word_load(pointer_add(handles, index * 8)));
        index = index + 2;
    }
    index = 0;
    while index < handleCount {
        GcUnrootHandle(raw_word_load(pointer_add(handles, index * 8)));
        index = index + 2;
    }

    Assert.True(GcHandlesClear(), "handle stack count returns to its baseline after out-of-order release");

    SystemFree(handles, handleCount * 8);
    SystemFree(descriptor, 40);
    DropTestHeap(runtime, thread, heap, region, 256);
    ResumeHostRuntime(hostRuntime);
}

// Checked operations leave no half-published allocation or root on failure.
test gc_checked_identity_and_allocation_failure_preserve_heap {
    pointer descriptor = TestDescriptor(24, 8);
    pointer first = Alloc(24, descriptor);
    pointer second = Alloc(24, descriptor);
    word firstHandle = GcRootHandle(first);
    word secondHandle = GcRootHandle(second);
    Assert.Equal(GcSameIdentity(first, first), 1, "same live allocation");
    Assert.Equal(GcSameIdentity(first, second), 0, "equal layout is distinct identity");
    Assert.Equal(GcSameIdentity(first, NativePointer(0)), 2, "invalid reference is not an identity");
    GcCollect();
    Assert.Equal(GcSameIdentity(GcResolveHandle(firstHandle), first), 1, "rooted identity survives collection");
    word before = GcObjectCount();
    Assert.True(GcTryAlloc(2147483648, 8) == NativePointer(0), "request beyond heap cap returns checked failure");
    Assert.Equal(GcAllocationFailureReason(), 3, "actual cap failure recorded without allocating error object");
    Assert.Equal(GcObjectCount(), before, "failed allocation publishes no object");
    Assert.True(GcResolveHandle(firstHandle) == first, "failure preserves existing roots");
    pointer recovered = GcTryAlloc(24, 8);
    Assert.True(recovered != NativePointer(0), "smaller request succeeds after failure");
    Assert.Equal(GcAllocationFailureReason(), 0, "successful request clears old failure");
    memory_set(recovered, 0, 24);
    raw_word_store(recovered, NativeWord(descriptor));
    GcUnrootHandle(firstHandle);
    GcUnrootHandle(secondHandle);
    GcCollect();
    SystemFree(descriptor, 40);
}

test gc_checked_handle_growth_failure_is_recoverable {
    pointer descriptor = TestDescriptor(24, 8);
    pointer value = Alloc(24, descriptor);
    word keeper = GcRootHandle(value);
    pointer handles = SystemAllocate(1024, 8);
    mut word count = 0;
    mut bool rejected = false;
    GcHeapForceRootStackFailure(1);
    while count < 128 && !rejected {
        word handle = GcTryRootHandle(value);
        if handle == 0 { rejected = true; }
        else { raw_word_store(pointer_add(handles, count * 8), handle); count = count + 1; }
    }
    word reason = GcAllocationFailureReason();
    bool alive = GcResolveHandle(keeper) == value;
    GcHeapForceRootStackFailure(0);
    Assert.True(rejected, "actual next handle block allocation fault returns checked failure");
    Assert.Equal(reason, 4, "handle admission preserves typed raw failure reason");
    Assert.True(alive, "failed admission leaves existing handle valid");
    word recovered = GcTryRootHandle(value);
    Assert.True(recovered != 0, "handle growth succeeds when allocation fault removed");
    GcUnrootHandle(recovered);
    while count > 0 { count = count - 1; GcUnrootHandle(raw_word_load(pointer_add(handles, count * 8))); }
    GcUnrootHandle(keeper);
    SystemFree(handles, 1024);
    GcCollect();
    SystemFree(descriptor, 40);
}

test gc_checked_root_growth_failure_is_recoverable {
    pointer slots = SystemAllocate(1024, 8);
    memory_set(slots, 0, 1024);
    mut word count = 0;
    mut bool rejected = false;
    GcHeapForceRootStackFailure(1);
    while count < 128 && !rejected {
        bool registered = GcTryRegisterRoot(pointer_add(slots, count * 8));
        if !registered { rejected = true; } else { count = count + 1; }
    }
    word reason = GcAllocationFailureReason();
    bool unpublished = !GcIsRegisteredRoot(pointer_add(slots, count * 8));
    GcHeapForceRootStackFailure(0);
    Assert.True(rejected, "actual next root block allocation fault returns checked failure");
    Assert.Equal(reason, 4, "root admission preserves raw failure reason");
    Assert.True(unpublished, "failed slot is never published");
    Assert.True(GcTryRegisterRoot(pointer_add(slots, count * 8)), "root block grows after fault removed");
    GcUnregisterRoot(pointer_add(slots, count * 8));
    while count > 0 { count = count - 1; GcUnregisterRoot(pointer_add(slots, count * 8)); }
    SystemFree(slots, 1024);
}

test gc_checked_array_growth_preserves_source_on_real_exhaustion {
    pointer element = SystemAllocate(32, 8);
    memory_set(element, 0, 32);
    raw_word_store(element, 8);
    raw_word_store(pointer_add(element, 8), 8);
    pointer descriptor = TestDescriptor(48, 8);
    raw_word_store(pointer_add(descriptor, 32), TypeDescriptorArrayFlag());
    pointer request = SystemAllocate(32, 8);
    memory_set(request, 0, 32);
    raw_word_store(request, NativeWord(element));
    raw_word_store(pointer_add(request, 8), 1);
    raw_word_store(pointer_add(request, 16), NativeWord(descriptor));
    pointer rootOut = SystemAllocate(8, 8);
    pointer source = TryAllocateArrayRooted(request, rootOut);
    word keeper = raw_word_load(rootOut);
    Assert.True(source != NativePointer(0) && keeper != 0, "checked initial array construction roots source");
    raw_word_store(NativePointer(raw_word_load(source)), 91);
    pointer originalData = NativePointer(raw_word_load(source));
    word originalLength = raw_word_load(pointer_add(source, 8));
    word originalCapacity = raw_word_load(pointer_add(source, 16));
    Assert.Equal(GcSameIdentity(source, NativePointer(NativeWord(source) - 24)), 1, "array ABI view and allocation header share canonical identity");
    pointer rejected = TryGrowArrayRooted(source, 268435456, rootOut);
    word reason = GcAllocationFailureReason();
    word failedRoot = raw_word_load(rootOut);
    Assert.True(rejected == NativePointer(0), "actual request beyond heap cap rejects");
    Assert.Equal(reason, 3, "checked growth reports allocation cap failure");
    Assert.Equal(failedRoot, 0, "no construction ownership escapes failure");
    Assert.True(NativePointer(raw_word_load(source)) == originalData, "failed growth preserves source backing");
    Assert.Equal(raw_word_load(pointer_add(source, 8)), originalLength, "failed growth preserves logical length");
    Assert.Equal(raw_word_load(pointer_add(source, 16)), originalCapacity, "failed growth preserves capacity");
    Assert.Equal(raw_word_load(originalData), 91, "failed growth preserves every original element");
    Assert.True(GcResolveHandle(keeper) == NativePointer(NativeWord(source) - 24), "source keeper survives failure cleanup");
    pointer grown = TryGrowArrayRooted(source, 2, rootOut);
    Assert.True(grown != NativePointer(0), "subsequent checked growth succeeds");
    Assert.Equal(raw_word_load(NativePointer(raw_word_load(grown))), 91, "successful growth preserves typed contents");
    Assert.Equal(ArrayConstructionFinish(NativePointer(raw_word_load(rootOut))), 1, "exactly one successful construction root released");
    GcUnrootHandle(keeper);
    GcCollect();
    SystemFree(rootOut, 8);
    SystemFree(request, 32);
    SystemFree(descriptor, 40);
    SystemFree(element, 32);
}


test gc_checked_scope_keeps_first_failure_and_restores_nested_links {
    pointer descriptor = TestDescriptor(24, 8);
    pointer failure = Alloc(24, descriptor);
    word failureHandle = GcRootHandle(failure);
    pointer outer = SystemAllocate(64, 8);
    pointer inner = SystemAllocate(64, 8);
    memory_set(outer, 0, 64);
    memory_set(inner, 0, 64);
    bool outerEntered = CheckedScopeEnter(outer, failureHandle);
    bool innerEntered = CheckedScopeEnter(inner, failureHandle);
    pointer rejected = GcAlloc(2147483648, 8);
    word firstReason = CheckedScopeFailureReason();
    pointer skipped = GcAlloc(24, 8);
    GcClearAllocationFailure();
    word retainedReason = CheckedScopeFailureReason();
    pointer retainedFailure = CheckedScopeFailureResult();
    CheckedScopeLeave(inner);
    word outerReason = CheckedScopeFailureReason();
    pointer restored = CheckedScopeCurrent();
    CheckedScopeLeave(outer);
    pointer released = CheckedScopeCurrent();
    Assert.True(outerEntered && innerEntered, "two admitted invocation contexts");
    Assert.True(rejected == NativePointer(0) && skipped == NativePointer(0), "sticky failure prevents another allocation");
    Assert.Equal(firstReason, 3, "actual cap failure");
    Assert.Equal(retainedReason, 3, "heap scratch reset cannot erase invocation failure");
    Assert.True(retainedFailure == failure, "reserved rooted cell retained without allocation");
    Assert.Equal(outerReason, 0, "child context does not corrupt prior invocation");
    Assert.True(restored == outer && released == NativePointer(0), "every exit restores prior link");
    Assert.True(!CheckedScopeEnter(outer, 0), "missing admission handle rejects scope");
    GcUnrootHandle(failureHandle);
    GcCollect();
    SystemFree(outer, 64);
    SystemFree(inner, 64);
    SystemFree(descriptor, 40);
}
