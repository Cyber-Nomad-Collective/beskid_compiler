// Canonical Beskid cooperative fiber scheduler.
//
// Design mirrors the Rust runtime: a round-robin run queue, fiber state machine,
// pending spawn/cancel/detach queues, join snapshots, and wake lists.
//
// Platform context-switch assembly is declared by runtime_manifest.bsol. The
// compiler materializes the selected BeskidArchContext layout for the canonical
// source corpus; source never spells a target size, alignment, or assembly ABI.

// ── Fiber State Constants ──────────────────────────────────────────
pub enum FiberState {
    Runnable,
    Running,
    Parked,
    Done,
    Cancelled,
}

pub enum JoinOutcome {
    Ok,
    Cancelled,
    Panicked,
    NotDone,
    StackOverflow,
}

// Scheduler table allocated through `BeskidRuntimeState.scheduler` at offset 32.
//
// `BeskidRuntimeState` is a fixed ABI-v5 record (64 bytes); the scheduler table is
// runtime-owned native storage and must never be embedded past that record.  The
// table layout is 3456 bytes:
//   offset    0: fiber_count (word)
//   offset    8: main_fiber (word)
//   offset   16: run_queue_head (word)
//   offset   24: run_queue_tail (word)
//   offset   32: run_queue[32] (32 words)
//   offset  288: pending_spawns[8] (8 * 40 bytes: entry/arg/cancel/parent)
//   offset  608: pending_spawn_count (word)
//   offset  616: pending_cancels[32] (32 words)
//   offset  872: pending_cancel_count (word)
//   offset  880: pending_detaches[32] (32 words)
//   offset 1136: pending_detach_count (word)
//   offset 1144: pending_wakes[32] (32 words)
//   offset 1400: pending_wake_count (word)
//   offset 1408: fiber_table[16] (16 * 128 bytes each)
//   offset 3456: channel_table (pointer to a separately allocated, zeroed
//                Channel.bd table)
//   offset 3464: mutex_table (pointer to a separately allocated, zeroed
//                Mutex.bd table)
//   offset 3472: waitgroup_table (pointer to a separately allocated, zeroed
//                WaitGroup.bd table)
//   offset 3480: current_fiber (word; 0xFFFF when no canonical fiber is
//                executing on this scheduler thread)
//   offset 3488: hub_table (pointer to a separately allocated, zeroed
//                PubSub Hub.bd table)
//
// Each fiber record (128 bytes):
//   offset   0: state (word)
//   offset   8: entry (pointer)
//   offset  16: arg (pointer)
//   offset  24: cancel_slot (pointer)
//   offset  32: parent (word)
//   offset  40: detached (u8)
//   offset  41: cancelled (u8)
//   offset  48: outcome_kind (word)
//   offset  56: outcome_value (i64)
//   offset  64: join_snapshot_state (word)
//   offset  72: join_snapshot_cancelled (u8)
//   offset  80: join_snapshot_outcome_kind (word)
//   offset  88: join_snapshot_outcome_value (i64)
//   offset  96: stack_ptr (pointer)
//   offset 104: arch_context (pointer) -- points to BeskidArchContext
//   offset 112: arch_context_size (word) -- selected manifest layout size

const FIBER_TABLE_MAX = 16;
const FIBER_SLOT_SIZE = 128;
const FIBER_NONE = 0xFFFF;
// Guarded stacks are a scheduler-owned native reservation. The manifest-only
// adapter derives the target's guard granularity; source owns the portable
// usable-capacity policy and never addresses below the returned usable base.
const FIBER_STACK_INITIAL_SIZE = 65536;
const FIBER_STACK_MAX_SIZE = 8388608;
const SCHEDULER_STATE_OFFSET = 32;
// The scheduler owns pointers to optional synchronization state.  The pointed
// objects are separately allocated so a fixed ABI-v5 runtime state never
// becomes backing storage for synchronization tables.
const SCHEDULER_CHANNEL_STATE_OFFSET = 3456;
const SCHEDULER_MUTEX_STATE_OFFSET = 3464;
const SCHEDULER_WAITGROUP_STATE_OFFSET = 3472;
const SCHEDULER_CURRENT_FIBER_OFFSET = 3480;
const SCHEDULER_HUB_STATE_OFFSET = 3488;
const SCHEDULER_TABLE_SIZE = 3496;

// Returns the selected target's BeskidArchContext record size. This compiler-owned
// intrinsic is available only to the canonical runtime corpus and is materialized
// from runtime_manifest.bsol, never from a source-level target switch.
pub word ArchContextSize() {
    return arch_context_size();
}

// Returns the selected target's BeskidArchContext record alignment.
pub word ArchContextAlignment() {
    return arch_context_alignment();
}

// Reserves a target-native guarded stack. The returned address is the first
// writable usable byte; the inaccessible guard immediately precedes it.
pub pointer GuardedStackAllocate(word usableSize) {
    return guarded_stack_allocate(usableSize);
}

// Releases the original reservation without exposing its lower guard.
pub unit GuardedStackFree(pointer usableBase, word usableSize) {
    guarded_stack_free(usableBase, usableSize);
    return;
}

// The sole assembly boundary for preparing a canonical fiber context. Its symbol,
// signature, and target calling convention are all manifest-owned.
pub unit ContextInit(pointer context, pointer stackTop, pointer entry, pointer argument, pointer returnTrampoline) {
    context_init(context, stackTop, entry, argument, returnTrampoline);
    return;
}

// The sole assembly boundary for saving and resuming a canonical fiber context.
pub unit ContextSwitch(pointer from, pointer to) {
    context_switch(from, to);
    return;
}

// Returns the scheduler table owned by the active ABI-v5 runtime state.
pub pointer SchedTable() {
    pointer state = RuntimeState();
    if state == NativePointer(0) {
        return NativePointer(0);
    }
    return NativePointer(raw_word_load(pointer_add(state, SCHEDULER_STATE_OFFSET)));
}

// Returns the separately allocated channel table owned by this scheduler.
// The first caller initializes the scheduler and creates the table; later
// callers reuse the same allocation.  Channel operations deliberately do not
// claim parking or wake semantics here; this is storage ownership only.
pub pointer SchedulerChannelTable() {
    SchedInit();
    pointer scheduler = SchedTable();
    if scheduler == NativePointer(0) {
        return NativePointer(0);
    }
    mut pointer table = NativePointer(raw_word_load(pointer_add(scheduler, SCHEDULER_CHANNEL_STATE_OFFSET)));
    if table != NativePointer(0) {
        return table;
    }
    table = SystemAllocate(CHANNEL_TABLE_SIZE, 8);
    if table == NativePointer(0) {
        return NativePointer(0);
    }
    memory_set(table, 0, CHANNEL_TABLE_SIZE);
    raw_word_store(pointer_add(scheduler, SCHEDULER_CHANNEL_STATE_OFFSET), NativeWord(table));
    return table;
}

// Returns the separately allocated mutex table owned by this scheduler.
// As with channels, synchronization state is not embedded after the fixed
// ABI-v5 runtime record; its lifetime follows the scheduler allocation.
pub pointer SchedulerMutexTable() {
    SchedInit();
    pointer scheduler = SchedTable();
    if scheduler == NativePointer(0) {
        return NativePointer(0);
    }
    mut pointer table = NativePointer(raw_word_load(pointer_add(scheduler, SCHEDULER_MUTEX_STATE_OFFSET)));
    if table != NativePointer(0) {
        return table;
    }
    table = SystemAllocate(MUTEX_TABLE_SIZE, 8);
    if table == NativePointer(0) {
        return NativePointer(0);
    }
    memory_set(table, 0, MUTEX_TABLE_SIZE);
    raw_word_store(pointer_add(scheduler, SCHEDULER_MUTEX_STATE_OFFSET), NativeWord(table));
    return table;
}

// Returns the separately allocated WaitGroup table owned by this scheduler.
// The waiter registry is bounded by the scheduler's fiber-table capacity, so
// it cannot overlap scheduler records or silently truncate registered waiters.
pub pointer SchedulerWaitGroupTable() {
    SchedInit();
    pointer scheduler = SchedTable();
    if scheduler == NativePointer(0) {
        return NativePointer(0);
    }
    mut pointer table = NativePointer(raw_word_load(pointer_add(scheduler, SCHEDULER_WAITGROUP_STATE_OFFSET)));
    if table != NativePointer(0) {
        return table;
    }
    table = SystemAllocate(WG_TABLE_SIZE, 8);
    if table == NativePointer(0) {
        return NativePointer(0);
    }
    memory_set(table, 0, WG_TABLE_SIZE);
    raw_word_store(pointer_add(scheduler, SCHEDULER_WAITGROUP_STATE_OFFSET), NativeWord(table));
    return table;
}

// Returns the separately allocated PubSub hub table owned by this scheduler.
// Hub state is a runtime object with the scheduler lifetime; it must not use a
// literal RuntimeState offset or overlap the ABI-v5 runtime-state record.
pub pointer SchedulerHubTable() {
    SchedInit();
    pointer scheduler = SchedTable();
    if scheduler == NativePointer(0) {
        return NativePointer(0);
    }
    mut pointer table = NativePointer(raw_word_load(pointer_add(scheduler, SCHEDULER_HUB_STATE_OFFSET)));
    if table != NativePointer(0) {
        return table;
    }
    table = SystemAllocate(HUB_TABLE_SIZE, 8);
    if table == NativePointer(0) {
        return NativePointer(0);
    }
    memory_set(table, 0, HUB_TABLE_SIZE);
    raw_word_store(pointer_add(scheduler, SCHEDULER_HUB_STATE_OFFSET), NativeWord(table));
    return table;
}

// Returns a fiber record pointer by index.
pub pointer FiberRecord(word index) {
    pointer table = SchedTable();
    if table == NativePointer(0) {
        return NativePointer(0);
    }
    return pointer_add(table, 1408 + index * FIBER_SLOT_SIZE);
}

// A handle is an index into the scheduler-owned fixed fiber table.  Never
// form a record address for an absent/stale handle: join operations must fail
// closed rather than read adjacent scheduler state.
pub bool FiberExists(word index) {
    pointer table = SchedTable();
    if table == NativePointer(0) {
        return false;
    }
    return index < raw_word_load(table);
}

// Stores a terminal stack-overflow outcome for an allocation that could not
// obtain its context or guarded stack.  The handle is intentionally retained
// in the one scheduler table so callers can observe status 3 without a fake
// stack reservation or a second failure registry.
pub unit FiberAllocationFailed(word index) {
    pointer fib = FiberRecord(index);
    memory_set(fib, 0, FIBER_SLOT_SIZE);
    raw_word_store(fib, FiberState::Done);
    raw_word_store(pointer_add(fib, 48), JoinOutcome::StackOverflow);
    raw_word_store(pointer_add(fib, 56), 0);
    return;
}

// Allocate a fiber slot. Returns the index or 0xFFFF on failure.
pub word FiberAlloc(word entry, word arg, word cancelSlot, word parent) {
    pointer table = SchedTable();
    if table == NativePointer(0) {
        return 0xFFFF;
    }
    word count = raw_word_load(table);
    if count >= FIBER_TABLE_MAX {
        return 0xFFFF;
    }
    pointer fib = FiberRecord(count);
    memory_set(fib, 0, FIBER_SLOT_SIZE);
    // Context storage is independent from the fixed scheduler record and derives
    // both of its allocation parameters from the selected ABI-v5 target layout.
    pointer context = SystemAllocate(ArchContextSize(), ArchContextAlignment());
    if context == NativePointer(0) {
        FiberAllocationFailed(count);
        raw_word_store(table, count + 1);
        return count;
    }
    pointer stack = GuardedStackAllocate(FIBER_STACK_INITIAL_SIZE);
    if stack == NativePointer(0) {
        SystemFree(context, ArchContextSize());
        FiberAllocationFailed(count);
        raw_word_store(table, count + 1);
        return count;
    }
    memory_set(context, 0, ArchContextSize());
    raw_word_store(fib, FiberState::Runnable);
    raw_word_store(pointer_add(fib, 8), entry);
    raw_word_store(pointer_add(fib, 16), arg);
    raw_word_store(pointer_add(fib, 24), cancelSlot);
    raw_word_store(pointer_add(fib, 32), parent);
    raw_byte_store(pointer_add(fib, 40), 0); // detached
    raw_byte_store(pointer_add(fib, 41), 0); // cancelled
    raw_word_store(pointer_add(fib, 96), NativeWord(stack));
    raw_word_store(pointer_add(fib, 104), NativeWord(context));
    raw_word_store(pointer_add(fib, 112), ArchContextSize());
    raw_word_store(table, count + 1);
    return count;
}

// Returns the public join status for one live scheduler record.  The five
// values are ABI-stable: 0 normal, 1 cancelled, 2 panicked/stale, 3 allocation
// or stack overflow, and 4 not yet terminal.
pub word FiberJoinStatusWord(word index) {
    if !FiberExists(index) {
        return JoinOutcome::Panicked;
    }
    pointer fib = FiberRecord(index);
    word state = raw_word_load(fib);
    if state != FiberState::Done && state != FiberState::Cancelled {
        return JoinOutcome::NotDone;
    }
    word outcome = raw_word_load(pointer_add(fib, 48));
    if outcome == JoinOutcome::Ok || outcome == JoinOutcome::Cancelled || outcome == JoinOutcome::Panicked || outcome == JoinOutcome::StackOverflow {
        return outcome;
    }
    return JoinOutcome::Panicked;
}

// The current handle is scheduler-owned rather than a second TLS/global
// scheduler.  A no-fiber sentinel is never observable through the public ABI.
pub word SchedulerCurrentFiber() {
    pointer table = SchedTable();
    if table == NativePointer(0) {
        return FIBER_NONE;
    }
    return raw_word_load(pointer_add(table, SCHEDULER_CURRENT_FIBER_OFFSET));
}

pub unit SchedulerSetCurrentFiber(word index) {
    pointer table = SchedTable();
    if table != NativePointer(0) {
        raw_word_store(pointer_add(table, SCHEDULER_CURRENT_FIBER_OFFSET), index);
    }
    return;
}

// ── Run Queue ──────────────────────────────────────────────────────

// Push a fiber index onto the run queue.
pub unit RunQueuePush(word fiberIndex) {
    pointer table = SchedTable();
    if table == NativePointer(0) { return; }
    word tail = raw_word_load(pointer_add(table, 24));
    raw_word_store(pointer_add(table, 32 + tail * 8), fiberIndex);
    raw_word_store(pointer_add(table, 24), (tail + 1) % 32);
    return;
}

// Pop a fiber index from the run queue. Returns 0xFFFF if empty.
pub word RunQueuePop() {
    pointer table = SchedTable();
    if table == NativePointer(0) { return 0xFFFF; }
    word head = raw_word_load(pointer_add(table, 16));
    word tail = raw_word_load(pointer_add(table, 24));
    if head == tail { return 0xFFFF; }
    word fiberIndex = raw_word_load(pointer_add(table, 32 + head * 8));
    raw_word_store(pointer_add(table, 16), (head + 1) % 32);
    return fiberIndex;
}

// Check if run queue is empty.
pub bool RunQueueEmpty() {
    pointer table = SchedTable();
    if table == NativePointer(0) { return true; }
    return raw_word_load(pointer_add(table, 16)) == raw_word_load(pointer_add(table, 24));
}

// ── Fiber State Transitions ────────────────────────────────────────

// Set fiber state. Must hold scheduler lock.
pub unit FiberSetState(word index, word state) {
    pointer fib = FiberRecord(index);
    raw_word_store(fib, state);
    return;
}

// Get fiber state.
pub word FiberState(word index) {
    pointer fib = FiberRecord(index);
    return raw_word_load(fib);
}

// Check if fiber is parked (waiting on a channel/mutex/wg).
pub bool FiberParked(word index) {
    return FiberState(index) == FiberState::Parked;
}

// Check if fiber is finished.
pub bool FiberFinished(word index) {
    word s = FiberState(index);
    return s == FiberState::Done || s == FiberState::Cancelled;
}

// Mark fiber done with a return value.
pub unit FiberDone(word index, i64 value) {
    pointer fib = FiberRecord(index);
    u8 cancelled = raw_byte_load(pointer_add(fib, 41));
    if cancelled != 0 {
        raw_word_store(fib, FiberState::Cancelled);
        raw_word_store(pointer_add(fib, 48), JoinOutcome::Cancelled);
        raw_word_store(pointer_add(fib, 56), 0);
    } else {
        raw_word_store(fib, FiberState::Done);
        raw_word_store(pointer_add(fib, 48), JoinOutcome::Ok);
        raw_word_store(pointer_add(fib, 56), word(value));
    }
    return;
}

// ── Pending Operations ─────────────────────────────────────────────

// Enqueue a pending spawn (applied at next scheduling step).
pub unit PendingSpawnEnqueue(word entry, word arg, word cancelSlot, word parent) {
    pointer table = SchedTable();
    if table == NativePointer(0) { return; }
    word count = raw_word_load(pointer_add(table, 608));
    if count >= 8 { return; }
    pointer slot = pointer_add(table, 288 + count * 40);
    raw_word_store(slot, entry);
    raw_word_store(pointer_add(slot, 8), arg);
    raw_word_store(pointer_add(slot, 16), cancelSlot);
    raw_word_store(pointer_add(slot, 24), parent);
    raw_word_store(pointer_add(table, 608), count + 1);
    return;
}

// Apply all pending spawns.
pub unit ApplyPendingSpawns() {
    pointer table = SchedTable();
    if table == NativePointer(0) { return; }
    word count = raw_word_load(pointer_add(table, 608));
    mut word i = 0;
    while i < count {
        pointer slot = pointer_add(table, 288 + i * 40);
        word entry = raw_word_load(slot);
        word arg = raw_word_load(pointer_add(slot, 8));
        word cancelSlot = raw_word_load(pointer_add(slot, 16));
        word parent = raw_word_load(pointer_add(slot, 24));
        word idx = FiberAlloc(entry, arg, cancelSlot, parent);
        if idx != 0xFFFF {
            RunQueuePush(idx);
        }
        i = i + 1;
    }
    raw_word_store(pointer_add(table, 608), 0);
    return;
}

// Enqueue a pending cancel.
pub unit PendingCancelEnqueue(word fiberIndex) {
    pointer table = SchedTable();
    if table == NativePointer(0) { return; }
    word count = raw_word_load(pointer_add(table, 872));
    if count >= 32 { return; }
    raw_word_store(pointer_add(table, 616 + count * 8), fiberIndex);
    raw_word_store(pointer_add(table, 872), count + 1);
    return;
}

// Apply all pending cancels.
pub unit ApplyPendingCancels() {
    pointer table = SchedTable();
    if table == NativePointer(0) { return; }
    word count = raw_word_load(pointer_add(table, 872));
    mut word i = 0;
    while i < count {
        word idx = raw_word_load(pointer_add(table, 616 + i * 8));
        if FiberExists(idx) {
            pointer fib = FiberRecord(idx);
            word state = FiberState(idx);
            raw_byte_store(pointer_add(fib, 41), 1); // cancelled
            // Queued and parked fibers reach a cancellation point at this
            // scheduler step. A running fiber observes the same flag when it
            // next yields or returns through its real target context path.
            if state == FiberState::Runnable || state == FiberState::Parked {
                raw_word_store(fib, FiberState::Cancelled);
                raw_word_store(pointer_add(fib, 48), JoinOutcome::Cancelled);
                raw_word_store(pointer_add(fib, 56), 0);
            }
        }
        i = i + 1;
    }
    raw_word_store(pointer_add(table, 872), 0);
    return;
}

// Enqueue a wake (fiber is ready to run again).
pub unit WakeEnqueue(word fiberIndex) {
    pointer table = SchedTable();
    if table == NativePointer(0) { return; }
    word count = raw_word_load(pointer_add(table, 1400));
    if count >= 32 { return; }
    raw_word_store(pointer_add(table, 1144 + count * 8), fiberIndex);
    raw_word_store(pointer_add(table, 1400), count + 1);
    return;
}

// Apply all pending wakes.
pub unit ApplyPendingWakes() {
    pointer table = SchedTable();
    if table == NativePointer(0) { return; }
    word count = raw_word_load(pointer_add(table, 1400));
    mut word i = 0;
    while i < count {
        word idx = raw_word_load(pointer_add(table, 1144 + i * 8));
        if FiberParked(idx) {
            FiberSetState(idx, FiberState::Runnable);
        }
        RunQueuePush(idx);
        i = i + 1;
    }
    raw_word_store(pointer_add(table, 1400), 0);
    return;
}

// ── Scheduler Main Loop ────────────────────────────────────────────

// Initialize the scheduler for the first time.
pub unit SchedInit() {
    mut pointer table = SchedTable();
    if table != NativePointer(0) { return; }
    pointer state = RuntimeState();
    table = SystemAllocate(SCHEDULER_TABLE_SIZE, 8);
    if table == NativePointer(0) { return; }
    memory_set(table, 0, SCHEDULER_TABLE_SIZE);
    raw_word_store(pointer_add(state, SCHEDULER_STATE_OFFSET), NativeWord(table));
    word mainIdx = FiberAlloc(0, 0, 0, 0xFFFF);
    raw_word_store(pointer_add(table, 8), mainIdx);
    if FiberJoinStatusWord(mainIdx) != JoinOutcome::StackOverflow {
        // Fiber 0 exists before main entry and is the initial current fiber;
        // it is not pushed as a synthetic child job.
        FiberSetState(mainIdx, FiberState::Running);
        SchedulerSetCurrentFiber(mainIdx);
    } else {
        SchedulerSetCurrentFiber(FIBER_NONE);
    }
    return;
}

// Registers work in the scheduler-owned table. Context switching is deliberately
// outside this ownership slice; the queued record preserves the ABI-v5 spawn
// boundary until the manifest-authorized target execution path is enabled.
pub i64 SchedulerSpawn(pointer entry, pointer environment, pointer cancelledSlot) {
    SchedInit();
    pointer table = SchedTable();
    if table == NativePointer(0) { return -1; }
    word index = FiberAlloc(NativeWord(entry), NativeWord(environment), NativeWord(cancelledSlot), 0xFFFF);
    if index == FIBER_NONE { return -1; }
    if FiberJoinStatusWord(index) != JoinOutcome::StackOverflow {
        RunQueuePush(index);
    }
    return i64(index);
}

// Initializes one capture-free syntax fiber dispatch through the canonical ABI-v5 runtime boundary.
//
// This ABI export is co-located with `SchedulerSpawn`: the canonical runtime lowerer follows
// direct calls only within the compiled runtime unit, so placing the boundary in Bootstrap would
// leave its scheduler implementation unreachable. The cancellation slot is initialized to null
// before the scheduler receives ownership of the queued fiber record.
[Export(Abi:"C", Symbol:"beskid_rt_v5_fiber_spawn_with_cancel_slot")]
pub i64 FiberSpawnWithCancelSlot(pointer entry, pointer environment, pointer cancelledSlot) {
    if cancelledSlot != NativePointer(0) {
        raw_word_store(cancelledSlot, 0);
    }
    return SchedulerSpawn(entry, environment, cancelledSlot);
}

// Drive one scheduling step. Returns true if work was done.
pub bool SchedStep() {
    pointer table = SchedTable();
    if table == NativePointer(0) { return false; }
    word fiberCount = raw_word_load(table);
    ApplyPendingSpawns();
    ApplyPendingCancels();
    ApplyPendingWakes();

    if RunQueueEmpty() {
        // Check if any fibers are still alive (runnable or parked).
        mut word i = 0; mut bool alive = false;
        while i < fiberCount {
            word s = FiberState(i);
            if s == FiberState::Runnable || s == FiberState::Parked || s == FiberState::Running {
                alive = true;
            }
            i = i + 1;
        }
        if !alive {
            return false; // Scheduler done — all fibers finished.
        }
        return false; // Nothing to run but fibers exist (all parked — deadlock risk).
    }

    word next = RunQueuePop();
    if next == 0xFFFF { return false; }
    if FiberParked(next) { return true; } // Skip parked.

    FiberSetState(next, FiberState::Running);

    // This lifecycle slice deliberately does not claim a context transfer.
    // The target-specific execution task must call ContextInit/ContextSwitch
    // and complete the running record through FiberDone.  In particular, do
    // not reinterpret an entry pointer as a return value or fabricate a
    // direct-call execution path here.
    SchedulerSetCurrentFiber(next);

    return true;
}

// Run the scheduler until quiescence. Returns the main fiber's result.
pub i64 SchedRun() {
    SchedInit();
    mut word steps = 0;
    while steps < 10000 {
        if !SchedStep() {
            // Check all-blocked (deadlock).
            pointer table = SchedTable();
            word fiberCount = raw_word_load(table);
            mut word i = 0; mut bool anyAlive = false; mut bool anyRunnable = false;
            while i < fiberCount {
                word s = FiberState(i);
                if s == FiberState::Runnable { anyAlive = true; }
                if s == FiberState::Parked { anyRunnable = true; }
                i = i + 1;
            }
            if !anyRunnable {
                break;
            }
            if anyAlive {
                // All fibers parked — deadlock.
                Trap(7, NativePointer(0), 0); // scheduler_deadlock
            }
            break;
        }
        steps = steps + 1;
    }
    pointer table = SchedTable();
    return 0;
}

// ── C ABI Exports ──────────────────────────────────────────────────

[Export(Abi:"C", Symbol:"runtime_preempt_check")]
pub unit RuntimePreemptCheck() {
    return;
}
