// Canonical Beskid fiber primitives.

// Spawns a runtime-owned child with a source-described managed capture environment.
[Export(Abi:"C", Symbol:"fiber_spawn")]
pub i64 FiberSpawn(pointer entry, pointer argument) {
    pointer cancelSlot = SystemAllocate(8, 8);
    if cancelSlot == NativePointer(0) {
        return -1;
    }
    raw_word_store(cancelSlot, 0);
    return SchedulerSpawn(entry, argument, cancelSlot);
}

// Cancels a running fiber by ID. The reason is stored in the fiber record
// and surfaced by the public FiberError::Cancelled(reason, cancelerId) result.
[Export(Abi:"C", Symbol:"fiber_cancel")]
pub bool FiberCancel(i64 fiberId, i64 reason) {
    if fiberId < 0 {
        return false;
    }
    word handle = word(fiberId);
    if !FiberHandleValid(handle) { return false; }
    word index = FiberHandleIndex(handle);
    if raw_byte_load(pointer_add(FiberRecord(index), 42)) != 0 { return false; }
    word state = FiberState(index);
    if state == FIBER_STATE_DONE || state == FIBER_STATE_CANCELLED {
        return false;
    }
    pointer fib = FiberRecord(index);
    pointer cancelSlot = NativePointer(raw_word_load(pointer_add(fib, 24)));
    if raw_byte_load(pointer_add(fib, 41)) != 0 || (cancelSlot != NativePointer(0) && raw_word_load(cancelSlot) != 0) { return true; }
    raw_word_store(pointer_add(fib, FIBER_OUTCOME_REASON_OFFSET), word(reason));
    raw_word_store(pointer_add(fib, FIBER_OUTCOME_CANCELER_OFFSET), word(FiberCurrentId()));
    if cancelSlot != NativePointer(0) {
        raw_word_store(cancelSlot, 1);
    }
    PendingCancelEnqueue(index);
    return true;
}

// Resumes a parked fiber. Duplicate resumes are coalesced by the wake queue.
pub bool FiberResume(i64 fiberId) {
    if fiberId < 0 || !FiberHandleValid(word(fiberId)) { return false; }
    word index = FiberHandleIndex(word(fiberId));
    if !FiberParked(index) { return false; }
    WakeEnqueue(index);
    return true;
}

// Detaches a fiber (fire-and-forget).
[Export(Abi:"C", Symbol:"fiber_detach")]
pub unit FiberDetach(i64 fiberId) {
    if fiberId < 0 {
        return;
    }
    word handle = word(fiberId);
    if !FiberHandleValid(handle) { return; }
    word index = FiberHandleIndex(handle);
    pointer fib = FiberRecord(index);
    if raw_byte_load(pointer_add(fib, 42)) != 0 { return; }
    raw_byte_store(pointer_add(fib, 40), 1);
    raw_byte_store(pointer_add(fib, 42), 1);
    if FiberJoinStatusWord(index) == FIBER_JOIN_PANICKED { Trap(9, NativePointer(0), 0); }
    if FiberFinished(index) { FiberCleanup(index); }
    return;
}

// Waits on the owner scheduler until the child's terminal outcome is available.
[Export(Abi:"C", Symbol:"fiber_join_status")]
pub i32 FiberJoinStatus(i64 fiberId) {
    if fiberId < 0 {
        return i32(FIBER_JOIN_PANICKED);
    }
    word handle = word(fiberId);
    if !FiberHandleValid(handle) { return i32(FIBER_JOIN_PANICKED); }
    word index = FiberHandleIndex(handle);
    if raw_byte_load(pointer_add(FiberRecord(index), 40)) != 0 || raw_byte_load(pointer_add(FiberRecord(index), 42)) != 0 { return i32(FIBER_JOIN_PANICKED); }
    while FiberJoinStatusWord(index) == FIBER_JOIN_NOT_DONE {
        if SchedulerCurrentFiber() == index { Trap(7, NativePointer(0), 0); }
        if SchedulerCurrentFiber() == FIBER_NONE {
            if SchedStep() == false {
                if ExternalActiveCount() == 0 { Trap(7, NativePointer(0), 0); }
                owner_wait(ExternalOwnerId(), ExternalNextDeadline());
            }
        } else {
            FiberYield();
        }
    }
    return i32(FiberJoinStatusWord(index));
}

// Returns the join value of a completed fiber.
[Export(Abi:"C", Symbol:"fiber_join_value")]
pub bool FiberJoinValue(i64 fiberId, pointer destination) {
    if fiberId < 0 || !FiberHandleValid(word(fiberId)) || FiberJoinStatusWord(FiberHandleIndex(word(fiberId))) != FIBER_JOIN_OK {
        return false;
    }
    word index = FiberHandleIndex(word(fiberId));
    pointer fiber = FiberRecord(index);
    if raw_byte_load(pointer_add(fiber, 40)) != 0 || raw_byte_load(pointer_add(fiber, 42)) != 0 { return false; }
    if AbiValueMoveOut(pointer_add(fiber, BESKID_FIBER_RECORD_RESULT_OFFSET), destination) == false { return false; }
    raw_byte_store(pointer_add(fiber, 42), 1);
    FiberCleanup(index);
    return true;
}

// Read terminal cancellation/panic/stack details without consuming the result.
[Export(Abi:"C", Symbol:"fiber_join_detail")]
pub i64 FiberJoinDetail(i64 fiberId, word detail) {
    if fiberId < 0 || !FiberHandleValid(word(fiberId)) || detail > 3 { return 0; }
    pointer fiber = FiberRecord(FiberHandleIndex(word(fiberId)));
    if raw_byte_load(pointer_add(fiber, 42)) != 0 { return 0; }
    return i64(raw_word_load(pointer_add(fiber, FIBER_OUTCOME_REASON_OFFSET + detail * 8)));
}

[Export(Abi:"C", Symbol:"fiber_join_message")]
pub pointer FiberJoinMessage(i64 fiberId) {
    if fiberId < 0 || !FiberHandleValid(word(fiberId)) { return StrNew(NativePointer(0), 0); }
    pointer fiber = FiberRecord(FiberHandleIndex(word(fiberId)));
    if raw_byte_load(pointer_add(fiber, 42)) != 0 { return StrNew(NativePointer(0), 0); }
    pointer message = NativePointer(raw_word_load(pointer_add(fiber, 56)));
    if message == NativePointer(0) { return StrNew(NativePointer(0), 0); }
    // Transfer the ordinary native string view; cleanup no longer owns this message.
    raw_word_store(pointer_add(fiber, 56), 0);
    return message;
}

[Export(Abi:"C", Symbol:"fiber_join_error_finish")]
pub bool FiberJoinErrorFinish(i64 fiberId) {
    if fiberId < 0 || !FiberHandleValid(word(fiberId)) { return false; }
    word index = FiberHandleIndex(word(fiberId));
    pointer fiber = FiberRecord(index);
    word status = FiberJoinStatusWord(index);
    if status == FIBER_JOIN_OK || status == FIBER_JOIN_NOT_DONE || raw_byte_load(pointer_add(fiber, 42)) != 0 { return false; }
    raw_byte_store(pointer_add(fiber, 42), 1);
    FiberCleanup(index);
    return true;
}

// Monotonic time in milliseconds since an arbitrary epoch.
[Export(Abi:"C", Symbol:"fiber_now_millis")]
pub i64 FiberNowMillis() {
    i64 nanos = clock_monotonic_nanos();
    if nanos < 0 { return -1; }
    return nanos / 1000000;
}

// Number of logical processors available.
[Export(Abi:"C", Symbol:"fiber_processor_count")]
pub word FiberProcessorCount() {
    return 1;
}
