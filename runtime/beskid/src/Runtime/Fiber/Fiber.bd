// Canonical Beskid fiber primitives.

// Spawns a new fiber from a capture-free entry point.
[Export(Abi:"C", Symbol:"fiber_spawn")]
pub i64 FiberSpawn(pointer entry, pointer argument) {
    pointer cancelSlot = SystemAllocate(8, 8);
    if cancelSlot == NativePointer(0) {
        return -1;
    }
    raw_word_store(cancelSlot, 0);
    return SchedulerSpawn(entry, argument, cancelSlot);
}

// Cancels a running fiber by ID. The reason is stored in the fiber record
// and surfaced via FiberJoinStatus::Cancelled(reason, cancelerId).
[Export(Abi:"C", Symbol:"fiber_cancel")]
pub bool FiberCancel(i64 fiberId, i64 reason) {
    if fiberId < 0 {
        return false;
    }
    word handle = word(fiberId);
    if !FiberHandleValid(handle) { return false; }
    word index = FiberHandleIndex(handle);
    word state = FiberState(index);
    if state == FiberState::Done || state == FiberState::Cancelled {
        return false;
    }
    pointer fib = FiberRecord(index);
    raw_word_store(pointer_add(fib, FIBER_OUTCOME_REASON_OFFSET), word(reason));
    raw_word_store(pointer_add(fib, FIBER_OUTCOME_CANCELER_OFFSET), SchedulerCurrentFiber());
    pointer cancelSlot = NativePointer(raw_word_load(pointer_add(fib, 24)));
    if cancelSlot != NativePointer(0) {
        raw_word_store(cancelSlot, 1);
    }
    PendingCancelEnqueue(index);
    return true;
}

// Resumes a parked fiber. Duplicate resumes are coalesced by the wake queue.
pub bool FiberResume(i64 fiberId) {
    if fiberId < 0 || !FiberHandleValid(word(fiberId)) { return false; }
    word index = FiberHandleIndex(word(fiberId));
    if !FiberParked(index) { return false; }
    WakeEnqueue(index);
    return true;
}

// Detaches a fiber (fire-and-forget).
[Export(Abi:"C", Symbol:"fiber_detach")]
pub unit FiberDetach(i64 fiberId) {
    if fiberId < 0 {
        return;
    }
    word handle = word(fiberId);
    if !FiberHandleValid(handle) { return; }
    word index = FiberHandleIndex(handle);
    pointer fib = FiberRecord(index);
    raw_byte_store(pointer_add(fib, 40), 1);
    if FiberFinished(index) { FiberCleanup(index); }
    return;
}

// Returns the join status of a fiber.
[Export(Abi:"C", Symbol:"fiber_join_status")]
pub i32 FiberJoinStatus(i64 fiberId) {
    if fiberId < 0 {
        return i32(FIBER_JOIN_PANICKED);
    }
    word handle = word(fiberId);
    if !FiberHandleValid(handle) { return i32(FIBER_JOIN_PANICKED); }
    return i32(FiberJoinStatusWord(FiberHandleIndex(handle)));
}

// Returns the join value of a completed fiber.
[Export(Abi:"C", Symbol:"fiber_join_value")]
pub i64 FiberJoinValue(i64 fiberId) {
    if fiberId < 0 || !FiberHandleValid(word(fiberId)) || FiberJoinStatusWord(FiberHandleIndex(word(fiberId))) != FIBER_JOIN_OK {
        Trap(6, NativePointer(0), 0);
        return 0;
    }
    return i64(raw_word_load(pointer_add(FiberRecord(FiberHandleIndex(word(fiberId))), 56)));
}

// Monotonic time in milliseconds since an arbitrary epoch.
[Export(Abi:"C", Symbol:"fiber_now_millis")]
pub i64 FiberNowMillis() {
    i64 nanos = clock_monotonic_nanos();
    if nanos < 0 { return -1; }
    return nanos / 1000000;
}

// Number of logical processors available.
[Export(Abi:"C", Symbol:"fiber_processor_count")]
pub word FiberProcessorCount() {
    return 1;
}
