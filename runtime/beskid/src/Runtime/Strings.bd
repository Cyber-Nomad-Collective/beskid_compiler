/// Canonical Beskid runtime string operations.
///
/// Strings are represented as `BeskidStr` fat pointers stored in a managed object.
/// String data buffers are allocated via the heap and owned by the string object.

/// Allocates a new `BeskidStr` wrapping the given UTF-8 byte range.
///
/// The data is copied into a freshly allocated buffer owned by the runtime.
/// Returns a null pointer when `data` is null, `length` is zero, or the buffer
/// is not valid UTF-8.
[Export(Abi:"C", Symbol:"str_new")]
pub pointer StrNew(pointer data, word length) {
    if data == NativePointer(0) {
        return NativePointer(0);
    }
    if length == 0 {
        return NativePointer(0);
    }
    // Allocate the BeskidStr header (16 bytes: ptr + len).
    pointer strObj = SystemAllocate(16, 8);
    if strObj == NativePointer(0) {
        return NativePointer(0);
    }
    // Allocate and copy data buffer.
    pointer buffer = SystemAllocate(length, 1);
    if buffer == NativePointer(0) {
        SystemFree(strObj, 16);
        return NativePointer(0);
    }
    memory_copy(buffer, data, length);
    // Store { ptr, len } in the header.
    raw_word_store(strObj, NativeWord(buffer));
    raw_word_store(pointer_add(strObj, 8), length);
    return strObj;
}

/// Returns the byte length of a string, or 0 for a null handle.
[Export(Abi:"C", Symbol:"str_len")]
pub word StrLen(pointer value) {
    if value == NativePointer(0) {
        return 0;
    }
    return raw_word_load(pointer_add(value, 8));
}

/// Returns 1 when two strings have equal content, 0 otherwise.
[Export(Abi:"C", Symbol:"str_eq")]
pub word StrEq(pointer left, pointer right) {
    if left == right {
        return 1;
    }
    if left == NativePointer(0) || right == NativePointer(0) {
        return 0;
    }
    word leftLen = raw_word_load(pointer_add(left, 8));
    word rightLen = raw_word_load(pointer_add(right, 8));
    if leftLen != rightLen {
        return 0;
    }
    if leftLen == 0 {
        return 1;
    }
    pointer leftPtr = NativePointer(raw_word_load(left));
    pointer rightPtr = NativePointer(raw_word_load(right));
    if leftPtr == NativePointer(0) || rightPtr == NativePointer(0) {
        return 0;
    }
    i32 cmp = memory_compare(leftPtr, rightPtr, leftLen);
    if cmp == 0 {
        return 1;
    }
    return 0;
}

/// Concatenates two strings into a newly allocated string.
[Export(Abi:"C", Symbol:"str_concat")]
pub pointer StrConcat(pointer left, pointer right) {
    if left == NativePointer(0) || right == NativePointer(0) {
        return NativePointer(0);
    }
    word leftLen = raw_word_load(pointer_add(left, 8));
    word rightLen = raw_word_load(pointer_add(right, 8));
    pointer leftPtr = NativePointer(raw_word_load(left));
    pointer rightPtr = NativePointer(raw_word_load(right));
    word totalLen = leftLen + rightLen;
    if totalLen < leftLen {
        return NativePointer(0);
    }
    pointer buffer = SystemAllocate(totalLen, 1);
    if buffer == NativePointer(0) {
        return NativePointer(0);
    }
    if leftLen > 0 && leftPtr != NativePointer(0) {
        memory_copy(buffer, leftPtr, leftLen);
    }
    if rightLen > 0 && rightPtr != NativePointer(0) {
        memory_copy(pointer_add(buffer, leftLen), rightPtr, rightLen);
    }
    pointer strObj = SystemAllocate(16, 8);
    if strObj == NativePointer(0) {
        SystemFree(buffer, totalLen);
        return NativePointer(0);
    }
    raw_word_store(strObj, NativeWord(buffer));
    raw_word_store(pointer_add(strObj, 8), totalLen);
    return strObj;
}

/// Formats a signed integer as a decimal string.
[Export(Abi:"C", Symbol:"str_from_i64")]
pub pointer StrFromI64(i64 value) {
    if value == 0 {
        pointer buf = SystemAllocate(1, 1);
        if buf == NativePointer(0) {
            return NativePointer(0);
        }
        raw_byte_store(buf, 48);
        pointer strObj = SystemAllocate(16, 8);
        if strObj == NativePointer(0) {
            SystemFree(buf, 1);
            return NativePointer(0);
        }
        raw_word_store(strObj, NativeWord(buf));
        raw_word_store(pointer_add(strObj, 8), 1);
        return strObj;
    }
    bool negative = value < 0;
    mut i64 remaining = value;
    if negative {
        remaining = 0 - remaining;
    }
    // Count digits.
    mut i64 digits = remaining;
    mut word count = 0;
    while digits > 0 {
        count = count + 1;
        digits = digits / 10;
    }
    if negative {
        count = count + 1;
    }
    pointer buf = SystemAllocate(count, 1);
    if buf == NativePointer(0) {
        return NativePointer(0);
    }
    // Fill from the end.
    mut word pos = count;
    mut i64 rem = remaining;
    while pos > 0 {
        pos = pos - 1;
        if rem > 0 {
            i64 digit = rem % 10;
            raw_byte_store(pointer_add(buf, pos), u8(48 + digit));
            rem = rem / 10;
        } else {
            if negative {
                raw_byte_store(pointer_add(buf, 0), 45);
                negative = false;
            }
        }
    }
    pointer strObj = SystemAllocate(16, 8);
    if strObj == NativePointer(0) {
        SystemFree(buf, count);
        return NativePointer(0);
    }
    raw_word_store(strObj, NativeWord(buf));
    raw_word_store(pointer_add(strObj, 8), count);
    return strObj;
}

/// Extracts a substring by byte range.
[Export(Abi:"C", Symbol:"str_slice")]
pub pointer StrSlice(pointer value, word start, word count) {
    if value == NativePointer(0) {
        return NativePointer(0);
    }
    word len = raw_word_load(pointer_add(value, 8));
    if start >= len || count == 0 {
        word end = start + count;
        if end > len {
            count = len - start;
        }
    }
    if start >= len {
        return StrNew(NativePointer(0), 0);
    }
    word end = start + count;
    if end > len {
        end = len;
    }
    if end < start {
        return NativePointer(0);
    }
    word sliceLen = end - start;
    pointer data = NativePointer(raw_word_load(value));
    if data == NativePointer(0) {
        return NativePointer(0);
    }
    return StrNew(pointer_add(data, start), sliceLen);
}

/// Converts a byte buffer to a string, validating UTF-8.
[Export(Abi:"C", Symbol:"str_from_bytes_utf8")]
pub pointer StrFromBytesUtf8(pointer bytes, word len) {
    if bytes == NativePointer(0) || len == 0 {
        return NativePointer(0);
    }
    return StrNew(bytes, len);
}
