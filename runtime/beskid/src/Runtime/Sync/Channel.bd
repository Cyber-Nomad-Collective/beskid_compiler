// Sole owner-mutator channel protocol. Stable linked cells never relocate address-rooted
// BeskidAbiValue slots. Capacity zero grows dynamically, subject to allocation/root limits.
const CHANNEL_TABLE_MAX = 64;
const CHANNEL_SLOT_SIZE = 112;
const CHANNEL_CELL_SIZE = 56;
const CHANNEL_CELL_VALUE = 16;
const CHANNEL_SEND_WAITERS = 48;
const CHANNEL_RECEIVE_WAITERS = 56;
const CHANNEL_RECEIPT_OWNER = 64;
const CHANNEL_RECEIPT_VALUE = 72;
const CHANNEL_SENDER_OWNS = 1;
const CHANNEL_OWNS = 2;
const CHANNEL_RECEIVER_OWNS = 3;
const CHANNEL_STATUS_OK = 0;
const CHANNEL_STATUS_CLOSED = 1;
const CHANNEL_STATUS_CANCELLED = 2;
const CHANNEL_STATUS_WOULD_BLOCK = 3;
// Manifest channel_operation byte: low 2 bits are the current call phase;
// high 6 bits count claimed receipts (0..63). Nested calls preserve receipts.
const CHANNEL_OPERATION_PHASE_MASK = 3;
const CHANNEL_OPERATION_RECEIPT_UNIT = 4;
const CHANNEL_OPERATION_RECEIPT_MASK = 252;

pub pointer ChannelTable() { return SchedulerChannelTable(); }

// Beskid `const` items have no `pub` visibility (see the grammar's `ConstantDefinition` rule):
// they only resolve within their own declaring file. Callers in other packages — including
// tests that are not part of the compiler-embedded runtime fixture allowlist — read the
// channel status discriminants through these functions instead of the bare constants.
// `i64`, not `word`: every channel status producer (`ChannelTrySend`, `ChannelSend`,
// `ChannelTryReceive`, `ChannelCommit`, `ChannelPark`) returns `i64` (its `[Export(Abi:"C")]`
// callers need a fixed-width type), and Beskid's generic `Assert.Equal<T>` requires an exact
// declared-type match between its two arguments — `word` and `i64` are distinct declared types
// despite sharing a 64-bit representation, so a `word` accessor here would make every comparison
// against those callers fail to type-check.
pub i64 ChannelStatusOk() { return CHANNEL_STATUS_OK; }
pub i64 ChannelStatusClosed() { return CHANNEL_STATUS_CLOSED; }
pub i64 ChannelStatusWouldBlock() { return CHANNEL_STATUS_WOULD_BLOCK; }

// The scheduler has one heap mutator. Critical sections never switch context or
// invoke a GC safepoint. This checked lock rejects reentrancy; foreign workers
// are not permitted to mutate this heap.
pub unit ChannelLock(pointer ch) {
    if raw_word_load(pointer_add(ch, 40)) != 0 { Trap(10, NativePointer(0), 0); }
    raw_word_store(pointer_add(ch, 40), 1);
    return;
}
pub unit ChannelUnlock(pointer ch) {
    if raw_word_load(pointer_add(ch, 40)) != 1 { Trap(10, NativePointer(0), 0); }
    raw_word_store(pointer_add(ch, 40), 0);
    return;
}
pub bool ChannelCancelled() {
    word index = SchedulerCurrentFiber();
    if index == FIBER_NONE || !FiberExists(index) { return false; }
    pointer fiber = FiberRecord(index);
    pointer cancel = NativePointer(raw_word_load(pointer_add(fiber, 24)));
    return raw_byte_load(pointer_add(fiber, 41)) != 0
        || (cancel != NativePointer(0) && raw_word_load(cancel) != 0);
}
pub word ChannelReceiver() { return word(FiberCurrentId()); }
pub bool ChannelHasOperation(word index) {
    return FiberExists(index)
        && raw_byte_load(pointer_add(FiberRecord(index), BESKID_FIBER_RECORD_CHANNEL_OPERATION_OFFSET)) != 0;
}
pub unit ChannelOperation(u8 ownership) {
    if ownership > CHANNEL_OPERATION_PHASE_MASK { Trap(10, NativePointer(0), 0); }
    word index = SchedulerCurrentFiber();
    if index != FIBER_NONE && FiberExists(index) {
        pointer state = pointer_add(FiberRecord(index), BESKID_FIBER_RECORD_CHANNEL_OPERATION_OFFSET);
        raw_byte_store(state, (raw_byte_load(state) & CHANNEL_OPERATION_RECEIPT_MASK) | ownership);
    }
    return;
}
pub unit ChannelReceiptOperation(word receiver, bool acquire) {
    if receiver == 0xFFFFFFFFFFFFFFFF { return; }
    if !FiberHandleValid(receiver) { Trap(10, NativePointer(0), 0); }
    pointer state = pointer_add(FiberRecord(FiberHandleIndex(receiver)), BESKID_FIBER_RECORD_CHANNEL_OPERATION_OFFSET);
    u8 current = raw_byte_load(state);
    u8 receipts = current & CHANNEL_OPERATION_RECEIPT_MASK;
    if acquire {
        if receipts == CHANNEL_OPERATION_RECEIPT_MASK { Trap(10, NativePointer(0), 0); }
        raw_byte_store(state, current + CHANNEL_OPERATION_RECEIPT_UNIT);
    } else {
        if receipts == 0 { Trap(10, NativePointer(0), 0); }
        raw_byte_store(state, current - CHANNEL_OPERATION_RECEIPT_UNIT);
    }
    return;
}

[Export(Abi:"C", Symbol:"channel_create")]
pub i64 ChannelCreate(i64 capacity, i64 flags) {
    if capacity < 0 { return -1; }
    pointer table = ChannelTable();
    if table == NativePointer(0) { return -1; }
    word count = raw_word_load(table);
    if count >= CHANNEL_TABLE_MAX { return -1; }
    pointer ch = pointer_add(table, 8 + count * CHANNEL_SLOT_SIZE);
    memory_set(ch, 0, CHANNEL_SLOT_SIZE);
    raw_word_store(pointer_add(ch, 24), word(capacity));
    raw_word_store(table, count + 1);
    return i64(count);
}
pub pointer ChannelSlot(i64 id) {
    if id < 0 || word(id) >= CHANNEL_TABLE_MAX { return NativePointer(0); }
    pointer table = ChannelTable();
    if table == NativePointer(0) || word(id) >= raw_word_load(table) { return NativePointer(0); }
    return pointer_add(table, 8 + word(id) * CHANNEL_SLOT_SIZE);
}

// Called locked. A failed move leaves the sender and queue untouched.
pub i64 ChannelCommit(pointer ch, pointer sender) {
    if ChannelCancelled() { return CHANNEL_STATUS_CANCELLED; }
    if raw_word_load(pointer_add(ch, 32)) != 0 { return CHANNEL_STATUS_CLOSED; }
    if !AbiValueIsLive(sender) { Trap(10, NativePointer(0), 0); }
    word count = raw_word_load(pointer_add(ch, 16));
    word capacity = raw_word_load(pointer_add(ch, 24));
    if capacity != 0 && count >= capacity { return CHANNEL_STATUS_WOULD_BLOCK; }
    pointer cell = SystemAllocate(CHANNEL_CELL_SIZE, 8);
    if cell == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    memory_set(cell, 0, CHANNEL_CELL_SIZE);
    raw_word_store(pointer_add(cell, 8), CHANNEL_SENDER_OWNS);
    if !AbiValueMoveOut(sender, pointer_add(cell, CHANNEL_CELL_VALUE)) {
        SystemFree(cell, CHANNEL_CELL_SIZE);
        Trap(5, NativePointer(0), 0);
    }
    // Single SenderOwns -> ChannelOwns commit before publishing the stable link.
    raw_word_store(pointer_add(cell, 8), CHANNEL_OWNS);
    pointer tail = NativePointer(raw_word_load(pointer_add(ch, 8)));
    if tail == NativePointer(0) { raw_word_store(ch, NativeWord(cell)); }
    else { raw_word_store(tail, NativeWord(cell)); }
    raw_word_store(pointer_add(ch, 8), NativeWord(cell));
    raw_word_store(pointer_add(ch, 16), count + 1);
    ChannelWakeOne(ch, CHANNEL_RECEIVE_WAITERS);
    return CHANNEL_STATUS_OK;
}
[Export(Abi:"C", Symbol:"channel_try_send")]
pub i64 ChannelTrySend(i64 id, pointer sender) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) { return CHANNEL_STATUS_CLOSED; }
    ChannelLock(ch);
    i64 status = ChannelCommit(ch, sender);
    ChannelUnlock(ch);
    if status == CHANNEL_STATUS_OK { HubWakeChannel(id); }
    return status;
}
[Export(Abi:"C", Symbol:"channel_send")]
pub i64 ChannelSend(i64 id, pointer sender) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) { return CHANNEL_STATUS_CLOSED; }
    ChannelLock(ch);
    mut word ownership = CHANNEL_SENDER_OWNS;
    mut i64 status = ChannelCommit(ch, sender);
    while status == CHANNEL_STATUS_WOULD_BLOCK {
        // Caller owns its stable, traced ABI slot while parked.
        status = ChannelPark(ch, CHANNEL_SEND_WAITERS);
        if status != CHANNEL_STATUS_OK { ChannelUnlock(ch); return status; }
        status = ChannelCommit(ch, sender);
    }
    if status == CHANNEL_STATUS_OK { ownership = CHANNEL_OWNS; }
    ChannelUnlock(ch);
    if ownership == CHANNEL_OWNS {
        HubWakeChannel(id);
        // Allow cancellation to race with reporting completion after commit.
        // The sender is vacant; cancellation cannot retract the queue's cell.
        ChannelOperation(2);
        FiberYield();
        ChannelOperation(0);
        ChannelLock(ch);
        if !AbiValueIsVacant(sender) { Trap(10, NativePointer(0), 0); }
        if ChannelCancelled() { status = CHANNEL_STATUS_CANCELLED; }
        ChannelUnlock(ch);
    }
    return status;
}
pub i64 ChannelClaimLocked(pointer ch) {
    pointer receipt = pointer_add(ch, CHANNEL_RECEIPT_VALUE);
    if !AbiValueIsVacant(receipt) { return CHANNEL_STATUS_WOULD_BLOCK; }
    if ChannelCancelled() { return CHANNEL_STATUS_CANCELLED; }
    word count = raw_word_load(pointer_add(ch, 16));
    if count == 0 {
        if raw_word_load(pointer_add(ch, 32)) != 0 { return CHANNEL_STATUS_CLOSED; }
        return CHANNEL_STATUS_WOULD_BLOCK;
    }
    pointer cell = NativePointer(raw_word_load(ch));
    if cell == NativePointer(0) || raw_word_load(pointer_add(cell, 8)) != CHANNEL_OWNS {
        Trap(10, NativePointer(0), 0);
    }
    if !AbiValueMoveOut(pointer_add(cell, CHANNEL_CELL_VALUE), receipt) { Trap(5, NativePointer(0), 0); }
    raw_word_store(pointer_add(cell, 8), CHANNEL_RECEIVER_OWNS);
    // Generation-safe receiver identity prevents another fiber stealing a receipt.
    raw_word_store(pointer_add(ch, CHANNEL_RECEIPT_OWNER), ChannelReceiver());
    ChannelReceiptOperation(ChannelReceiver(), true);
    raw_word_store(ch, raw_word_load(cell));
    if count == 1 { raw_word_store(pointer_add(ch, 8), 0); }
    raw_word_store(pointer_add(ch, 16), count - 1);
    SystemFree(cell, CHANNEL_CELL_SIZE);
    ChannelWakeOne(ch, CHANNEL_SEND_WAITERS);
    return CHANNEL_STATUS_OK;
}
pub i64 ChannelClaimReceive(i64 id) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) { return CHANNEL_STATUS_CLOSED; }
    ChannelLock(ch);
    i64 status = ChannelClaimLocked(ch);
    ChannelUnlock(ch);
    return status;
}
[Export(Abi:"C", Symbol:"channel_try_receive")]
pub i64 ChannelTryReceive(i64 id) { return ChannelClaimReceive(id); }
[Export(Abi:"C", Symbol:"channel_receive_status")]
pub i64 ChannelReceiveStatus(i64 id) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) { return CHANNEL_STATUS_CLOSED; }
    ChannelLock(ch);
    mut i64 status = ChannelClaimLocked(ch);
    while status == CHANNEL_STATUS_WOULD_BLOCK {
        status = ChannelPark(ch, CHANNEL_RECEIVE_WAITERS);
        if status != CHANNEL_STATUS_OK { ChannelUnlock(ch); return status; }
        status = ChannelClaimLocked(ch);
    }
    ChannelUnlock(ch);
    return status;
}
[Export(Abi:"C", Symbol:"channel_receive_value")]
pub bool ChannelReceiveValue(i64 id, pointer destination) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) { return false; }
    ChannelLock(ch);
    if raw_word_load(pointer_add(ch, CHANNEL_RECEIPT_OWNER)) != ChannelReceiver() {
        ChannelUnlock(ch); return false;
    }
    // Claim already committed. Cancellation cannot discard a successful receipt.
    bool moved = AbiValueMoveOut(pointer_add(ch, CHANNEL_RECEIPT_VALUE), destination);
    if moved {
        ChannelReceiptOperation(ChannelReceiver(), false);
        raw_word_store(pointer_add(ch, CHANNEL_RECEIPT_OWNER), 0);
        ChannelWakeOne(ch, CHANNEL_RECEIVE_WAITERS);
    }
    ChannelUnlock(ch);
    return moved;
}
// A terminal claimant may return or panic without consuming its receipt. Cleanup
// restores that oldest committed value before releasing the generation's stack.
// This is an ownership move, never a clear or resource disposal.
pub unit ChannelReleaseReceipts(word receiver) {
    if !FiberHandleValid(receiver) { return; }
    pointer table = ChannelTable();
    if table == NativePointer(0) { return; }
    mut word index = 0;
    while index < raw_word_load(table) {
        pointer ch = pointer_add(table, 8 + index * CHANNEL_SLOT_SIZE);
        ChannelLock(ch);
        if raw_word_load(pointer_add(ch, CHANNEL_RECEIPT_OWNER)) == receiver {
            pointer cell = SystemAllocate(CHANNEL_CELL_SIZE, 8);
            if cell == NativePointer(0) { Trap(5, NativePointer(0), 0); }
            memory_set(cell, 0, CHANNEL_CELL_SIZE);
            if !AbiValueMoveOut(pointer_add(ch, CHANNEL_RECEIPT_VALUE), pointer_add(cell, CHANNEL_CELL_VALUE)) {
                Trap(10, NativePointer(0), 0);
            }
            raw_word_store(pointer_add(cell, 8), CHANNEL_OWNS);
            raw_word_store(cell, raw_word_load(ch));
            raw_word_store(ch, NativeWord(cell));
            if raw_word_load(pointer_add(ch, 16)) == 0 { raw_word_store(pointer_add(ch, 8), NativeWord(cell)); }
            raw_word_store(pointer_add(ch, 16), raw_word_load(pointer_add(ch, 16)) + 1);
            raw_word_store(pointer_add(ch, CHANNEL_RECEIPT_OWNER), 0);
            ChannelReceiptOperation(receiver, false);
            ChannelWakeOne(ch, CHANNEL_RECEIVE_WAITERS);
            HubWakeChannel(i64(index));
        }
        ChannelUnlock(ch);
        index = index + 1;
    }
    pointer state = pointer_add(FiberRecord(FiberHandleIndex(receiver)), BESKID_FIBER_RECORD_CHANNEL_OPERATION_OFFSET);
    if (raw_byte_load(state) & CHANNEL_OPERATION_RECEIPT_MASK) != 0 { Trap(10, NativePointer(0), 0); }
    return;
}
[Export(Abi:"C", Symbol:"channel_close")]
pub unit ChannelClose(i64 id) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) { return; }
    ChannelLock(ch);
    raw_word_store(pointer_add(ch, 32), 1);
    ChannelWakeAll(ch, CHANNEL_SEND_WAITERS);
    ChannelWakeAll(ch, CHANNEL_RECEIVE_WAITERS);
    ChannelUnlock(ch);
    HubWakeChannel(id);
    return;
}
// Shutdown only. Close never calls this; tracing release never invokes Dispose.
pub unit ChannelDrain(pointer ch) {
    mut pointer cell = NativePointer(raw_word_load(ch));
    while cell != NativePointer(0) {
        pointer next = NativePointer(raw_word_load(cell));
        if !AbiValueClear(pointer_add(cell, CHANNEL_CELL_VALUE)) { Trap(10, NativePointer(0), 0); }
        SystemFree(cell, CHANNEL_CELL_SIZE);
        cell = next;
    }
    if !AbiValueClear(pointer_add(ch, CHANNEL_RECEIPT_VALUE)) { Trap(10, NativePointer(0), 0); }
    memory_set(ch, 0, CHANNEL_SLOT_SIZE);
    return;
}
pub unit ChannelWakeOne(pointer ch, word waiterOffset) {
    word waiters = raw_word_load(pointer_add(ch, waiterOffset));
    mut word index = 0;
    while index < FIBER_TABLE_MAX {
        word bit = word(1) << index;
        if (waiters & bit) != 0 {
            raw_word_store(pointer_add(ch, waiterOffset), waiters & (0xFFFFFFFFFFFFFFFF - bit));
            WakeEnqueue(index); return;
        }
        index = index + 1;
    }
    return;
}
pub unit ChannelWakeAll(pointer ch, word waiterOffset) {
    while raw_word_load(pointer_add(ch, waiterOffset)) != 0 { ChannelWakeOne(ch, waiterOffset); }
    return;
}
// Enter and return locked. Predicate/register/unlock cannot lose a wake.
pub i64 ChannelPark(pointer ch, word waiterOffset) {
    word index = SchedulerCurrentFiber();
    if index == FIBER_NONE || !FiberExists(index) { return CHANNEL_STATUS_WOULD_BLOCK; }
    if ChannelCancelled() { return CHANNEL_STATUS_CANCELLED; }
    pointer fiber = FiberRecord(index);
    word bit = word(1) << index;
    raw_word_store(pointer_add(ch, waiterOffset), raw_word_load(pointer_add(ch, waiterOffset)) | bit);
    FiberSetState(index, FIBER_STATE_PARKED);
    if waiterOffset == CHANNEL_SEND_WAITERS { ChannelOperation(1); }
    else { ChannelOperation(3); }
    ChannelUnlock(ch);
    SaveFiberLocalState(index);
    SchedulerSetCurrentFiber(FIBER_NONE);
    ContextSwitch(NativePointer(raw_word_load(pointer_add(fiber, 104))), SchedulerContext());
    ChannelLock(ch);
    ChannelOperation(0);
    raw_word_store(pointer_add(ch, waiterOffset), raw_word_load(pointer_add(ch, waiterOffset)) & (0xFFFFFFFFFFFFFFFF - bit));
    if ChannelCancelled() { return CHANNEL_STATUS_CANCELLED; }
    return CHANNEL_STATUS_OK;
}
