// Canonical Beskid channel: bounded FIFO queue with i64 payloads.
//
// Channels are slots in a scheduler-owned, separately allocated fixed-capacity
// table. Each channel has a ring buffer of i64 values, capacity limit, close
// flag, and wait lists.

const CHANNEL_TABLE_MAX = 64;
const CHANNEL_BUFFER_SIZE = 16; // ring buffer capacity per channel
const CHANNEL_SLOT_SIZE = 192;  // header + ring buffer + wait lists
const CHANNEL_TABLE_SIZE = 12296; // count word + CHANNEL_TABLE_MAX slots

// Returns the separately allocated channel table owned by the active scheduler.
// Channel storage must never be derived from an undeclared RuntimeState offset.
pub pointer ChannelTable() {
    return SchedulerChannelTable();
}

pub enum ChannelStatus {
    Ok,
    Closed,
    Cancelled,
    WouldBlock,
}

// Creates a channel. Capacity 0 means unbounded.
[Export(Abi:"C", Symbol:"channel_create")]
pub i64 ChannelCreate(i64 capacity, i64 flags) {
    pointer table = ChannelTable();
    if table == NativePointer(0) {
        return -1;
    }
    word count = raw_word_load(table);
    if count >= CHANNEL_TABLE_MAX {
        return -1;
    }
    pointer slot = pointer_add(table, 8 + count * CHANNEL_SLOT_SIZE);
    // Channel header: { head: word, tail: word, count: word, capacity: i64, closed: u8, buffer_start: pointer }
    raw_word_store(slot, 0);       // head = 0
    raw_word_store(pointer_add(slot, 8), 0);   // tail = 0
    raw_word_store(pointer_add(slot, 16), 0);  // count = 0
    raw_word_store(pointer_add(slot, 24), word(capacity));
    raw_byte_store(pointer_add(slot, 32), 0);  // closed = 0
    // Zero the ring buffer.
    mut word i = 0;
    while i < CHANNEL_BUFFER_SIZE {
        raw_word_store(pointer_add(slot, 40 + i * 8), 0);
        i = i + 1;
    }
    raw_word_store(table, count + 1);
    return i64(count);
}

// Reads channel header at given table index.
pub pointer ChannelSlot(i64 id) {
    word slotIndex = word(id);
    if slotIndex >= CHANNEL_TABLE_MAX {
        return NativePointer(0);
    }
    pointer table = ChannelTable();
    if table == NativePointer(0) {
        return NativePointer(0);
    }
    return pointer_add(table, 8 + slotIndex * CHANNEL_SLOT_SIZE);
}

// Sends a value to the channel, blocking if bounded and full.
[Export(Abi:"C", Symbol:"channel_send")]
pub i64 ChannelSend(i64 id, i64 value) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) {
        return ChannelStatus::Closed;
    }
    u8 closed = raw_byte_load(pointer_add(ch, 32));
    if closed != 0 {
        return ChannelStatus::Closed;
    }
    word count = raw_word_load(pointer_add(ch, 16));
    i64 cap = i64(raw_word_load(pointer_add(ch, 24)));
    if cap > 0 && i64(count) >= cap {
        return ChannelStatus::WouldBlock;
    }
    word tail = raw_word_load(pointer_add(ch, 8));
    raw_word_store(pointer_add(ch, 40 + (tail % CHANNEL_BUFFER_SIZE) * 8), word(value));
    raw_word_store(pointer_add(ch, 8), (tail + 1) % CHANNEL_BUFFER_SIZE);
    raw_word_store(pointer_add(ch, 16), count + 1);
    return ChannelStatus::Ok;
}

// Tries to send without blocking.
[Export(Abi:"C", Symbol:"channel_try_send")]
pub i64 ChannelTrySend(i64 id, i64 value) {
    return ChannelSend(id, value);
}

// Blocks until a message is available (or channel closes), without dequeuing.
[Export(Abi:"C", Symbol:"channel_receive_status")]
pub i64 ChannelReceiveStatus(i64 id) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) {
        return ChannelStatus::Closed;
    }
    u8 closed = raw_byte_load(pointer_add(ch, 32));
    word count = raw_word_load(pointer_add(ch, 16));
    if count > 0 {
        return ChannelStatus::Ok;
    }
    if closed != 0 {
        return ChannelStatus::Closed;
    }
    return ChannelStatus::WouldBlock;
}

// Dequeues a value after a successful receive_status call.
[Export(Abi:"C", Symbol:"channel_receive_value")]
pub i64 ChannelReceiveValue(i64 id) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) {
        return 0;
    }
    word count = raw_word_load(pointer_add(ch, 16));
    if count == 0 {
        return 0;
    }
    word head = raw_word_load(pointer_add(ch, 0));
    word value = raw_word_load(pointer_add(ch, 40 + (head % CHANNEL_BUFFER_SIZE) * 8));
    raw_word_store(pointer_add(ch, 40 + (head % CHANNEL_BUFFER_SIZE) * 8), 0);
    raw_word_store(pointer_add(ch, 0), (head + 1) % CHANNEL_BUFFER_SIZE);
    raw_word_store(pointer_add(ch, 16), count - 1);
    return i64(value);
}

// Tries to receive without blocking. Writes value to *out on success.
[Export(Abi:"C", Symbol:"channel_try_receive")]
pub bool ChannelTryReceive(i64 id) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) {
        return false;
    }
    word count = raw_word_load(pointer_add(ch, 16));
    if count == 0 {
        return false;
    }
    word head = raw_word_load(pointer_add(ch, 0));
    raw_word_store(pointer_add(ch, 40 + (head % CHANNEL_BUFFER_SIZE) * 8), 0);
    raw_word_store(pointer_add(ch, 0), (head + 1) % CHANNEL_BUFFER_SIZE);
    raw_word_store(pointer_add(ch, 16), count - 1);
    return true;
}

// Closes the channel. Wakes all waiters.
[Export(Abi:"C", Symbol:"channel_close")]
pub unit ChannelClose(i64 id) {
    pointer ch = ChannelSlot(id);
    if ch == NativePointer(0) {
        return;
    }
    raw_byte_store(pointer_add(ch, 32), 1);
    return;
}

// ── Phase B pointer-payload variants ───────────────────────────────

[Export(Abi:"C", Symbol:"channel_send_ptr")]
pub i64 ChannelSendPtr(i64 id, pointer valuePtr) {
    if valuePtr == NativePointer(0) {
        return ChannelStatus::Cancelled;
    }
    return ChannelSend(id, i64(NativeWord(valuePtr)));
}

[Export(Abi:"C", Symbol:"channel_try_send_ptr")]
pub i64 ChannelTrySendPtr(i64 id, pointer valuePtr) {
    if valuePtr == NativePointer(0) {
        return ChannelStatus::Cancelled;
    }
    return ChannelTrySend(id, i64(NativeWord(valuePtr)));
}

[Export(Abi:"C", Symbol:"channel_receive_ptr")]
pub pointer ChannelReceivePtr(i64 id) {
    i64 value = ChannelReceiveValue(id);
    return NativePointer(word(value));
}

[Export(Abi:"C", Symbol:"channel_try_receive_ptr")]
pub pointer ChannelTryReceivePtr(i64 id) {
    i64 value = ChannelReceiveValue(id);
    return NativePointer(word(value));
}
