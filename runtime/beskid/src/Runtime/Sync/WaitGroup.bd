// Canonical Beskid WaitGroup counter with Add/Done/Wait.

const WG_TABLE_MAX = 16;
// Every registered waiter is a scheduler fiber, and the active scheduler has
// exactly 16 fiber records (`FIBER_TABLE_MAX`). Therefore 16 is an exact bound
// for one group's simultaneously registered waiter identities, not a smaller
// arbitrary queue that can contradict the scheduler's public capacity.
const WG_WAITER_MAX = 16;
const WG_SLOT_SIZE = 144; // counter + waiter_count + 16 waiter fiber IDs

// Returns the separately allocated WaitGroup table owned by the active scheduler.
// WaitGroup storage must never be derived from an undeclared RuntimeState offset.
pub pointer WgTable() {
    return SchedulerWaitGroupTable();
}

// Creates a wait group and returns its opaque ID.
[Export(Abi:"C", Symbol:"wait_group_create")]
pub pointer WaitGroupCreate() {
    pointer table = WgTable();
    if table == NativePointer(0) {
        return NativePointer(0);
    }
    word count = raw_word_load(table);
    if count >= WG_TABLE_MAX {
        return NativePointer(0);
    }
    pointer slot = pointer_add(table, 8 + count * WG_SLOT_SIZE);
    raw_word_store(slot, 0);
    raw_word_store(pointer_add(slot, 8), 0);
    mut word waiter = 0;
    while waiter < WG_WAITER_MAX {
        raw_word_store(pointer_add(slot, 16 + waiter * 8), 0);
        waiter = waiter + 1;
    }
    raw_word_store(table, count + 1);
    return NativePointer(count);
}

// Queues every waiter registered on `slot` for the scheduler wake phase.
// This is intentionally only the ownership/wake-recording half of cooperative
// waiting: fiber context switching remains the scheduler's separate ABI work.
pub unit WaitGroupWakeAll(pointer slot) {
    word count = raw_word_load(pointer_add(slot, 8));
    mut word i = 0;
    while i < count {
        WakeEnqueue(raw_word_load(pointer_add(slot, 16 + i * 8)));
        raw_word_store(pointer_add(slot, 16 + i * 8), 0);
        i = i + 1;
    }
    raw_word_store(pointer_add(slot, 8), 0);
    return;
}

// Adds `delta` to the wait group counter.
[Export(Abi:"C", Symbol:"wait_group_add")]
pub unit WaitGroupAdd(pointer id, i64 delta) {
    word slotIndex = NativeWord(id);
    if slotIndex >= WG_TABLE_MAX {
        return;
    }
    pointer table = WgTable();
    if table == NativePointer(0) {
        return;
    }
    pointer slot = pointer_add(table, 8 + slotIndex * WG_SLOT_SIZE);
    i64 current = i64(raw_word_load(slot));
    raw_word_store(slot, word(i64(word(current)) + delta));
    return;
}

// Decrements the counter. Wakes waiters when it reaches zero.
[Export(Abi:"C", Symbol:"wait_group_done")]
pub unit WaitGroupDone(pointer id) {
    word slotIndex = NativeWord(id);
    if slotIndex >= WG_TABLE_MAX {
        return;
    }
    pointer table = WgTable();
    if table == NativePointer(0) {
        return;
    }
    pointer slot = pointer_add(table, 8 + slotIndex * WG_SLOT_SIZE);
    i64 current = i64(raw_word_load(slot));
    current = current - 1;
    if current < 0 {
        current = 0;
    }
    raw_word_store(slot, word(i64(word(current))));
    if current == 0 {
        WaitGroupWakeAll(slot);
    }
    return;
}

// Blocks until the counter reaches zero.
[Export(Abi:"C", Symbol:"wait_group_wait")]
pub i32 WaitGroupWait(pointer id) {
    word slotIndex = NativeWord(id);
    if slotIndex >= WG_TABLE_MAX {
        return 0;
    }
    pointer table = WgTable();
    if table == NativePointer(0) {
        return 0;
    }
    pointer slot = pointer_add(table, 8 + slotIndex * WG_SLOT_SIZE);
    i64 current = i64(raw_word_load(slot));
    if current <= 0 {
        return 0;
    }
    word waiterCount = raw_word_load(pointer_add(slot, 8));
    word currentFiber = word(FiberCurrentId());
    mut word i = 0;
    while i < waiterCount {
        if raw_word_load(pointer_add(slot, 16 + i * 8)) == currentFiber {
            return 1;
        }
        i = i + 1;
    }
    if waiterCount < WG_WAITER_MAX {
        raw_word_store(pointer_add(slot, 16 + waiterCount * 8), currentFiber);
        raw_word_store(pointer_add(slot, 8), waiterCount + 1);
    }
    return 1;
}
