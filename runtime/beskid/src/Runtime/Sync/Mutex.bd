// Canonical Beskid fiber-aware mutex.
//
// Each mutex is a slot in a scheduler-owned, separately allocated fixed-capacity
// table. Waiters queue as fiber IDs when running inside a scheduler; outside a
// scheduler, lock/unlock still works for try_lock.

const MUTEX_TABLE_MAX = 32;

pub enum MutexState {
    Unlocked,
    Locked,
}

// ── Scheduler-owned mutex table ─────────────────────────────────────

const MUTEX_SLOT_SIZE = 40; // u8 locked + u8 pad + word owner + 8 * word waiters
const MUTEX_TABLE_SIZE = 1288; // count word + MUTEX_TABLE_MAX slots

// Returns the separately allocated mutex table owned by the active scheduler.
// Mutex storage must never be derived from an undeclared RuntimeState offset.
pub pointer MutexTable() {
    return SchedulerMutexTable();
}

// Creates a mutex and returns its opaque ID (slot index).
[Export(Abi:"C", Symbol:"mutex_create")]
pub pointer MutexCreate() {
    pointer table = MutexTable();
    if table == NativePointer(0) {
        return NativePointer(0);
    }
    word count = raw_word_load(table);
    if count >= MUTEX_TABLE_MAX {
        return NativePointer(0);
    }
    pointer slot = pointer_add(table, 8 + count * MUTEX_SLOT_SIZE);
    raw_byte_store(slot, MutexState::Unlocked);
    raw_word_store(pointer_add(slot, 8), 0);
    mut word i = 0;
    while i < 8 {
        raw_word_store(pointer_add(slot, 16 + i * 8), 0);
        i = i + 1;
    }
    raw_word_store(table, count + 1);
    return NativePointer(count);
}

// Locks the mutex, blocking the current fiber if already held.
// Returns 0 on success, 1 on cancellation.
[Export(Abi:"C", Symbol:"mutex_lock")]
pub i32 MutexLock(pointer id) {
    word slotIndex = NativeWord(id);
    if slotIndex >= MUTEX_TABLE_MAX {
        return 1;
    }
    pointer table = MutexTable();
    if table == NativePointer(0) {
        return 1;
    }
    pointer slot = pointer_add(table, 8 + slotIndex * MUTEX_SLOT_SIZE);
    // Spin-lock: in the absence of fiber scheduler, busy-wait briefly.
    mut word attempts = 0;
    while attempts < 1000 {
        u8 locked = raw_byte_load(slot);
        if locked == MutexState::Unlocked {
            raw_byte_store(slot, MutexState::Locked);
            raw_word_store(pointer_add(slot, 8), NativeWord(CurrentThreadState()));
            return 0;
        }
        attempts = attempts + 1;
    }
    // If scheduler is available, park the fiber. Otherwise return WOULD_BLOCK.
    return 1;
}

// Tries to lock the mutex without blocking. Returns 0 on success.
[Export(Abi:"C", Symbol:"mutex_try_lock")]
pub i32 MutexTryLock(pointer id) {
    word slotIndex = NativeWord(id);
    if slotIndex >= MUTEX_TABLE_MAX {
        return 1;
    }
    pointer table = MutexTable();
    if table == NativePointer(0) {
        return 1;
    }
    pointer slot = pointer_add(table, 8 + slotIndex * MUTEX_SLOT_SIZE);
    u8 locked = raw_byte_load(slot);
    if locked == MutexState::Locked {
        return 1;
    }
    raw_byte_store(slot, MutexState::Locked);
    raw_word_store(pointer_add(slot, 8), NativeWord(CurrentThreadState()));
    return 0;
}

// Unlocks the mutex. Wake the first waiter if any.
[Export(Abi:"C", Symbol:"mutex_unlock")]
pub unit MutexUnlock(pointer id) {
    word slotIndex = NativeWord(id);
    if slotIndex >= MUTEX_TABLE_MAX {
        return;
    }
    pointer table = MutexTable();
    if table == NativePointer(0) {
        return;
    }
    pointer slot = pointer_add(table, 8 + slotIndex * MUTEX_SLOT_SIZE);
    raw_byte_store(slot, MutexState::Unlocked);
    raw_word_store(pointer_add(slot, 8), 0);
    // Wake first waiter by yielding (scheduler will pick it up).
    return;
}
