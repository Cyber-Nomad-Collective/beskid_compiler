/// Canonical Beskid dynamic dispatch primitives.
///
/// DynamicCell wraps a heap-allocated value with a shape ID for checked casts.
/// AOT mappings and fallback dispatch route through registered shape tables.

const DYNAMIC_OK = 0;
const DYNAMIC_ERR_INCOMPATIBLE = 1;
const DYNAMIC_ERR_NULL_PAYLOAD = 2;
const DYNAMIC_ERR_UNKNOWN_SRC_SHAPE = 3;
const DYNAMIC_ERR_UNKNOWN_DST_SHAPE = 4;

const DynamicCellSize = 32;

[Export(Abi:"C", Symbol:"dynamic_cast_checked")]
pub i32 DynamicCastChecked(pointer cell, i32 expectedShapeId) {
    if cell == NativePointer(0) { return DYNAMIC_ERR_NULL_PAYLOAD; }
    i32 actualId = i32(raw_word_load(pointer_add(cell, 16)));
    if actualId == expectedShapeId { return DYNAMIC_OK; }
    return DYNAMIC_ERR_INCOMPATIBLE;
}

[Export(Abi:"C", Symbol:"dynamic_cell_create")]
pub pointer DynamicCellCreate(pointer value, pointer descriptor) {
    if value == NativePointer(0) { return NativePointer(0); }
    pointer cell = Alloc(DynamicCellSize, NativePointer(0));
    if cell == NativePointer(0) { return NativePointer(0); }
    raw_word_store(cell, NativeWord(value));
    raw_word_store(pointer_add(cell, 8), NativeWord(descriptor));
    raw_word_store(pointer_add(cell, 16), 0);
    raw_word_store(pointer_add(cell, 24), 0);
    return cell;
}

[Export(Abi:"C", Symbol:"dynamic_cell_wrap")]
pub pointer DynamicCellWrap(pointer value, pointer descriptor) {
    return DynamicCellCreate(value, descriptor);
}

[Export(Abi:"C", Symbol:"dynamic_map_aot")]
pub pointer DynamicMapAot(pointer cell, pointer mapping) {
    if cell == NativePointer(0) { return NativePointer(0); }
    return NativePointer(raw_word_load(cell));
}

[Export(Abi:"C", Symbol:"dynamic_map_fallback")]
pub pointer DynamicMapFallback(pointer cell, pointer mapping) {
    if cell == NativePointer(0) { return NativePointer(0); }
    return NativePointer(raw_word_load(cell));
}

[Export(Abi:"C", Symbol:"dynamic_object_alloc")]
pub pointer DynamicObjectAlloc(pointer descriptor) {
    if descriptor == NativePointer(0) { return NativePointer(0); }
    word size = TypeDescriptorSize(descriptor);
    if size == 0 { return NativePointer(0); }
    return Alloc(size, descriptor);
}
