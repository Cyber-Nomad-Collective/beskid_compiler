// Descriptor-driven transit of a managed object graph between heaps (v0.6.3), an Erlang-style
// structural copy (Erlang `copy_struct`; Johansson, Sagonas, Wilhelmsson, ISMM 2002,
// https://doi.org/10.1145/773039.512440).
//
// A transit is two steps on two threads. `TransitCapture` runs on the source heap's mutator: it
// walks the graph from one managed reference, validates every object fail-closed, and writes a
// native transit record; it never writes the source heap. `TransitMaterialize` runs on the
// destination heap's mutator: it allocates every object of the record in the current heap and
// rewrites the internal references. Sharing and cycles are preserved exactly: the walk keeps a
// visited table from source object to record index, so an object met again is the same record
// entry. Spawn captures, port messages and non-adoptable results use the same record.
//
// Rules of the walk:
// - A reference that is not an object of the source heap (`ManagedObjectForReference` fails: a
//   pointer into another isolate's heap, or into no heap) is kept unchanged and not entered.
// - With `shareImmutable`, an object whose descriptor carries `TYPE_DESCRIPTOR_IMMUTABLE` is kept
//   by pointer and not entered (a Shared capture; the spawning scope roots it).
// - An aggregate rewrites every pointer-map offset; an array (`TYPE_DESCRIPTOR_ARRAY`) applies
//   the element descriptor's stride and pointer map to each of `length` elements and copies
//   `length` and `capacity`; a UTF-8 view record (`TYPE_DESCRIPTOR_UTF8_VIEW`) is copied together
//   with its backing byte array. Words outside the pointer maps are copied as bits.
// - Refused: a descriptor that fails `ValidateTypeDescriptor` (unknown flag bits included), an
//   object whose size cannot be derived, an array whose `length` exceeds `capacity`, and an
//   element pointer-map offset outside the element stride. A refusal produces no record; the
//   refused descriptor address is reported to the caller.
//
// Record layout (native, `SystemAllocate`d; the first word is the allocation size so that any
// owner, including the port ring, can free it):
//   0 byte size, 8 object count, 16 encoded root reference, 24 bytes used, then the images.
// Image: 0 descriptor, 8 object size (header included), 16 alignment, then the object's bytes
// from offset 16 to its size, pointer fields encoded.
// Encoded reference: 0 for null; an internal reference is `index << 6 | delta | 1` with `delta`
// the reference's offset from its object (0, or 24 for an array or view public reference); any
// other value is an external reference copied unchanged (always 8-aligned).

const TYPE_DESCRIPTOR_ARRAY = 1;
const TYPE_DESCRIPTOR_UTF8_VIEW = 2;
const TYPE_DESCRIPTOR_KIND_MASK = 3;

const TRANSIT_SIZE = 0;
const TRANSIT_COUNT = 8;
const TRANSIT_ROOT = 16;
const TRANSIT_USED = 24;
const TRANSIT_HEADER = 32;
const TRANSIT_INITIAL_SIZE = 256;

const IMAGE_DESCRIPTOR = 0;
const IMAGE_SIZE = 8;
const IMAGE_ALIGNMENT = 16;
const IMAGE_HEADER = 24;

// Capture scratch (native): record, objects vector (data, count, capacity), visited table
// (entries, capacity, count; entry = source object, index + 1), refused descriptor, flags.
const CAPTURE_SCRATCH_SIZE = 72;
const CAPTURE_RECORD = 0;
const CAPTURE_OBJECTS = 8;
const CAPTURE_OBJECT_COUNT = 16;
const CAPTURE_OBJECT_CAPACITY = 24;
const CAPTURE_VISITED = 32;
const CAPTURE_VISITED_CAPACITY = 40;
const CAPTURE_HEAP = 48;
const CAPTURE_REFUSED = 56;
const CAPTURE_SHARE_IMMUTABLE = 64;
const VISITED_ENTRY_SIZE = 16;

// ── Capture ───────────────────────────────────────────────────────────

// Walks the graph of `value` in the current heap into a new native record. Returns the record, or
// null when an object is refused; then `refusedOut` (when not null) receives the descriptor
// address that was refused. A null `value` produces a record whose root is null.
pub pointer TransitCapture(pointer value, bool shareImmutable, pointer refusedOut) {
    pointer scratch = SystemAllocate(CAPTURE_SCRATCH_SIZE, 8);
    if scratch == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    memory_set(scratch, 0, CAPTURE_SCRATCH_SIZE);
    raw_word_store(pointer_add(scratch, CAPTURE_HEAP), NativeWord(Heap()));
    if shareImmutable { raw_word_store(pointer_add(scratch, CAPTURE_SHARE_IMMUTABLE), 1); }
    pointer record = SystemAllocate(TRANSIT_INITIAL_SIZE, 8);
    if record == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    memory_set(record, 0, TRANSIT_HEADER);
    raw_word_store(pointer_add(record, TRANSIT_SIZE), TRANSIT_INITIAL_SIZE);
    raw_word_store(pointer_add(record, TRANSIT_USED), TRANSIT_HEADER);
    raw_word_store(pointer_add(scratch, CAPTURE_RECORD), NativeWord(record));
    raw_word_store(pointer_add(scratch, CAPTURE_VISITED_CAPACITY), 64);
    pointer visited = SystemAllocate(64 * VISITED_ENTRY_SIZE, 8);
    if visited == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    memory_set(visited, 0, 64 * VISITED_ENTRY_SIZE);
    raw_word_store(pointer_add(scratch, CAPTURE_VISITED), NativeWord(visited));
    word root = TransitEncode(scratch, value);
    mut word next = 0;
    mut bool refused = root == 1;
    while !refused && next < raw_word_load(pointer_add(scratch, CAPTURE_OBJECT_COUNT)) {
        if TransitWriteImage(scratch, next) == false { refused = true; }
        next = next + 1;
    }
    mut pointer result = NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_RECORD)));
    if refused {
        if refusedOut != NativePointer(0) { raw_word_store(refusedOut, raw_word_load(pointer_add(scratch, CAPTURE_REFUSED))); }
        TransitFree(result);
        result = NativePointer(0);
    } else {
        raw_word_store(pointer_add(result, TRANSIT_COUNT), raw_word_load(pointer_add(scratch, CAPTURE_OBJECT_COUNT)));
        raw_word_store(pointer_add(result, TRANSIT_ROOT), root);
    }
    TransitCaptureScratchFree(scratch);
    return result;
}

pub unit TransitCaptureScratchFree(pointer scratch) {
    word objectCapacity = raw_word_load(pointer_add(scratch, CAPTURE_OBJECT_CAPACITY));
    if objectCapacity != 0 { SystemFree(NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_OBJECTS))), objectCapacity * 8); }
    SystemFree(NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_VISITED))),
        raw_word_load(pointer_add(scratch, CAPTURE_VISITED_CAPACITY)) * VISITED_ENTRY_SIZE);
    SystemFree(scratch, CAPTURE_SCRATCH_SIZE);
    return;
}

// Frees a record produced by `TransitCapture`.
pub unit TransitFree(pointer record) {
    if record == NativePointer(0) { return; }
    SystemFree(record, raw_word_load(pointer_add(record, TRANSIT_SIZE)));
    return;
}

pub word TransitVisitedSlot(pointer visited, word capacity, word object) {
    mut word index = (((object >> 3) * 0x9E3779B97F4A7C15) >> 20) & (capacity - 1);
    while true {
        word key = raw_word_load(pointer_add(visited, index * VISITED_ENTRY_SIZE));
        if key == 0 || key == object { return index; }
        index = (index + 1) & (capacity - 1);
    }
    return 0;
}

// Record index of `object`, appending it to the walk when it is new.
pub word TransitIntern(pointer scratch, word object) {
    mut pointer visited = NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_VISITED)));
    mut word capacity = raw_word_load(pointer_add(scratch, CAPTURE_VISITED_CAPACITY));
    word slot = TransitVisitedSlot(visited, capacity, object);
    pointer entry = pointer_add(visited, slot * VISITED_ENTRY_SIZE);
    if raw_word_load(entry) == object { return raw_word_load(pointer_add(entry, 8)) - 1; }
    word count = raw_word_load(pointer_add(scratch, CAPTURE_OBJECT_COUNT));
    // Objects vector growth.
    word objectCapacity = raw_word_load(pointer_add(scratch, CAPTURE_OBJECT_CAPACITY));
    if count == objectCapacity {
        mut word grown = objectCapacity * 2;
        if grown == 0 { grown = 32; }
        pointer objects = SystemAllocate(grown * 8, 8);
        if objects == NativePointer(0) { Trap(5, NativePointer(0), 0); }
        if objectCapacity != 0 {
            pointer old = NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_OBJECTS)));
            memory_copy(objects, old, objectCapacity * 8);
            SystemFree(old, objectCapacity * 8);
        }
        raw_word_store(pointer_add(scratch, CAPTURE_OBJECTS), NativeWord(objects));
        raw_word_store(pointer_add(scratch, CAPTURE_OBJECT_CAPACITY), grown);
    }
    raw_word_store(pointer_add(NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_OBJECTS))), count * 8), object);
    raw_word_store(pointer_add(scratch, CAPTURE_OBJECT_COUNT), count + 1);
    raw_word_store(entry, object);
    raw_word_store(pointer_add(entry, 8), count + 1);
    // Visited table growth at half occupancy.
    if (count + 1) * 2 > capacity {
        word grownCapacity = capacity * 2;
        pointer grownTable = SystemAllocate(grownCapacity * VISITED_ENTRY_SIZE, 8);
        if grownTable == NativePointer(0) { Trap(5, NativePointer(0), 0); }
        memory_set(grownTable, 0, grownCapacity * VISITED_ENTRY_SIZE);
        mut word index = 0;
        while index < capacity {
            pointer old = pointer_add(visited, index * VISITED_ENTRY_SIZE);
            word key = raw_word_load(old);
            if key != 0 {
                word target = TransitVisitedSlot(grownTable, grownCapacity, key);
                raw_word_store(pointer_add(grownTable, target * VISITED_ENTRY_SIZE), key);
                raw_word_store(pointer_add(grownTable, target * VISITED_ENTRY_SIZE + 8), raw_word_load(pointer_add(old, 8)));
            }
            index = index + 1;
        }
        SystemFree(visited, capacity * VISITED_ENTRY_SIZE);
        raw_word_store(pointer_add(scratch, CAPTURE_VISITED), NativeWord(grownTable));
        raw_word_store(pointer_add(scratch, CAPTURE_VISITED_CAPACITY), grownCapacity);
    }
    return count;
}

// Encodes one reference of the source graph. Returns 1 (never a valid encoding) for a refused
// object, after recording its descriptor.
pub word TransitEncode(pointer scratch, pointer value) {
    if value == NativePointer(0) { return 0; }
    pointer heap = NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_HEAP)));
    pointer object = ManagedObjectForReference(heap, value);
    if object == NativePointer(0) {
        if NativeWord(value) % 8 != 0 {
            raw_word_store(pointer_add(scratch, CAPTURE_REFUSED), 0);
            return 1;
        }
        return NativeWord(value);
    }
    pointer descriptor = NativePointer(raw_word_load(object));
    if ValidateTypeDescriptor(descriptor) == false {
        raw_word_store(pointer_add(scratch, CAPTURE_REFUSED), NativeWord(descriptor));
        return 1;
    }
    if raw_word_load(pointer_add(scratch, CAPTURE_SHARE_IMMUTABLE)) != 0 && TypeDescriptorIsImmutable(descriptor) {
        return NativeWord(value);
    }
    word delta = NativeWord(value) - NativeWord(object);
    if delta != 0 && delta != 24 {
        raw_word_store(pointer_add(scratch, CAPTURE_REFUSED), NativeWord(descriptor));
        return 1;
    }
    word index = TransitIntern(scratch, NativeWord(object));
    return (index << 6) | delta | 1;
}

// Ensures `extra` more bytes in the record, which may move; returns the record.
pub pointer TransitReserve(pointer scratch, word extra) {
    pointer record = NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_RECORD)));
    word size = raw_word_load(pointer_add(record, TRANSIT_SIZE));
    word used = raw_word_load(pointer_add(record, TRANSIT_USED));
    if used + extra <= size { return record; }
    mut word grown = size * 2;
    while grown < used + extra { grown = grown * 2; }
    pointer moved = SystemAllocate(grown, 8);
    if moved == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    memory_copy(moved, record, used);
    raw_word_store(pointer_add(moved, TRANSIT_SIZE), grown);
    SystemFree(record, size);
    raw_word_store(pointer_add(scratch, CAPTURE_RECORD), NativeWord(moved));
    return moved;
}

// Writes the image of walk entry `index`. Returns false on a refusal.
pub bool TransitWriteImage(pointer scratch, word index) {
    pointer object = NativePointer(raw_word_load(pointer_add(NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_OBJECTS))), index * 8)));
    pointer descriptor = NativePointer(raw_word_load(object));
    word size = ManagedObjectSize(object, descriptor);
    if size < 16 || size % 8 != 0 {
        raw_word_store(pointer_add(scratch, CAPTURE_REFUSED), NativeWord(descriptor));
        return false;
    }
    word kind = TypeDescriptorFlags(descriptor) & TYPE_DESCRIPTOR_KIND_MASK;
    mut word length = 0;
    mut word stride = 0;
    mut pointer elementMap = NativePointer(0);
    mut word elementPointers = 0;
    if kind == TYPE_DESCRIPTOR_ARRAY {
        pointer element = NativePointer(raw_word_load(pointer_add(object, 16)));
        length = raw_word_load(pointer_add(object, 32));
        stride = raw_word_load(element);
        elementMap = NativePointer(raw_word_load(pointer_add(element, 16)));
        elementPointers = raw_word_load(pointer_add(element, 24));
        if length > raw_word_load(pointer_add(object, 40)) {
            raw_word_store(pointer_add(scratch, CAPTURE_REFUSED), NativeWord(descriptor));
            return false;
        }
        mut word mapIndex = 0;
        while mapIndex < elementPointers {
            word offset = raw_word_load(pointer_add(elementMap, mapIndex * 8));
            if offset % 8 != 0 || offset + 8 < offset || offset + 8 > stride {
                raw_word_store(pointer_add(scratch, CAPTURE_REFUSED), NativeWord(descriptor));
                return false;
            }
            mapIndex = mapIndex + 1;
        }
    }
    mut pointer record = TransitReserve(scratch, IMAGE_HEADER + size - 16);
    word imageOffset = raw_word_load(pointer_add(record, TRANSIT_USED));
    raw_word_store(pointer_add(record, TRANSIT_USED), imageOffset + IMAGE_HEADER + size - 16);
    pointer image = pointer_add(record, imageOffset);
    raw_word_store(pointer_add(image, IMAGE_DESCRIPTOR), NativeWord(descriptor));
    raw_word_store(pointer_add(image, IMAGE_SIZE), size);
    raw_word_store(pointer_add(image, IMAGE_ALIGNMENT), TypeDescriptorAlignment(descriptor));
    memory_copy(pointer_add(image, IMAGE_HEADER), pointer_add(object, 16), size - 16);
    // `TransitEncode` may grow the record; image addresses are re-derived after each call. Field
    // `f` of the object lives at image + IMAGE_HEADER + f - 16.
    if kind == TYPE_DESCRIPTOR_ARRAY {
        raw_word_store(pointer_add(image, IMAGE_HEADER + 24 - 16), 0);
        // Slots past `length` are never traced; they are not copied.
        word liveEnd = 48 + length * stride;
        if size > liveEnd { memory_set(pointer_add(image, IMAGE_HEADER + liveEnd - 16), 0, size - liveEnd); }
        mut word element = 0;
        while element < length {
            mut word mapIndex = 0;
            while mapIndex < elementPointers {
                word field = 48 + element * stride + raw_word_load(pointer_add(elementMap, mapIndex * 8));
                word encoded = TransitEncode(scratch, NativePointer(raw_word_load(pointer_add(object, field))));
                if encoded == 1 { return false; }
                record = NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_RECORD)));
                raw_word_store(pointer_add(record, imageOffset + IMAGE_HEADER + field - 16), encoded);
                mapIndex = mapIndex + 1;
            }
            element = element + 1;
        }
        return true;
    }
    if kind == TYPE_DESCRIPTOR_UTF8_VIEW {
        raw_word_store(pointer_add(image, IMAGE_HEADER + 24 - 16), 0);
    }
    pointer pointerMap = TypeDescriptorPointerMap(descriptor);
    word pointerCount = TypeDescriptorPointerCount(descriptor);
    mut word mapIndex = 0;
    while mapIndex < pointerCount {
        word field = raw_word_load(pointer_add(pointerMap, mapIndex * 8));
        word encoded = TransitEncode(scratch, NativePointer(raw_word_load(pointer_add(object, field))));
        if encoded == 1 { return false; }
        record = NativePointer(raw_word_load(pointer_add(scratch, CAPTURE_RECORD)));
        raw_word_store(pointer_add(record, imageOffset + IMAGE_HEADER + field - 16), encoded);
        mapIndex = mapIndex + 1;
    }
    return true;
}

// ── Materialize ───────────────────────────────────────────────────────

// Allocates the graph of `record` in the current heap and stores its root reference into
// `rootSlot`, a native word that this function registers as a GC root; the caller unregisters it
// (`GcUnregisterRoot(rootSlot)`) once the root is reachable otherwise. Returns false only when a
// root could not be registered. The record is not freed.
pub bool TransitMaterialize(pointer record, pointer rootSlot) {
    raw_word_store(rootSlot, 0);
    if GcRegisterRoot(rootSlot) == false { return false; }
    word count = raw_word_load(pointer_add(record, TRANSIT_COUNT));
    if count == 0 {
        raw_word_store(rootSlot, raw_word_load(pointer_add(record, TRANSIT_ROOT)));
        return true;
    }
    pointer slots = SystemAllocate(count * 16, 8);
    if slots == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    memory_set(slots, 0, count * 16);
    // Word `2i` holds object `i` (a registered root), word `2i + 1` its image offset.
    mut word index = 0;
    mut word cursor = TRANSIT_HEADER;
    while index < count {
        raw_word_store(pointer_add(slots, index * 16 + 8), cursor);
        cursor = cursor + IMAGE_HEADER + raw_word_load(pointer_add(record, cursor + IMAGE_SIZE)) - 16;
        if GcRegisterRoot(pointer_add(slots, index * 16)) == false { Trap(5, NativePointer(0), 0); }
        index = index + 1;
    }
    // Pass 1: allocate. Each allocation may collect; every object allocated so far is rooted and
    // traceable (zeroed fields; an array has its element descriptor and an empty length).
    index = 0;
    while index < count {
        pointer image = pointer_add(record, raw_word_load(pointer_add(slots, index * 16 + 8)));
        pointer descriptor = NativePointer(raw_word_load(pointer_add(image, IMAGE_DESCRIPTOR)));
        word size = raw_word_load(pointer_add(image, IMAGE_SIZE));
        pointer object = GcAlloc(size, raw_word_load(pointer_add(image, IMAGE_ALIGNMENT)));
        if object == NativePointer(0) { Trap(5, NativePointer(0), 0); }
        InitializeObjectHeader(object, descriptor);
        if (TypeDescriptorFlags(descriptor) & TYPE_DESCRIPTOR_KIND_MASK) == TYPE_DESCRIPTOR_ARRAY {
            raw_word_store(pointer_add(object, 16), raw_word_load(pointer_add(image, IMAGE_HEADER + 16 - 16)));
            raw_word_store(pointer_add(object, 24), NativeWord(object) + 48);
            raw_word_store(pointer_add(object, 40), raw_word_load(pointer_add(image, IMAGE_HEADER + 40 - 16)));
        }
        raw_word_store(pointer_add(slots, index * 16), NativeWord(object));
        index = index + 1;
    }
    // Pass 2: copy and decode. Nothing here allocates, so no collection runs; every pointer store
    // goes through the hybrid barrier because a black object may receive a white target while the
    // heap is marking.
    index = 0;
    while index < count {
        pointer image = pointer_add(record, raw_word_load(pointer_add(slots, index * 16 + 8)));
        pointer object = NativePointer(raw_word_load(pointer_add(slots, index * 16)));
        pointer descriptor = NativePointer(raw_word_load(object));
        word size = raw_word_load(pointer_add(image, IMAGE_SIZE));
        word kind = TypeDescriptorFlags(descriptor) & TYPE_DESCRIPTOR_KIND_MASK;
        if kind == TYPE_DESCRIPTOR_ARRAY {
            // Element descriptor, data word and capacity are already in place; length and the
            // elements follow, then the element pointers are decoded.
            memory_copy(pointer_add(object, 48), pointer_add(image, IMAGE_HEADER + 48 - 16), size - 48);
            raw_word_store(pointer_add(object, 32), raw_word_load(pointer_add(image, IMAGE_HEADER + 32 - 16)));
            TransitDecodeArray(slots, image, object);
        } else {
            memory_copy(pointer_add(object, 16), pointer_add(image, IMAGE_HEADER), size - 16);
            TransitDecodeAggregate(slots, image, object, descriptor);
        }
        index = index + 1;
    }
    // Pass 3: a view's data word is its (now copied) backing array's data word.
    index = 0;
    while index < count {
        pointer object = NativePointer(raw_word_load(pointer_add(slots, index * 16)));
        pointer descriptor = NativePointer(raw_word_load(object));
        if (TypeDescriptorFlags(descriptor) & TYPE_DESCRIPTOR_KIND_MASK) == TYPE_DESCRIPTOR_UTF8_VIEW {
            pointer payload = NativePointer(raw_word_load(pointer_add(object, 16)));
            if payload != NativePointer(0) { raw_word_store(pointer_add(object, 24), raw_word_load(payload)); }
        }
        index = index + 1;
    }
    raw_word_store(rootSlot, TransitDecode(slots, raw_word_load(pointer_add(record, TRANSIT_ROOT))));
    index = count;
    while index > 0 {
        index = index - 1;
        GcUnregisterRoot(pointer_add(slots, index * 16));
    }
    SystemFree(slots, count * 16);
    return true;
}

pub word TransitDecode(pointer slots, word encoded) {
    if (encoded & 1) == 0 { return encoded; }
    return raw_word_load(pointer_add(slots, (encoded >> 6) * 16)) + (encoded & 0x3E);
}

// Stores one decoded pointer field: the slot is cleared first so the barrier never shades an
// encoded word.
pub unit TransitStoreField(pointer field, word value) {
    raw_word_store(field, 0);
    if value != 0 { GcHybridWriteBarrier(field, NativePointer(value)); }
    raw_word_store(field, value);
    return;
}

pub unit TransitDecodeArray(pointer slots, pointer image, pointer object) {
    pointer element = NativePointer(raw_word_load(pointer_add(object, 16)));
    word stride = raw_word_load(element);
    pointer elementMap = NativePointer(raw_word_load(pointer_add(element, 16)));
    word elementPointers = raw_word_load(pointer_add(element, 24));
    word length = raw_word_load(pointer_add(object, 32));
    mut word index = 0;
    while index < length {
        mut word mapIndex = 0;
        while mapIndex < elementPointers {
            word field = 48 + index * stride + raw_word_load(pointer_add(elementMap, mapIndex * 8));
            TransitStoreField(pointer_add(object, field), TransitDecode(slots, raw_word_load(pointer_add(image, IMAGE_HEADER + field - 16))));
            mapIndex = mapIndex + 1;
        }
        index = index + 1;
    }
    return;
}

pub unit TransitDecodeAggregate(pointer slots, pointer image, pointer object, pointer descriptor) {
    pointer pointerMap = TypeDescriptorPointerMap(descriptor);
    word pointerCount = TypeDescriptorPointerCount(descriptor);
    mut word mapIndex = 0;
    while mapIndex < pointerCount {
        word field = raw_word_load(pointer_add(pointerMap, mapIndex * 8));
        TransitStoreField(pointer_add(object, field), TransitDecode(slots, raw_word_load(pointer_add(image, IMAGE_HEADER + field - 16))));
        mapIndex = mapIndex + 1;
    }
    return;
}

// Allocates the graph of `record` in the current heap and returns its root reference, which is
// unrooted on return: the caller stores it into a rooted location before its next allocation.
// Used where the result is published immediately (an ABI value slot).
pub pointer TransitMaterializeValue(pointer record) {
    pointer cell = SystemAllocate(8, 8);
    if cell == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    if TransitMaterialize(record, cell) == false { Trap(5, NativePointer(0), 0); }
    pointer value = NativePointer(raw_word_load(cell));
    GcUnregisterRoot(cell);
    SystemFree(cell, 8);
    return value;
}
