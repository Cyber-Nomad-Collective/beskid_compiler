// Canonical external roots, generation-tagged handles, and heap initialization.

const HEAP_FIRST_REGION = 0;
const HEAP_CURRENT_REGION = 8;
const HEAP_REGION_COUNT = 16;
const HEAP_COMMITTED_BYTES = 24;
const HEAP_COLLECTION_THRESHOLD = 56;
const HEAP_CAP_BYTES = 72;
const HEAP_NEXT_REGION_SIZE = 80;
const HEAP_EXTERNAL_ROOT_COUNT = 168;
const HEAP_EXTERNAL_ROOTS = 176;
const HEAP_HANDLE_COUNT = 32936;
const HEAP_HANDLES = 32944;
const HEAP_STATE_SIZE = 41136;
const GC_EXTERNAL_ROOT_CAPACITY = 4095;
const GC_HANDLE_CAPACITY = 512;
const GC_HANDLE_SLOT_SIZE = 16;

const HEAP_MIN_THRESHOLD = 524288;
const HEAP_MAX_REGION_SIZE = 67108864;
const REGION_HEADER_SIZE = 64;
const HEAP_MIN_REGION_SIZE = 80;


// Root identity is the stable storage address, not a copyable payload or owner-state bit.
pub bool GcIsRegisteredRoot(pointer ptrAddr) {
    pointer heap = Heap();
    if heap == NativePointer(0) || ptrAddr == NativePointer(0) { return false; }
    word count = raw_word_load(pointer_add(heap, HEAP_EXTERNAL_ROOT_COUNT));
    if count > GC_EXTERNAL_ROOT_CAPACITY { return false; }
    mut word index = 0;
    while index < count {
        if raw_word_load(pointer_add(heap, HEAP_EXTERNAL_ROOTS + index * 8)) == NativeWord(ptrAddr) { return true; }
        index = index + 1;
    }
    return false;
}

[Export(Abi:"C", Symbol:"gc_register_root")]
pub bool GcRegisterRoot(pointer ptrAddr) {
    pointer heap = Heap();
    if heap == NativePointer(0) || ptrAddr == NativePointer(0) { return false; }
    if GcIsRegisteredRoot(ptrAddr) { return true; }
    word count = raw_word_load(pointer_add(heap, HEAP_EXTERNAL_ROOT_COUNT));
    if count >= GC_EXTERNAL_ROOT_CAPACITY { return false; }
    raw_word_store(pointer_add(heap, HEAP_EXTERNAL_ROOTS + count * 8), NativeWord(ptrAddr));
    raw_word_store(pointer_add(heap, HEAP_EXTERNAL_ROOT_COUNT), count + 1);
    return true;
}

[Export(Abi:"C", Symbol:"gc_unregister_root")]
pub unit GcUnregisterRoot(pointer ptrAddr) {
    pointer heap = Heap();
    if heap == NativePointer(0) || ptrAddr == NativePointer(0) { return; }
    word count = raw_word_load(pointer_add(heap, HEAP_EXTERNAL_ROOT_COUNT));
    mut word index = 0;
    while index < count {
        pointer slot = pointer_add(heap, HEAP_EXTERNAL_ROOTS + index * 8);
        if raw_word_load(slot) == NativeWord(ptrAddr) {
            raw_word_store(slot, raw_word_load(pointer_add(heap, HEAP_EXTERNAL_ROOTS + (count - 1) * 8)));
            raw_word_store(pointer_add(heap, HEAP_EXTERNAL_ROOTS + (count - 1) * 8), 0);
            raw_word_store(pointer_add(heap, HEAP_EXTERNAL_ROOT_COUNT), count - 1);
            return;
        }
        index = index + 1;
    }
    return;
}

[Export(Abi:"C", Symbol:"gc_external_root_count")]
pub word GcExternalRootCount() {
    pointer heap = Heap();
    if heap == NativePointer(0) { return 0; }
    return raw_word_load(pointer_add(heap, HEAP_EXTERNAL_ROOT_COUNT));
}

[Export(Abi:"C", Symbol:"gc_root_handle")]
pub word GcRootHandle(pointer valuePtr) {
    pointer heap = Heap();
    if heap == NativePointer(0) || valuePtr == NativePointer(0) || IsAllocatedObject(heap, valuePtr) == false { return 0; }
    word count = raw_word_load(pointer_add(heap, HEAP_HANDLE_COUNT));
    mut word index = 0;
    while index < count {
        pointer slot = pointer_add(heap, HEAP_HANDLES + index * GC_HANDLE_SLOT_SIZE);
        if raw_word_load(slot) == 0 {
            mut word generation = raw_word_load(pointer_add(slot, 8));
            if generation == 0 { generation = 1; }
            raw_word_store(slot, NativeWord(valuePtr));
            raw_word_store(pointer_add(slot, 8), generation);
            return (generation << 32) | index;
        }
        index = index + 1;
    }
    if count >= GC_HANDLE_CAPACITY { return 0; }
    pointer slot = pointer_add(heap, HEAP_HANDLES + count * GC_HANDLE_SLOT_SIZE);
    raw_word_store(slot, NativeWord(valuePtr));
    raw_word_store(pointer_add(slot, 8), 1);
    raw_word_store(pointer_add(heap, HEAP_HANDLE_COUNT), count + 1);
    return (word(1) << 32) | count;
}

[Export(Abi:"C", Symbol:"gc_unroot_handle")]
pub unit GcUnrootHandle(word handle) {
    pointer heap = Heap();
    if heap == NativePointer(0) || handle == 0 { return; }
    mut word index = handle & 0xFFFFFFFF;
    mut word generation = handle >> 32;
    word count = raw_word_load(pointer_add(heap, HEAP_HANDLE_COUNT));
    if index >= count { return; }
    pointer slot = pointer_add(heap, HEAP_HANDLES + index * GC_HANDLE_SLOT_SIZE);
    if raw_word_load(slot) == 0 || raw_word_load(pointer_add(slot, 8)) != generation { return; }
    raw_word_store(slot, 0);
    mut word nextGeneration = generation + 1;
    if nextGeneration == 0 { nextGeneration = 1; }
    raw_word_store(pointer_add(slot, 8), nextGeneration);
    return;
}

pub bool GcHandlesClear() {
    pointer heap = Heap();
    if heap == NativePointer(0) { return true; }
    word count = raw_word_load(pointer_add(heap, HEAP_HANDLE_COUNT));
    if count > GC_HANDLE_CAPACITY { return false; }
    mut word index = 0;
    while index < count {
        if raw_word_load(pointer_add(heap, HEAP_HANDLES + index * GC_HANDLE_SLOT_SIZE)) != 0 { return false; }
        index = index + 1;
    }
    return true;
}

pub pointer GcResolveHandle(word handle) {
    pointer heap = Heap();
    if heap == NativePointer(0) || handle == 0 { return NativePointer(0); }
    mut word index = handle & 0xFFFFFFFF;
    mut word generation = handle >> 32;
    word count = raw_word_load(pointer_add(heap, HEAP_HANDLE_COUNT));
    if index >= count { return NativePointer(0); }
    pointer slot = pointer_add(heap, HEAP_HANDLES + index * GC_HANDLE_SLOT_SIZE);
    if raw_word_load(pointer_add(slot, 8)) != generation { return NativePointer(0); }
    pointer value = NativePointer(raw_word_load(slot));
    if IsAllocatedObject(heap, value) == false { return NativePointer(0); }
    return value;
}

pub bool MarkRoots() {
    pointer heap = Heap();
    if heap == NativePointer(0) { return false; }
    pointer tls = CurrentThreadState();
    if tls != NativePointer(0) {
        mut pointer frame = NativePointer(raw_word_load(pointer_add(tls, 8)));
        while frame != NativePointer(0) {
            pointer slots = NativePointer(raw_word_load(pointer_add(frame, 8)));
            word count = raw_word_load(pointer_add(frame, 16));
            mut word index = 0;
            while slots != NativePointer(0) && index < count {
                pointer value = NativePointer(raw_word_load(pointer_add(slots, index * 8)));
                if value != NativePointer(0) { GcMarkGray(value); }
                index = index + 1;
            }
            frame = NativePointer(raw_word_load(frame));
        }
    }
    word externalCount = raw_word_load(pointer_add(heap, HEAP_EXTERNAL_ROOT_COUNT));
    if externalCount > GC_EXTERNAL_ROOT_CAPACITY { return false; }
    mut word externalIndex = 0;
    while externalIndex < externalCount {
        pointer address = NativePointer(raw_word_load(pointer_add(heap, HEAP_EXTERNAL_ROOTS + externalIndex * 8)));
        if address != NativePointer(0) {
            pointer value = NativePointer(raw_word_load(address));
            if value != NativePointer(0) { GcMarkGray(value); }
        }
        externalIndex = externalIndex + 1;
    }
    if MarkSuspendedFiberRoots() == false { return false; }
    word handleCount = raw_word_load(pointer_add(heap, HEAP_HANDLE_COUNT));
    if handleCount > GC_HANDLE_CAPACITY { return false; }
    mut word handleIndex = 0;
    while handleIndex < handleCount {
        pointer value = NativePointer(raw_word_load(pointer_add(heap, HEAP_HANDLES + handleIndex * GC_HANDLE_SLOT_SIZE)));
        if value != NativePointer(0) { GcMarkGray(value); }
        handleIndex = handleIndex + 1;
    }
    return true;
}

// Writes the first region's header into `region` (whole mapping `regionSize` bytes) and
// initializes `heapStruct` as a fresh one-region chain: `first_region == current_region ==
// region`, `region_count = 1`, `committed_bytes = regionSize`, `next_region_size = 2 *
// regionSize` (bounded), `cap_bytes = capBytes`, `collection_threshold = HEAP_MIN_THRESHOLD`.
pub unit HeapInit(pointer heapStruct, pointer region, word regionSize, word capBytes) {
    if heapStruct == NativePointer(0) || region == NativePointer(0) || regionSize < HEAP_MIN_REGION_SIZE ||
       regionSize % 8 != 0 || NativeWord(region) % 8 != 0 {
        return;
    }
    word limit = NativeWord(region) + regionSize;
    if limit < NativeWord(region) { return; }
    memory_set(heapStruct, 0, HEAP_STATE_SIZE);
    RegionInit(region, regionSize);
    raw_word_store(pointer_add(heapStruct, HEAP_FIRST_REGION), NativeWord(region));
    raw_word_store(pointer_add(heapStruct, HEAP_CURRENT_REGION), NativeWord(region));
    raw_word_store(pointer_add(heapStruct, HEAP_REGION_COUNT), 1);
    raw_word_store(pointer_add(heapStruct, HEAP_COMMITTED_BYTES), regionSize);
    raw_word_store(pointer_add(heapStruct, HEAP_CAP_BYTES), capBytes);
    mut word nextRegionSize = regionSize * 2;
    if nextRegionSize > HEAP_MAX_REGION_SIZE || nextRegionSize < regionSize {
        nextRegionSize = HEAP_MAX_REGION_SIZE;
    }
    raw_word_store(pointer_add(heapStruct, HEAP_NEXT_REGION_SIZE), nextRegionSize);
    raw_word_store(pointer_add(heapStruct, HEAP_COLLECTION_THRESHOLD), HEAP_MIN_THRESHOLD);
    return;
}
