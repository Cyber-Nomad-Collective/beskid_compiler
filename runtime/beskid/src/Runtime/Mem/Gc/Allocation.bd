// Canonical non-moving GC allocation and in-region free-list reuse.

const HEAP_REGION_START = 0;
const HEAP_BUMP = 16;
const HEAP_LIMIT = 24;
const HEAP_LIVE_BYTES = 32;
const HEAP_LIVE_COUNT = 40;

pub word AlignUp(word value, word alignment) {
    word remainder = value % alignment;
    if remainder == 0 {
        return value;
    }
    word increase = alignment - remainder;
    mut word aligned = value + increase;
    if aligned < value {
        return 0;
    }
    return aligned;
}

// Free blocks are linked implicitly by their address order. Their manifest object-header-sized
// prefix is { descriptor = null, block_size }; sweep coalesces adjacent entries.
pub pointer AllocateFromFreeList(pointer heap, word size, word alignment) {
    mut pointer cursor = NativePointer(raw_word_load(pointer_add(heap, HEAP_REGION_START)));
    mut pointer bump = NativePointer(raw_word_load(pointer_add(heap, HEAP_BUMP)));
    while NativeWord(cursor) < NativeWord(bump) {
        word descriptorWord = raw_word_load(cursor);
        mut word blockSize;
        if descriptorWord == 0 {
            blockSize = raw_word_load(pointer_add(cursor, 8));
            if blockSize < 16 || blockSize % 8 != 0 {
                return NativePointer(0);
            }
            mut word aligned = AlignUp(NativeWord(cursor), alignment);
            mut word prefix = aligned - NativeWord(cursor);
            if prefix > 0 && prefix < 16 {
                aligned = aligned + alignment;
                prefix = aligned - NativeWord(cursor);
            }
            if aligned >= NativeWord(cursor) && prefix <= blockSize && blockSize - prefix >= size {
                word remainder = blockSize - prefix - size;
                if remainder == 0 || remainder >= 16 {
                    if prefix >= 16 {
                        raw_word_store(cursor, 0);
                        raw_word_store(pointer_add(cursor, 8), prefix);
                    }
                    if remainder >= 16 {
                        pointer rest = NativePointer(aligned + size);
                        raw_word_store(rest, 0);
                        raw_word_store(pointer_add(rest, 8), remainder);
                    }
                    return NativePointer(aligned);
                }
            }
        } else {
            pointer descriptor = NativePointer(descriptorWord);
            if ValidateTypeDescriptor(descriptor) == false {
                return NativePointer(0);
            }
            blockSize = ManagedObjectSize(cursor, descriptor);
            if blockSize == 0 { return NativePointer(0); }
        }
        mut word next = NativeWord(cursor) + blockSize;
        if blockSize < 16 || blockSize % 8 != 0 || next <= NativeWord(cursor) || next > NativeWord(bump) {
            return NativePointer(0);
        }
        cursor = NativePointer(next);
    }
    return NativePointer(0);
}

pub pointer GcAlloc(word size, word alignment) {
    pointer heap = Heap();
    if heap == NativePointer(0) || size < 16 || size % 8 != 0 || IsValidObjectAlignment(alignment) == false {
        return NativePointer(0);
    }
    mut pointer reused = AllocateFromFreeList(heap, size, alignment);
    if reused != NativePointer(0) {
        raw_word_store(pointer_add(heap, HEAP_LIVE_BYTES), raw_word_load(pointer_add(heap, HEAP_LIVE_BYTES)) + size);
        raw_word_store(pointer_add(heap, HEAP_LIVE_COUNT), raw_word_load(pointer_add(heap, HEAP_LIVE_COUNT)) + 1);
        return reused;
    }
    mut word bump = raw_word_load(pointer_add(heap, HEAP_BUMP));
    mut word aligned = AlignUp(bump, alignment);
    if aligned > bump && aligned - bump < 16 { aligned = aligned + alignment; }
    word limit = raw_word_load(pointer_add(heap, HEAP_LIMIT));
    mut word next = aligned + size;
    if aligned < bump || next < aligned || next > limit {
        GcCollect();
        reused = AllocateFromFreeList(heap, size, alignment);
        if reused != NativePointer(0) {
            raw_word_store(pointer_add(heap, HEAP_LIVE_BYTES), raw_word_load(pointer_add(heap, HEAP_LIVE_BYTES)) + size);
            raw_word_store(pointer_add(heap, HEAP_LIVE_COUNT), raw_word_load(pointer_add(heap, HEAP_LIVE_COUNT)) + 1);
            return reused;
        }
        bump = raw_word_load(pointer_add(heap, HEAP_BUMP));
        aligned = AlignUp(bump, alignment);
        if aligned > bump && aligned - bump < 16 { aligned = aligned + alignment; }
        next = aligned + size;
        if aligned < bump || next < aligned || next > limit {
            return NativePointer(0);
        }
    }
    // Keep every alignment prefix representable as an ordinary free-list header. When the first
    // aligned address would leave a sub-header prefix, the next aligned address is used instead.
    if aligned > bump {
        word gap = aligned - bump;
        pointer gapBlock = NativePointer(bump);
        raw_word_store(gapBlock, 0);
        raw_word_store(pointer_add(gapBlock, 8), gap);
    }
    raw_word_store(pointer_add(heap, HEAP_BUMP), next);
    raw_word_store(pointer_add(heap, HEAP_LIVE_BYTES), raw_word_load(pointer_add(heap, HEAP_LIVE_BYTES)) + size);
    raw_word_store(pointer_add(heap, HEAP_LIVE_COUNT), raw_word_load(pointer_add(heap, HEAP_LIVE_COUNT)) + 1);
    return NativePointer(aligned);
}

[Export(Abi:"C", Symbol:"alloc")]
pub pointer Alloc(word size, pointer descriptorPtr) {
    if descriptorPtr == NativePointer(0) || ValidateTypeDescriptor(descriptorPtr) == false {
        return NativePointer(0);
    }
    if size != TypeDescriptorSize(descriptorPtr) {
        return NativePointer(0);
    }
    pointer object = GcAlloc(size, TypeDescriptorAlignment(descriptorPtr));
    if object == NativePointer(0) {
        return object;
    }
    memory_set(object, 0, size);
    raw_word_store(object, NativeWord(descriptorPtr));
    return object;
}
