// Test-mode heap verifier (docs/superpowers/specs/2026-09-22-gc-span-heap-design.md, section 5,
// invariants 2 and 3): walks every region's span directory and checks that every small span's
// allocated-slot count plus free-slot-list length equals its slot count (no slot is both
// allocated and free, and none is missing from either), and that the free-slot list is
// acyclic and no longer than the span. Exported so Rust tests can call it after a collection
// without embedding this walk in every test's own harness.

const HEAP_FIRST_REGION_VERIFY = 0;
const REGION_NEXT_VERIFY = 0;
const REGION_SIZE_VERIFY = 8;
const REGION_HEADER_SIZE = 64;
const REGION_FREE_SPAN_LIST_VERIFY = 56;

const PAGE_SIZE = 8192;
const SPAN_BASE = 8;
const SPAN_PAGE_COUNT_VERIFY = 16;
const SPAN_SIZE_CLASS = 24;
const SPAN_FREE_SLOT = 48;
const SPAN_QUARANTINED = 40;
const SPAN_ALLOC_BITS = 56;
const SPAN_HEADER_SIZE = 256;
const SIZE_CLASS_LARGE = 14;

const HEAP_QUARANTINE_HEAD = 360;
const HEAP_QUARANTINE_TAIL = 368;
const HEAP_QUARANTINE_BYTES = 376;
const HEAP_DEBUG_KIT = 392;
// Debug-kit freed-memory patterns (Sweep.bd): every word of a freed slot after its link word holds
// `GC_POISON_WORD`; a slot in quarantine holds `GC_QUARANTINE_TAG` in its second word instead.
const GC_POISON_WORD = 0xDEADBEEFFEEDFACE;
const GC_QUARANTINE_TAG = 0xDEADBEEFFEEDFAC0;

// Large-span invariants (docs/superpowers/specs/2026-09-22-gc-span-heap-design.md, section 5):
// an in-use large span's directory entry must (1) point back to a span whose base is exactly
// this page's own address — the directory is addressed by page index from the region start, so
// a mismatch means the entry and its page have drifted apart; (2) claim a page run that stays
// inside the region and does not overlap a later span's own populated entry — only a span's
// first page is ever populated, so every other page in its run must read as empty; (3) have a
// live, valid type descriptor at its base, the same header word every other consumer
// (`IsAllocatedObject`'s large branch, `ManagedObjectForReference`) treats as the liveness
// signal; and (4) never also appear on the region's free-page list — an in-use span and a free
// span are mutually exclusive by construction (`SIZE_CLASS_LARGE` vs. `size_class == 0`, see
// Span.bd), so finding it there means a free and a live view of the same pages coexist.
pub bool VerifyLargeSpan(pointer region, word pageIndex, word totalPages, pointer entry, word base) {
    // The base<->entry round trip (now checked once, for every span, by `VerifySpan` before
    // dispatching here) already covers "this entry is the one `base`'s own page maps to";
    // recomputing `region + pageIndex * PAGE_SIZE` independently and comparing it to `base`
    // would be a DIFFERENT, stricter claim (that `base` sits exactly on a `PAGE_SIZE`-aligned
    // offset from `region` itself) that only holds when `region` is itself PAGE_SIZE-aligned —
    // which `SystemAllocate`'s 8-byte alignment request does not guarantee, so that comparison
    // does not belong here.
    word pageCount = raw_word_load(pointer_add(entry, SPAN_PAGE_COUNT_VERIFY));
    if pageCount == 0 || pageIndex + pageCount > totalPages {
        return false;
    }
    pointer descriptor = NativePointer(raw_word_load(NativePointer(base)));
    if descriptor == NativePointer(0) || ValidateTypeDescriptor(descriptor) == false {
        return false;
    }
    mut word offset = 1;
    while offset < pageCount {
        pointer otherEntry = pointer_add(region, REGION_HEADER_SIZE + (pageIndex + offset) * SPAN_HEADER_SIZE);
        word otherBase = raw_word_load(pointer_add(otherEntry, SPAN_BASE));
        word otherSizeClass = raw_word_load(pointer_add(otherEntry, SPAN_SIZE_CLASS));
        if otherBase != 0 || otherSizeClass != 0 {
            return false;
        }
        offset = offset + 1;
    }
    mut pointer cursor = NativePointer(raw_word_load(pointer_add(region, REGION_FREE_SPAN_LIST_VERIFY)));
    while cursor != NativePointer(0) {
        if cursor == entry {
            return false;
        }
        cursor = NativePointer(raw_word_load(cursor));
    }
    return true;
}

pub bool VerifySpan(pointer region, word pageIndex, word totalPages, pointer entry, bool debugKit) {
    word base = raw_word_load(pointer_add(entry, SPAN_BASE));
    word sizeClass = raw_word_load(pointer_add(entry, SPAN_SIZE_CLASS));
    if base == 0 || sizeClass == 0 {
        return true;
    }
    // Round-trip invariant: the directory entry a span's own `base` maps back to via
    // `SpanEntryInRegion` must be this exact entry — holds by construction whenever every writer
    // of `base` used the same address-to-page-index formula `SpanEntryInRegion` uses for lookups.
    if SpanEntryInRegion(region, base) != entry {
        return false;
    }
    // Absolute page-alignment invariant: every region is allocated with `PAGE_SIZE` alignment
    // (Lifecycle.bd's initial region, Allocation.bd's `GcGrow`), so every carved span's `base`
    // must itself land on a `PAGE_SIZE` boundary.
    if base % PAGE_SIZE != 0 {
        return false;
    }
    if sizeClass == SIZE_CLASS_LARGE {
        return VerifyLargeSpan(region, pageIndex, totalPages, entry, base);
    }
    word classBytes = SizeClassBytes(sizeClass);
    word slotsPerSpan = PAGE_SIZE / classBytes;
    pointer allocBits = pointer_add(entry, SPAN_ALLOC_BITS);
    word allocCount = PopcountBitmap(allocBits);
    mut word freeCount = 0;
    mut pointer cursor = NativePointer(raw_word_load(pointer_add(entry, SPAN_FREE_SLOT)));
    while cursor != NativePointer(0) {
        freeCount = freeCount + 1;
        if freeCount > slotsPerSpan {
            return false;
        }
        // A slot on the free list is never also in quarantine.
        if debugKit && raw_word_load(pointer_add(cursor, 8)) == GC_QUARANTINE_TAG {
            return false;
        }
        cursor = NativePointer(raw_word_load(cursor));
    }
    // Every slot is allocated, on the free list, or (debug kit) in quarantine; no allocated slot
    // holds the poison pattern in its header word.
    mut word quarantined = 0;
    mut word idx = 0;
    while idx < slotsPerSpan {
        pointer slot = NativePointer(base + idx * classBytes);
        if BitmapTestBit(allocBits, idx) {
            if raw_word_load(slot) == GC_POISON_WORD {
                return false;
            }
        } else if debugKit && raw_word_load(pointer_add(slot, 8)) == GC_QUARANTINE_TAG {
            quarantined = quarantined + 1;
        }
        idx = idx + 1;
    }
    if quarantined != raw_word_load(pointer_add(entry, SPAN_QUARANTINED)) {
        return false;
    }
    if allocCount + freeCount + quarantined != slotsPerSpan {
        return false;
    }
    return true;
}

// The quarantine FIFO (Sweep.bd) holds exactly `quarantine_bytes` of tagged, unallocated small
// slots, each on a small span of the heap, and its tail pointer names the last entry.
pub bool VerifyQuarantine(pointer heap) {
    word expected = raw_word_load(pointer_add(heap, HEAP_QUARANTINE_BYTES));
    mut word total = 0;
    mut pointer slot = NativePointer(raw_word_load(pointer_add(heap, HEAP_QUARANTINE_HEAD)));
    mut pointer last = NativePointer(0);
    while slot != NativePointer(0) {
        pointer entry = SpanHeaderFor(heap, NativeWord(slot));
        if entry == NativePointer(0) { return false; }
        word sizeClass = raw_word_load(pointer_add(entry, SPAN_SIZE_CLASS));
        if sizeClass == 0 || sizeClass == SIZE_CLASS_LARGE { return false; }
        word classBytes = SizeClassBytes(sizeClass);
        word base = raw_word_load(pointer_add(entry, SPAN_BASE));
        word offset = NativeWord(slot) - base;
        if NativeWord(slot) < base || offset >= PAGE_SIZE || offset % classBytes != 0 { return false; }
        if BitmapTestBit(pointer_add(entry, SPAN_ALLOC_BITS), offset / classBytes) { return false; }
        if raw_word_load(pointer_add(slot, 8)) != GC_QUARANTINE_TAG { return false; }
        total = total + classBytes;
        if total > expected { return false; }
        last = slot;
        slot = NativePointer(raw_word_load(slot));
    }
    if total != expected { return false; }
    return last == NativePointer(raw_word_load(pointer_add(heap, HEAP_QUARANTINE_TAIL)));
}

[Export(Abi:"C", Symbol:"gc_heap_verify")]
pub bool GcHeapVerify() {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return false;
    }
    bool debugKit = raw_word_load(pointer_add(heap, HEAP_DEBUG_KIT)) != 0;
    mut pointer region = NativePointer(raw_word_load(pointer_add(heap, HEAP_FIRST_REGION_VERIFY)));
    while region != NativePointer(0) {
        word regionSize = raw_word_load(pointer_add(region, REGION_SIZE_VERIFY));
        word totalPages = regionSize / PAGE_SIZE;
        mut word pageIndex = 0;
        while pageIndex < totalPages {
            pointer entry = pointer_add(region, REGION_HEADER_SIZE + pageIndex * SPAN_HEADER_SIZE);
            if VerifySpan(region, pageIndex, totalPages, entry, debugKit) == false {
                return false;
            }
            pageIndex = pageIndex + 1;
        }
        region = NativePointer(raw_word_load(pointer_add(region, REGION_NEXT_VERIFY)));
    }
    if VerifyCycleState(heap) == false {
        return false;
    }
    return VerifyQuarantine(heap);
}

// ---- Stress mode (`BESKID_GC_STRESS`, Lifecycle.bd) ----
//
// `stress_interval` n > 0 collects before every n-th managed allocation (`GcTryAlloc`, the one
// path every managed allocation takes); 0 disables it. `stress_flags` bit 0 (`verify`) runs
// `GcHeapVerify` before and after every collection and traps `runtime_internal_corruption` (10)
// when it fails. The fields belong to `BeskidHeapState` (runtime_manifest.bsol).
const HEAP_STRESS_INTERVAL = 328;
const HEAP_STRESS_COUNTER = 336;
const HEAP_STRESS_FLAGS = 344;
const GC_STRESS_FLAG_VERIFY = 1;
const STRESS_VERIFY_BEFORE = 0;
const STRESS_VERIFY_AFTER = 1;
const STRESS_DIAGNOSTIC_SIZE = 128;

[Export(Abi:"C", Symbol:"gc_heap_set_stress_interval")]
pub unit GcHeapSetStressInterval(word n) {
    pointer heap = Heap();
    if heap == NativePointer(0) { return; }
    raw_word_store(pointer_add(heap, HEAP_STRESS_INTERVAL), n);
    raw_word_store(pointer_add(heap, HEAP_STRESS_COUNTER), 0);
    return;
}

// Installs the parsed `BESKID_GC_STRESS` setting on the calling instance's heap.
pub unit GcHeapSetStressMode(word interval, word flags) {
    pointer heap = Heap();
    if heap == NativePointer(0) { return; }
    raw_word_store(pointer_add(heap, HEAP_STRESS_INTERVAL), interval);
    raw_word_store(pointer_add(heap, HEAP_STRESS_COUNTER), 0);
    raw_word_store(pointer_add(heap, HEAP_STRESS_FLAGS), flags);
    return;
}

// Called at the start of every managed allocation (`GcTryAlloc`); returns true when this
// allocation must be preceded by a collection. Without a stress interval the cost is one load
// and one branch.
pub bool StressShouldCollect() {
    pointer heap = Heap();
    if heap == NativePointer(0) { return false; }
    word interval = raw_word_load(pointer_add(heap, HEAP_STRESS_INTERVAL));
    if interval == 0 { return false; }
    word counter = raw_word_load(pointer_add(heap, HEAP_STRESS_COUNTER)) + 1;
    if counter >= interval {
        raw_word_store(pointer_add(heap, HEAP_STRESS_COUNTER), 0);
        return true;
    }
    raw_word_store(pointer_add(heap, HEAP_STRESS_COUNTER), counter);
    return false;
}

// Runs the verifier around a collection when the `verify` stress flag is set; `position` is
// `STRESS_VERIFY_BEFORE` or `STRESS_VERIFY_AFTER`.
pub unit GcStressVerify(pointer heap, word position) {
    if (raw_word_load(pointer_add(heap, HEAP_STRESS_FLAGS)) & GC_STRESS_FLAG_VERIFY) == 0 { return; }
    if GcHeapVerify() { return; }
    TrapHeapVerifyFailed(position);
}

// `beskid runtime trap v5: runtime_internal_corruption (10): gc_heap_verify failed before|after a
// collection (BESKID_GC_STRESS verify)`. The text lives in system memory: a managed string cannot
// be allocated while the heap is known to be inconsistent.
pub never TrapHeapVerifyFailed(word position) {
    pointer diagnostic = SystemAllocate(STRESS_DIAGNOSTIC_SIZE, 8);
    if diagnostic == NativePointer(0) { Trap(10, NativePointer(0), 0); }
    mut word offset = 0;
    offset = WritePackedAscii(diagnostic, offset, 0x5f706165685f6367, 8); // "gc_heap_"
    offset = WritePackedAscii(diagnostic, offset, 0x6620796669726576, 8); // "verify f"
    if position == STRESS_VERIFY_BEFORE {
        offset = WritePackedAscii(diagnostic, offset, 0x65622064656c6961, 8); // "ailed be"
        offset = WritePackedAscii(diagnostic, offset, 0x6320612065726f66, 8); // "fore a c"
        offset = WritePackedAscii(diagnostic, offset, 0x6f697463656c6c6f, 8); // "ollectio"
        offset = WritePackedAscii(diagnostic, offset, 0x6e, 1); // "n"
    } else {
        offset = WritePackedAscii(diagnostic, offset, 0x66612064656c6961, 8); // "ailed af"
        offset = WritePackedAscii(diagnostic, offset, 0x6f63206120726574, 8); // "ter a co"
        offset = WritePackedAscii(diagnostic, offset, 0x6e6f697463656c6c, 8); // "llection"
    }
    offset = WritePackedAscii(diagnostic, offset, 0x44494b5345422820, 8); // " (BESKID"
    offset = WritePackedAscii(diagnostic, offset, 0x455254535f43475f, 8); // "_GC_STRE"
    offset = WritePackedAscii(diagnostic, offset, 0x6669726576205353, 8); // "SS verif"
    offset = WritePackedAscii(diagnostic, offset, 0x2979, 2); // "y)"
    Trap(10, diagnostic, offset);
}

// `beskid runtime trap v5: runtime_internal_corruption (10): poisoned object header: a freed slot
// is used as a live object`. The liveness check (`ManagedObjectForReference`) and the marker
// (`TraceObjectAt`) call this when they find `GC_POISON_WORD` where a live object header must be.
pub never TrapPoisonedObjectHeader() {
    pointer diagnostic = SystemAllocate(STRESS_DIAGNOSTIC_SIZE, 8);
    if diagnostic == NativePointer(0) { Trap(10, NativePointer(0), 0); }
    mut word offset = 0;
    offset = WritePackedAscii(diagnostic, offset, 0x64656e6f73696f70, 8); // "poisoned"
    offset = WritePackedAscii(diagnostic, offset, 0x207463656a626f20, 8); // " object "
    offset = WritePackedAscii(diagnostic, offset, 0x203a726564616568, 8); // "header: "
    offset = WritePackedAscii(diagnostic, offset, 0x2064656572662061, 8); // "a freed "
    offset = WritePackedAscii(diagnostic, offset, 0x20736920746f6c73, 8); // "slot is "
    offset = WritePackedAscii(diagnostic, offset, 0x2073612064657375, 8); // "used as "
    offset = WritePackedAscii(diagnostic, offset, 0x6f206576696c2061, 8); // "a live o"
    offset = WritePackedAscii(diagnostic, offset, 0x7463656a62, 5); // "bject"
    Trap(10, diagnostic, offset);
}

// ---- Incremental collection verification and stress (v0.6.2) ----
//
// `gc_heap_set_incremental_stress(n)`, n > 0: an idle heap starts a cycle at every n-th
// allocation, a marking heap performs one mark step of the smallest granularity (one small span
// or one large-object chunk) at every allocation, a sweeping heap sweeps one span at every
// allocation, and every mark termination runs `GcHeapVerify`, the closure check (no marked object
// points at an unmarked object of the heap) and the rescan check (the termination rescan shaded
// nothing); a failure traps `runtime_internal_corruption` (10) with the name of the check.
const HEAP_GC_PHASE_VERIFY = 64;
const HEAP_SWEEP_GENERATION_VERIFY = 432;
const HEAP_RESCAN_SHADED_COUNT = 464;
const HEAP_INCREMENTAL_STRESS_INTERVAL = 472;
const HEAP_INCREMENTAL_STRESS_COUNTER = 480;
const HEAP_FORCE_BARRIER_SKIP = 488;
const SPAN_QUEUED_VERIFY = 32;
const SPAN_MARK_BITS_VERIFY = 120;
const SPAN_SCANNED_BITS_VERIFY = 184;
const SPAN_SWEEP_GENERATION_VERIFY = 248;
const SPAN_BITMAP_WORDS_VERIFY = 8;
const GC_PHASE_MARKING_VERIFY = 1;
const GC_PHASE_SWEEPING_VERIFY = 2;
const TYPE_DESCRIPTOR_ARRAY_VERIFY = 1;
const CHECK_TERMINATION_VERIFY = 0;
const CHECK_CLOSURE = 1;
const CHECK_RESCAN = 2;

[Export(Abi:"C", Symbol:"gc_heap_set_incremental_stress")]
pub unit GcHeapSetIncrementalStress(word n) {
    pointer heap = Heap();
    if heap == NativePointer(0) { return; }
    raw_word_store(pointer_add(heap, HEAP_INCREMENTAL_STRESS_INTERVAL), n);
    raw_word_store(pointer_add(heap, HEAP_INCREMENTAL_STRESS_COUNTER), 0);
    return;
}

// Fault injection for tests: makes `beskid_rt_v5_gc_write_barrier` return without shading, so the
// stress checks can be shown to detect a missing barrier.
[Export(Abi:"C", Symbol:"gc_heap_force_barrier_skip")]
pub unit GcHeapForceBarrierSkip(word enabled) {
    pointer heap = Heap();
    if heap == NativePointer(0) { return; }
    raw_word_store(pointer_add(heap, HEAP_FORCE_BARRIER_SKIP), enabled);
    return;
}

// Test-only: 0 white, 1 shaded and not traced, 2 traced or allocated black, for the object the
// reference resolves to (0 for a reference that resolves to no object of the heap).
[Export(Abi:"C", Symbol:"gc_object_mark_state")]
pub word GcObjectMarkState(pointer value) {
    pointer heap = Heap();
    if heap == NativePointer(0) { return 0; }
    pointer object = ManagedObjectForReference(heap, value);
    if object == NativePointer(0) { return 0; }
    pointer entry = SpanHeaderFor(heap, NativeWord(object));
    if entry == NativePointer(0) { return 0; }
    word sizeClass = raw_word_load(pointer_add(entry, SPAN_SIZE_CLASS));
    if sizeClass == SIZE_CLASS_LARGE {
        return raw_word_load(pointer_add(object, 8));
    }
    word base = raw_word_load(pointer_add(entry, SPAN_BASE));
    word idx = (NativeWord(object) - base) / SizeClassBytes(sizeClass);
    if BitmapTestBit(pointer_add(entry, SPAN_MARK_BITS_VERIFY), idx) == false { return 0; }
    if BitmapTestBit(pointer_add(entry, SPAN_SCANNED_BITS_VERIFY), idx) { return 2; }
    return 1;
}

// Called at the start of every managed allocation (`GcTryAlloc`).
pub unit GcIncrementalStressStep(pointer heap) {
    word interval = raw_word_load(pointer_add(heap, HEAP_INCREMENTAL_STRESS_INTERVAL));
    if interval == 0 { return; }
    word phase = raw_word_load(pointer_add(heap, HEAP_GC_PHASE_VERIFY));
    if phase == GC_PHASE_MARKING_VERIFY {
        GcMarkStepOn(heap, 1, true);
        return;
    }
    if phase == GC_PHASE_SWEEPING_VERIFY {
        GcSweepStepOn(heap, 1);
        return;
    }
    word counter = raw_word_load(pointer_add(heap, HEAP_INCREMENTAL_STRESS_COUNTER)) + 1;
    if counter >= interval {
        raw_word_store(pointer_add(heap, HEAP_INCREMENTAL_STRESS_COUNTER), 0);
        GcCycleStartOn(heap);
        return;
    }
    raw_word_store(pointer_add(heap, HEAP_INCREMENTAL_STRESS_COUNTER), counter);
    return;
}

// The stress-mode checks at mark termination, while every mark bit is still intact.
pub unit GcIncrementalStressTerminationChecks(pointer heap) {
    if raw_word_load(pointer_add(heap, HEAP_INCREMENTAL_STRESS_INTERVAL)) == 0 { return; }
    if GcHeapVerify() == false { TrapIncrementalCheckFailed(CHECK_TERMINATION_VERIFY); }
    if GcClosureCheck(heap) == false { TrapIncrementalCheckFailed(CHECK_CLOSURE); }
    if raw_word_load(pointer_add(heap, HEAP_RESCAN_SHADED_COUNT)) != 0 { TrapIncrementalCheckFailed(CHECK_RESCAN); }
    return;
}

// True when no marked object of the heap has a pointer field that resolves to an unmarked object
// of the heap (the strong tri-color invariant at termination).
pub bool GcClosureCheck(pointer heap) {
    mut pointer region = NativePointer(raw_word_load(pointer_add(heap, HEAP_FIRST_REGION_VERIFY)));
    while region != NativePointer(0) {
        word totalPages = raw_word_load(pointer_add(region, REGION_SIZE_VERIFY)) / PAGE_SIZE;
        mut word pageIndex = 0;
        while pageIndex < totalPages {
            pointer entry = pointer_add(region, REGION_HEADER_SIZE + pageIndex * SPAN_HEADER_SIZE);
            word base = raw_word_load(pointer_add(entry, SPAN_BASE));
            word sizeClass = raw_word_load(pointer_add(entry, SPAN_SIZE_CLASS));
            if base != 0 && sizeClass == SIZE_CLASS_LARGE {
                if raw_word_load(NativePointer(base + 8)) != GcMarkWhite() &&
                   ClosureCheckObject(heap, NativePointer(base)) == false {
                    return false;
                }
            } else if base != 0 && sizeClass != 0 {
                word classBytes = SizeClassBytes(sizeClass);
                word slots = PAGE_SIZE / classBytes;
                mut word idx = 0;
                while idx < slots {
                    if BitmapTestBit(pointer_add(entry, SPAN_MARK_BITS_VERIFY), idx) &&
                       ClosureCheckObject(heap, NativePointer(base + idx * classBytes)) == false {
                        return false;
                    }
                    idx = idx + 1;
                }
            }
            pageIndex = pageIndex + 1;
        }
        region = NativePointer(raw_word_load(pointer_add(region, REGION_NEXT_VERIFY)));
    }
    return true;
}

pub bool ClosureCheckObject(pointer heap, pointer object) {
    pointer descriptor = NativePointer(raw_word_load(object));
    if descriptor == NativePointer(0) || ValidateTypeDescriptor(descriptor) == false { return false; }
    if TypeDescriptorKind(descriptor) == TYPE_DESCRIPTOR_ARRAY_VERIFY {
        pointer element = NativePointer(raw_word_load(pointer_add(object, 16)));
        word stride = raw_word_load(element);
        pointer pointerMap = NativePointer(raw_word_load(pointer_add(element, 16)));
        word pointerCount = raw_word_load(pointer_add(element, 24));
        word length = raw_word_load(pointer_add(object, 32));
        mut word elementIndex = 0;
        while elementIndex < length {
            mut word mapIndex = 0;
            while mapIndex < pointerCount {
                word offset = raw_word_load(pointer_add(pointerMap, mapIndex * 8));
                pointer child = NativePointer(raw_word_load(pointer_add(object, 48 + elementIndex * stride + offset)));
                if ChildIsMarked(heap, child) == false { return false; }
                mapIndex = mapIndex + 1;
            }
            elementIndex = elementIndex + 1;
        }
        return true;
    }
    pointer pointerMap = TypeDescriptorPointerMap(descriptor);
    word pointerCount = TypeDescriptorPointerCount(descriptor);
    mut word index = 0;
    while index < pointerCount {
        word offset = raw_word_load(pointer_add(pointerMap, index * 8));
        if ChildIsMarked(heap, NativePointer(raw_word_load(pointer_add(object, offset)))) == false { return false; }
        index = index + 1;
    }
    return true;
}

// True for null, for a value that resolves to no object of the heap, and for a marked object.
pub bool ChildIsMarked(pointer heap, pointer child) {
    if child == NativePointer(0) { return true; }
    pointer object = ManagedObjectForReference(heap, child);
    if object == NativePointer(0) { return true; }
    return GcObjectMarkState(object) != 0;
}

// Phase invariants of `GcHeapVerify`: while marking, a small span with marked but unscanned slots
// is queued, and a gray large object is queued with its scan cursor inside the object; while
// sweeping, a span already swept in the current generation has clear mark and scanned bitmaps.
pub bool VerifyCycleState(pointer heap) {
    word phase = raw_word_load(pointer_add(heap, HEAP_GC_PHASE_VERIFY));
    if phase != GC_PHASE_MARKING_VERIFY && phase != GC_PHASE_SWEEPING_VERIFY { return true; }
    word generation = raw_word_load(pointer_add(heap, HEAP_SWEEP_GENERATION_VERIFY));
    mut pointer region = NativePointer(raw_word_load(pointer_add(heap, HEAP_FIRST_REGION_VERIFY)));
    while region != NativePointer(0) {
        word totalPages = raw_word_load(pointer_add(region, REGION_SIZE_VERIFY)) / PAGE_SIZE;
        mut word pageIndex = 0;
        while pageIndex < totalPages {
            pointer entry = pointer_add(region, REGION_HEADER_SIZE + pageIndex * SPAN_HEADER_SIZE);
            word base = raw_word_load(pointer_add(entry, SPAN_BASE));
            word sizeClass = raw_word_load(pointer_add(entry, SPAN_SIZE_CLASS));
            if base != 0 && sizeClass != 0 {
                bool queued = raw_word_load(pointer_add(entry, SPAN_QUEUED_VERIFY)) != 0;
                if phase == GC_PHASE_MARKING_VERIFY {
                    if sizeClass == SIZE_CLASS_LARGE {
                        if VerifyLargeMarkState(entry, NativePointer(base), queued) == false { return false; }
                    } else {
                        mut word i = 0;
                        while i < SPAN_BITMAP_WORDS_VERIFY {
                            word marks = raw_word_load(pointer_add(entry, SPAN_MARK_BITS_VERIFY + i * 8));
                            // Marked and not scanned: `marks & ~scanned`, as a subtraction of the subset.
                            word pending = marks - (marks & raw_word_load(pointer_add(entry, SPAN_SCANNED_BITS_VERIFY + i * 8)));
                            if pending != 0 && queued == false { return false; }
                            i = i + 1;
                        }
                    }
                } else if sizeClass != SIZE_CLASS_LARGE &&
                          raw_word_load(pointer_add(entry, SPAN_SWEEP_GENERATION_VERIFY)) == generation {
                    mut word i = 0;
                    while i < SPAN_BITMAP_WORDS_VERIFY * 2 {
                        if raw_word_load(pointer_add(entry, SPAN_MARK_BITS_VERIFY + i * 8)) != 0 { return false; }
                        i = i + 1;
                    }
                }
            }
            pageIndex = pageIndex + 1;
        }
        region = NativePointer(raw_word_load(pointer_add(region, REGION_NEXT_VERIFY)));
    }
    return true;
}

pub bool VerifyLargeMarkState(pointer entry, pointer object, bool queued) {
    word state = raw_word_load(pointer_add(object, 8));
    word cursor = raw_word_load(pointer_add(entry, SPAN_MARK_BITS_VERIFY));
    if state != GcMarkGrayState() {
        return cursor == 0;
    }
    if queued == false { return false; }
    pointer descriptor = NativePointer(raw_word_load(object));
    if ValidateTypeDescriptor(descriptor) == false { return false; }
    if TypeDescriptorKind(descriptor) == TYPE_DESCRIPTOR_ARRAY_VERIFY {
        return cursor <= raw_word_load(pointer_add(object, 32));
    }
    return cursor <= TypeDescriptorPointerCount(descriptor);
}

// `beskid runtime trap v5: runtime_internal_corruption (10): <check>`.
pub never TrapIncrementalCheckFailed(word check) {
    pointer diagnostic = SystemAllocate(STRESS_DIAGNOSTIC_SIZE, 8);
    if diagnostic == NativePointer(0) { Trap(10, NativePointer(0), 0); }
    mut word offset = 0;
    if check == CHECK_TERMINATION_VERIFY {
        offset = WritePackedAscii(diagnostic, offset, 0x5f706165685f6367, 8); // "gc_heap_"
        offset = WritePackedAscii(diagnostic, offset, 0x6620796669726576, 8); // "verify f"
        offset = WritePackedAscii(diagnostic, offset, 0x74612064656c6961, 8); // "ailed at"
        offset = WritePackedAscii(diagnostic, offset, 0x6574206b72616d20, 8); // " mark te"
        offset = WritePackedAscii(diagnostic, offset, 0x6f6974616e696d72, 8); // "rminatio"
        offset = WritePackedAscii(diagnostic, offset, 0x6572636e6928206e, 8); // "n (incre"
        offset = WritePackedAscii(diagnostic, offset, 0x73206c61746e656d, 8); // "mental s"
        offset = WritePackedAscii(diagnostic, offset, 0x297373657274, 6); // "tress)"
    } else if check == CHECK_CLOSURE {
        offset = WritePackedAscii(diagnostic, offset, 0x75736f6c63206367, 8); // "gc closu"
        offset = WritePackedAscii(diagnostic, offset, 0x6b63656863206572, 8); // "re check"
        offset = WritePackedAscii(diagnostic, offset, 0x6b72616d2061203a, 8); // ": a mark"
        offset = WritePackedAscii(diagnostic, offset, 0x63656a626f206465, 8); // "ed objec"
        offset = WritePackedAscii(diagnostic, offset, 0x73746e696f702074, 8); // "t points"
        offset = WritePackedAscii(diagnostic, offset, 0x75206e6120746120, 8); // " at an u"
        offset = WritePackedAscii(diagnostic, offset, 0x2064656b72616d6e, 8); // "nmarked "
        offset = WritePackedAscii(diagnostic, offset, 0x28207463656a626f, 8); // "object ("
        offset = WritePackedAscii(diagnostic, offset, 0x20676e697373696d, 8); // "missing "
        offset = WritePackedAscii(diagnostic, offset, 0x6162206574697277, 8); // "write ba"
        offset = WritePackedAscii(diagnostic, offset, 0x297265697272, 6); // "rrier)"
    } else {
        offset = WritePackedAscii(diagnostic, offset, 0x6163736572206367, 8); // "gc resca"
        offset = WritePackedAscii(diagnostic, offset, 0x3a6b63656863206e, 8); // "n check:"
        offset = WritePackedAscii(diagnostic, offset, 0x7265742065687420, 8); // " the ter"
        offset = WritePackedAscii(diagnostic, offset, 0x6e6f6974616e696d, 8); // "mination"
        offset = WritePackedAscii(diagnostic, offset, 0x206e616373657220, 8); // " rescan "
        offset = WritePackedAscii(diagnostic, offset, 0x6120646564616873, 8); // "shaded a"
        offset = WritePackedAscii(diagnostic, offset, 0x7463656a626f206e, 8); // "n object"
        offset = WritePackedAscii(diagnostic, offset, 0x6e697373696d2820, 8); // " (missin"
        offset = WritePackedAscii(diagnostic, offset, 0x2065746972772067, 8); // "g write "
        offset = WritePackedAscii(diagnostic, offset, 0x2972656972726162, 8); // "barrier)"
    }
    Trap(10, diagnostic, offset);
}
