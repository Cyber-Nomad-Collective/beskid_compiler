// Foreign reference table (v0.6.3): the references this heap holds into other runtime instances'
// heaps, the foreign reference count table of ORCA (Clebsch et al., OOPSLA 2017,
// https://doi.org/10.1145/3133896, sec. 4).
//
// Marking never enters a foreign object. When `GcMarkGray` meets a managed reference that is not
// inside one of the current heap's regions, it resolves the owning runtime instance through the
// process-wide region-to-owner map (`RegionOwner`) and stamps this table's entry for the
// reference with the current collection epoch; it writes nothing into the owner's heap or span
// directory. Mark termination drops every entry that the cycle did not stamp. In 0.6.3 the only
// foreign references are scope-rooted Shared captures and objects reachable from them, so every
// entry has `count = 1` and `immutable = 1`; the scope frame, not the count, keeps the owner's
// object alive.
//
// The table is native memory: an open-addressing hash set keyed by the reference value (the
// ABI-visible reference, so an array is keyed by its public `{ data, len, cap }` address). It is
// rebuilt, not tombstoned, when unstamped entries are dropped.
//
// Table record (FOREIGN_TABLE_SIZE bytes): count, capacity (a power of two), entries.
// Entry (FOREIGN_ENTRY_SIZE bytes): reference, owner instance, count, epoch, immutable.

const HEAP_FOREIGN_TABLE = 512;
const HEAP_FOREIGN_EPOCH = 520;

const FOREIGN_TABLE_SIZE = 24;
const FOREIGN_TABLE_COUNT = 0;
const FOREIGN_TABLE_CAPACITY = 8;
const FOREIGN_TABLE_ENTRIES = 16;
const FOREIGN_ENTRY_SIZE = 40;
const FOREIGN_ENTRY_REFERENCE = 0;
const FOREIGN_ENTRY_OWNER = 8;
const FOREIGN_ENTRY_COUNT = 16;
const FOREIGN_ENTRY_EPOCH = 24;
const FOREIGN_ENTRY_IMMUTABLE = 32;
const FOREIGN_INITIAL_CAPACITY = 16;

pub pointer ForeignTable(pointer heap) {
    if heap == NativePointer(0) { return NativePointer(0); }
    return NativePointer(raw_word_load(pointer_add(heap, HEAP_FOREIGN_TABLE)));
}

pub word ForeignEpoch(pointer heap) {
    return raw_word_load(pointer_add(heap, HEAP_FOREIGN_EPOCH));
}

// Number of live entries (diagnostic and test view).
pub word ForeignEntryCount(pointer heap) {
    pointer table = ForeignTable(heap);
    if table == NativePointer(0) { return 0; }
    return raw_word_load(pointer_add(table, FOREIGN_TABLE_COUNT));
}

pub pointer ForeignEntry(pointer table, word index) {
    return pointer_add(NativePointer(raw_word_load(pointer_add(table, FOREIGN_TABLE_ENTRIES))), index * FOREIGN_ENTRY_SIZE);
}

// Allocates a zeroed entry array of `capacity` slots, or null.
pub pointer ForeignEntriesAllocate(word capacity) {
    pointer entries = SystemAllocate(capacity * FOREIGN_ENTRY_SIZE, 8);
    if entries == NativePointer(0) { return entries; }
    memory_set(entries, 0, capacity * FOREIGN_ENTRY_SIZE);
    return entries;
}

// The table of `heap`, created on first use. Allocation failure is the out-of-memory trap: a
// marking pass cannot report a recoverable error.
pub pointer ForeignTableEnsure(pointer heap) {
    mut pointer table = ForeignTable(heap);
    if table != NativePointer(0) { return table; }
    table = SystemAllocate(FOREIGN_TABLE_SIZE, 8);
    if table == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    pointer entries = ForeignEntriesAllocate(FOREIGN_INITIAL_CAPACITY);
    if entries == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    raw_word_store(pointer_add(table, FOREIGN_TABLE_COUNT), 0);
    raw_word_store(pointer_add(table, FOREIGN_TABLE_CAPACITY), FOREIGN_INITIAL_CAPACITY);
    raw_word_store(pointer_add(table, FOREIGN_TABLE_ENTRIES), NativeWord(entries));
    raw_word_store(pointer_add(heap, HEAP_FOREIGN_TABLE), NativeWord(table));
    return table;
}

pub word ForeignHash(word reference, word capacity) {
    word mixed = (reference >> 3) * 0x9E3779B97F4A7C15;
    return (mixed >> 17) & (capacity - 1);
}

// The entry for `reference`, or the empty slot where it belongs.
pub pointer ForeignProbe(pointer table, word reference) {
    word capacity = raw_word_load(pointer_add(table, FOREIGN_TABLE_CAPACITY));
    mut word index = ForeignHash(reference, capacity);
    while true {
        pointer entry = ForeignEntry(table, index);
        word key = raw_word_load(pointer_add(entry, FOREIGN_ENTRY_REFERENCE));
        if key == 0 || key == reference { return entry; }
        index = (index + 1) & (capacity - 1);
    }
    return NativePointer(0);
}

// Rehashes into `capacity` slots, keeping only entries stamped with `epoch` unless `keepAll`.
pub unit ForeignRebuild(pointer table, word capacity, bool keepAll, word epoch) {
    pointer oldEntries = NativePointer(raw_word_load(pointer_add(table, FOREIGN_TABLE_ENTRIES)));
    word oldCapacity = raw_word_load(pointer_add(table, FOREIGN_TABLE_CAPACITY));
    pointer entries = ForeignEntriesAllocate(capacity);
    if entries == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    raw_word_store(pointer_add(table, FOREIGN_TABLE_ENTRIES), NativeWord(entries));
    raw_word_store(pointer_add(table, FOREIGN_TABLE_CAPACITY), capacity);
    raw_word_store(pointer_add(table, FOREIGN_TABLE_COUNT), 0);
    mut word index = 0;
    while index < oldCapacity {
        pointer old = pointer_add(oldEntries, index * FOREIGN_ENTRY_SIZE);
        word key = raw_word_load(pointer_add(old, FOREIGN_ENTRY_REFERENCE));
        if key != 0 && (keepAll || raw_word_load(pointer_add(old, FOREIGN_ENTRY_EPOCH)) == epoch) {
            pointer slot = ForeignProbe(table, key);
            memory_copy(slot, old, FOREIGN_ENTRY_SIZE);
            raw_word_store(pointer_add(table, FOREIGN_TABLE_COUNT), raw_word_load(pointer_add(table, FOREIGN_TABLE_COUNT)) + 1);
        }
        index = index + 1;
    }
    SystemFree(oldEntries, oldCapacity * FOREIGN_ENTRY_SIZE);
    return;
}

// Creates or finds the entry of `reference` owned by `owner`, stamps it with the heap's epoch and
// adds `count` to it. Returns the entry.
pub pointer ForeignInsert(pointer heap, word reference, pointer owner, word count, word immutable) {
    pointer table = ForeignTableEnsure(heap);
    word capacity = raw_word_load(pointer_add(table, FOREIGN_TABLE_CAPACITY));
    if (raw_word_load(pointer_add(table, FOREIGN_TABLE_COUNT)) + 1) * 2 > capacity {
        ForeignRebuild(table, capacity * 2, true, 0);
    }
    pointer entry = ForeignProbe(table, reference);
    if raw_word_load(pointer_add(entry, FOREIGN_ENTRY_REFERENCE)) == 0 {
        raw_word_store(pointer_add(entry, FOREIGN_ENTRY_REFERENCE), reference);
        raw_word_store(pointer_add(entry, FOREIGN_ENTRY_OWNER), NativeWord(owner));
        raw_word_store(pointer_add(entry, FOREIGN_ENTRY_COUNT), 0);
        raw_word_store(pointer_add(entry, FOREIGN_ENTRY_IMMUTABLE), immutable);
        raw_word_store(pointer_add(table, FOREIGN_TABLE_COUNT), raw_word_load(pointer_add(table, FOREIGN_TABLE_COUNT)) + 1);
    }
    raw_word_store(pointer_add(entry, FOREIGN_ENTRY_COUNT), raw_word_load(pointer_add(entry, FOREIGN_ENTRY_COUNT)) + count);
    raw_word_store(pointer_add(entry, FOREIGN_ENTRY_EPOCH), ForeignEpoch(heap));
    return entry;
}

// Marking met `reference`, which is not an object of `heap`. Records it when another live runtime
// instance owns the address; ignores it otherwise. Never reads or writes the owner's heap.
pub unit ForeignObserve(pointer heap, pointer reference) {
    word address = NativeWord(reference);
    if address == 0 || address % 8 != 0 { return; }
    // With one instance there is no foreign heap, and the map walk is skipped.
    if ProcessLiveInstances() < 2 && ForeignEntryCount(heap) == 0 { return; }
    pointer owner = RegionOwner(reference);
    if owner == NativePointer(0) || owner == RuntimeState() { return; }
    pointer table = ForeignTable(heap);
    if table != NativePointer(0) {
        pointer existing = ForeignProbe(table, address);
        if raw_word_load(pointer_add(existing, FOREIGN_ENTRY_REFERENCE)) == address {
            raw_word_store(pointer_add(existing, FOREIGN_ENTRY_EPOCH), ForeignEpoch(heap));
            return;
        }
    }
    ForeignInsert(heap, address, owner, 1, 1);
    return;
}

// Mark start: a new epoch, so that this cycle's stamps are distinguishable from older ones.
pub unit ForeignBeginEpoch(pointer heap) {
    word next = ForeignEpoch(heap) + 1;
    raw_word_store(pointer_add(heap, HEAP_FOREIGN_EPOCH), next);
    return;
}

// Mark termination: entries the cycle did not stamp are no longer reachable from this heap.
pub unit ForeignDropUnstamped(pointer heap) {
    pointer table = ForeignTable(heap);
    if table == NativePointer(0) || raw_word_load(pointer_add(table, FOREIGN_TABLE_COUNT)) == 0 { return; }
    ForeignRebuild(table, raw_word_load(pointer_add(table, FOREIGN_TABLE_CAPACITY)), false, ForeignEpoch(heap));
    return;
}

// Adoption (Runtime/Parallel/Adoption.bd): entries of `child` that name `parentRuntime` become
// ordinary intra-heap references and are dropped; every other entry is added to `parent`'s table.
// The child's table is freed.
pub unit ForeignMergeInto(pointer parent, pointer child, pointer parentRuntime) {
    pointer table = ForeignTable(child);
    if table == NativePointer(0) { return; }
    word capacity = raw_word_load(pointer_add(table, FOREIGN_TABLE_CAPACITY));
    mut word index = 0;
    while index < capacity {
        pointer entry = ForeignEntry(table, index);
        word key = raw_word_load(pointer_add(entry, FOREIGN_ENTRY_REFERENCE));
        pointer owner = NativePointer(raw_word_load(pointer_add(entry, FOREIGN_ENTRY_OWNER)));
        if key != 0 && owner != parentRuntime {
            ForeignInsert(parent, key, owner, raw_word_load(pointer_add(entry, FOREIGN_ENTRY_COUNT)),
                raw_word_load(pointer_add(entry, FOREIGN_ENTRY_IMMUTABLE)));
        }
        index = index + 1;
    }
    ForeignTableFree(child);
    return;
}

// Releases the table of a heap that is being released or adopted.
pub unit ForeignTableFree(pointer heap) {
    pointer table = ForeignTable(heap);
    if table == NativePointer(0) { return; }
    SystemFree(NativePointer(raw_word_load(pointer_add(table, FOREIGN_TABLE_ENTRIES))),
        raw_word_load(pointer_add(table, FOREIGN_TABLE_CAPACITY)) * FOREIGN_ENTRY_SIZE);
    SystemFree(table, FOREIGN_TABLE_SIZE);
    raw_word_store(pointer_add(heap, HEAP_FOREIGN_TABLE), 0);
    return;
}

// The count recorded for `reference` in `heap`'s table, 0 when absent (test view).
pub word ForeignReferenceCount(pointer heap, pointer reference) {
    pointer table = ForeignTable(heap);
    if table == NativePointer(0) { return 0; }
    pointer entry = ForeignProbe(table, NativeWord(reference));
    if raw_word_load(pointer_add(entry, FOREIGN_ENTRY_REFERENCE)) != NativeWord(reference) { return 0; }
    return raw_word_load(pointer_add(entry, FOREIGN_ENTRY_COUNT));
}
