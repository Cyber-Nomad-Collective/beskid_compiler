// Canonical Beskid non-moving mark/sweep garbage collector.
//
// Objects are allocated from a contiguous heap region via a bump pointer.
// Mark/sweep is stop-the-world: the mutator is paused while roots are
// traced and unreachable objects are swept. The heap is initialized once
// per process by the host embedder or the native runtime bootstrap.
//
// Header layout (BeskidObjectHeader, 16 bytes):
//   offset 0: descriptor (pointer to BeskidTypeDescriptor)
//   offset 8: gc_word (mark state: 0=white, 1=gray, 2=black)
//
// The heap state is stored in a BeskidRuntimeState at a known TLS offset,
// installed by ThreadAttach during bootstrap.

// Mark-state constants for gc_word.
const GC_WHITE = 0;
const GC_GRAY = 1;
const GC_BLACK = 2;

// ── Heap state layout (in-process, thread-local) ──────────────────

// Returns the active BeskidRuntimeState pointer installed by ThreadAttach.
pub pointer RuntimeState() {
    pointer tls = CurrentThreadState();
    if tls == NativePointer(0) {
        Trap(10, pointer_from_native_word(0), 0);
    }
    return NativePointer(raw_word_load(tls));
}

// Returns the heap pointer from the runtime state (offset 16 in BeskidRuntimeState).
pub pointer Heap() {
    pointer state = RuntimeState();
    return NativePointer(raw_word_load(pointer_add(state, 16)));
}

// Returns the root-frame pointer from the runtime state (offset 40).
pub pointer StateRootFrame() {
    pointer state = RuntimeState();
    return NativePointer(raw_word_load(pointer_add(state, 40)));
}

// ── Allocation ────────────────────────────────────────────────────

// Allocates `size` bytes from the GC heap.
//
// When the bump pointer overflows its limit, a collection is triggered.
// If collection cannot free enough space, the heap traps with out_of_memory.
[Export(Abi:"C", Symbol:"gc_alloc")]
pub pointer GcAlloc(word size, word alignment) {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        Trap(5, pointer_from_native_word(0), 0);
    }
    // BeskidHeap layout (64 bytes):
    //   offset  0: start (pointer)
    //   offset  8: size (word)
    //   offset 16: bump (pointer — current allocation cursor)
    //   offset 24: limit (pointer — end of heap)
    //   offset 32: live_bytes (word)
    //   offset 40: object_count (word)
    //   offset 48: phase (u8): 0=idle, 1=marking, 2=sweeping
    //   offset 56: gc_threshold (word)
    pointer bump = NativePointer(raw_word_load(pointer_add(heap, 16)));
    pointer limit = NativePointer(raw_word_load(pointer_add(heap, 24)));
    word alignedBump = NativeWord(bump);
    word alignMask = alignment - 1;
    if (alignedBump & alignMask) != 0 {
        alignedBump = (alignedBump + alignMask) & (0 - alignment);
    }
    pointer nextBump = NativePointer(alignedBump + size);
    if NativeWord(nextBump) < alignedBump {
        Trap(5, pointer_from_native_word(0), 0);
    }
    if NativeWord(nextBump) > NativeWord(limit) {
        // Trigger collection and retry.
        GcCollect();
        bump = NativePointer(raw_word_load(pointer_add(heap, 16)));
        limit = NativePointer(raw_word_load(pointer_add(heap, 24)));
        alignedBump = NativeWord(bump);
        if (alignedBump & alignMask) != 0 {
            alignedBump = (alignedBump + alignMask) & (0 - alignment);
        }
        nextBump = NativePointer(alignedBump + size);
        if NativeWord(nextBump) < alignedBump || NativeWord(nextBump) > NativeWord(limit) {
            Trap(5, pointer_from_native_word(0), 0);
        }
    }
    raw_word_store(pointer_add(heap, 16), NativeWord(nextBump));
    word live = raw_word_load(pointer_add(heap, 32)) + size;
    raw_word_store(pointer_add(heap, 32), live);
    word count = raw_word_load(pointer_add(heap, 40)) + 1;
    raw_word_store(pointer_add(heap, 40), count);
    return NativePointer(alignedBump);
}


// Canonical GC-tracked allocation entrypoint.
//
// `size` bytes are allocated from the GC heap and zero-filled. When `type_desc_ptr`
// is non-null, the descriptor pointer is written at offset 0 as the object header.
[Export(Abi:"C", Symbol:"alloc")]
pub pointer Alloc(word size, pointer type_desc_ptr) {
    if size == 0 {
        return NativePointer(0);
    }
    // Use the GC heap for managed allocation; fall through to system
    // allocation when the heap isn't initialized yet (bootstrap phase).
    pointer heap = Heap();
    if heap != NativePointer(0) {
        pointer obj = GcAlloc(size, 8);
        if obj != NativePointer(0) {
            memory_set(obj, 0, size);
            if type_desc_ptr != NativePointer(0) {
                raw_word_store(obj, NativeWord(type_desc_ptr));
            }
            return obj;
        }
    }
    // Fallback: direct system allocation for bootstrap/heap-init
    pointer obj = SystemAllocate(size, 8);
    if obj != NativePointer(0) {
        memory_set(obj, 0, size);
        if type_desc_ptr != NativePointer(0) {
            raw_word_store(obj, NativeWord(type_desc_ptr));
        }
    }
    return obj;
}

// ── External root registration (embedded fixed-capacity array) ──

const ROOT_REGISTRY_MAX = 64;
const ROOT_REGISTRY_OFFSET = 128;

// Registers a stack-slot address (`*mut *mut u8`) so the GC traces the pointer it points to.
[Export(Abi:"C", Symbol:"gc_register_root")]
pub unit GcRegisterRoot(pointer ptrAddr) {
    if ptrAddr == NativePointer(0) {
        return;
    }
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return;
    }
    word i = 0; word count = raw_word_load(pointer_add(heap, ROOT_REGISTRY_OFFSET - 8));
    while i < count {
        pointer slot = pointer_add(heap, ROOT_REGISTRY_OFFSET + i * 8);
        if raw_word_load(slot) == NativeWord(ptrAddr) {
            return;
        }
        i = i + 1;
    }
    if count >= ROOT_REGISTRY_MAX {
        return;
    }
    pointer slot = pointer_add(heap, ROOT_REGISTRY_OFFSET + count * 8);
    raw_word_store(slot, NativeWord(ptrAddr));
    raw_word_store(pointer_add(heap, ROOT_REGISTRY_OFFSET - 8), count + 1);
    return;
}

// Removes a previously registered external root.
[Export(Abi:"C", Symbol:"gc_unregister_root")]
pub unit GcUnregisterRoot(pointer ptrAddr) {
    if ptrAddr == NativePointer(0) {
        return;
    }
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return;
    }
    word count = raw_word_load(pointer_add(heap, ROOT_REGISTRY_OFFSET - 8));
    mut word i = 0;
    while i < count {
        pointer slot = pointer_add(heap, ROOT_REGISTRY_OFFSET + i * 8);
        if raw_word_load(slot) == NativeWord(ptrAddr) {
            // Remove by swapping with the last slot.
            raw_word_store(slot, raw_word_load(pointer_add(heap, ROOT_REGISTRY_OFFSET + (count - 1) * 8)));
            raw_word_store(pointer_add(heap, ROOT_REGISTRY_OFFSET + (count - 1) * 8), 0);
            raw_word_store(pointer_add(heap, ROOT_REGISTRY_OFFSET - 8), count - 1);
            return;
        }
        i = i + 1;
    }
    return;
}

// Returns the number of registered external roots.
[Export(Abi:"C", Symbol:"gc_external_root_count")]
pub word GcExternalRootCount() {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return 0;
    }
    return raw_word_load(pointer_add(heap, ROOT_REGISTRY_OFFSET - 8));
}

// ── Temporary handle table (generation-tagged slots) ───────────────

const HANDLE_TABLE_MAX = 64;
const HANDLE_TABLE_OFFSET = 640;           // 128 + 64*8
const HANDLE_SLOT_SIZE = 16;
const HANDLE_COUNT_OFFSET = 636;           // HANDLE_TABLE_OFFSET - 4
const HANDLE_NEXT_ID_OFFSET = 628;          // compacted: HANDLE_COUNT_OFFSET - 4
const HANDLE_FREE_HEAD_OFFSET = 620;        // next free list head

// Allocates a generation-tagged handle for `valuePtr` and returns the opaque u64 cookie.
[Export(Abi:"C", Symbol:"gc_root_handle")]
pub u64 GcRootHandle(pointer valuePtr) {
    if valuePtr == NativePointer(0) {
        return 0;
    }
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return 0;
    }
    word freeHead = raw_word_load(pointer_add(heap, HANDLE_FREE_HEAD_OFFSET));
    word slotIndex;
    word generation;
    if freeHead != 0xFFFFFFFFFFFFFFFF {
        // Reuse a freed slot.
        slotIndex = freeHead;
        pointer slotPtr = pointer_add(heap, HANDLE_TABLE_OFFSET + slotIndex * HANDLE_SLOT_SIZE);
        generation = raw_word_load(pointer_add(slotPtr, 8));
        // Pop free list.
        word nextFree = raw_word_load(pointer_add(slotPtr, 12));
        raw_word_store(pointer_add(heap, HANDLE_FREE_HEAD_OFFSET), nextFree);
    } else {
        // Allocate new slot.
        word count = raw_word_load(pointer_add(heap, HANDLE_COUNT_OFFSET));
        if count >= HANDLE_TABLE_MAX {
            return 0;
        }
        slotIndex = count;
        generation = 1;
        raw_word_store(pointer_add(heap, HANDLE_COUNT_OFFSET), count + 1);
    }
    // Write { value, generation, 0 } into the slot.
    pointer slotPtr = pointer_add(heap, HANDLE_TABLE_OFFSET + slotIndex * HANDLE_SLOT_SIZE);
    raw_word_store(slotPtr, NativeWord(valuePtr));
    raw_word_store(pointer_add(slotPtr, 8), generation);
    raw_word_store(pointer_add(slotPtr, 12), 0);
    // Encode: upper 32 = generation, lower 32 = slotIndex.
    return (generation << 32) | slotIndex;
}

// Releases a handle. Stale/double-free handles are silently ignored.
[Export(Abi:"C", Symbol:"gc_unroot_handle")]
pub unit GcUnrootHandle(u64 handle) {
    if handle == 0 {
        return;
    }
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return;
    }
    word slotIndex = handle & 0xFFFFFFFF;
    word generation = handle >> 32;
    word count = raw_word_load(pointer_add(heap, HANDLE_COUNT_OFFSET));
    if slotIndex >= count {
        return;
    }
    pointer slotPtr = pointer_add(heap, HANDLE_TABLE_OFFSET + slotIndex * HANDLE_SLOT_SIZE);
    word storedGen = raw_word_load(pointer_add(slotPtr, 8));
    if storedGen != generation {
        return; // Stale handle.
    }
    // Increment generation so future lookups with this handle fail.
    raw_word_store(pointer_add(slotPtr, 8), storedGen + 1);
    raw_word_store(slotPtr, 0);
    // Push onto free list.
    word freeHead = raw_word_load(pointer_add(heap, HANDLE_FREE_HEAD_OFFSET));
    raw_word_store(pointer_add(slotPtr, 12), freeHead);
    raw_word_store(pointer_add(heap, HANDLE_FREE_HEAD_OFFSET), slotIndex);
    return;
}

// Resolves a handle to its stored pointer value, or null for stale handles.
pub pointer GcResolveHandle(u64 handle) {
    if handle == 0 {
        return NativePointer(0);
    }
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return NativePointer(0);
    }
    word slotIndex = handle & 0xFFFFFFFF;
    word generation = handle >> 32;
    word count = raw_word_load(pointer_add(heap, HANDLE_COUNT_OFFSET));
    if slotIndex >= count {
        return NativePointer(0);
    }
    pointer slotPtr = pointer_add(heap, HANDLE_TABLE_OFFSET + slotIndex * HANDLE_SLOT_SIZE);
    word storedGen = raw_word_load(pointer_add(slotPtr, 8));
    if storedGen != generation {
        return NativePointer(0);
    }
    return NativePointer(raw_word_load(slotPtr));
}

// ── Write Barrier ─────────────────────────────────────────────────

// Insertion write barrier: records `child` as reachable from `parent`
// so concurrent marking preserves the invariant.
[Export(Abi:"C", Symbol:"gc_write_barrier")]
pub unit GcWriteBarrier(pointer parent, pointer child) {
    if parent == NativePointer(0) || child == NativePointer(0) {
        return;
    }
    pointer heap = Heap();
    u8 phase = raw_byte_load(pointer_add(heap, 48));
    if phase == 1 {
        // During marking, push child onto the gray stack.
        GcMarkGray(child);
    }
    return;
}

// ── Collection ────────────────────────────────────────────────────

// Returns the total bytes allocated (live + dead).
[Export(Abi:"C", Symbol:"gc_bytes_allocated")]
pub word GcBytesAllocated() {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return 0;
    }
    return raw_word_load(pointer_add(heap, 32));
}

// Returns the number of allocated objects.
[Export(Abi:"C", Symbol:"gc_object_count")]
pub word GcObjectCount() {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return 0;
    }
    return raw_word_load(pointer_add(heap, 40));
}

// Returns the current GC phase: 0=idle, 1=marking, 2=sweeping.
[Export(Abi:"C", Symbol:"gc_phase")]
pub word GcPhase() {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return 0;
    }
    return word(raw_byte_load(pointer_add(heap, 48)));
}

// Returns the number of registered external roots.
[Export(Abi:"C", Symbol:"gc_external_root_count")]
pub word GcExternalRootCount() {
    // TODO: count from handles table.
    return 0;
}

// Force a full mark/sweep collection.
[Export(Abi:"C", Symbol:"gc_collect")]
pub word GcCollect() {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return 0;
    }
    // 1. Set phase to marking.
    raw_byte_store(pointer_add(heap, 48), 1);
    // 2. Mark all roots.
    MarkRoots();
    // 3. Sweep.
    Sweep(heap);
    // 4. Set phase back to idle.
    raw_byte_store(pointer_add(heap, 48), 0);
    return raw_word_load(pointer_add(heap, 32));
}

// Collect if the heap has exceeded the GC threshold.
[Export(Abi:"C", Symbol:"gc_collect_if_needed")]
pub word GcCollectIfNeeded() {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return 0;
    }
    word live = raw_word_load(pointer_add(heap, 32));
    word threshold = raw_word_load(pointer_add(heap, 56));
    if live >= threshold {
        return GcCollect();
    }
    return live;
}

// ── Internal mark/sweep implementation ────────────────────────────

// Marks a single object gray and pushes it onto the mark stack.
pub unit GcMarkGray(pointer object) {
    word state = raw_word_load(pointer_add(object, 8));
    if state == GC_WHITE {
        raw_word_store(pointer_add(object, 8), GC_GRAY);
        // Push onto gray stack for processing.
        PushGray(object);
    }
    return;
}

// Marks an object black (fully traced).
pub unit GcMarkBlack(pointer object) {
    raw_word_store(pointer_add(object, 8), GC_BLACK);
    return;
}

// Processes the gray stack: for each gray object, mark its pointer fields,
// then mark the object black.
pub unit ProcessGrayStack() {
    mut pointer obj = PopGray();
    while obj != NativePointer(0) {
        // Trace pointer fields in this object.
        pointer descriptor = NativePointer(raw_word_load(obj));
        if descriptor != NativePointer(0) {
            word pointerCount = raw_word_load(pointer_add(descriptor, 24));
            pointer pointerMap = NativePointer(raw_word_load(pointer_add(descriptor, 16)));
            if pointerCount > 0 && pointerMap != NativePointer(0) {
                mut word i = 0;
                while i < pointerCount {
                    word offset = raw_word_load(pointer_add(pointerMap, i * 8));
                    pointer child = NativePointer(raw_word_load(pointer_add(obj, offset)));
                    if child != NativePointer(0) {
                        GcMarkGray(child);
                    }
                    i = i + 1;
                }
            }
        }
        GcMarkBlack(obj);
        obj = PopGray();
    }
    return;
}

// ── Gray stack (simplified — fixed capacity, embedded in heap) ────

// Pushes an object pointer onto the gray stack.
pub unit PushGray(pointer object) {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return;
    }
    // Gray stack: BeskidHeap bytes 64-128 (8 slots of pointer each).
    mut word i = 0;
    while i < 8 {
        pointer slot = pointer_add(heap, 64 + i * 8);
        if raw_word_load(slot) == 0 {
            raw_word_store(slot, NativeWord(object));
            return;
        }
        i = i + 1;
    }
    return;
}

// Pops an object from the gray stack. Returns null when empty.
pub pointer PopGray() {
    pointer heap = Heap();
    if heap == NativePointer(0) {
        return NativePointer(0);
    }
    mut word i = 8;
    while i > 0 {
        i = i - 1;
        pointer slot = pointer_add(heap, 64 + i * 8);
        word value = raw_word_load(slot);
        if value != 0 {
            raw_word_store(slot, 0);
            return NativePointer(value);
        }
    }
    return NativePointer(0);
}

// ── Root tracing ──────────────────────────────────────────────────

// Traces all registered roots and marks reachable objects gray.
pub unit MarkRoots() {
    pointer heap = Heap();
    // Trace TLS root frames.
    pointer tls = CurrentThreadState();
    if tls != NativePointer(0) {
        pointer rootFrame = NativePointer(raw_word_load(pointer_add(tls, 8)));
        while rootFrame != NativePointer(0) {
            pointer slots = NativePointer(raw_word_load(pointer_add(rootFrame, 8)));
            word slotCount = raw_word_load(pointer_add(rootFrame, 16));
            if slots != NativePointer(0) && slotCount > 0 {
                mut word i = 0;
                while i < slotCount {
                    pointer value = NativePointer(raw_word_load(pointer_add(slots, i * 8)));
                    if value != NativePointer(0) {
                        GcMarkGray(value);
                    }
                    i = i + 1;
                }
            }
            rootFrame = NativePointer(raw_word_load(rootFrame));
        }
    }
    // Trace external root registry (gc_register_root slots).
    if heap != NativePointer(0) {
        word extCount = raw_word_load(pointer_add(heap, ROOT_REGISTRY_OFFSET - 8));
        mut word j = 0;
        while j < extCount {
            pointer slotAddr = NativePointer(raw_word_load(pointer_add(heap, ROOT_REGISTRY_OFFSET + j * 8)));
            if slotAddr != NativePointer(0) {
                pointer value = NativePointer(raw_word_load(slotAddr));
                if value != NativePointer(0) {
                    GcMarkGray(value);
                }
            }
            j = j + 1;
        }
        // Trace handle table (gc_root_handle temporary roots).
        word handleCount = raw_word_load(pointer_add(heap, HANDLE_COUNT_OFFSET));
        if handleCount > HANDLE_TABLE_MAX {
            handleCount = HANDLE_TABLE_MAX;
        }
        mut word k = 0;
        while k < handleCount {
            pointer slotPtr = pointer_add(heap, HANDLE_TABLE_OFFSET + k * HANDLE_SLOT_SIZE);
            word generation = raw_word_load(pointer_add(slotPtr, 8));
            if generation > 0 {
                pointer value = NativePointer(raw_word_load(slotPtr));
                if value != NativePointer(0) {
                    GcMarkGray(value);
                }
            }
            k = k + 1;
        }
    }
    // Process all gray objects.
    ProcessGrayStack();
    return;
}

// ── Sweep ─────────────────────────────────────────────────────────

// Sweeps the heap: resets the bump pointer and rebuilds a free list
// from unreachable (white) objects. Live objects are reset to white.
pub unit Sweep(pointer heap) {
    pointer start = NativePointer(raw_word_load(heap));
    pointer end = NativePointer(raw_word_load(pointer_add(heap, 8)) + NativeWord(start));
    pointer bump = start;
    word liveBytes = 0;
    word liveCount = 0;
    while NativeWord(bump) < NativeWord(end) {
        pointer descriptor = NativePointer(raw_word_load(bump));
        if descriptor == NativePointer(0) {
            // Free/uninitialized memory — skip.
            bump = NativePointer(NativeWord(bump) + 8);
        } else {
            word state = raw_word_load(pointer_add(bump, 8));
            word objSize = raw_word_load(descriptor);
            if state == GC_BLACK {
                // Object is live — reset to white for next cycle.
                raw_word_store(pointer_add(bump, 8), GC_WHITE);
                liveBytes = liveBytes + objSize;
                liveCount = liveCount + 1;
            } else {
                // Object is unreachable (white or gray) — wipe header.
                raw_word_store(bump, 0);
                raw_word_store(pointer_add(bump, 8), 0);
            }
            bump = NativePointer(NativeWord(bump) + objSize);
        }
    }
    // Reset bump pointer to compacted position.
    raw_word_store(pointer_add(heap, 16), NativeWord(start));
    raw_word_store(pointer_add(heap, 32), liveBytes);
    raw_word_store(pointer_add(heap, 40), liveCount);
    return;
}

// Initializes a BeskidHeap structure.
// The caller provides a pre-allocated memory region.
[Export(Abi:"C", Symbol:"beskid_rt_v5_heap_init")]
pub unit HeapInit(pointer heapStruct, pointer region, word regionSize) {
    // Zero the entire heap struct (768 bytes: 128 core + 512 root registry + 128 handle table).
    memory_set(heapStruct, 0, 768);
    raw_word_store(heapStruct, NativeWord(region));
    raw_word_store(pointer_add(heapStruct, 8), regionSize);
    raw_word_store(pointer_add(heapStruct, 16), NativeWord(region));
    raw_word_store(pointer_add(heapStruct, 24), NativeWord(region) + regionSize);
    raw_word_store(pointer_add(heapStruct, 56), regionSize / 2);
    // Initialize free-head sentinel.
    raw_word_store(pointer_add(heapStruct, HANDLE_FREE_HEAD_OFFSET), 0xFFFFFFFFFFFFFFFF);
    return;
}
