// Canonical Beskid pub/sub hub broker.
//
// Hubs multiplex multiple channels: subscribers register channels by index,
// and waiters poll all channels in round-robin order until one delivers.
// Built on top of the channel subsystem. Hubs live in a scheduler-owned chunked
// table (Storage.bd) and each hub's registrations and waiters are growable
// vectors; neither the hub count nor the registration count has a fixed cap.
//
// Hub record layout (HUB_SLOT_SIZE bytes, never relocates):
//   offset  0: cursor (word) — round-robin position
//   offset  8: entries (growable vector; each entry is { index: i64 (8), channel: i64 (8) })
//   offset 32: waiters (growable vector of parked fiber indices)
// Re-registering an index replaces its channel in-place; removal compacts
// in-order so cursor fairness is deterministic and cannot be perturbed by a
// swap-remove.
const HUB_CURSOR = 0;
const HUB_ENTRIES = 8;
const HUB_WAITERS = 32;
const HUB_ENTRY_SIZE = 16;
const HUB_SLOT_SIZE = 56;

pub word HubSlotSize() { return HUB_SLOT_SIZE; }

// Hub status discriminants (ABI-stable 4-6, gapped to align with ChannelStatus 0-3).
const HUB_STATUS_HUB_EMPTY = 4;
const HUB_STATUS_HUB_LIMIT = 5;
const HUB_STATUS_HUB_NOT_FOUND = 6;

// Beskid `const` items have no `pub` visibility (see the grammar's `ConstantDefinition` rule):
// they only resolve within their own declaring file. Callers in other packages — including
// tests that are not part of the compiler-embedded runtime fixture allowlist — read the
// hub-not-found status discriminant through this function instead of the bare constant.
// `i64`, not `word`: `HubRegister` returns `i64` and `Assert.Equal<T>` requires an exact
// declared-type match between its two arguments (see the matching note in Channel.bd's
// `ChannelStatusOk`).
pub i64 HubStatusHubNotFound() { return HUB_STATUS_HUB_NOT_FOUND; }

// Hub status — enum-with-arguments for the logical type.
// Mirrors corelib Concurrency.Status variants.
pub enum HubStatus {
    Ok,
    Closed(i64 memberIndex),
    Cancelled(i64 reason),
    HubEmpty,
    HubLimit(i64 cap, i64 attemptedIndex),
    HubNotFound(i64 index),
}

// Returns the chunked hub table owned by the active scheduler.
// Hub storage must never be derived from an undeclared RuntimeState offset.
pub pointer HubTable() {
    return SchedulerHubTable();
}

pub pointer HubSlot(word index) {
    pointer table = HubTable();
    if table == NativePointer(0) || index >= ChunkTableCount(table) { return NativePointer(0); }
    return ChunkTableRecord(table, index);
}

pub pointer HubById(i64 hubId) {
    if hubId < 0 { return NativePointer(0); }
    return HubSlot(word(hubId));
}

pub word HubEntryCount(pointer hub) { return VecCount(pointer_add(hub, HUB_ENTRIES)); }
pub pointer HubEntry(pointer hub, word position) {
    return pointer_add(VecData(pointer_add(hub, HUB_ENTRIES)), position * HUB_ENTRY_SIZE);
}

// Shutdown only: releases one hub's vectors.
pub unit HubRelease(pointer hub) {
    VecFree(pointer_add(hub, HUB_ENTRIES), HUB_ENTRY_SIZE);
    VecFree(pointer_add(hub, HUB_WAITERS), 8);
    return;
}

// Creates a hub. A -1 return means the system allocator refused to grow the table.
[Export(Abi:"C", Symbol:"hub_create")]
pub i64 HubCreate() {
    pointer table = HubTable();
    if table == NativePointer(0) { return -1; }
    word index = ChunkTableAppend(table);
    if index == 0xFFFFFFFFFFFFFFFF || index > 0x7FFFFFFFFFFFFFFF { return -1; }
    return i64(index);
}

[Export(Abi:"C", Symbol:"hub_register")]
pub i64 HubRegister(i64 hubId, i64 index, i64 channelId) {
    pointer hub = HubById(hubId);
    if hub == NativePointer(0) || ChannelSlot(channelId) == NativePointer(0) { return HUB_STATUS_HUB_NOT_FOUND; }
    word entryCount = HubEntryCount(hub);
    // An index identifies one registration.  Replacement is stable: it keeps
    // the existing position and therefore preserves the circular poll order.
    mut word existing = 0;
    while existing < entryCount {
        pointer existingEntry = HubEntry(hub, existing);
        if i64(raw_word_load(existingEntry)) == index {
            raw_word_store(pointer_add(existingEntry, 8), word(channelId));
            return CHANNEL_STATUS_OK;
        }
        existing = existing + 1;
    }
    // Registrations grow on demand; HubLimit now reports only an allocator refusal.
    pointer entries = pointer_add(hub, HUB_ENTRIES);
    if !VecReserve(entries, HUB_ENTRY_SIZE, entryCount + 1) { return HUB_STATUS_HUB_LIMIT; }
    pointer entry = HubEntry(hub, entryCount);
    raw_word_store(entry, word(index));
    raw_word_store(pointer_add(entry, 8), word(channelId));
    raw_word_store(entries, entryCount + 1);
    return CHANNEL_STATUS_OK;
}

[Export(Abi:"C", Symbol:"hub_unregister")]
pub i64 HubUnregister(i64 hubId, i64 index) {
    pointer hub = HubById(hubId);
    if hub == NativePointer(0) { return HUB_STATUS_HUB_NOT_FOUND; }
    word entryCount = HubEntryCount(hub);
    mut word i = 0;
    while i < entryCount {
        pointer entry = HubEntry(hub, i);
        mut i64 entryIndex = i64(raw_word_load(entry));
        if entryIndex == index {
            // Shift entries left to retain registration order.  Swap-removal
            // would make round-robin delivery depend on the removed position.
            mut word move = i;
            while move + 1 < entryCount {
                pointer nextEntry = HubEntry(hub, move + 1);
                pointer currentEntry = HubEntry(hub, move);
                raw_word_store(currentEntry, raw_word_load(nextEntry));
                raw_word_store(pointer_add(currentEntry, 8), raw_word_load(pointer_add(nextEntry, 8)));
                move = move + 1;
            }
            pointer lastEntry = HubEntry(hub, entryCount - 1);
            raw_word_store(lastEntry, 0);
            raw_word_store(pointer_add(lastEntry, 8), 0);
            word remaining = entryCount - 1;
            raw_word_store(pointer_add(hub, HUB_ENTRIES), remaining);
            if remaining == 0 {
                raw_word_store(pointer_add(hub, HUB_CURSOR), 0);
            } else {
                mut word cursor = raw_word_load(pointer_add(hub, HUB_CURSOR));
                // The next slot after a deletion is the deletion position,
                // unless the cursor was earlier in the retained sequence.
                if cursor > i {
                    cursor = cursor - 1;
                }
                raw_word_store(pointer_add(hub, HUB_CURSOR), cursor % remaining);
            }
            return CHANNEL_STATUS_OK;
        }
        i = i + 1;
    }
    return HUB_STATUS_HUB_NOT_FOUND;
}

// Poll all channels round-robin until one delivers, then return index and value.
[Export(Abi:"C", Symbol:"hub_wait_receive_status")]
pub i64 HubWaitReceiveStatus(i64 hubId) {
    pointer hub = HubById(hubId);
    if hub == NativePointer(0) { return HUB_STATUS_HUB_NOT_FOUND; }
    word entryCount = HubEntryCount(hub);
    if entryCount == 0 { return HUB_STATUS_HUB_EMPTY; }
    word startPos = raw_word_load(pointer_add(hub, HUB_CURSOR)) % entryCount;
    mut word attempts = 0;
    while attempts < entryCount {
        word pos = (startPos + attempts) % entryCount;
        pointer entry = HubEntry(hub, pos);
        i64 chId = i64(raw_word_load(pointer_add(entry, 8)));
        i64 status = ChannelClaimReceive(chId);
        if status == CHANNEL_STATUS_OK {
            raw_word_store(pointer_add(hub, HUB_CURSOR), (pos + 1) % entryCount);
            return CHANNEL_STATUS_OK;
        }
        attempts = attempts + 1;
    }
    mut word fiberIndex = SchedulerCurrentFiber();
    if fiberIndex == FIBER_NONE || !FiberExists(fiberIndex) { return HUB_STATUS_HUB_EMPTY; }
    pointer fiber = FiberRecord(fiberIndex);
    if raw_byte_load(pointer_add(fiber, 41)) != 0 { return CHANNEL_STATUS_CANCELLED; }
    if !VecPushWordUnique(pointer_add(hub, HUB_WAITERS), fiberIndex) { Trap(5, NativePointer(0), 0); }
    FiberSetState(fiberIndex, FIBER_STATE_PARKED);
    SaveFiberLocalState(fiberIndex);
    SchedulerSetCurrentFiber(FIBER_NONE);
    ContextSwitch(NativePointer(raw_word_load(pointer_add(fiber, 104))), SchedulerContext());
    VecRemoveWord(pointer_add(hub, HUB_WAITERS), fiberIndex);
    if raw_byte_load(pointer_add(fiber, 41)) != 0 { return CHANNEL_STATUS_CANCELLED; }
    return HubWaitReceiveStatus(hubId);
}

pub unit HubWakeChannel(i64 channelId) {
    pointer table = HubTable();
    if table == NativePointer(0) { return; }
    word hubCount = ChunkTableCount(table);
    mut word hi = 0;
    while hi < hubCount {
        pointer hub = ChunkTableRecord(table, hi);
        word entryCount = HubEntryCount(hub);
        mut word entryIndex = 0;
        mut word matched = 0;
        while entryIndex < entryCount {
            if i64(raw_word_load(pointer_add(HubEntry(hub, entryIndex), 8))) == channelId { matched = 1; }
            entryIndex = entryIndex + 1;
        }
        if matched != 0 {
            pointer waiters = pointer_add(hub, HUB_WAITERS);
            while VecCount(waiters) != 0 {
                word fiberIndex = VecShiftWord(waiters, FIBER_NONE);
                if fiberIndex != FIBER_NONE { WakeEnqueue(fiberIndex); }
            }
        }
        hi = hi + 1;
    }
    return;
}

[Export(Abi:"C", Symbol:"hub_wait_receive_value")]
pub bool HubWaitReceiveValue(i64 hubId, pointer destination) {
    pointer hub = HubById(hubId);
    if hub == NativePointer(0) { return false; }
    mut word cursor = raw_word_load(pointer_add(hub, HUB_CURSOR));
    word entryCount = HubEntryCount(hub);
    if entryCount == 0 { return false; }
    word pos = (cursor + entryCount - 1) % entryCount;
    pointer entry = HubEntry(hub, pos);
    i64 chId = i64(raw_word_load(pointer_add(entry, 8)));
    return ChannelReceiveValue(chId, destination);
}

[Export(Abi:"C", Symbol:"hub_wait_receive_index")]
pub i64 HubWaitReceiveIndex(i64 hubId) {
    pointer hub = HubById(hubId);
    if hub == NativePointer(0) { return -1; }
    mut word cursor = raw_word_load(pointer_add(hub, HUB_CURSOR));
    word entryCount = HubEntryCount(hub);
    if entryCount == 0 { return -1; }
    word pos = (cursor + entryCount - 1) % entryCount;
    pointer entry = HubEntry(hub, pos);
    return i64(raw_word_load(entry));
}
