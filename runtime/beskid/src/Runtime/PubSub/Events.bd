// Canonical Beskid event system.
//
// An event's state lives inside the object that declares it, at the event's field offset:
//   offset 0: subscribed handler count (word)
//   offset 8: ordered handler pointers (word[capacity])
// The owner's type descriptor lists every handler word in its pointer map, so the collector
// traces the handlers through the owner. A handler is never an external GC root: when the
// owner becomes unreachable its handlers do too, and a program that exits with handlers still
// subscribed holds no root. Every store of a handler word takes the hybrid write barrier. The
// managed allocator zeroes the owner, so a new event has no handlers. The `event` argument of
// every operation is the address of that state inside the owner.

[Export(Abi: "C", Symbol: "event_get_handler")]
pub pointer EventGetHandler(pointer event, u32 index)
{
    if (event == NativePointer(0))
    {
        return NativePointer(0);
    }
    word count = raw_word_load(event);
    if (word(index) >= count)
    {
        return NativePointer(0);
    }
    return NativePointer(raw_word_load(pointer_add(event, 8 + word(index) * 8)));
}

[Export(Abi: "C", Symbol: "event_len")]
pub word EventLen(pointer event)
{
    if (event == NativePointer(0))
    {
        return 0;
    }
    return raw_word_load(event);
}

// Appends one handler when the event holds fewer than `capacity` handlers (the event's declared
// capacity). A full event reports its existing length and never overwrites a prior handler.
[Export(Abi: "C", Symbol: "event_subscribe")]
pub word EventSubscribe(pointer event, pointer handler, word capacity)
{
    if (event == NativePointer(0) || handler == NativePointer(0) || capacity == 0)
    {
        return 0;
    }
    word count = raw_word_load(event);
    if (count >= capacity)
    {
        return count;
    }
    pointer handlerSlot = pointer_add(event, 8 + count * 8);
    GcHybridWriteBarrier(handlerSlot, handler);
    raw_word_store(handlerSlot, NativeWord(handler));
    raw_word_store(event, count + 1);
    return count + 1;
}

// Removes the first matching handler, compacting the tail so indexed lookup preserves
// subscription order.
[Export(Abi: "C", Symbol: "event_unsubscribe_first")]
pub word EventUnsubscribeFirst(pointer event, pointer handler)
{
    if (event == NativePointer(0) || handler == NativePointer(0))
    {
        return 0;
    }
    word count = raw_word_load(event);
    mut word index = 0;
    while (index < count)
    {
        if (raw_word_load(pointer_add(event, 8 + index * 8)) == NativeWord(handler))
        {
            while (index + 1 < count)
            {
                pointer slot = pointer_add(event, 8 + index * 8);
                pointer next = NativePointer(raw_word_load(pointer_add(event, 8 + (index + 1) * 8)));
                GcHybridWriteBarrier(slot, next);
                raw_word_store(slot, NativeWord(next));
                index = index + 1;
            }
            pointer last = pointer_add(event, 8 + (count - 1) * 8);
            GcHybridWriteBarrier(last, NativePointer(0));
            raw_word_store(last, 0);
            raw_word_store(event, count - 1);
            return 1;
        }
        index = index + 1;
    }
    return 0;
}

// Observed properties of one owner share a nullable head pointer. Every subscription is an
// ordinary traced heap object: { header, closure pointer, next pointer, property id }.
const OBSERVER_CLOSURE_OFFSET = 16;
const OBSERVER_NEXT_OFFSET = 24;
const OBSERVER_PROPERTY_OFFSET = 32;
const OBSERVER_NODE_SIZE = 40;

[Export(Abi: "C", Symbol: "observer_tail")]
pub pointer ObserverTail(pointer head)
{
    mut pointer node = head;
    mut pointer tail = NativePointer(0);
    while (node != NativePointer(0))
    {
        tail = node;
        node = NativePointer(raw_word_load(pointer_add(node, OBSERVER_NEXT_OFFSET)));
    }
    return tail;
}

[Export(Abi: "C", Symbol: "observer_subscribe")]
pub bool ObserverSubscribe(pointer owner, word slotOffset, word propertyId, pointer closure, pointer nodeDescriptor)
{
    pointer heap = Heap();
    if (heap == NativePointer(0) || owner == NativePointer(0) || closure == NativePointer(0))
    {
        return false;
    }
    // Only the owning isolate can attach a local callback to this object.
    if (IsAllocatedObject(heap, owner) == false || IsAllocatedObject(heap, closure) == false)
    {
        return false;
    }
    pointer ownerDescriptor = NativePointer(raw_word_load(owner));
    if (ownerDescriptor == NativePointer(0) || slotOffset < 16 || slotOffset % 8 != 0 || slotOffset >= TypeDescriptorSize(ownerDescriptor))
    {
        return false;
    }
    word ownerHandle = GcRootHandle(owner);
    if (ownerHandle == 0)
    {
        return false;
    }
    word closureHandle = GcRootHandle(closure);
    if (closureHandle == 0)
    {
        GcUnrootHandle(ownerHandle);
        return false;
    }
    // The runtime allocator may collect before it returns. These temporary handles protect the
    // owner, all previous registrations, and the new callback until we publish the node.
    pointer node = Alloc(OBSERVER_NODE_SIZE, nodeDescriptor);
    if (node != NativePointer(0))
    {
        pointer closureSlot = pointer_add(node, OBSERVER_CLOSURE_OFFSET);
        GcHybridWriteBarrier(closureSlot, closure);
        raw_word_store(closureSlot, NativeWord(closure));
        raw_word_store(pointer_add(node, OBSERVER_PROPERTY_OFFSET), propertyId);
        pointer ownerSlot = pointer_add(owner, slotOffset);
        pointer tail = ObserverTail(NativePointer(raw_word_load(ownerSlot)));
        mut pointer destination = ownerSlot;
        if (tail != NativePointer(0))
        {
            destination = pointer_add(tail, OBSERVER_NEXT_OFFSET);
        }
        GcHybridWriteBarrier(destination, node);
        raw_word_store(destination, NativeWord(node));
    }
    GcUnrootHandle(closureHandle);
    GcUnrootHandle(ownerHandle);
    return node != NativePointer(0);
}
