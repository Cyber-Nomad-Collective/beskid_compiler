// Canonical Beskid event system.
//
// An event's state lives inside the object that declares it, at the event's field offset:
//   offset 0: subscribed handler count (word)
//   offset 8: ordered handler pointers (word[capacity])
// The owner's type descriptor lists every handler word in its pointer map, so the collector
// traces the handlers through the owner. A handler is never an external GC root: when the
// owner becomes unreachable its handlers do too, and a program that exits with handlers still
// subscribed holds no root. Every store of a handler word takes the hybrid write barrier. The
// managed allocator zeroes the owner, so a new event has no handlers. The `event` argument of
// every operation is the address of that state inside the owner.

[Export(Abi: "C", Symbol: "event_get_handler")]
pub pointer EventGetHandler(pointer event, u32 index)
{
    if (event == NativePointer(0))
    {
        return NativePointer(0);
    }
    word count = raw_word_load(event);
    if (word(index) >= count)
    {
        return NativePointer(0);
    }
    return NativePointer(raw_word_load(pointer_add(event, 8 + word(index) * 8)));
}

[Export(Abi: "C", Symbol: "event_len")]
pub word EventLen(pointer event)
{
    if (event == NativePointer(0))
    {
        return 0;
    }
    return raw_word_load(event);
}

// Appends one handler when the event holds fewer than `capacity` handlers (the event's declared
// capacity). A full event reports its existing length and never overwrites a prior handler.
[Export(Abi: "C", Symbol: "event_subscribe")]
pub word EventSubscribe(pointer event, pointer handler, word capacity)
{
    if (event == NativePointer(0) || handler == NativePointer(0) || capacity == 0)
    {
        return 0;
    }
    word count = raw_word_load(event);
    if (count >= capacity)
    {
        return count;
    }
    pointer handlerSlot = pointer_add(event, 8 + count * 8);
    GcHybridWriteBarrier(handlerSlot, handler);
    raw_word_store(handlerSlot, NativeWord(handler));
    raw_word_store(event, count + 1);
    return count + 1;
}

// Removes the first matching handler, compacting the tail so indexed lookup preserves
// subscription order.
[Export(Abi: "C", Symbol: "event_unsubscribe_first")]
pub word EventUnsubscribeFirst(pointer event, pointer handler)
{
    if (event == NativePointer(0) || handler == NativePointer(0))
    {
        return 0;
    }
    word count = raw_word_load(event);
    mut word index = 0;
    while (index < count)
    {
        if (raw_word_load(pointer_add(event, 8 + index * 8)) == NativeWord(handler))
        {
            while (index + 1 < count)
            {
                pointer slot = pointer_add(event, 8 + index * 8);
                pointer next = NativePointer(raw_word_load(pointer_add(event, 8 + (index + 1) * 8)));
                GcHybridWriteBarrier(slot, next);
                raw_word_store(slot, NativeWord(next));
                index = index + 1;
            }
            pointer last = pointer_add(event, 8 + (count - 1) * 8);
            GcHybridWriteBarrier(last, NativePointer(0));
            raw_word_store(last, 0);
            raw_word_store(event, count - 1);
            return 1;
        }
        index = index + 1;
    }
    return 0;
}
