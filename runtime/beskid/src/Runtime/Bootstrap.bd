// Returns the native runtime ABI implemented by this canonical source corpus.
[Export(Abi:"C", Symbol:"beskid_rt_v5_abi_version")]
pub i32 AbiVersion() {
    return 5;
}

// Activates the caller-owned runtime state for the current process.
//
// The caller supplies a manifest-layout `BeskidRuntimeState`. This stamps
// `abi_version = 5` at offset 0 (and clears `flags` via the little-endian word write) and
// returns the same handle. It does not install RuntimeState into TLS: root-frame helpers
// require a dedicated `BeskidTlsState` installed by [`ThreadAttach`].
[Export(Abi:"C", Symbol:"beskid_rt_v5_process_init")]
pub pointer ProcessInit(pointer config) {
    raw_word_store(config, 5);
    return config;
}

// Ends the current process-thread bootstrap scope.
//
// If a `BeskidTlsState` token is still installed, detach it so root chaining and the
// RuntimeState `current_thread` link cannot outlive process shutdown.
[Export(Abi:"C", Symbol:"beskid_rt_v5_process_shutdown")]
pub unit ProcessShutdown(pointer runtime) {
    pointer thread = CurrentThreadState();
    if thread != NativePointer(0) {
        ThreadDetach(thread);
    }
    return;
}

// Attaches a dynamically composed Beskid library to its caller-owned runtime state.
//
// Library composition shares process init (abi_version stamp) without installing TLS.
// Callers that need root-frame chaining must still [`ThreadAttach`] the runtime.
[Export(Abi:"C", Symbol:"beskid_library_attach_v5")]
pub i32 LibraryAttach(pointer runtime) {
    ProcessInit(runtime);
    return 0;
}

// Detaches a composed library from its caller-owned runtime state.
[Export(Abi:"C", Symbol:"beskid_library_detach_v5")]
pub unit LibraryDetach(pointer runtime) {
    ProcessShutdown(runtime);
    return;
}

// Attaches the current native thread to one caller-owned runtime state.
//
// Allocates a zeroed `BeskidTlsState` (size 32, alignment 8), installs it as the TLS token,
// and links `BeskidRuntimeState.current_thread` at offset 8. Root-frame helpers then read
// `root_frame` at TLS offset 8 without colliding with RuntimeState fields.
[Export(Abi:"C", Symbol:"beskid_rt_v5_thread_attach")]
pub pointer ThreadAttach(pointer runtime) {
    pointer previous = CurrentThreadState();
    if previous != NativePointer(0) {
        ThreadDetach(previous);
    }
    pointer tlsState = SystemAllocate(32, 8);
    if tlsState == NativePointer(0) {
        return tlsState;
    }
    memory_set(tlsState, 0, 32);
    raw_word_store(tlsState, NativeWord(runtime));
    raw_word_store(pointer_add(tlsState, 8), 0);
    raw_word_store(pointer_add(tlsState, 16), 0);
    raw_word_store(pointer_add(tlsState, 24), 1);
    raw_word_store(pointer_add(runtime, 8), NativeWord(tlsState));
    SetCurrentThreadState(tlsState);
    return tlsState;
}

// Detaches the current thread when its installed token matches `thread`.
//
// An out-of-order detach leaves another active attachment intact. A matching detach clears
// TLS and `BeskidRuntimeState.current_thread`, then frees the 32-byte `BeskidTlsState`.
[Export(Abi:"C", Symbol:"beskid_rt_v5_thread_detach")]
pub unit ThreadDetach(pointer thread) {
    if CurrentThreadState() == thread {
        pointer runtime = NativePointer(raw_word_load(thread));
        SetCurrentThreadState(NativePointer(0));
        if runtime != NativePointer(0) {
            raw_word_store(pointer_add(runtime, 8), 0);
        }
        SystemFree(thread, 32);
    }
    return;
}

// Converts an opaque runtime address to its pointer-width representation.
//
// `native_word_from_pointer` is not a user-visible extern: codegen recognizes this direct call
// only after the compiler has attached canonical-runtime authority to this exact source corpus.
pub word NativeWord(pointer value) {
    return native_word_from_pointer(value);
}

// Converts a pointer-width runtime word back to an opaque native address.
pub pointer NativePointer(word value) {
    return pointer_from_native_word(value);
}

// Reserves native storage through the manifest-owned platform allocator.
//
// This is deliberately not a managed-object allocation: object headers, descriptor validation,
// GC accounting, and collection policy remain owned by the future heap module.  The wrapper only
// preserves the ABI-v5 allocator boundary used by bootstrap state.
pub pointer SystemAllocate(word size, word alignment) {
    return system_allocate(size, alignment);
}

// Releases storage previously obtained from [`SystemAllocate`].
//
// The manifest owns the size-only release contract.  This wrapper must not infer ownership or
// run destructors; managed lifetime is not part of this bootstrap corpus.
pub unit SystemFree(pointer address, word size) {
    system_free(address, size);
    return;
}

// Returns the opaque state associated with the current runtime thread.
//
// The value is a `BeskidTlsState` address only after a caller has installed one.  Keeping it
// opaque prevents this source-only bootstrap layer from imposing scheduler or GC-thread policy.
pub pointer CurrentThreadState() {
    return tls_get();
}

// Installs the opaque state for the current runtime thread.
pub unit SetCurrentThreadState(pointer state) {
    tls_set(state);
    return;
}

// Reads `BeskidTlsState.root_frame` from its manifest-frozen byte offset.
//
// Root frame chaining is represented but not interpreted here.  In particular, this wrapper
// does not scan slots or collect objects; that belongs to the canonical heap implementation.
pub pointer RootFrame(pointer tlsState) {
    return NativePointer(raw_word_load(pointer_add(tlsState, 8)));
}

// Writes `BeskidTlsState.root_frame` at its manifest-frozen byte offset.
pub unit SetRootFrame(pointer tlsState, pointer rootFrame) {
    raw_word_store(pointer_add(tlsState, 8), NativeWord(rootFrame));
    return;
}

// Reads the preceding frame from a caller-owned `BeskidRootFrame` record.
//
// A frame is stack storage owned by generated code.  The runtime may link the frame into TLS,
// but never allocates, frees, or moves it.
pub pointer RootFramePrevious(pointer rootFrame) {
    return NativePointer(raw_word_load(rootFrame));
}

// Reads the address of the first `BeskidRootSlot` from a root-frame record.
//
// This is a collector input, not a collector: it gives a future non-moving marker an exact
// manifest-layout traversal boundary without making liveness decisions here.
pub pointer RootFrameSlots(pointer rootFrame) {
    return NativePointer(raw_word_load(pointer_add(rootFrame, 8)));
}

// Reads the number of caller-owned slots represented by a root frame.
pub word RootFrameSlotCount(pointer rootFrame) {
    return raw_word_load(pointer_add(rootFrame, 16));
}

// Links a caller-owned root frame as the current frame for this TLS state.
//
// The prior top is retained in `rootFrame.previous`, so a future collector can traverse a stable
// LIFO chain while generated code owns the actual slot storage.
pub unit PushRootFrame(pointer tlsState, pointer rootFrame) {
    raw_word_store(rootFrame, NativeWord(RootFrame(tlsState)));
    SetRootFrame(tlsState, rootFrame);
    return;
}

// Unlinks `rootFrame` only when it remains the current top of this TLS state.
//
// Returning `false` for an out-of-order pop preserves the active root chain instead of silently
// dropping a live frame.  This is ownership validation, not collection or finalization.
pub bool PopRootFrame(pointer tlsState, pointer rootFrame) {
    if RootFrame(tlsState) != rootFrame {
        return false;
    }
    SetRootFrame(tlsState, RootFramePrevious(rootFrame));
    raw_word_store(rootFrame, 0);
    return true;
}

// Reads `BeskidAllocationRequest.size` at its manifest-frozen offset.
pub word AllocationSize(pointer request) {
    return raw_word_load(request);
}

// Reads `BeskidAllocationRequest.alignment` at its manifest-frozen offset.
pub word AllocationAlignment(pointer request) {
    return raw_word_load(pointer_add(request, 8));
}

// Reads `BeskidAllocationRequest.descriptor` at its manifest-frozen offset.
pub pointer AllocationDescriptor(pointer request) {
    return NativePointer(raw_word_load(pointer_add(request, 16)));
}

// Installs the fixed `BeskidObjectHeader` fields at the start of a freshly zeroed object.
//
// `gc_word` stays zero until the future marker owns mark-state transitions. Descriptor pointer
// maps are validated before closure-environment allocation; this helper only stamps headers.
pub unit InitializeObjectHeader(pointer object, pointer descriptor) {
    raw_word_store(object, NativeWord(descriptor));
    raw_word_store(pointer_add(object, 8), 0);
    return;
}

// The largest value representable by one native word.
//
// Runtime `word` values use the native pointer width, and arithmetic in this canonical source
// is defined as wrapping machine arithmetic. Keeping this boundary in one helper makes every
// raw-address calculation prove its addition before the calculation happens.
pub word NativeWordMax() {
    return 0 - 1;
}

// Reads `BeskidTypeDescriptor.size` at its manifest-frozen offset.
pub word TypeDescriptorSize(pointer descriptor) {
    return raw_word_load(descriptor);
}

// Reads `BeskidTypeDescriptor.alignment` at its manifest-frozen offset.
pub word TypeDescriptorAlignment(pointer descriptor) {
    return raw_word_load(pointer_add(descriptor, 8));
}

// Reads `BeskidTypeDescriptor.pointer_map` at its manifest-frozen offset.
pub pointer TypeDescriptorPointerMap(pointer descriptor) {
    return NativePointer(raw_word_load(pointer_add(descriptor, 16)));
}

// Reads `BeskidTypeDescriptor.pointer_count` at its manifest-frozen offset.
pub word TypeDescriptorPointerCount(pointer descriptor) {
    return raw_word_load(pointer_add(descriptor, 24));
}

// Returns whether one ABI allocation alignment is a power-of-two word alignment.
//
// The ABI's minimum object alignment is eight bytes. Division avoids adding an unimplemented
// bitwise surface to the canonical runtime while still rejecting every non-power-of-two value.
pub bool IsValidObjectAlignment(word alignment) {
    if alignment < 8 {
        return false;
    } else {
        mut word remaining = alignment;
        while remaining > 1 {
            if remaining % 2 != 0 {
                return false;
            } else {
                remaining = remaining / 2;
            }
        }
        return true;
    }
}

// Validates pointer-map offsets before using them as native addresses.
//
// Pointer-map entries are byte offsets into an object which includes its 16-byte header. Each
// offset must name an aligned payload word and leave a complete pointer-sized slot in bounds.
// The multiplication for locating a map entry and the end-of-slot addition are guarded before
// they execute so malformed descriptors fail closed rather than wrapping into arbitrary memory.
pub bool ValidatePointerMap(pointer pointerMap, word pointerCount, word objectSize) {
    if pointerCount == 0 {
        return true;
    } else {
        if pointerMap == NativePointer(0) {
            return false;
        } else {
            // Overflow guards use wrapping arithmetic. `word` lowers as a signed Cranelift
            // integer with signed compares, so `NativeWordMax() - 8` is negative and would
            // reject every valid offset under SignedGreaterThan (CYB-129 / isle_adapter).
            mut word index = 0;
            while index < pointerCount {
                word mapOffset = index * 8;
                if mapOffset / 8 != index {
                    return false;
                } else {
                    word offset = raw_word_load(pointer_add(pointerMap, mapOffset));
                    if offset < 16 {
                        return false;
                    } else {
                        if offset % 8 != 0 {
                            return false;
                        } else {
                            word end = offset + 8;
                            if end < offset {
                                return false;
                            } else {
                                if end > objectSize {
                                    return false;
                                } else {
                                    index = index + 1;
                                }
                            }
                        }
                    }
                }
            }
            return true;
        }
    }
}

// Fail-closed structural validation of a managed object's `BeskidTypeDescriptor`.
pub bool ValidateTypeDescriptor(pointer descriptor) {
    if descriptor == NativePointer(0) {
        return false;
    } else {
        word size = TypeDescriptorSize(descriptor);
        if size < 16 {
            return false;
        } else {
            word alignment = TypeDescriptorAlignment(descriptor);
            bool alignmentOk = IsValidObjectAlignment(alignment);
            if alignmentOk {
                return ValidatePointerMap(
                    TypeDescriptorPointerMap(descriptor),
                    TypeDescriptorPointerCount(descriptor),
                    size
                );
            } else {
                return false;
            }
        }
    }
}

// Reserves one validated, zeroed managed object whose header begins at the returned address.
//
// This mirrors the existing runtime's `allocate_beskid` ownership shape: the descriptor is at
// offset zero and the allocation size already includes the 16-byte object header. The request
// size and alignment must exactly match its structurally valid descriptor. Returning a null
// pointer on an invalid or saturated request leaves trap and rooting policy to generated code.
[Export(Abi:"C", Symbol:"beskid_rt_v5_managed_object_allocate")]
pub pointer AllocateObject(pointer request) {
    if request == NativePointer(0) {
        return NativePointer(0);
    } else {
        pointer descriptor = AllocationDescriptor(request);
        bool descriptorOk = ValidateTypeDescriptor(descriptor);
        if descriptorOk {
            word size = AllocationSize(request);
            word alignment = AllocationAlignment(request);
            if size != TypeDescriptorSize(descriptor) {
                return NativePointer(0);
            } else {
                if alignment != TypeDescriptorAlignment(descriptor) {
                    return NativePointer(0);
                } else {
                    pointer object = SystemAllocate(size, alignment);
                    if object == NativePointer(0) {
                          return object;
                    } else {
                        memory_set(object, 0, size);
                        InitializeObjectHeader(object, descriptor);
                        return object;
                    }
                }
            }
        } else {
            return NativePointer(0);
        }
    }
}

// Allocates a closure capture environment through the canonical managed-object allocator.
[Export(Abi:"C", Symbol:"beskid_rt_v5_closure_environment_allocate")]
pub pointer AllocateClosureEnvironment(pointer request) {
    return AllocateObject(request);
}

// Stores a capture in a validated closure environment's registered pointer-map slot.
[Export(Abi:"C", Symbol:"beskid_rt_v5_closure_capture_store")]
pub bool StoreClosureCapture(pointer environment, pointer descriptor, word mapIndex, pointer value) {
    if environment == NativePointer(0) {
        return false;
    } else {
        bool descriptorOk = ValidateTypeDescriptor(descriptor);
        if descriptorOk {
            word pointerCount = TypeDescriptorPointerCount(descriptor);
            if mapIndex >= pointerCount {
                return false;
            } else {
                pointer pointerMap = TypeDescriptorPointerMap(descriptor);
                word offset = raw_word_load(pointer_add(pointerMap, mapIndex * 8));
                raw_word_store(pointer_add(environment, offset), NativeWord(value));
                return true;
            }
        } else {
            return false;
        }
    }
}

// Reads `BeskidRootSlot.value` for a caller-owned root-frame slot.
pub pointer RootSlotValue(pointer rootFrame, word index) {
    if rootFrame == NativePointer(0) {
        return NativePointer(0);
    }
    if index >= RootFrameSlotCount(rootFrame) {
        return NativePointer(0);
    }
    pointer slots = RootFrameSlots(rootFrame);
    if slots == NativePointer(0) {
        return NativePointer(0);
    }
    return NativePointer(raw_word_load(pointer_add(slots, index * 8)));
}

// Writes `BeskidRootSlot.value` for a caller-owned root-frame slot.
pub bool SetRootSlotValue(pointer rootFrame, word index, pointer value) {
    if rootFrame == NativePointer(0) {
        return false;
    }
    if index >= RootFrameSlotCount(rootFrame) {
        return false;
    }
    pointer slots = RootFrameSlots(rootFrame);
    if slots == NativePointer(0) {
        return false;
    }
    raw_word_store(pointer_add(slots, index * 8), NativeWord(value));
    return true;
}

// Registers a closure environment in the current TLS root frame.
[Export(Abi:"C", Symbol:"beskid_rt_v5_closure_environment_root")]
pub bool RootClosureEnvironment(pointer tlsState, word slotIndex, pointer environment) {
    if tlsState == NativePointer(0) {
        return false;
    }
    if environment == NativePointer(0) {
        return false;
    }
    pointer rootFrame = RootFrame(tlsState);
    if rootFrame == NativePointer(0) {
        return false;
    }
    return SetRootSlotValue(rootFrame, slotIndex, environment);
}

// Roots a closure environment through the actual TLS state installed for this runtime thread.
//
// This is the sole generated-code entry for current root ownership. `tls_get` remains a
// compiler-authorized canonical-runtime intrinsic: user syntax receives neither the TLS address
// nor an alternate way to fabricate one. Missing TLS, root-frame, or environment values remain
// fail-closed in `RootClosureEnvironment`.
[Export(Abi:"C", Symbol:"beskid_rt_v5_closure_environment_root_current")]
pub bool RootClosureEnvironmentCurrent(word slotIndex, pointer environment) {
    return RootClosureEnvironment(CurrentThreadState(), slotIndex, environment);
}

// Releases an object allocation during a future sweep phase.
//
// No currently exposed function invokes this directly.  Keeping deallocation paired with the
// originating request preserves size ownership without claiming that tracing or finalization is
// available yet.
pub unit ReleaseObject(pointer object, pointer request) {
    if object != NativePointer(0) {
        SystemFree(object, AllocationSize(request));
    }
    return;
}

// Terminates through the manifest-owned ABI-v5 trap entrypoint.
[Export(Abi:"C", Symbol:"beskid_rt_v5_trap")]
pub never Trap(u8 code, pointer message, word messageLength) {
    trap(code, message, messageLength);
}
