/// Returns the native runtime ABI implemented by this canonical source corpus.
[Export(Abi:"C", Symbol:"beskid_rt_v5_abi_version")]
pub i32 AbiVersion() {
    return 5;
}

/// Activates the caller-owned runtime state for the current process thread.
///
/// The old bridge only established thread-local runtime bootstrap state; it did not own a
/// separately allocated ABI-v5 process object.  Keep that ownership boundary while the
/// allocation and GC runtime modules are migrated: the caller supplies the manifest-layout
/// runtime handle, which becomes the current trusted TLS value and is returned unchanged.
[Export(Abi:"C", Symbol:"beskid_rt_v5_process_init")]
pub pointer ProcessInit(pointer config) {
    tls_set(config);
    return config;
}

/// Ends the current process-thread bootstrap scope.
///
/// `runtime` is retained in the ABI signature so future lifecycle modules can validate and
/// dispose caller-owned state.  This first source-only slice mirrors the bridge's TLS-only
/// bootstrap by clearing the active handle without allocating or scheduling work.
[Export(Abi:"C", Symbol:"beskid_rt_v5_process_shutdown")]
pub unit ProcessShutdown(pointer runtime) {
    tls_set(NativePointer(0));
    return;
}

/// Converts an opaque runtime address to its pointer-width representation.
///
/// `native_word_from_pointer` is not a user-visible extern: codegen recognizes this direct call
/// only after the compiler has attached canonical-runtime authority to this exact source corpus.
pub word NativeWord(pointer value) {
    return native_word_from_pointer(value);
}

/// Converts a pointer-width runtime word back to an opaque native address.
pub pointer NativePointer(word value) {
    return pointer_from_native_word(value);
}

/// Reserves native storage through the manifest-owned platform allocator.
///
/// This is deliberately not a managed-object allocation: object headers, descriptor validation,
/// GC accounting, and collection policy remain owned by the future heap module.  The wrapper only
/// preserves the ABI-v5 allocator boundary used by bootstrap state.
pub pointer SystemAllocate(word size, word alignment) {
    return system_allocate(size, alignment);
}

/// Releases storage previously obtained from [`SystemAllocate`].
///
/// The manifest owns the size-only release contract.  This wrapper must not infer ownership or
/// run destructors; managed lifetime is not part of this bootstrap corpus.
pub unit SystemFree(pointer address, word size) {
    system_free(address, size);
    return;
}

/// Returns the opaque state associated with the current runtime thread.
///
/// The value is a `BeskidTlsState` address only after a caller has installed one.  Keeping it
/// opaque prevents this source-only bootstrap layer from imposing scheduler or GC-thread policy.
pub pointer CurrentThreadState() {
    return tls_get();
}

/// Installs the opaque state for the current runtime thread.
pub unit SetCurrentThreadState(pointer state) {
    tls_set(state);
    return;
}

/// Reads `BeskidTlsState.root_frame` from its manifest-frozen byte offset.
///
/// Root frame chaining is represented but not interpreted here.  In particular, this wrapper
/// does not scan slots or collect objects; that belongs to the canonical heap implementation.
pub pointer RootFrame(pointer tlsState) {
    return NativePointer(raw_word_load(pointer_add(tlsState, 8)));
}

/// Writes `BeskidTlsState.root_frame` at its manifest-frozen byte offset.
pub unit SetRootFrame(pointer tlsState, pointer rootFrame) {
    raw_word_store(pointer_add(tlsState, 8), NativeWord(rootFrame));
    return;
}

/// Reads the preceding frame from a caller-owned `BeskidRootFrame` record.
///
/// A frame is stack storage owned by generated code.  The runtime may link the frame into TLS,
/// but never allocates, frees, or moves it.
pub pointer RootFramePrevious(pointer rootFrame) {
    return NativePointer(raw_word_load(rootFrame));
}

/// Reads the address of the first `BeskidRootSlot` from a root-frame record.
///
/// This is a collector input, not a collector: it gives a future non-moving marker an exact
/// manifest-layout traversal boundary without making liveness decisions here.
pub pointer RootFrameSlots(pointer rootFrame) {
    return NativePointer(raw_word_load(pointer_add(rootFrame, 8)));
}

/// Reads the number of caller-owned slots represented by a root frame.
pub word RootFrameSlotCount(pointer rootFrame) {
    return raw_word_load(pointer_add(rootFrame, 16));
}

/// Links a caller-owned root frame as the current frame for this TLS state.
///
/// The prior top is retained in `rootFrame.previous`, so a future collector can traverse a stable
/// LIFO chain while generated code owns the actual slot storage.
pub unit PushRootFrame(pointer tlsState, pointer rootFrame) {
    raw_word_store(rootFrame, NativeWord(RootFrame(tlsState)));
    SetRootFrame(tlsState, rootFrame);
    return;
}

/// Unlinks `rootFrame` only when it remains the current top of this TLS state.
///
/// Returning `false` for an out-of-order pop preserves the active root chain instead of silently
/// dropping a live frame.  This is ownership validation, not collection or finalization.
pub bool PopRootFrame(pointer tlsState, pointer rootFrame) {
    if RootFrame(tlsState) != rootFrame {
        return false;
    }
    SetRootFrame(tlsState, RootFramePrevious(rootFrame));
    raw_word_store(rootFrame, 0);
    return true;
}

/// Reads `BeskidAllocationRequest.size` at its manifest-frozen offset.
pub word AllocationSize(pointer request) {
    return raw_word_load(request);
}

/// Reads `BeskidAllocationRequest.alignment` at its manifest-frozen offset.
pub word AllocationAlignment(pointer request) {
    return raw_word_load(pointer_add(request, 8));
}

/// Reads `BeskidAllocationRequest.descriptor` at its manifest-frozen offset.
pub pointer AllocationDescriptor(pointer request) {
    return NativePointer(raw_word_load(pointer_add(request, 16)));
}

/// Installs the fixed `BeskidObjectHeader` fields at the start of a freshly zeroed object.
///
/// `gc_word` stays zero until the future marker owns mark-state transitions.  This source slice
/// does not interpret descriptor pointer maps, trace children, or finalize an object.
pub unit InitializeObjectHeader(pointer object, pointer descriptor) {
    raw_word_store(object, NativeWord(descriptor));
    raw_word_store(pointer_add(object, 8), 0);
    return;
}

/// Reserves one zeroed object whose header begins at the returned address.
///
/// This mirrors the existing runtime's `allocate_beskid` ownership shape: the descriptor is at
/// offset zero and the allocation size already includes the 16-byte object header.  Returning a
/// null pointer on an invalid/saturated request leaves trap and collection policy to higher
/// runtime layers.
pub pointer AllocateObject(pointer request) {
    word size = AllocationSize(request);
    if size < 16 {
        return NativePointer(0);
    }
    pointer object = SystemAllocate(size, AllocationAlignment(request));
    if object == NativePointer(0) {
        return object;
    }
    memory_set(object, 0, size);
    pointer descriptor = AllocationDescriptor(request);
    InitializeObjectHeader(object, descriptor);
    return object;
}

/// Releases an object allocation during a future sweep phase.
///
/// No currently exposed function invokes this directly.  Keeping deallocation paired with the
/// originating request preserves size ownership without claiming that tracing or finalization is
/// available yet.
pub unit ReleaseObject(pointer object, pointer request) {
    if object != NativePointer(0) {
        SystemFree(object, AllocationSize(request));
    }
    return;
}

/// Terminates through the manifest-owned ABI-v5 trap entrypoint.
[Export(Abi:"C", Symbol:"beskid_rt_v5_trap")]
pub never Trap(u8 code, pointer message, word messageLength) {
    trap(code, message, messageLength);
}
