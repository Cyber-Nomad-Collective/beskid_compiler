// Canonical descriptor-bearing Dynamic V1 records. Registration code consumes
// compiler-issued signature closure and constructors; raw addresses do not
// acquire managed-reference classification through these declarations.
use Core.Collections.Array;
use Core.Hash.Sha256;
use Core.Results;
use Core.Dynamic;

pub type DynamicRegistryRecordV1 {
    pub DynamicShapeRecordV1[] shapes,
    pub DynamicMappingRecordV1[] mappings,
    pub u64 processIssuer,
    pub u64 session,
    pub u64 generation,
    pub u64 closed,
}

pub type DynamicShapeRecordV1 {
    pub DynamicRegistryRecordV1 registryOwner,
    pub u8[] signature,
    pub u8[] stableDigest,
    pub pointer payloadDescriptor,
    pub pointer cellDescriptor,
    pub pointer constructCell,
    pub pointer readPayload,
    pub u8[] sourceIdentity,
    pub u64 generation,
    pub u64 library,
    pub u64 tag,
}

pub type DynamicMappingRecordV1 {
    pub DynamicShapeRecordV1 source,
    pub DynamicShapeRecordV1 destination,
    pub u8[] transformationSignature,
    pub pointer transformPayload,
    pub u64 generation,
    pub u64 library,
    pub u64 token,
}

// Pack's source-qualified box is already constructed. This canonical cell
// stores that sealed managed payload directly; no primitive box relabeling or
// raw pointer-to-nominal cast is performed by source code.
pub type DynamicErasedCellV1 {
    pub DynamicPayloadV1 payload,
    pub DynamicShapeRecordV1 shapeRecord,
    pub u64 tag,
}
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_erased_construct")]
pub DynamicErasedCellV1 DynamicErasedConstructV1(DynamicPayloadV1 payload, DynamicShapeRecordV1 shape) {
    return DynamicErasedCellV1 { payload: payload, shapeRecord: shape, tag: shape.tag };
}
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_erased_read")]
pub DynamicPayloadV1 DynamicErasedReadV1(DynamicErasedCellV1 cell) { return cell.payload; }

pub type DynamicBoxV1<T> { pub T value, }
pub type DynamicCellV1<T> {
    pub DynamicBoxV1<T> payload,
    pub DynamicShapeRecordV1 shapeRecord,
    pub u64 tag,
}

// These generic constructors are instantiated only from current-assembly
// canonical type bindings. The concrete box is always a managed nominal field,
// so each cell has the same 40-byte shape and traces payload and shapeRecord.
pub DynamicCellV1<T> DynamicConstructTypedV1<T>(T value, DynamicShapeRecordV1 shape) {
    DynamicBoxV1<T> payloadBox = DynamicBoxV1<T> { value: value };
    return DynamicCellV1<T> { payload: payloadBox, shapeRecord: shape, tag: shape.tag };
}

pub T DynamicReadTypedV1<T>(DynamicCellV1<T> cell) { return cell.payload.value; }

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_registry_construct")]
pub DynamicRegistryRecordV1 DynamicRegistryConstructV1(u64 issuer, u64 session, u64 generation) {
    DynamicShapeRecordV1[] shapes = Array.Empty<DynamicShapeRecordV1>();
    DynamicMappingRecordV1[] mappings = Array.Empty<DynamicMappingRecordV1>();
    return DynamicRegistryRecordV1 { shapes: shapes, mappings: mappings,
        processIssuer: issuer, session: session, generation: generation, closed: 0 };
}

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_shape_construct")]
pub DynamicShapeRecordV1 DynamicShapeConstructV1(DynamicRegistryRecordV1 owner,
    u8[] signature, u8[] digest, pointer payloadDescriptor, pointer cellDescriptor,
    pointer constructor, pointer reader, u8[] sourceIdentity, u64 generation, u64 library, u64 tag) {
    return DynamicShapeRecordV1 { registryOwner: owner, signature: signature,
        stableDigest: digest, payloadDescriptor: payloadDescriptor,
        cellDescriptor: cellDescriptor, constructCell: constructor, readPayload: reader,
        sourceIdentity: sourceIdentity, generation: generation, library: library, tag: tag };
}

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_registry_append_shape")]
pub unit DynamicRegistryAppendShapeV1(mut DynamicRegistryRecordV1 owner, DynamicShapeRecordV1 shape) {
    Array.Append<DynamicShapeRecordV1>(owner.shapes, shape);
}

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_registry_shape_count")]
pub word DynamicRegistryShapeCountV1(DynamicRegistryRecordV1 owner) { return word(Array.Len<DynamicShapeRecordV1>(owner.shapes)); }

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_registry_shape_at")]
pub DynamicShapeRecordV1 DynamicRegistryShapeAtV1(DynamicRegistryRecordV1 owner, word index) { return owner.shapes[index]; }

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_registry_tag")]
pub u64 DynamicRegistryTagV1(DynamicRegistryRecordV1 owner, word selector) {
    if selector == 0 { return owner.processIssuer; }
    if selector == 1 { return owner.session; }
    if selector == 2 { return owner.generation; }
    if selector == 3 { return owner.closed; }
    return 0;
}

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_registry_close")]
pub unit DynamicRegistryCloseV1(mut DynamicRegistryRecordV1 owner) { owner.closed = 1; }

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_shape_pointer")]
pub pointer DynamicShapePointerV1(DynamicShapeRecordV1 shape, word selector) {
    if selector == 0 { return shape.payloadDescriptor; }
    if selector == 1 { return shape.cellDescriptor; }
    if selector == 2 { return shape.constructCell; }
    if selector == 3 { return shape.readPayload; }
    return NativePointer(0);
}

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_shape_tag")]
pub u64 DynamicShapeTagV1(DynamicShapeRecordV1 shape, word selector) {
    if selector == 1 { return shape.generation; }
    if selector == 2 { return shape.tag; }
    if selector == 3 { return shape.library; }
    return 0;
}

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_shape_signature")]
pub u8[] DynamicShapeSignatureV1(DynamicShapeRecordV1 shape) { return shape.signature; }

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_shape_digest")]
pub u8[] DynamicShapeDigestV1(DynamicShapeRecordV1 shape) { return shape.stableDigest; }

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_shape_owner")]
pub DynamicRegistryRecordV1 DynamicShapeOwnerV1(DynamicShapeRecordV1 shape) { return shape.registryOwner; }

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_shape_source")]
pub u8[] DynamicShapeSourceV1(DynamicShapeRecordV1 shape) { return shape.sourceIdentity; }

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_descriptor_valid")]
pub bool DynamicDescriptorValidV1(pointer descriptor, bool cell) {
    if ValidateTypeDescriptor(descriptor) == false { return false; }
    if cell == false { return true; }
    pointer map = TypeDescriptorPointerMap(descriptor);
    return TypeDescriptorSize(descriptor) == 40 && TypeDescriptorAlignment(descriptor) == 8
        && TypeDescriptorFlags(descriptor) == 0 && TypeDescriptorPointerCount(descriptor) == 2
        && map != NativePointer(0) && raw_word_load(map) == 16
        && raw_word_load(pointer_add(map, 8)) == 24;
}

[Export(Abi:"C", Symbol:"beskid_dynamic_v1_signature_digest")]
pub u8[] DynamicSignatureDigestV1(u8[] signature) {
    return match Sha256.HashBytes(signature, 1048576_i64) {
        Result::Ok(value) => value,
        Result::Error(_) => Array.Empty<u8>(),
    };
}

pub DynamicBoxV1<T> DynamicBoxTypedV1<T>(T value) { return DynamicBoxV1<T> { value: value }; }
pub DynamicCellV1<T> DynamicConstructBoxedV1<T>(DynamicBoxV1<T> payload, DynamicShapeRecordV1 shape) {
    return DynamicCellV1<T> { payload: payload, shapeRecord: shape, tag: shape.tag };
}
pub DynamicBoxV1<T> DynamicReadBoxedV1<T>(DynamicCellV1<T> cell) { return cell.payload; }

