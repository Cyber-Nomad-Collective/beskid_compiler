[Export(Abi:"C", Symbol:"beskid_dynamic_v1_mapping_construct")]
pub DynamicMappingRecordV1 DynamicMappingConstructV1(DynamicShapeRecordV1 source,
    DynamicShapeRecordV1 destination, u8[] signature, pointer transform, u64 generation, u64 library, u64 token) {
    return DynamicMappingRecordV1 { source: source, destination: destination,
        transformationSignature: signature, transformPayload: transform,
        generation: generation, library: library, token: token };
}
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_registry_append_mapping")]
pub unit DynamicRegistryAppendMappingV1(mut DynamicRegistryRecordV1 owner, DynamicMappingRecordV1 mapping) {
    Array.Append<DynamicMappingRecordV1>(owner.mappings, mapping);
}
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_registry_mapping_count")]
pub word DynamicRegistryMappingCountV1(DynamicRegistryRecordV1 owner) { return word(Array.Len<DynamicMappingRecordV1>(owner.mappings)); }
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_registry_mapping_at")]
pub DynamicMappingRecordV1 DynamicRegistryMappingAtV1(DynamicRegistryRecordV1 owner, word index) { return owner.mappings[index]; }
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_mapping_source")]
pub DynamicShapeRecordV1 DynamicMappingSourceV1(DynamicMappingRecordV1 mapping) { return mapping.source; }
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_mapping_destination")]
pub DynamicShapeRecordV1 DynamicMappingDestinationV1(DynamicMappingRecordV1 mapping) { return mapping.destination; }
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_mapping_signature")]
pub u8[] DynamicMappingSignatureV1(DynamicMappingRecordV1 mapping) { return mapping.transformationSignature; }
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_mapping_transform")]
pub pointer DynamicMappingTransformV1(DynamicMappingRecordV1 mapping) { return mapping.transformPayload; }
[Export(Abi:"C", Symbol:"beskid_dynamic_v1_mapping_tag")]
pub u64 DynamicMappingTagV1(DynamicMappingRecordV1 mapping, word selector) {
    if selector == 0 { return mapping.generation; }
    if selector == 1 { return mapping.token; }
    if selector == 2 { return mapping.library; }
    return 0;
}
