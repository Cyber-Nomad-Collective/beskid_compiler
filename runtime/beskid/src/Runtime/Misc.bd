/// Canonical Beskid miscellaneous builtins: mutex, hub, events, dynamic, callbacks, wait groups.

// ── Mutex ──
[Export(Abi:"C", Symbol:"mutex_create")]
pub pointer MutexCreate() { return NativePointer(0); }

[Export(Abi:"C", Symbol:"mutex_lock")]
pub unit MutexLock(pointer m) { return; }

[Export(Abi:"C", Symbol:"mutex_try_lock")]
pub bool MutexTryLock(pointer m) { return false; }

[Export(Abi:"C", Symbol:"mutex_unlock")]
pub unit MutexUnlock(pointer m) { return; }

// ── Hub (pub/sub broker) ──
[Export(Abi:"C", Symbol:"hub_create")]
pub pointer HubCreate() { return NativePointer(0); }

[Export(Abi:"C", Symbol:"hub_register")]
