[Export(Abi:"C", Symbol:"hub_unregister")]
pub unit HubUnregister(pointer hub, u64 id) { return; }

[Export(Abi:"C", Symbol:"hub_wait_receive_status")]
pub i32 HubWaitReceiveStatus(pointer hub, u64 id) { return 0; }

[Export(Abi:"C", Symbol:"hub_wait_receive_value")]
pub i64 HubWaitReceiveValue(pointer hub, u64 id) { return 0; }

[Export(Abi:"C", Symbol:"hub_wait_receive_index")]
pub i32 HubWaitReceiveIndex(pointer hub, u64 id) { return 0; }

