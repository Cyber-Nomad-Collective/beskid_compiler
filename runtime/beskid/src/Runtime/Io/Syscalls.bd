// Canonical tagged syscall-worker seam. Managed addresses never cross into the
// worker pool: submission copies bytes/metadata to native system allocations,
// parks the calling fiber, and copies read results only after scheduler resume.

const SYSCALL_REQUEST_SIZE = 64;
const SYSCALL_READ = 1;
const SYSCALL_WRITE = 2;

pointer StringViewData(pointer value) {
    if value == NativePointer(0) { return NativePointer(0); }
    return NativePointer(raw_word_load(value));
}

word StringViewLength(pointer value) {
    if value == NativePointer(0) { return 0; }
    return raw_word_load(pointer_add(value, 8));
}

i64 FinishSyscallRequest(pointer request, pointer nativeBuffer, word allocation, pointer managedBuffer, word len, word operation) {
    i64 result = i64(raw_word_load(pointer_add(request, 48)));
    if operation == SYSCALL_READ && result > 0 { memory_copy(managedBuffer, nativeBuffer, word(result)); }
    SystemFree(request, SYSCALL_REQUEST_SIZE);
    SystemFree(nativeBuffer, allocation);
    return result;
}

pub i64 SyscallSubmitAndPark(word nativeHandle, pointer managedBuffer, word len, word operation) {
    mut word allocation = len;
    if allocation == 0 { allocation = 1; }
    pointer nativeBuffer = SystemAllocate(allocation, 8);
    if nativeBuffer == NativePointer(0) { return -1; }
    if operation == SYSCALL_WRITE && len != 0 { memory_copy(nativeBuffer, managedBuffer, len); }

    pointer request = SystemAllocate(SYSCALL_REQUEST_SIZE, 8);
    if request == NativePointer(0) { SystemFree(nativeBuffer, allocation); return -1; }
    memory_set(request, 0, SYSCALL_REQUEST_SIZE);
    raw_word_store(pointer_add(request, 16), operation);
    raw_word_store(pointer_add(request, 24), nativeHandle);
    raw_word_store(pointer_add(request, 32), NativeWord(nativeBuffer));
    raw_word_store(pointer_add(request, 40), len);

    word fiberIndex = SchedulerCurrentFiber();
    if fiberIndex == FIBER_NONE {
        if WorkerSubmit(request) != 0 {
            SystemFree(request, SYSCALL_REQUEST_SIZE);
            SystemFree(nativeBuffer, allocation);
            return -1;
        }
        while !WorkerPoll(request) {}
        return FinishSyscallRequest(request, nativeBuffer, allocation, managedBuffer, len, operation);
    }
    if !SchedulerRegisterWorkerRequest(request, fiberIndex) {
        SystemFree(request, SYSCALL_REQUEST_SIZE);
        SystemFree(nativeBuffer, allocation);
        return -1;
    }
    if WorkerSubmit(request) != 0 {
        SchedulerUnregisterWorkerRequest(request);
        SystemFree(request, SYSCALL_REQUEST_SIZE);
        SystemFree(nativeBuffer, allocation);
        return -1;
    }

    FiberSetState(fiberIndex, FIBER_STATE_PARKED);
    SaveFiberLocalState(fiberIndex);
    SchedulerSetCurrentFiber(FIBER_NONE);
    SchedulerReleaseMutatorToken();
    ContextSwitch(NativePointer(raw_word_load(pointer_add(FiberRecord(fiberIndex), 104))), SchedulerContext());

    return FinishSyscallRequest(request, nativeBuffer, allocation, managedBuffer, len, operation);
}

[Export(Abi:"C", Symbol:"syscall_read")]
pub i64 SyscallRead(i32 nativeHandle, pointer buffer, word len) {
    return SyscallSubmitAndPark(word(nativeHandle), buffer, len, SYSCALL_READ);
}

[Export(Abi:"C", Symbol:"syscall_read_bytes")]
pub i64 SyscallReadBytes(i32 nativeHandle, pointer data, word len) { return SyscallRead(nativeHandle, data, len); }

[Export(Abi:"C", Symbol:"syscall_write")]
pub i64 SyscallWrite(i64 nativeHandle, pointer value) {
    if value == NativePointer(0) { return -1; }
    return SyscallSubmitAndPark(word(nativeHandle), StringViewData(value), StringViewLength(value), SYSCALL_WRITE);
}

[Export(Abi:"C", Symbol:"syscall_write_bytes")]
pub i64 SyscallWriteBytes(i32 nativeHandle, pointer data, word len) {
    return SyscallSubmitAndPark(word(nativeHandle), data, len, SYSCALL_WRITE);
}

[Export(Abi:"C", Symbol:"beskid_trap_code")]
pub never Panic(i64 code) { FiberPanic(NativePointer(0)); }

[Export(Abi:"C", Symbol:"beskid_trap_message")]
pub never PanicStr(pointer message) {
    FiberPanic(message);
}

// A child panic unwinds by transferring its native context back to the scheduler.
// The terminal stack is never resumed. A panic outside a fiber, or in a detached
// fiber, retains process-fatal behavior. Panic codes exposed by Join are always 2.
pub never FiberPanic(pointer message) {
    word index = SchedulerCurrentFiber();
    if index == FIBER_NONE || !FiberExists(index) {
        Trap(9, StringViewData(message), StringViewLength(message));
    }
    pointer fiber = FiberRecord(index);
    if raw_byte_load(pointer_add(fiber, 40)) != 0 {
        Trap(9, StringViewData(message), StringViewLength(message));
    }
    pointer ownedMessage = StrNew(StringViewData(message), StringViewLength(message));
    if ownedMessage == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    raw_word_store(pointer_add(fiber, 56), NativeWord(ownedMessage));
    raw_word_store(pointer_add(fiber, FIBER_OUTCOME_REASON_OFFSET), 2);
    raw_word_store(pointer_add(fiber, 48), FIBER_JOIN_PANICKED);
    raw_word_store(fiber, FIBER_STATE_DONE);
    if AbiValueClear(pointer_add(fiber, BESKID_FIBER_RECORD_CAPTURE_OFFSET)) == false { Trap(10, NativePointer(0), 0); }
    raw_word_store(pointer_add(fiber, 16), 0);
    FiberReleaseStackRoots(index);
    SaveFiberLocalState(index);
    SchedulerSetCurrentFiber(FIBER_NONE);
    ContextSwitch(NativePointer(raw_word_load(pointer_add(fiber, 104))), SchedulerContext());
    Trap(10, NativePointer(0), 0);
}
