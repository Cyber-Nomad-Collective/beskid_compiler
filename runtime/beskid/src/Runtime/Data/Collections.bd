// Canonical Beskid runtime arrays and byte-buffer operations.

// Allocates a new managed array of `elementSize` bytes per element.
[Export(Abi:"C", Symbol:"array_new")]
pub pointer ArrayNew(word elementSize, word count) {
    if count == 0 || elementSize == 0 {
        return NativePointer(0);
    }
    word totalSize = elementSize * count;
    if totalSize / elementSize != count {
        return NativePointer(0);
    }
    pointer buffer = SystemAllocate(totalSize, elementSize);
    if buffer == NativePointer(0) {
        return NativePointer(0);
    }
    memory_set(buffer, 0, totalSize);
    return buffer;
}

// Allocates one descriptor-backed array object and roots it before generated code can write
// any element. `request` is the ABI-v5 BeskidArrayAllocationRequest layout and `rootHandleOut`
// is a caller-owned native-word stack slot. The handle is released only by
// ArrayConstructionFinish after every element store and pointer write barrier has completed.
[Export(Abi:"C", Symbol:"beskid_rt_v5_array_allocate_rooted")]
pub pointer AllocateArrayRooted(pointer request, pointer rootHandleOut) {
    if request == NativePointer(0) || rootHandleOut == NativePointer(0) {
        return NativePointer(0);
    }
    raw_word_store(rootHandleOut, 0);
    pointer element = NativePointer(raw_word_load(request));
    pointer descriptor = NativePointer(raw_word_load(pointer_add(request, 16)));
    if ValidateArrayElementDescriptor(element) == false || ValidateTypeDescriptor(descriptor) == false ||
       TypeDescriptorFlags(descriptor) != TYPE_DESCRIPTOR_ARRAY || raw_word_load(pointer_add(request, 24)) != 0 {
        return NativePointer(0);
    }
    word stride = raw_word_load(element);
    word alignment = raw_word_load(pointer_add(element, 8));
    word length = raw_word_load(pointer_add(request, 8));
    if stride == 0 || alignment == 0 || stride / alignment * alignment != stride {
        return NativePointer(0);
    }
    word backingSize = stride * length;
    if length != 0 && backingSize / stride != length {
        return NativePointer(0);
    }
    // Hidden element metadata follows the header; the public BeskidArray remains exactly
    // `{ pointer data; word len; word cap; }` and starts at object + 24.
    word totalSize = backingSize + 48;
    if totalSize < backingSize {
        return NativePointer(0);
    }
    pointer object = GcAlloc(totalSize, TypeDescriptorAlignment(descriptor));
    if object == NativePointer(0) {
        return NativePointer(0);
    }
    memory_set(object, 0, totalSize);
    raw_word_store(object, NativeWord(descriptor));
    raw_word_store(pointer_add(object, 16), NativeWord(element));
    pointer array = pointer_add(object, 24);
    word handle = GcRootHandle(object);
    if handle == 0 {
        return NativePointer(0);
    }
    raw_word_store(array, NativeWord(pointer_add(object, 48)));
    raw_word_store(pointer_add(array, 8), length);
    raw_word_store(pointer_add(array, 16), length);
    raw_word_store(rootHandleOut, handle);
    return array;
}

// Grows a descriptor-backed array into a distinct rooted object. The ABI-visible array starts
// after the GC header and hidden element descriptor; the construction handle roots the object.
// Failure never mutates the source array and leaves the output token at zero.
[Export(Abi:"C", Symbol:"beskid_rt_v5_array_grow_rooted")]
pub pointer GrowArrayRooted(pointer array, word minimumCapacity, pointer rootHandleOut) {
    if array == NativePointer(0) || rootHandleOut == NativePointer(0) {
        return NativePointer(0);
    }
    raw_word_store(rootHandleOut, 0);

    pointer object = NativePointer(NativeWord(array) - 24);
    if NativeWord(object) >= NativeWord(array) {
        return NativePointer(0);
    }
    pointer descriptor = NativePointer(raw_word_load(object));
    if descriptor == NativePointer(0) || ValidateTypeDescriptor(descriptor) == false {
        return NativePointer(0);
    }

    pointer sourceData = NativePointer(raw_word_load(array));
    word length = raw_word_load(pointer_add(array, 8));
    word capacity = raw_word_load(pointer_add(array, 16));
    if sourceData == NativePointer(0) || length > capacity || minimumCapacity < length {
        return NativePointer(0);
    }

    // A no-growth request still returns a rooted result and never reallocates the source.
    if minimumCapacity <= capacity {
        word existingHandle = GcRootHandle(object);
        if existingHandle == 0 {
            return NativePointer(0);
        }
        raw_word_store(rootHandleOut, existingHandle);
        return array;
    }

    pointer element = NativePointer(raw_word_load(pointer_add(object, 16)));
    if TypeDescriptorFlags(descriptor) != TYPE_DESCRIPTOR_ARRAY || ValidateArrayElementDescriptor(element) == false {
        return NativePointer(0);
    }
    word stride = raw_word_load(element);
    word alignment = raw_word_load(pointer_add(element, 8));
    if stride == 0 || alignment == 0 || stride / alignment * alignment != stride {
        return NativePointer(0);
    }
    word copyBytes = stride * length;
    if length != 0 && copyBytes / stride != length {
        return NativePointer(0);
    }
    word backingSize = stride * minimumCapacity;
    if minimumCapacity != 0 && backingSize / stride != minimumCapacity {
        return NativePointer(0);
    }
    word totalSize = backingSize + 48;
    if totalSize < backingSize {
        return NativePointer(0);
    }

    pointer replacementObject = GcAlloc(totalSize, alignment);
    if replacementObject == NativePointer(0) {
        return NativePointer(0);
    }
    memory_set(replacementObject, 0, totalSize);
    raw_word_store(replacementObject, NativeWord(descriptor));
    raw_word_store(pointer_add(replacementObject, 16), NativeWord(element));
    pointer replacement = pointer_add(replacementObject, 24);
    pointer replacementData = pointer_add(replacementObject, 48);
    if copyBytes != 0 {
        memory_copy(replacementData, sourceData, copyBytes);
    }
    raw_word_store(replacement, NativeWord(replacementData));
    raw_word_store(pointer_add(replacement, 8), length);
    raw_word_store(pointer_add(replacement, 16), minimumCapacity);

    word handle = GcRootHandle(replacementObject);
    if handle == 0 {
        return NativePointer(0);
    }
    raw_word_store(rootHandleOut, handle);
    return replacement;
}

// Releases the construction root established by AllocateArrayRooted or GrowArrayRooted. A zero
// token is never a successful rooted result, so generated code fails closed if none was published.
[Export(Abi:"C", Symbol:"beskid_rt_v5_array_construction_finish")]
pub u8 ArrayConstructionFinish(pointer rootHandle) {
    word handle = NativeWord(rootHandle);
    if handle == 0 {
        return 0;
    }
    GcUnrootHandle(handle);
    return 1;
}

// Publishes a pointer element write to the GC's insertion barrier while the array remains under
// its construction root. Scalar arrays do not call this entrypoint.
[Export(Abi:"C", Symbol:"beskid_rt_v5_array_write_barrier")]
pub u8 ArrayWriteBarrier(pointer array, pointer value) {
    if array == NativePointer(0) {
        return 0;
    }
    GcWriteBarrier(NativePointer(NativeWord(array) - 24), value);
    return 1;
}

// Returns the element count of a managed array.
[Export(Abi:"C", Symbol:"array_len")]
pub word ArrayLen(pointer array) {
    if array == NativePointer(0) {
        return 0;
    }
    // Array length is stored at offset -8 from the buffer start
    // (managed by the allocating codegen, not stored here).
    // For now, return 0 — the Rust runtime handles this via its own header.
    return 0;
}

// Byte-wise comparison of two buffers. Returns 0 when equal.
[Export(Abi:"C", Symbol:"bytes_compare")]
pub i32 BytesCompare(pointer left, word leftLen, pointer right, word rightLen) {
    if leftLen != rightLen {
        if leftLen < rightLen {
            return -1;
        }
        return 1;
    }
    if leftLen == 0 {
        return 0;
    }
    if left == NativePointer(0) || right == NativePointer(0) {
        return 0;
    }
    return memory_compare(left, right, leftLen);
}

// Copies `count` bytes from `source` to `destination`.
[Export(Abi:"C", Symbol:"bytes_copy")]
pub unit BytesCopy(pointer destination, pointer source, word count) {
    if destination == NativePointer(0) || source == NativePointer(0) || count == 0 {
        return;
    }
    memory_copy(destination, source, count);
    return;
}

// Creates a byte buffer from a string.
[Export(Abi:"C", Symbol:"bytes_from_str")]
pub pointer BytesFromStr(pointer value) {
    if value == NativePointer(0) {
        return NativePointer(0);
    }
    word len = raw_word_load(pointer_add(value, 8));
    pointer ptr = NativePointer(raw_word_load(value));
    if ptr == NativePointer(0) || len == 0 {
        return NativePointer(0);
    }
    pointer buffer = SystemAllocate(len, 1);
    if buffer == NativePointer(0) {
        return NativePointer(0);
    }
    memory_copy(buffer, ptr, len);
    return buffer;
}

// Reads a single byte at the given index.
[Export(Abi:"C", Symbol:"bytes_get")]
pub u8 BytesGet(pointer bytes, word index) {
    if bytes == NativePointer(0) {
        return 0;
    }
    return raw_byte_load(pointer_add(bytes, index));
}

// Writes a single byte at the given index.
[Export(Abi:"C", Symbol:"bytes_set")]
pub unit BytesSet(pointer bytes, word index, u8 value) {
    if bytes == NativePointer(0) {
        return;
    }
    raw_byte_store(pointer_add(bytes, index), value);
    return;
}
