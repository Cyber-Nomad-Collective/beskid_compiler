// Canonical compiler-planned dependency composition. The compiler supplies the exact
// slot count and emits direct slot writes; the runtime owns storage, rooting, activation,
// scopes, and reverse-order shutdown. Runtime service lookup is intentionally absent.
// Container record: owner_runtime(0), status(8), slot_count(16), slots(24), activated_count(32),
// open_scope_count(40), slots_bytes(48). The slot array is sized exactly to the compiler-supplied
// plan; there is no fixed plan-entry cap.
const COMPOSITION_CONTAINER_SIZE = 56;
// Scope record: owner_container(0), parent_scope(8), owned_count(16), owned_values(24), scope_id(32),
// parent_scope_id(40), owned_capacity(48). Owned values grow on demand (`CompositionScopeOwn`).
const COMPOSITION_SCOPE_SIZE = 56;
const COMPOSITION_SCOPE_OWNED_COUNT = 16;
const COMPOSITION_SCOPE_OWNED_VALUES = 24;
const COMPOSITION_SCOPE_OWNED_CAPACITY = 48;
const COMPOSITION_CONFIGURING = 1;
const COMPOSITION_ACTIVATING = 2;
const COMPOSITION_ACTIVE = 3;
const COMPOSITION_SHUTTING_DOWN = 4;
const COMPOSITION_SHUT_DOWN = 5;
const COMPOSITION_STATUS_OFFSET = 8;
const COMPOSITION_SLOT_COUNT_OFFSET = 16;
const COMPOSITION_SLOTS_OFFSET = 24;
const COMPOSITION_ACTIVATED_COUNT_OFFSET = 32;
const COMPOSITION_OPEN_SCOPE_COUNT_OFFSET = 40;
const COMPOSITION_SLOTS_BYTES_OFFSET = 48;
const TLS_COMPOSITION_SCOPE_OFFSET = 32;
const TLS_COMPOSITION_DEPTH_OFFSET = 40;

pub pointer CompositionScopeOwner() {
    // The scheduler projects each running fiber's scope and depth into TLS and
    // saves them back to its record on yield. Writing the record directly here
    // would be overwritten by SaveFiberLocalState at the next context switch.
    return CurrentThreadState();
}

pub word CompositionScopeOffset() {
    return TLS_COMPOSITION_SCOPE_OFFSET;
}

pub word CompositionDepthOffset() {
    return TLS_COMPOSITION_DEPTH_OFFSET;
}

pub word CompositionContainerValid(pointer container) {
    if container == NativePointer(0) { return 0; }
    pointer state = RuntimeState();
    if state == NativePointer(0) { return 0; }
    if raw_word_load(container) != NativeWord(state) { return 0; }
    return 1;
}

[Export(Abi:"C", Symbol:"composition_container_create")]
pub pointer CompositionContainerCreate(word slotCount) {
    pointer state = RuntimeState();
    if state == NativePointer(0) || slotCount > 0x0FFFFFFFFFFFFFFF { return NativePointer(0); }
    pointer container = SystemAllocate(COMPOSITION_CONTAINER_SIZE, 8);
    if container == NativePointer(0) { return NativePointer(0); }
    // Exactly the compiler's plan; a zero-slot plan still owns one addressable word.
    mut word slotsBytes = slotCount * 8;
    if slotsBytes == 0 { slotsBytes = 8; }
    pointer slots = SystemAllocate(slotsBytes, 8);
    if slots == NativePointer(0) {
        SystemFree(container, COMPOSITION_CONTAINER_SIZE);
        return NativePointer(0);
    }
    memory_set(container, 0, COMPOSITION_CONTAINER_SIZE);
    memory_set(slots, 0, slotsBytes);
    raw_word_store(container, NativeWord(state));
    raw_word_store(pointer_add(container, COMPOSITION_STATUS_OFFSET), COMPOSITION_CONFIGURING);
    raw_word_store(pointer_add(container, COMPOSITION_SLOT_COUNT_OFFSET), slotCount);
    raw_word_store(pointer_add(container, COMPOSITION_SLOTS_OFFSET), NativeWord(slots));
    raw_word_store(pointer_add(container, COMPOSITION_SLOTS_BYTES_OFFSET), slotsBytes);
    return container;
}

[Export(Abi:"C", Symbol:"composition_container_drop")]
pub unit CompositionContainerDrop(pointer container) {
    if CompositionContainerValid(container) == 0 ||
       raw_word_load(pointer_add(container, COMPOSITION_STATUS_OFFSET)) != COMPOSITION_SHUT_DOWN ||
       raw_word_load(pointer_add(container, COMPOSITION_OPEN_SCOPE_COUNT_OFFSET)) != 0 {
        Trap(10, NativePointer(0), 0);
    }
    pointer slots = NativePointer(raw_word_load(pointer_add(container, COMPOSITION_SLOTS_OFFSET)));
    word slotsBytes = raw_word_load(pointer_add(container, COMPOSITION_SLOTS_BYTES_OFFSET));
    memory_set(slots, 0, slotsBytes);
    SystemFree(slots, slotsBytes);
    memory_set(container, 0, COMPOSITION_CONTAINER_SIZE);
    SystemFree(container, COMPOSITION_CONTAINER_SIZE);
    return;
}

// The slot is compiler authority, not a service name or key. There is deliberately no
// dynamic resolve operation: generated injection code already knows the exact slot.
[Export(Abi:"C", Symbol:"composition_slot_store")]
pub bool CompositionSlotStore(pointer container, word slot, pointer service) {
    if CompositionContainerValid(container) == 0 || service == NativePointer(0) { return false; }
    if raw_word_load(pointer_add(container, COMPOSITION_STATUS_OFFSET)) != COMPOSITION_CONFIGURING { return false; }
    word slotCount = raw_word_load(pointer_add(container, COMPOSITION_SLOT_COUNT_OFFSET));
    // The root stack is now a growable chain (see Runtime.Mem.Gc.RootsHandles), not a
    // fixed-capacity table, so there is no capacity to pre-check here; `GcRegisterRoot` below
    // reports its own failure (only possible if the platform allocator refuses a new block).
    if slot >= slotCount { return false; }
    pointer slots = NativePointer(raw_word_load(pointer_add(container, COMPOSITION_SLOTS_OFFSET)));
    pointer destination = pointer_add(slots, slot * 8);
    if raw_word_load(destination) != 0 { return false; }
    raw_word_store(destination, NativeWord(service));
    if GcRegisterRoot(destination) == false {
        raw_word_store(destination, 0);
        return false;
    }
    return true;
}

[Export(Abi:"C", Symbol:"composition_launch")]
pub bool CompositionLaunch(pointer container) {
    if CompositionContainerValid(container) == 0 { return false; }
    if raw_word_load(pointer_add(container, COMPOSITION_STATUS_OFFSET)) != COMPOSITION_CONFIGURING { return false; }
    raw_word_store(pointer_add(container, COMPOSITION_STATUS_OFFSET), COMPOSITION_ACTIVATING);
    word slotCount = raw_word_load(pointer_add(container, COMPOSITION_SLOT_COUNT_OFFSET));
    pointer slots = NativePointer(raw_word_load(pointer_add(container, COMPOSITION_SLOTS_OFFSET)));
    mut word slot = 0;
    while slot < slotCount {
        if raw_word_load(pointer_add(slots, slot * 8)) == 0 {
            raw_word_store(pointer_add(container, COMPOSITION_ACTIVATED_COUNT_OFFSET), 0);
            raw_word_store(pointer_add(container, COMPOSITION_STATUS_OFFSET), COMPOSITION_CONFIGURING);
            return false;
        }
        raw_word_store(pointer_add(container, COMPOSITION_ACTIVATED_COUNT_OFFSET), slot + 1);
        slot = slot + 1;
    }
    raw_word_store(pointer_add(container, COMPOSITION_STATUS_OFFSET), COMPOSITION_ACTIVE);
    return true;
}

// The two IDs are emitted from one validated scope tree. The active fiber's top frame
// must be the frozen parent; repeated entry of the same named scope owns a new frame.
pub bool CompositionScopeTryEnter(pointer container, word scopeId, word parentScopeId) {
    if CompositionContainerValid(container) == 0 ||
       raw_word_load(pointer_add(container, COMPOSITION_STATUS_OFFSET)) != COMPOSITION_ACTIVE ||
       scopeId == 0 || scopeId == parentScopeId { return false; }
    pointer owner = CompositionScopeOwner();
    if owner == NativePointer(0) { return false; }
    word scopeOffset = CompositionScopeOffset();
    word depthOffset = CompositionDepthOffset();
    pointer previous = NativePointer(raw_word_load(pointer_add(owner, scopeOffset)));
    if previous == NativePointer(0) {
        if parentScopeId != 0 { return false; }
    } else {
        if NativePointer(raw_word_load(previous)) != container { return false; }
        word activeId = raw_word_load(pointer_add(previous, 32));
        word activeParentId = raw_word_load(pointer_add(previous, 40));
        if activeId != parentScopeId && !(activeId == scopeId && activeParentId == parentScopeId) {
            return false;
        }
    }
    pointer scopePtr = SystemAllocate(COMPOSITION_SCOPE_SIZE, 8);
    if scopePtr == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    memory_set(scopePtr, 0, COMPOSITION_SCOPE_SIZE);
    raw_word_store(scopePtr, NativeWord(container));
    raw_word_store(pointer_add(scopePtr, 8), NativeWord(previous));
    // Owned values are allocated on first use (`CompositionScopeOwn`), never pre-sized.
    raw_word_store(pointer_add(scopePtr, 32), scopeId);
    raw_word_store(pointer_add(scopePtr, 40), parentScopeId);
    raw_word_store(pointer_add(owner, scopeOffset), NativeWord(scopePtr));
    raw_word_store(pointer_add(owner, depthOffset), raw_word_load(pointer_add(owner, depthOffset)) + 1);
    raw_word_store(pointer_add(container, COMPOSITION_OPEN_SCOPE_COUNT_OFFSET), raw_word_load(pointer_add(container, COMPOSITION_OPEN_SCOPE_COUNT_OFFSET)) + 1);
    return true;
}

// Roots `value` in the active scope's owned-value list, which grows on demand (count at
// offset 16, data at 24, capacity at 48 of the scope record). Returns false when no scope is
// open, the root registry refuses, or the system allocator refuses the growth.
pub bool CompositionScopeOwn(pointer value) {
    pointer owner = CompositionScopeOwner();
    if owner == NativePointer(0) || value == NativePointer(0) { return false; }
    pointer scopePtr = NativePointer(raw_word_load(pointer_add(owner, CompositionScopeOffset())));
    if scopePtr == NativePointer(0) { return false; }
    word count = raw_word_load(pointer_add(scopePtr, COMPOSITION_SCOPE_OWNED_COUNT));
    // The vector header order here (count 16, data 24, capacity 48) is the scope record's own,
    // so growth is spelled out instead of reusing Storage.bd's contiguous header.
    word capacity = raw_word_load(pointer_add(scopePtr, COMPOSITION_SCOPE_OWNED_CAPACITY));
    mut pointer values = NativePointer(raw_word_load(pointer_add(scopePtr, COMPOSITION_SCOPE_OWNED_VALUES)));
    if count >= capacity {
        mut word next = capacity * 2;
        if next < 16 { next = 16; }
        pointer fresh = SystemAllocate(next * 8, 8);
        if fresh == NativePointer(0) { return false; }
        memory_set(fresh, 0, next * 8);
        if values != NativePointer(0) {
            if count != 0 { memory_copy(fresh, values, count * 8); }
            // Roots are address-identity entries; move them to the new storage.
            mut word moved = 0;
            while moved < count {
                GcUnregisterRoot(pointer_add(values, moved * 8));
                if GcRegisterRoot(pointer_add(fresh, moved * 8)) == false { Trap(5, NativePointer(0), 0); }
                moved = moved + 1;
            }
            SystemFree(values, capacity * 8);
        }
        values = fresh;
        raw_word_store(pointer_add(scopePtr, COMPOSITION_SCOPE_OWNED_VALUES), NativeWord(fresh));
        raw_word_store(pointer_add(scopePtr, COMPOSITION_SCOPE_OWNED_CAPACITY), next);
    }
    pointer destination = pointer_add(values, count * 8);
    raw_word_store(destination, NativeWord(value));
    if GcRegisterRoot(destination) == false {
        raw_word_store(destination, 0);
        return false;
    }
    raw_word_store(pointer_add(scopePtr, COMPOSITION_SCOPE_OWNED_COUNT), count + 1);
    return true;
}

[Export(Abi:"C", Symbol:"composition_scope_enter")]
pub unit CompositionScopeEnter(pointer container, word scopeId, word parentScopeId) {
    // A task isolate has no composition container and never resolves its parent's (v0.6.3): an
    // injected read inside an isolate ends the isolate main fiber as a panic, not a trap.
    if container != NativePointer(0) && IsolateIsTask() && CompositionContainerValid(container) == 0 {
        PanicCompositionUnavailable();
    }
    if !CompositionScopeTryEnter(container, scopeId, parentScopeId) {
        Trap(10, NativePointer(0), 0);
    }
    return;
}

[Export(Abi:"C", Symbol:"composition_scope_leave")]
pub unit CompositionScopeLeave() {
    pointer owner = CompositionScopeOwner();
    if owner == NativePointer(0) { Trap(10, NativePointer(0), 0); }
    word scopeOffset = CompositionScopeOffset();
    word depthOffset = CompositionDepthOffset();
    pointer scopePtr = NativePointer(raw_word_load(pointer_add(owner, scopeOffset)));
    if scopePtr == NativePointer(0) { Trap(10, NativePointer(0), 0); }
    pointer container = NativePointer(raw_word_load(scopePtr));
    if CompositionContainerValid(container) == 0 { Trap(10, NativePointer(0), 0); }
    pointer ownedValues = NativePointer(raw_word_load(pointer_add(scopePtr, COMPOSITION_SCOPE_OWNED_VALUES)));
    mut word ownedCount = raw_word_load(pointer_add(scopePtr, COMPOSITION_SCOPE_OWNED_COUNT));
    while ownedCount > 0 {
        ownedCount = ownedCount - 1;
        GcUnregisterRoot(pointer_add(ownedValues, ownedCount * 8));
        raw_word_store(pointer_add(ownedValues, ownedCount * 8), 0);
    }
    raw_word_store(pointer_add(owner, scopeOffset), raw_word_load(pointer_add(scopePtr, 8)));
    raw_word_store(pointer_add(owner, depthOffset), raw_word_load(pointer_add(owner, depthOffset)) - 1);
    raw_word_store(pointer_add(container, COMPOSITION_OPEN_SCOPE_COUNT_OFFSET), raw_word_load(pointer_add(container, COMPOSITION_OPEN_SCOPE_COUNT_OFFSET)) - 1);
    word ownedCapacity = raw_word_load(pointer_add(scopePtr, COMPOSITION_SCOPE_OWNED_CAPACITY));
    if ownedValues != NativePointer(0) && ownedCapacity != 0 { SystemFree(ownedValues, ownedCapacity * 8); }
    memory_set(scopePtr, 0, COMPOSITION_SCOPE_SIZE);
    SystemFree(scopePtr, COMPOSITION_SCOPE_SIZE);
    return;
}

[Export(Abi:"C", Symbol:"composition_scope_depth")]
pub i32 CompositionScopeDepth() {
    pointer owner = CompositionScopeOwner();
    if owner == NativePointer(0) { return 0; }
    return i32(raw_word_load(pointer_add(owner, CompositionDepthOffset())));
}

pub bool CompositionTryShutdown(pointer container) {
    if CompositionContainerValid(container) == 0 { return false; }
    word status = raw_word_load(pointer_add(container, COMPOSITION_STATUS_OFFSET));
    if (status != COMPOSITION_CONFIGURING && status != COMPOSITION_ACTIVE) ||
       raw_word_load(pointer_add(container, COMPOSITION_OPEN_SCOPE_COUNT_OFFSET)) != 0 {
        return false;
    }
    raw_word_store(pointer_add(container, COMPOSITION_STATUS_OFFSET), COMPOSITION_SHUTTING_DOWN);
    pointer slots = NativePointer(raw_word_load(pointer_add(container, COMPOSITION_SLOTS_OFFSET)));
    mut word slot = raw_word_load(pointer_add(container, COMPOSITION_SLOT_COUNT_OFFSET));
    while slot > 0 {
        slot = slot - 1;
        pointer location = pointer_add(slots, slot * 8);
        if raw_word_load(location) != 0 {
            GcUnregisterRoot(location);
            raw_word_store(location, 0);
        }
    }
    raw_word_store(pointer_add(container, COMPOSITION_ACTIVATED_COUNT_OFFSET), 0);
    raw_word_store(pointer_add(container, COMPOSITION_SLOT_COUNT_OFFSET), 0);
    raw_word_store(pointer_add(container, COMPOSITION_STATUS_OFFSET), COMPOSITION_SHUT_DOWN);
    return true;
}

[Export(Abi:"C", Symbol:"composition_shutdown")]
pub unit CompositionShutdown(pointer container) {
    if !CompositionTryShutdown(container) { Trap(10, NativePointer(0), 0); }
    return;
}
