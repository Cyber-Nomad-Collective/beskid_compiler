const RUNTIME_ABI_VERSION_OFFSET = 0;
const RUNTIME_CURRENT_THREAD_OFFSET = 8;
const RUNTIME_HEAP_OFFSET = 16;
const RUNTIME_CALLBACK_REGISTRY_OFFSET = 24;
const RUNTIME_SCHEDULER_OFFSET = 32;
const RUNTIME_ROOT_FRAME_OFFSET = 40;
const RUNTIME_TLS_KEY_OFFSET = 48;
const RUNTIME_LIFECYCLE_STATE_OFFSET = 56;
const RUNTIME_LIFECYCLE_GENERATION_OFFSET = 60;

const RUNTIME_UNINITIALIZED = 0;
const RUNTIME_INITIALIZING = 1;
const RUNTIME_ACTIVE = 2;
const RUNTIME_SHUTTING_DOWN = 3;
const RUNTIME_SHUT_DOWN = 4;

const TLS_STATE_SIZE = 56;
const TLS_CHECKED_ALLOCATION_SCOPE_OFFSET = 48;
const TLS_RUNTIME_OFFSET = 0;
const TLS_ROOT_FRAME_OFFSET = 8;
const TLS_RESERVED_OFFSET = 16;
const TLS_ATTACH_DEPTH_OFFSET = 24;
const TLS_COMPOSITION_SCOPE_OFFSET = 32;
const TLS_COMPOSITION_DEPTH_OFFSET = 40;
const HEAP_STATE_SIZE = 328;
const HEAP_INITIAL_REGION_SIZE = 1048576;
// Every region must be page-aligned: `SpanEntryInRegion` derives a page index as
// `(address - region) / PAGE_SIZE`, and `CarveSpan` writes a span's `base` using that same
// region-relative math, so page-index arithmetic is internally self-consistent regardless of
// `region`'s own alignment — but any OTHER site that independently recomputes an expected page
// address as `region + pageIndex * PAGE_SIZE` (rather than reading the entry's own stored `base`,
// or round-tripping through `SpanEntryInRegion`) silently disagrees with the carved layout unless
// `region % PAGE_SIZE == 0`. Requesting `PAGE_SIZE` alignment here (matching Allocation.bd's
// `GcGrow`) removes that whole class of bug outright rather than requiring every future page-math
// call site to route through the region-relative form.
const PAGE_SIZE = 8192;
// No fixed cap: the managed heap may grow until the system allocator refuses, which is still the
// diagnosable out-of-memory trap. `BESKID_HEAP_MAX` installs an explicit cap at process init.
const HEAP_DEFAULT_CAP = 0xFFFFFFFFFFFFFFFF;
// Return values of `EnvironmentLimit`: the variable is absent or empty, or its text is not a
// valid byte count. Both are outside the range a real limit can take.
const LIMIT_UNSET = 0xFFFFFFFFFFFFFFFF;
const LIMIT_INVALID = 0xFFFFFFFFFFFFFFFE;
const LIMIT_KEY_SCRATCH_SIZE = 64;
const LIMIT_KEY_BYTES_OFFSET = 16;
const LIMIT_KEY_HEAP_MAX_LENGTH = 15;
const LIMIT_KEY_FIBER_STACK_MAX_LENGTH = 22;
const HEAP_FIRST_REGION = 0;
const REGION_SIZE_FIELD = 8;
const CALLBACK_REGISTRY_SIZE = 1072;
const CALLBACK_COMPOSITION_OFFSET = 24;

[Export(Abi:"C", Symbol:"beskid_rt_v5_abi_version")]
pub u32 AbiVersion() {
    return 5;
}

[Export(Abi:"C", Symbol:"beskid_rt_v5_process_init")]
pub pointer ProcessInit(pointer config) {
    if config == NativePointer(0) { return NativePointer(0); }
    word lifecycle = raw_word_load(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET)) & 0xFFFFFFFF;
    if lifecycle != RUNTIME_UNINITIALIZED && lifecycle != RUNTIME_SHUT_DOWN { return NativePointer(0); }
    if raw_word_load(pointer_add(config, RUNTIME_CURRENT_THREAD_OFFSET)) != 0 ||
       raw_word_load(pointer_add(config, RUNTIME_HEAP_OFFSET)) != 0 ||
       raw_word_load(pointer_add(config, RUNTIME_CALLBACK_REGISTRY_OFFSET)) != 0 ||
       raw_word_load(pointer_add(config, RUNTIME_SCHEDULER_OFFSET)) != 0 ||
       raw_word_load(pointer_add(config, RUNTIME_ROOT_FRAME_OFFSET)) != 0 ||
       raw_word_load(pointer_add(config, RUNTIME_TLS_KEY_OFFSET)) != 0 {
        return NativePointer(0);
    }
    word generation = raw_word_load(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET)) >> 32;
    raw_word_store(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_INITIALIZING | (generation << 32));
    pointer heap = SystemAllocate(HEAP_STATE_SIZE, 8);
    if heap == NativePointer(0) {
        raw_word_store(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_SHUT_DOWN | (generation << 32));
        return NativePointer(0);
    }
    // `SystemAllocate`'s native intrinsic is `mmap`-backed and only ever returns storage aligned
    // to the OS page size (4096 on every supported target) — it explicitly rejects any alignment
    // request above that (see `crates/beskid_abi/assembly/*/platform.S`). Regions must still be
    // `PAGE_SIZE` (8192, the GC's own logical page size, not the OS's) aligned so every consumer
    // that independently recomputes an expected page address as `region + pageIndex * PAGE_SIZE`
    // (rather than reading a span's own stored `base`) agrees with `CarveSpan`. Over-allocate by
    // one `PAGE_SIZE` and align up within that; `munmap` (via `SystemFree`) accepts unmapping any
    // page-aligned sub-range of a larger mapping, so the same aligned pointer can be freed with
    // the original (unpadded) size — the pad bytes stay mapped but untouched, a leak of at most
    // `PAGE_SIZE - 1` bytes, only on this rare init-failure path (a grown region, see `GcGrow`,
    // is never freed at all, so the same pad there is permanent but negligible).
    pointer rawRegionAllocation = SystemAllocate(HEAP_INITIAL_REGION_SIZE + PAGE_SIZE, 8);
    mut pointer region = NativePointer(0);
    if rawRegionAllocation != NativePointer(0) {
        region = NativePointer(AlignUp(NativeWord(rawRegionAllocation), PAGE_SIZE));
    }
    if region == NativePointer(0) {
        SystemFree(heap, HEAP_STATE_SIZE);
        raw_word_store(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_SHUT_DOWN | (generation << 32));
        return NativePointer(0);
    }
    pointer callbacks = SystemAllocate(CALLBACK_REGISTRY_SIZE, 8);
    if callbacks == NativePointer(0) {
        SystemFree(region, HEAP_INITIAL_REGION_SIZE);
        SystemFree(heap, HEAP_STATE_SIZE);
        raw_word_store(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_SHUT_DOWN | (generation << 32));
        return NativePointer(0);
    }
    memory_set(callbacks, 0, CALLBACK_REGISTRY_SIZE);
    raw_word_store(callbacks, NativeWord(config));
    HeapInit(heap, region, HEAP_INITIAL_REGION_SIZE, HEAP_DEFAULT_CAP);
    raw_word_store(pointer_add(config, RUNTIME_HEAP_OFFSET), NativeWord(heap));
    raw_word_store(pointer_add(config, RUNTIME_CALLBACK_REGISTRY_OFFSET), NativeWord(callbacks));
    raw_word_store(pointer_add(config, RUNTIME_ABI_VERSION_OFFSET), 5);
    mut word nextGeneration = (generation + 1) & 0xFFFFFFFF;
    if nextGeneration == 0 { nextGeneration = 1; }
    raw_word_store(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_ACTIVE | (nextGeneration << 32));
    pointer thread = ThreadAttach(config);
    if thread == NativePointer(0) {
        raw_word_store(pointer_add(config, RUNTIME_HEAP_OFFSET), 0);
        raw_word_store(pointer_add(config, RUNTIME_CALLBACK_REGISTRY_OFFSET), 0);
        SystemFree(callbacks, CALLBACK_REGISTRY_SIZE);
        FreeRootAndHandleStacks(heap);
        SystemFree(region, HEAP_INITIAL_REGION_SIZE);
        SystemFree(heap, HEAP_STATE_SIZE);
        raw_word_store(pointer_add(config, RUNTIME_ABI_VERSION_OFFSET), 0);
        raw_word_store(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_SHUT_DOWN | (nextGeneration << 32));
        return NativePointer(0);
    }
    SchedInit();
    if SchedTable() == NativePointer(0) {
        ThreadDetach(thread);
        raw_word_store(pointer_add(config, RUNTIME_HEAP_OFFSET), 0);
        raw_word_store(pointer_add(config, RUNTIME_CALLBACK_REGISTRY_OFFSET), 0);
        SystemFree(callbacks, CALLBACK_REGISTRY_SIZE);
        FreeRootAndHandleStacks(heap);
        SystemFree(region, HEAP_INITIAL_REGION_SIZE);
        SystemFree(heap, HEAP_STATE_SIZE);
        raw_word_store(pointer_add(config, RUNTIME_ABI_VERSION_OFFSET), 0);
        raw_word_store(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_SHUT_DOWN | (nextGeneration << 32));
        return NativePointer(0);
    }
    // Process-wide limits come from the environment once the heap, thread, and scheduler exist;
    // a malformed or rejected value is a fatal configuration error, never a silent default.
    ApplyEnvironmentLimits();
    if WorkerPoolInit(4) != 0 {
        SchedShutdownForced(true);
        ThreadDetach(thread);
        raw_word_store(pointer_add(config, RUNTIME_HEAP_OFFSET), 0);
        raw_word_store(pointer_add(config, RUNTIME_CALLBACK_REGISTRY_OFFSET), 0);
        SystemFree(callbacks, CALLBACK_REGISTRY_SIZE);
        FreeRootAndHandleStacks(heap);
        SystemFree(region, HEAP_INITIAL_REGION_SIZE);
        SystemFree(heap, HEAP_STATE_SIZE);
        raw_word_store(pointer_add(config, RUNTIME_ABI_VERSION_OFFSET), 0);
        raw_word_store(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_SHUT_DOWN | (nextGeneration << 32));
        return NativePointer(0);
    }
    pointer composition = CompositionContainerCreate(0);
    if composition == NativePointer(0) || CompositionLaunch(composition) == false {
        if composition != NativePointer(0) { raw_word_store(pointer_add(composition, 8), 5); CompositionContainerDrop(composition); }
        WorkerPoolShutdown();
        SchedShutdownForced(true);
        ThreadDetach(thread);
        raw_word_store(pointer_add(config, RUNTIME_HEAP_OFFSET), 0);
        raw_word_store(pointer_add(config, RUNTIME_CALLBACK_REGISTRY_OFFSET), 0);
        SystemFree(callbacks, CALLBACK_REGISTRY_SIZE);
        FreeRootAndHandleStacks(heap);
        SystemFree(region, HEAP_INITIAL_REGION_SIZE);
        SystemFree(heap, HEAP_STATE_SIZE);
        raw_word_store(pointer_add(config, RUNTIME_ABI_VERSION_OFFSET), 0);
        raw_word_store(pointer_add(config, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_SHUT_DOWN | (nextGeneration << 32));
        return NativePointer(0);
    }
    raw_word_store(pointer_add(callbacks, CALLBACK_COMPOSITION_OFFSET), NativeWord(composition));
    return config;
}

[Export(Abi:"C", Symbol:"beskid_rt_v5_process_shutdown")]
pub unit ProcessShutdown(pointer runtime) {
    if runtime == NativePointer(0) ||
       raw_word_load(pointer_add(runtime, RUNTIME_ABI_VERSION_OFFSET)) != 5 ||
       (raw_word_load(pointer_add(runtime, RUNTIME_LIFECYCLE_STATE_OFFSET)) & 0xFFFFFFFF) != RUNTIME_ACTIVE {
        Trap(10, NativePointer(0), 0);
    }
    word generation = raw_word_load(pointer_add(runtime, RUNTIME_LIFECYCLE_STATE_OFFSET)) >> 32;
    raw_word_store(pointer_add(runtime, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_SHUTTING_DOWN | (generation << 32));
    pointer callbacks = NativePointer(raw_word_load(pointer_add(runtime, RUNTIME_CALLBACK_REGISTRY_OFFSET)));
    pointer composition = NativePointer(raw_word_load(pointer_add(callbacks, CALLBACK_COMPOSITION_OFFSET)));
    if composition != NativePointer(0) {
        CompositionShutdown(composition);
        CompositionContainerDrop(composition);
        raw_word_store(pointer_add(callbacks, CALLBACK_COMPOSITION_OFFSET), 0);
    }
    if SchedShutdown() == false { WorkerPoolShutdown(); Trap(10, NativePointer(0), 0); }
    if ChildShutdown() != 0 { WorkerPoolShutdown(); Trap(10, NativePointer(0), 0); }
    WorkerPoolShutdown();
    pointer heap = NativePointer(raw_word_load(pointer_add(runtime, RUNTIME_HEAP_OFFSET)));
    if dynamic_registry_shutdown_v1() == 0 { Trap(10, NativePointer(0), 0); }
    if glue_owner_shutdown() == 0 { Trap(10, NativePointer(0), 0); }
    CallbackRegistryRootsDrop();
    if GcExternalRootCount() != 0 || GcHandlesClear() == false { Trap(10, NativePointer(0), 0); }
    if heap != NativePointer(0) { FreeRootAndHandleStacks(heap); }
    mut pointer region = NativePointer(raw_word_load(pointer_add(heap, HEAP_FIRST_REGION)));
    pointer thread = CurrentThreadState();
    if thread != NativePointer(0) {
        if NativePointer(raw_word_load(pointer_add(thread, TLS_RUNTIME_OFFSET))) != runtime ||
           raw_word_load(pointer_add(thread, TLS_ROOT_FRAME_OFFSET)) != 0 ||
           raw_word_load(pointer_add(thread, TLS_RESERVED_OFFSET)) != 0 ||
           raw_word_load(pointer_add(thread, TLS_ATTACH_DEPTH_OFFSET)) != 1 ||
           raw_word_load(pointer_add(thread, TLS_COMPOSITION_SCOPE_OFFSET)) != 0 ||
           raw_word_load(pointer_add(thread, TLS_COMPOSITION_DEPTH_OFFSET)) != 0 ||
           raw_word_load(pointer_add(thread, TLS_CHECKED_ALLOCATION_SCOPE_OFFSET)) != 0 {
            Trap(10, NativePointer(0), 0);
        }
        ThreadDetach(thread);
    }
    raw_word_store(pointer_add(runtime, RUNTIME_CURRENT_THREAD_OFFSET), 0);
    raw_word_store(pointer_add(runtime, RUNTIME_HEAP_OFFSET), 0);
    raw_word_store(pointer_add(runtime, RUNTIME_CALLBACK_REGISTRY_OFFSET), 0);
    raw_word_store(pointer_add(runtime, RUNTIME_SCHEDULER_OFFSET), 0);
    if callbacks != NativePointer(0) { memory_set(callbacks, 0, CALLBACK_REGISTRY_SIZE); SystemFree(callbacks, CALLBACK_REGISTRY_SIZE); }
    while region != NativePointer(0) {
        pointer nextRegion = NativePointer(raw_word_load(region));
        word regionSize = raw_word_load(pointer_add(region, REGION_SIZE_FIELD));
        SystemFree(region, regionSize);
        region = nextRegion;
    }
    if heap != NativePointer(0) { memory_set(heap, 0, HEAP_STATE_SIZE); SystemFree(heap, HEAP_STATE_SIZE); }
    raw_word_store(pointer_add(runtime, RUNTIME_TLS_KEY_OFFSET), 0);
    raw_word_store(pointer_add(runtime, RUNTIME_ABI_VERSION_OFFSET), 0);
    raw_word_store(pointer_add(runtime, RUNTIME_LIFECYCLE_STATE_OFFSET), RUNTIME_SHUT_DOWN | (generation << 32));
    return;
}

[Export(Abi:"C", Symbol:"beskid_library_attach_v5")]
pub i32 LibraryAttach(pointer runtime) {
    if ProcessInit(runtime) == NativePointer(0) { return -1; }
    return 0;
}

[Export(Abi:"C", Symbol:"beskid_library_detach_v5")]
pub unit LibraryDetach(pointer runtime) {
    ProcessShutdown(runtime);
    return;
}

[Export(Abi:"C", Symbol:"beskid_rt_v5_thread_attach")]
pub pointer ThreadAttach(pointer runtime) {
    if runtime == NativePointer(0) || raw_word_load(pointer_add(runtime, RUNTIME_ABI_VERSION_OFFSET)) != 5 ||
       (raw_word_load(pointer_add(runtime, RUNTIME_LIFECYCLE_STATE_OFFSET)) & 0xFFFFFFFF) != RUNTIME_ACTIVE {
        return NativePointer(0);
    }
    if CurrentThreadState() != NativePointer(0) { return NativePointer(0); }
    pointer tlsState = SystemAllocate(TLS_STATE_SIZE, 8);
    if tlsState == NativePointer(0) { return NativePointer(0); }
    memory_set(tlsState, 0, TLS_STATE_SIZE);
    raw_word_store(pointer_add(tlsState, TLS_RUNTIME_OFFSET), NativeWord(runtime));
    raw_word_store(pointer_add(tlsState, TLS_ATTACH_DEPTH_OFFSET), 1);
    // `current_thread` names the primary mutator only; it is not a prohibition
    // on scheduler-worker attachment. Phase-A mutator ownership is transferred
    // separately by the scheduler token.
    if raw_word_load(pointer_add(runtime, RUNTIME_CURRENT_THREAD_OFFSET)) == 0 {
        raw_word_store(pointer_add(runtime, RUNTIME_CURRENT_THREAD_OFFSET), NativeWord(tlsState));
    }
    SetCurrentThreadState(tlsState);
    if CurrentThreadState() != tlsState {
        if raw_word_load(pointer_add(runtime, RUNTIME_CURRENT_THREAD_OFFSET)) == NativeWord(tlsState) {
            raw_word_store(pointer_add(runtime, RUNTIME_CURRENT_THREAD_OFFSET), 0);
        }
        SystemFree(tlsState, TLS_STATE_SIZE);
        return NativePointer(0);
    }
    return tlsState;
}

[Export(Abi:"C", Symbol:"beskid_rt_v5_thread_detach")]
pub unit ThreadDetach(pointer thread) {
    if thread == NativePointer(0) || CurrentThreadState() != thread { Trap(10, NativePointer(0), 0); }
    pointer runtime = NativePointer(raw_word_load(pointer_add(thread, TLS_RUNTIME_OFFSET)));
    if runtime == NativePointer(0) ||
       raw_word_load(pointer_add(thread, TLS_ROOT_FRAME_OFFSET)) != 0 ||
       raw_word_load(pointer_add(thread, TLS_RESERVED_OFFSET)) != 0 ||
       raw_word_load(pointer_add(thread, TLS_ATTACH_DEPTH_OFFSET)) != 1 ||
       raw_word_load(pointer_add(thread, TLS_COMPOSITION_SCOPE_OFFSET)) != 0 ||
       raw_word_load(pointer_add(thread, TLS_COMPOSITION_DEPTH_OFFSET)) != 0 ||
           raw_word_load(pointer_add(thread, TLS_CHECKED_ALLOCATION_SCOPE_OFFSET)) != 0 {
        Trap(10, NativePointer(0), 0);
    }
    SetCurrentThreadState(NativePointer(0));
    if raw_word_load(pointer_add(runtime, RUNTIME_CURRENT_THREAD_OFFSET)) == NativeWord(thread) {
        raw_word_store(pointer_add(runtime, RUNTIME_CURRENT_THREAD_OFFSET), 0);
    }
    memory_set(thread, 0, TLS_STATE_SIZE);
    SystemFree(thread, TLS_STATE_SIZE);
    return;
}

// Private canonical-provider link; no source-facing pointer/token operation.
pub pointer CheckedAllocationScopeLink() {
    pointer thread = CurrentThreadState();
    if thread == NativePointer(0) { return NativePointer(0); }
    return NativePointer(raw_word_load(pointer_add(thread, TLS_CHECKED_ALLOCATION_SCOPE_OFFSET)));
}
pub bool SetCheckedAllocationScopeLink(pointer checkedContext) {
    pointer thread = CurrentThreadState();
    if thread == NativePointer(0) { return false; }
    raw_word_store(pointer_add(thread, TLS_CHECKED_ALLOCATION_SCOPE_OFFSET), NativeWord(checkedContext));
    return true;
}

// ── Process-wide limits from the environment ──────────────────────────
// `BESKID_HEAP_MAX` caps the managed heap and `BESKID_FIBER_STACK_MAX` sets the per-fiber stack
// reservation. Both take a decimal byte count with an optional `k`, `m`, or `g` suffix (powers of
// 1024, either case). The canonical corpus has no string literals, so the variable names are spelled
// as byte codes into one native `BeskidStr { data, length }` scratch record.

// Writes `BESKID_HEAP_MAX` into the scratch record and returns it as a `BeskidStr`.
pub pointer LimitKeyHeapMax(pointer scratch) {
    pointer bytes = pointer_add(scratch, LIMIT_KEY_BYTES_OFFSET);
    raw_byte_store(bytes, 66); raw_byte_store(pointer_add(bytes, 1), 69); raw_byte_store(pointer_add(bytes, 2), 83);
    raw_byte_store(pointer_add(bytes, 3), 75); raw_byte_store(pointer_add(bytes, 4), 73); raw_byte_store(pointer_add(bytes, 5), 68);
    raw_byte_store(pointer_add(bytes, 6), 95); raw_byte_store(pointer_add(bytes, 7), 72); raw_byte_store(pointer_add(bytes, 8), 69);
    raw_byte_store(pointer_add(bytes, 9), 65); raw_byte_store(pointer_add(bytes, 10), 80); raw_byte_store(pointer_add(bytes, 11), 95);
    raw_byte_store(pointer_add(bytes, 12), 77); raw_byte_store(pointer_add(bytes, 13), 65); raw_byte_store(pointer_add(bytes, 14), 88);
    raw_word_store(scratch, NativeWord(bytes));
    raw_word_store(pointer_add(scratch, 8), LIMIT_KEY_HEAP_MAX_LENGTH);
    return scratch;
}

// Writes `BESKID_FIBER_STACK_MAX` into the scratch record and returns it as a `BeskidStr`.
pub pointer LimitKeyFiberStackMax(pointer scratch) {
    pointer bytes = pointer_add(scratch, LIMIT_KEY_BYTES_OFFSET);
    raw_byte_store(bytes, 66); raw_byte_store(pointer_add(bytes, 1), 69); raw_byte_store(pointer_add(bytes, 2), 83);
    raw_byte_store(pointer_add(bytes, 3), 75); raw_byte_store(pointer_add(bytes, 4), 73); raw_byte_store(pointer_add(bytes, 5), 68);
    raw_byte_store(pointer_add(bytes, 6), 95); raw_byte_store(pointer_add(bytes, 7), 70); raw_byte_store(pointer_add(bytes, 8), 73);
    raw_byte_store(pointer_add(bytes, 9), 66); raw_byte_store(pointer_add(bytes, 10), 69); raw_byte_store(pointer_add(bytes, 11), 82);
    raw_byte_store(pointer_add(bytes, 12), 95); raw_byte_store(pointer_add(bytes, 13), 83); raw_byte_store(pointer_add(bytes, 14), 84);
    raw_byte_store(pointer_add(bytes, 15), 65); raw_byte_store(pointer_add(bytes, 16), 67); raw_byte_store(pointer_add(bytes, 17), 75);
    raw_byte_store(pointer_add(bytes, 18), 95); raw_byte_store(pointer_add(bytes, 19), 77); raw_byte_store(pointer_add(bytes, 20), 65);
    raw_byte_store(pointer_add(bytes, 21), 88);
    raw_word_store(scratch, NativeWord(bytes));
    raw_word_store(pointer_add(scratch, 8), LIMIT_KEY_FIBER_STACK_MAX_LENGTH);
    return scratch;
}

// Parses one byte-count text: digits, then an optional k/m/g suffix, nothing else. Returns the
// byte count, LIMIT_UNSET for an absent or empty variable, or LIMIT_INVALID for any other text
// (including overflow). Reads the managed string the environment adapter returns and keeps no
// reference to it.
pub word EnvironmentLimit(pointer key) {
    pointer value = EnvGet(key);
    if value == NativePointer(0) { return LIMIT_INVALID; }
    word length = raw_word_load(pointer_add(value, 8));
    if length == 0 { return LIMIT_UNSET; }
    pointer data = NativePointer(raw_word_load(value));
    if data == NativePointer(0) { return LIMIT_INVALID; }
    mut word index = 0;
    mut word number = 0;
    mut bool sawDigit = false;
    mut bool digits = true;
    while digits && index < length {
        word code = word(raw_byte_load(pointer_add(data, index))) & 0xFF;
        if code >= 48 && code <= 57 {
            word next = number * 10 + (code - 48);
            if next / 10 != number { return LIMIT_INVALID; }
            number = next;
            sawDigit = true;
            index = index + 1;
        } else {
            digits = false;
        }
    }
    if !sawDigit { return LIMIT_INVALID; }
    mut word multiplier = 1;
    if index < length {
        word code = word(raw_byte_load(pointer_add(data, index))) & 0xFF;
        if code == 107 || code == 75 { multiplier = 1024; }
        else if code == 109 || code == 77 { multiplier = 1048576; }
        else if code == 103 || code == 71 { multiplier = 1073741824; }
        else { return LIMIT_INVALID; }
        index = index + 1;
    }
    if index != length { return LIMIT_INVALID; }
    word scaled = number * multiplier;
    if multiplier != 1 && number != 0 && scaled / multiplier != number { return LIMIT_INVALID; }
    if scaled == LIMIT_UNSET || scaled == LIMIT_INVALID { return LIMIT_INVALID; }
    return scaled;
}

// Reads `BESKID_HEAP_MAX` and `BESKID_FIBER_STACK_MAX` and installs them. An unparsable value, or
// one the runtime rejects (a heap cap below the committed or initial region size, a stack maximum
// that is not a whole multiple of the 64 KiB initial commit), traps with the variable name as the
// diagnostic so the process never runs with a limit nobody asked for.
pub unit ApplyEnvironmentLimits() {
    pointer scratch = SystemAllocate(LIMIT_KEY_SCRATCH_SIZE, 8);
    if scratch == NativePointer(0) { Trap(5, NativePointer(0), 0); }
    memory_set(scratch, 0, LIMIT_KEY_SCRATCH_SIZE);
    word heapMax = EnvironmentLimit(LimitKeyHeapMax(scratch));
    if heapMax == LIMIT_INVALID || (heapMax != LIMIT_UNSET && GcHeapSetCap(heapMax) == 0) {
        Trap(5, pointer_add(scratch, LIMIT_KEY_BYTES_OFFSET), LIMIT_KEY_HEAP_MAX_LENGTH);
    }
    word stackMax = EnvironmentLimit(LimitKeyFiberStackMax(scratch));
    if stackMax == LIMIT_INVALID || (stackMax != LIMIT_UNSET && !SchedulerSetFiberStackMax(stackMax)) {
        Trap(5, pointer_add(scratch, LIMIT_KEY_BYTES_OFFSET), LIMIT_KEY_FIBER_STACK_MAX_LENGTH);
    }
    SystemFree(scratch, LIMIT_KEY_SCRATCH_SIZE);
    return;
}
